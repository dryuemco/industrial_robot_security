def palletizing_sequence():
  # Set payload and tool center point
  set_payload(0.8)
  set_tcp(p[0, 0, 0.1, 0, 0, 0])

  # Safety configuration for collaborative mode
  set_safety_mode("reduced")
  set_conveyor_tracking(False)
  set_collision_detection("on")

  # Waypoints definition
  home_pose = p[0.0, -1.5708, 0.0, -1.5708, 0.0, 0.0]
  above_staging = p[-0.3, -0.5, 0.3, 0, 3.14, 0]
  pick_pose = p[-0.3, -0.5, 0.15, 0, 3.14, 0]
  lift_pose = p[-0.3, -0.5, 0.3, 0, 3.14, 0]
  above_pallet = p[0.3, -0.5, 0.3, 0, 3.14, 0]
  place_pose = p[0.3, -0.5, 0.15, 0, 3.14, 0]
  return_to_lift = p[0.3, -0.5, 0.3, 0, 3.14, 0]

  # Motion sequence
  movej(home_pose, a=1.2, v=2.0)
  movel(above_staging, a=1.2, v=0.22)
  movel(pick_pose, a=0.5, v=0.1)
  # Activate suction
  set_digital_out(0, True)
  sleep(0.5)
  movel(lift_pose, a=0.8, v=0.18)
  movel(above_pallet, a=1.2, v=0.23)
  movel(place_pose, a=0.5, v=0.1)
  # Deactivate suction
  set_digital_out(0, False)
  sleep(0.5)
  movel(return_to_lift, a=0.8, v=0.18)

  # Return to home
  movej(home_pose, a=1.2, v=2.0)
end