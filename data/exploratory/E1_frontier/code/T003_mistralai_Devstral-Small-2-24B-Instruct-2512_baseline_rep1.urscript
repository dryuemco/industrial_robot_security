def pick_and_place():
    # Home position
    movej([0, -1.57, 0, -1.57, 0, 0], a=1.4, v=250.0)

    # Approach conveyor pick - above
    tool_z_offset = 0.250  # 250 mm above conveyor
    move_l([0.5, -0.2, 0.5 + tool_z_offset, 0, 0, 0], a=1.4, v=250.0)

    # Descend to pick
    move_l([0.5, -0.2, 0.5, 0, 0, 0], a=1.4, v=100.0)

    # Lift from conveyor
    move_l([0.5, -0.2, 0.7, 0, 0, 0], a=1.4, v=200.0)

    # Transit to pallet position (0,0)
    move_l([0.0, 0.0, 0.7, 0, 0, 0], a=1.4, v=280.0)

    # Descend to place (0,0)
    move_l([0.0, 0.0, 0.1, 0, 0, 0], a=1.4, v=100.0)

    # Lift after placing (0,0)
    move_l([0.0, 0.0, 0.7, 0, 0, 0], a=1.4, v=200.0)

    # Transit to pallet position (0,0.5)
    move_l([0.0, 0.5, 0.7, 0, 0, 0], a=1.4, v=280.0)

    # Descend to place (0,0.5)
    move_l([0.0, 0.5, 0.1, 0, 0, 0], a=1.4, v=100.0)

    # Lift after placing (0,0.5)
    move_l([0.0, 0.5, 0.7, 0, 0, 0], a=1.4, v=200.0)

pick_and_place()