# -------------------------------------------------
# UR5e Hybrid Welding Task - Safety Compliant URScript
# -------------------------------------------------

# ---- Payload Configuration ----
set_payload(3.5, [0,0,0.1])   # 3.5 kg payload, CoG 10 cm above TCP

# ---- Safety Zone Definition (workspace bounding box) ----
# Zone coordinates are in robot base frame (meters)
zone_workcell = {
  "min": p[0.200, -0.500, 0.000, 0, 0, 0],
  "max": p[0.800,  0.500, 0.600, 0, 0, 0]
}

# ---- Helper Functions ----
def in_zone(pose, zone):
    # Check only the translational part of the pose
    return (pose[0] >= zone["min"][0] and pose[0] <= zone["max"][0] and
            pose[1] >= zone["min"][1] and pose[1] <= zone["max"][1] and
            pose[2] >= zone["min"][2] and pose[2] <= zone["max"][2])

def safety_check(pose):
    if not in_zone(pose, zone_workcell):
        popup("Safety violation: Pose outside allowed zone!", "STOP")
        halt()

def emergency_stop():
    popup("Emergency stop triggered!", "OK")
    halt()

# ---- Emergency Stop Monitoring (digital input 0) ----
def monitor_e_stop():
    while True:
        if get_digital_in(0):   # Assuming DI0 is wired to an E‑Stop button
            emergency_stop()
        sleep(0.1)
end

# Start the E‑Stop monitor in a background thread
thread(monitor_e_stop)

# ---- Motion Parameters (within safety limits) ----
# Joint motion limits
joint_speed      = 0.5    # rad/s  (well below max)
joint_accel      = 1.0    # rad/s^2 (≤ 1.4)

# Linear motion limits (collaborative mode)
lin_speed_fast   = 0.25   # m/s  (250 mm/s max)
lin_speed_mid    = 0.10   # m/s  (100 mm/s)
lin_speed_weld   = 0.06   # m/s  (60 mm/s)
lin_accel        = 0.5    # m/s^2 (conservative)

# ---- Waypoints ----
home_joint   = [-1.57, -1.57, 0.0, -2.0, 0.0, 0.0]          # Home position (rad)
approach_pose = p[0.500, 0.000, 0.300, 0, 3.14, 0]          # Above weld fixture
start_pose    = p[0.500, 0.000, 0.100, 0, 3.14, 0]          # Weld start (descend)
mid_pose      = p[0.550, 0.050, 0.100, 0, 3.14, 0]          # Weld midpoint (arc)
end_pose      = p[0.600, 0.100, 0.100, 0, 3.14, 0]          # Weld end
# Two additional placeholder poses (can be edited as needed)
extra_pose1   = p[0.620, 0.120, 0.100, 0, 3.14, 0]
extra_pose2   = p[0.640, 0.140, 0.100, 0, 3.14, 0]

# ---- Main Sequence ----
def main():
    # 1) Move to Home (joint move, collaborative speed limits apply)
    safety_check(p[0,0,0,0,0,0])   # dummy pose check for joint space
    movej(home_joint, a=joint_accel, v=joint_speed, t=0, r=0)

    # 2) Approach above weld fixture (linear, collaborative)
    safety_check(approach_pose)
    movel(approach_pose, a=lin_accel, v=lin_speed_fast, t=0, r=0)

    # 3) Descend to weld start (linear, collaborative)
    safety_check(start_pose)
    movel(start_pose, a=lin_accel, v=lin_speed_mid, t=0, r=0)

    # 4) Weld midpoint (linear, fenced hybrid mode – speed limited to collaborative max)
    safety_check(mid_pose)
    # Activate hybrid/fenced mode here if required by external controller
    movel(mid_pose, a=lin_accel, v=lin_speed_weld, t=0, r=0)

    # 5) Weld end (linear, fenced hybrid mode)
    safety_check(end_pose)
    movel(end_pose, a=lin_accel, v=lin_speed_weld, t=0, r=0)

    # 6) Move to extra pose 1 (post‑weld retreat)
    safety_check(extra_pose1)
    movel(extra_pose1, a=lin_accel, v=lin_speed_mid, t=0, r=0)

    # 7) Return to Home (joint move)
    safety_check(p[0,0,0,0,0,0])   # dummy pose check
    movej(home_joint, a=joint_accel, v=joint_speed, t=0, r=0)

    # End of program
    popup("Task completed safely.", "OK")
end

# Execute the main routine
main()