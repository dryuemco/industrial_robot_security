# ============================================================
# URScript for UR5e Collaborative Spot Welding (3 Points)
# ISO 10218:2025 Compliance Mode
# ============================================================

# --- Safety Constants ---
MAX_TCP_SPEED = 0.25        # 250 mm/s
MAX_JOINT_ACCEL = 1.4       # 1.4 rad/s^2
MAX_JOINT_SPEED = 1.0       # rad/s (Safe limit)

# --- Safety Zone Boundaries (Confinement Box) ---
ZONE_X_MIN = 0.30
ZONE_X_MAX = 0.65
ZONE_Y_MIN = -0.30
ZONE_Y_MAX = 0.30
ZONE_Z_MIN = 0.05
ZONE_Z_MAX = 0.40

# --- Emergency Stop Handler ---
def emergency_stop(reason):
    popup("SAFETY VIOLATION: " + reason, warning=False, error=True)
    textmsg("HALT: ", reason)
    stopj(2.0)
    halt
end

# --- Safety Zone Check ---
def check_safety_zone(pose):
    x = pose[0]
    y = pose[1]
    z = pose[2]
    
    if x < ZONE_X_MIN or x > ZONE_X_MAX:
        emergency_stop("X-axis boundary violation")
    elif y < ZONE_Y_MIN or y > ZONE_Y_MAX:
        emergency_stop("Y-axis boundary violation")
    elif z < ZONE_Z_MIN or z > ZONE_Z_MAX:
        emergency_stop("Z-axis boundary violation")
    end
end

# --- Pre-Motion Safety Guard ---
def safety_check():
    # Check for high forces (Collision detection)
    force = get_tcp_force()
    if norm(force) > 50.0:
        emergency_stop("Excessive force detected")
    end
    
    # Check robot status
    if not is_steady():
        emergency_stop("Robot not steady")
    end
end

# --- Weld Activation Function ---
def activate_weld():
    set_digital_out(0, True)  # Trigger weld gun
    sleep(1.5)                # Weld dwell time
    set_digital_out(0, False) # Release weld gun
    sleep(0.2)                # Cool/Release delay
end

# ============================================================
# Main Program
# ============================================================

# 1. Setup Payload (2.5 kg, CoM approx 50mm below flange)
set_payload(2.5, [0, 0, 0.05])

# 2. Define Waypoints
# Home Position (Safe parking)
q_home = [-1.57, -1.57, -1.57, -1.57, -1.57, 0.0]

# Spot 1
p_spot1 = p[0.5, -0.15, 0.15, 3.14, 0, 0]
p_spot1_app = p[0.5, -0.15, 0.25, 3.14, 0, 0] # Approach height

# Spot 2
p_spot2 = p[0.5, 0.0, 0.15, 3.14, 0, 0]
p_spot2_app = p[0.5, 0.0, 0.25, 3.14, 0, 0]   # Approach height

# Spot 3
p_spot3 = p[0.5, 0.15, 0.15, 3.14, 0, 0]
p_spot3_app = p[0.5, 0.15, 0.25, 3.14, 0, 0]  # Approach height

# --- Motion Sequence ---

# Move 1: move_joint: Home, 200.0 mm/s
safety_check()
movej(q_home, a=MAX_JOINT_ACCEL, v=0.2)

# Move 2: move_linear: Approach spot 1, 200.0 mm/s
safety_check()
check_safety_zone(p_spot1_app)
movel(p_spot1_app, a=MAX_JOINT_ACCEL, v=0.2)

# Move 3: move_linear: Descend to spot 1, 80.0 mm/s
safety_check()
check_safety_zone(p_spot1)
movel(p_spot1, a=MAX_JOINT_ACCEL, v=0.08)
activate_weld()

# Move 4: move_linear: Lift from spot 1, 150.0 mm/s
safety_check()
movel(p_spot1_app, a=MAX_JOINT_ACCEL, v=0.15)

# Move 5: move_linear: Move to spot 2, 200.0 mm/s
safety_check()
check_safety_zone(p_spot2_app)
movel(p_spot2_app, a=MAX_JOINT_ACCEL, v=0.2)

# Move 6: move_linear: Descend to spot 2, 80.0 mm/s
safety_check()
check_safety_zone(p_spot2)
movel(p_spot2, a=MAX_JOINT_ACCEL, v=0.08)
activate_weld()

# Move 7: move_linear: Move to spot 3, 200.0 mm/s
safety_check()
check_safety_zone(p_spot3_app)
movel(p_spot3_app, a=MAX_JOINT_ACCEL, v=0.2)

# Move 8: move_linear: Descend to spot 3, 80.0 mm/s
safety_check()
check_safety_zone(p_spot3)
movel(p_spot3, a=MAX_JOINT_ACCEL, v=0.08)
activate_weld()

# End of Sequence
textmsg("Spot welding sequence completed successfully.")