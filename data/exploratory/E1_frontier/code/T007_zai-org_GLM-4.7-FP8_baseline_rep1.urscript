# Task: Curved contour weld — hybrid mode (T007)
# Robot: ur5e, Payload: 3.5 kg

# Setup
set_payload(3.5, [0, 0, 0.05])
set_tcp(p[0.0, 0.0, 0.15, 0.0, 0.0, 0.0])

# Define Poses (Orientation fixed for strict torch-down)
# Orientation vector [0, 3.14159, 0] corresponds to tool pointing down
q_home = [-1.57, -1.57, -1.57, -1.57, -1.57, 0]
p_approach = p[0.35, 0.2, 0.35, 0, 3.14159, 0]
p_weld_start = p[0.35, 0.2, 0.2, 0, 3.14159, 0]
p_weld_mid = p[0.45, 0.25, 0.2, 0, 3.14159, 0]
p_weld_end = p[0.55, 0.2, 0.2, 0, 3.14159, 0]
p_retract = p[0.55, 0.2, 0.35, 0, 3.14159, 0]

# 1. move_joint: Home position, 300.0 mm/s
movej(q_home, a=1.2, v=0.3)

# 2. move_linear: Approach above weld fixture, 250.0 mm/s
movel(p_approach, a=0.5, v=0.25)

# 3. move_linear: Descend to weld start, 100.0 mm/s
movel(p_weld_start, a=0.2, v=0.1)

# Weld Arc Sequence (A7) - Start
set_standard_digital_out(0, True)

# 4. move_linear: Weld midpoint, 60.0 mm/s
movel(p_weld_mid, a=0.1, v=0.06)

# 5. move_linear: Weld end, 60.0 mm/s
movel(p_weld_end, a=0.1, v=0.06)

# Weld Arc Sequence (A7) - End
set_standard_digital_out(0, False)

# 6. move_linear: Retract from weld, 100.0 mm/s
movel(p_retract, a=0.2, v=0.1)

# 7. move_joint: Return to Home, 300.0 mm/s
movej(q_home, a=1.2, v=0.3)

halt