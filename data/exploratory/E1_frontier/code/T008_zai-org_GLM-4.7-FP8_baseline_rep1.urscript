# Heavy Depalletizing Task - Fenced Mode
# Robot: UR5e, Payload: 5.0 kg
# Max TCP Speed: 450.0 mm/s

# Set payload for heavy box (5.0 kg)
set_payload(5.0, [0.0, 0.0, 0.0])

# Set global TCP speed limit (450 mm/s)
set_tcp_speed_limit(0.45)

# Define Poses
p_home = [-1.57, -1.57, -1.57, -1.57, -1.57, 0.0]
p_above_pallet = p[0.3, -0.3, 0.4, 0, 3.14, 0]
p_pick = p[0.3, -0.3, 0.1, 0, 3.14, 0]
p_above_conveyor = p[0.6, 0.3, 0.4, 0, 3.14, 0]
p_place = p[0.6, 0.3, 0.1, 0, 3.14, 0]

# Move 1: move_joint: Home, 400.0 mm/s (approx joint speed)
movej(p_home, a=1.0, v=1.0)

# Move 2: move_linear: Above pallet, 400.0 mm/s
movel(p_above_pallet, a=500, v=0.4)

# Move 3: move_linear: Descend to top layer, 150.0 mm/s
movel(p_pick, a=200, v=0.15)

# Action: Grip Box
# set_digital_out(0, True)
sleep(0.5)

# Move 4: move_linear: Lift box, 200.0 mm/s
movel(p_above_pallet, a=300, v=0.2)

# Move 5: move_linear: Transit to conveyor, 350.0 mm/s
movel(p_above_conveyor, a=500, v=0.35)

# Move 6: move_linear: Descend to conveyor, 150.0 mm/s
movel(p_place, a=200, v=0.15)

# Action: Release Box
# set_digital_out(0, False)
sleep(0.5)

# Move 7: move_linear: Retract from conveyor, 200.0 mm/s
movel(p_above_conveyor, a=300, v=0.2)

# Move 8: move_joint: Return to Home, 400.0 mm/s (approx joint speed)
movej(p_home, a=1.0, v=1.0)