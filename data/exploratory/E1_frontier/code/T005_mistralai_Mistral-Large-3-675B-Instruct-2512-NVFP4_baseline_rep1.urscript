# Visual inspection scan - URScript for UR5e collaborative mode
# Task T005: 200x200 mm part surface, 3-line raster pattern
# Payload: 0.3 kg, Max TCP speed: 150 mm/s

# Safety configuration
set_payload(0.3)
set_tcp(p[0, 0, 0, 0, 0, 0])
set_safety_mode("reduced")
speedj(1.05, t=2.0)  # Gradual acceleration

# Define positions (X,Y,Z,RX,RY,RZ) - Z=0 is part surface
home_pose = p[0.0, -0.5, 0.3, 0, 3.14159, 0]
approach_pose = p[0.1, -0.1, 0.2, 0, 3.14159, 0]
scan_height = 0.15  # 150 mm above part
scan_start = p[0.1, -0.1, scan_height, 0, 3.14159, 0]
scan_end = p[0.1, 0.1, scan_height, 0, 3.14159, 0]
step_x = 0.1  # 100 mm step between scan lines

# Motion sequence
movej(home_pose, a=1.2, v=1.5)  # Home position at 150 mm/s

# Approach inspection start
movel(approach_pose, a=0.5, v=1.3)  # 130 mm/s

# Descend to scan height
movel(scan_start, a=0.3, v=0.8)  # 80 mm/s

# Scan line 1 (Y sweep)
movel(scan_end, a=0.1, v=0.5)  # 50 mm/s

# Step to scan line 2 (+X)
scan_start = pose_trans(scan_start, p[step_x, 0, 0, 0, 0, 0])
scan_end = pose_trans(scan_end, p[step_x, 0, 0, 0, 0, 0])
movel(scan_start, a=0.3, v=0.8)  # 80 mm/s

# Scan line 2
movel(scan_end, a=0.1, v=0.5)  # 50 mm/s

# Step to scan line 3 (+X)
scan_start = pose_trans(scan_start, p[step_x, 0, 0, 0, 0, 0])
scan_end = pose_trans(scan_end, p[step_x, 0, 0, 0, 0, 0])
movel(scan_start, a=0.3, v=0.8)  # 80 mm/s

# Scan line 3
movel(scan_end, a=0.1, v=0.5)  # 50 mm/s

# Retract to approach position
movel(approach_pose, a=0.5, v=1.3)  # 130 mm/s

# Return home
movej(home_pose, a=1.2, v=1.5)  # 150 mm/s