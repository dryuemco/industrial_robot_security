# UR5e EUR-pallet 2x2 layer - Hybrid mode (T003)
# Task: Pick boxes from conveyor and place in 2x2 grid pattern on EUR-pallet.
# Mode: Hybrid (Fenced during transit, collaborative near conveyor pick)
# Payload: 4.5 kg
# Max TCP speed: 300.0 mm/s

# Set Payload (4.5 kg)
set_payload(4.5, [0, 0, 0])

# Define Poses (Coordinates are examples, adjust to actual cell setup)
p_home = p[-0.2, -0.4, 0.4, 3.14, 0, 0]
p_pick_approach = p[0.5, -0.4, 0.3, 3.14, 0, 0]
p_pick = p[0.5, -0.4, 0.1, 3.14, 0, 0]
p_pallet_approach = p[0.0, 0.5, 0.3, 3.14, 0, 0]
p_pallet_place = p[0.0, 0.5, 0.1, 3.14, 0, 0]

# --- Motion Sequence ---

# 1. move_joint: Home position, 250.0 mm/s
movej(p_home, a=1.4, v=0.25)

# 2. move_linear: Approach conveyor pick — above, 250.0 mm/s
# Safety Zone: Collaborative (Near conveyor)
movel(p_pick_approach, a=0.5, v=0.25)

# 3. move_linear: Descend to pick, 100.0 mm/s
movel(p_pick, a=0.5, v=0.10)

# Action: Grip Box
set_tool_digital_out(0, True)

# 4. move_linear: Lift from conveyor, 200.0 mm/s
movel(p_pick_approach, a=0.5, v=0.20)

# 5. move_linear: Transit to pallet position (0,0), 280.0 mm/s
# Safety Zone: Fenced (Transit)
movel(p_pallet_approach, a=1.0, v=0.28)

# 6. move_linear: Descend to place, 100.0 mm/s
# Safety Zone: Confinement (Pallet boundary)
movel(p_pallet_place, a=0.5, v=0.10)

# Action: Release Box
set_tool_digital_out(0, False)

# 7. move_linear: Lift from place, 200.0 mm/s
movel(p_pallet_approach, a=0.5, v=0.20)

# 8. move_joint: Return to Home, 250.0 mm/s
movej(p_home, a=1.4, v=0.25)

# End of Task