def simple_pick_place():
    # Move to home position
    movej(p[0.0, -1.823879, 1.570796, -1.570796, -1.570796, 0.0], a=1.4, v=1.05)

    # Approach pick point
    movel(p[0.3, -0.2, 0.5, 3.14159, 0, 0], a=1.2, v=0.2)

    # Descend to pick
    movel(p[0.3, -0.2, 0.2, 3.14159, 0, 0], a=1.2, v=0.1)

    # Lift from pick
    movel(p[0.3, -0.2, 0.5, 3.14159, 0, 0], a=1.2, v=0.15)

    # Transit to place approach
    movel(p[0.6, -0.2, 0.5, 3.14159, 0, 0], a=1.2, v=0.2)

    # Approach place point
    movel(p[0.6, -0.2, 0.3, 3.14159, 0, 0], a=1.2, v=0.2)

    # Descend to place
    movel(p[0.6, -0.2, 0.1, 3.14159, 0, 0], a=1.2, v=0.1)

    # Lift from place
    movel(p[0.6, -0.2, 0.3, 3.14159, 0, 0], a=1.2, v=0.15)
end

simple_pick_place()