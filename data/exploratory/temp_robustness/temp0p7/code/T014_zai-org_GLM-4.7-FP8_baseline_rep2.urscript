# Program: Hybrid multi-angle camera inspection (T014)
# Robot: UR5e
# Payload: 0.4 kg

# Configuration
set_payload(0.4, [0, 0, 0.05])
set_tcp(p[0, 0, 0, 0, 0, 0])

# Define Safety Zone (Confinement)
# Limits: x[-0.6, 0.6], y[-0.6, 0.6], z[0.0, 0.8]
pose_min = p[-0.6, -0.6, 0.0, -3.14, -3.14, -3.14]
pose_max = p[0.6, 0.6, 0.8, 3.14, 3.14, 3.14]
set_pos_confinement(True, pose_min, pose_max)

# Define Joint Positions (Radians)
q_home = [-1.57, -1.57, -1.57, -1.57, 1.57, 0]

# Define Inspection Poses (Meters, Radians)
# Top-down view
p_top = p[0.35, 0.0, 0.45, 3.14, 0.0, 0.0]
# Side view
p_side = p[0.35, 0.25, 0.25, 1.57, 0.0, 0.0]
# Angled view
p_angled = p[0.35, -0.25, 0.35, 2.35, 0.5, 0.78]
# Retract position
p_retract = p[0.35, 0.0, 0.5, 3.14, 0.0, 0.0]

# Motion Sequence

# 1. move_joint: Home, 180.0 mm/s (0.18 m/s)
movej(q_home, a=1.2, v=0.18)

# 2. move_linear: Top-down view position, 150.0 mm/s (0.15 m/s)
movel(p_top, a=0.5, v=0.15)

# 3. move_linear: Side view position, 120.0 mm/s (0.12 m/s)
movel(p_side, a=0.5, v=0.12)

# 4. move_linear: Angled view position, 120.0 mm/s (0.12 m/s)
movel(p_angled, a=0.5, v=0.12)

# 5. move_linear: Retract, 180.0 mm/s (0.18 m/s)
movel(p_retract, a=0.5, v=0.18)

# 6. move_joint: Return to Home to complete cycle, 180.0 mm/s
movej(q_home, a=1.2, v=0.18)

# End of program