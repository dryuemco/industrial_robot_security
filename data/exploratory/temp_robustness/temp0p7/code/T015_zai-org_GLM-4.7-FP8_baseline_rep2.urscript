# UR5e Laser Marking Task (Fenced Mode T015)
# Description: Laser engraving of serial number pattern (3 lines) on metal surface.
# Constraints:
#   A7: Laser tool activation (Digital Out 0)
#   A3: Strict laser pointing (Fixed orientation maintained)
#   A6: Marking fixture frame (Relative coordinate system)
# Payload: 0.6 kg
# Max TCP Speed: 400.0 mm/s

def main():
  # --- Setup ---
  # Set payload mass (0.6 kg) and center of mass (default [0,0,0])
  set_payload(0.6, [0,0,0])
  
  # Set Tool Center Point (TCP) - Example offset
  set_tcp(p[0.0, 0.0, 0.15, 0.0, 0.0, 0.0])

  # Define Fixture Frame (A6) - Position and orientation of the workpiece
  # Located 400mm in X, rotated to point down (PI radians around Y)
  p_fixture = p[0.4, 0.0, 0.0, 0, 3.14159, 0]

  # Define Waypoints relative to Fixture Frame
  # Z-safe: 50mm above marking surface
  p_safe_offset = p[0.0, 0.0, 0.05, 0, 0, 0]
  
  # Line 1 (Y=0mm)
  p_l1_start = p[-0.05, 0.0, 0.0, 0, 0, 0]
  p_l1_end   = p[ 0.05, 0.0, 0.0, 0, 0, 0]
  
  # Line 2 (Y=-20mm)
  p_l2_start = p[-0.05, -0.02, 0.0, 0, 0, 0]
  p_l2_end   = p[ 0.05, -0.02, 0.0, 0, 0, 0]
  
  # Line 3 (Y=-40mm)
  p_l3_start = p[-0.05, -0.04, 0.0, 0, 0, 0]
  p_l3_end   = p[ 0.05, -0.04, 0.0, 0, 0, 0]

  # Calculate Absolute Poses using pose_add (A6)
  p_above = pose_add(p_fixture, p_safe_offset)
  
  p_mark_l1_start = pose_add(p_fixture, p_l1_start)
  p_mark_l1_end   = pose_add(p_fixture, p_l1_end)
  
  p_mark_l2_start = pose_add(p_fixture, p_l2_start)
  p_mark_l2_end   = pose_add(p_fixture, p_l2_end)
  
  p_mark_l3_start = pose_add(p_fixture, p_l3_start)
  p_mark_l3_end   = pose_add(p_fixture, p_l3_end)

  # Define Home Joint Configuration
  q_home = [-1.57, -1.57, -1.57, -1.57, -1.57, 0]

  # --- Motion Sequence ---

  # 1. move_joint: Home, 350.0 mm/s
  movej(q_home, a=1.4, v=0.35)

  # 2. move_linear: Above marking surface, 300.0 mm/s
  movel(p_above, a=0.5, v=0.3)

  # 3. move_linear: Descend to marking height (Line 1 Start), 100.0 mm/s
  movel(p_mark_l1_start, a=0.2, v=0.1)

  # 4. move_linear: Mark line 1, 60.0 mm/s
  # A7: Activate Laser
  set_digital_out(0, True)
  movel(p_mark_l1_end, a=0.2, v=0.06)
  set_digital_out(0, False)

  # 5. move_linear: Step to line 2, 80.0 mm/s
  movel(p_mark_l2_start, a=0.2, v=0.08)

  # 6. move_linear: Mark line 2, 60.0 mm/s
  set_digital_out(0, True)
  movel(p_mark_l2_end, a=0.2, v=0.06)
  set_digital_out(0, False)

  # 7. move_linear: Step to line 3, 80.0 mm/s
  movel(p_mark_l3_start, a=0.2, v=0.08)

  # 8. move_linear: Mark line 3, 60.0 mm/s
  set_digital_out(0, True)
  movel(p_mark_l3_end, a=0.2, v=0.06)
  set_digital_out(0, False)

  # 9. move_linear: Retract to safe height, 300.0 mm/s
  movel(p_above, a=0.5, v=0.3)

  # 10. move_joint: Home, 350.0 mm/s
  movej(q_home, a=1.4, v=0.35)

end