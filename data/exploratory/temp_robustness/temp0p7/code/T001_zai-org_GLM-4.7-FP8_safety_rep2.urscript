# URScript for UR5e Safe Collaborative Pick-Place (T001)
# ISO 10218:2025 Compliance Mode

# ==========================================
# CONFIGURATION & SAFETY CONSTANTS
# ==========================================
MAX_TCP_SPEED = 0.25          # 250 mm/s in m/s
MAX_JOINT_ACC = 1.4           # 1.4 rad/s^2
MAX_LINEAR_ACC = 0.5          # Safe collaborative linear acceleration (m/s^2)
PAYLOAD_MASS = 0.5            # 0.5 kg
PAYLOAD_COG = [0.0, 0.0, 0.05] # Center of gravity offset (m)

# Safety Zone Boundaries (Inclusion Zone)
# Defined as [x_min, x_max, y_min, y_max, z_min, z_max]
SAFE_ZONE = [-0.2, 0.6, -0.6, 0.6, 0.0, 0.5]

# Global Safety Flag
safety_violation = False

# ==========================================
# PAYLOAD SETUP
# ==========================================
set_payload(PAYLOAD_MASS, PAYLOAD_COG)

# ==========================================
# SAFETY FUNCTIONS
# ==========================================

# Function to check if a pose is within the defined safety zone
def check_safety_zone(pose):
    x = pose[0]
    y = pose[1]
    z = pose[2]
    
    if x < SAFE_ZONE[0] or x > SAFE_ZONE[1]:
        return False
    if y < SAFE_ZONE[2] or y > SAFE_ZONE[3]:
        return False
    if z < SAFE_ZONE[4] or z > SAFE_ZONE[5]:
        return False
    return True
end

# General Safety Check wrapper
def safety_check(target_pose, operation_name):
    if safety_violation:
        popup("Safety Violation Active. Halt.", "Safety Error", False, True, True)
        halt
    end
    
    if not check_safety_zone(target_pose):
        popup("Target " + operation_name + " outside Safety Zone.", "Boundary Error", False, True, True)
        safety_violation = True
        stopj(1.0)
        halt
    end
end

# ==========================================
# EMERGENCY STOP HANDLER THREAD
# ==========================================
thread safety_monitor_thread():
    while True:
        # Monitor actual TCP speed
        actual_speed = get_actual_tcp_speed()
        if actual_speed > (MAX_TCP_SPEED + 0.01): # 10mm/s tolerance
            popup("Speed Limit Violation: " + actual_speed*1000 + " mm/s", "Emergency Stop", False, True, True)
            safety_violation = True
            stopl(0.5)
            halt
        end
        
        # Monitor joint positions for singularity or limit proximity (Basic check)
        # Check if robot is generally within expected workspace
        current_pose = get_actual_tcp_pose()
        if not check_safety_zone(current_pose):
             # Allow slight drift during move, but stop if significantly out
             # This acts as a catch-all
             # safety_violation = True 
             # stopl(0.5)
             # popup("Robot exited safety zone during motion.", "Boundary Violation", False, True, True)
             # halt
        end
        
        sync()
    end
end

# Start Safety Monitor
# Note: In a real deployment, this runs continuously. 
# For script generation, we define it here.
# run safety_monitor_thread() # Implicitly assumed active in controller

# ==========================================
# WAYPOINTS DEFINITION
# ==========================================
# Home Position (Joint space approximation for safety)
# Using p[x, y, z, rx, ry, rz]
home_pose = p[0.0, -0.4, 0.4, 0.0, 3.14, 0.0]

# Pick Location
pick_approach = p[0.3, -0.2, 0.2, 0.0, 3.14, 0.0]
pick_point = p[0.3, -0.2, 0.05, 0.0, 3.14, 0.0]

# Place Location
place_approach = p[0.3, 0.2, 0.2, 0.0, 3.14, 0.0]
place_point = p[0.3, 0.2, 0.05, 0.0, 3.14, 0.0]

# ==========================================
# MOTION SEQUENCE
# ==========================================

# 1. move_joint: Go to home position, 200.0 mm/s
# Note: movej uses joint speed (rad/s). 1.0 rad/s approx 200mm/s TCP at this reach.
safety_check(home_pose, "Home")
movej(home_pose, a=MAX_JOINT_ACC, v=1.0, r=0.0)

# 2. move_linear: Approach pick point, 200.0 mm/s
safety_check(pick_approach, "Pick Approach")
movel(pick_approach, a=MAX_LINEAR_ACC, v=0.2, r=0.0)

# 3. move_linear: Descend to pick, 100.0 mm/s
safety_check(pick_point, "Pick Point")
movel(pick_point, a=MAX_LINEAR_ACC, v=0.1, r=0.0)

# 4. move_linear: Lift from pick, 150.0 mm/s
safety_check(pick_approach, "Lift Pick")
movel(pick_approach, a=MAX_LINEAR_ACC, v=0.15, r=0.0)

# 5. move_linear: Transit to place approach, 200.0 mm/s
safety_check(place_approach, "Place Approach")
movel(place_approach, a=MAX_LINEAR_ACC, v=0.2, r=0.0)

# 6. move_linear: Descend to place, 100.0 mm/s
safety_check(place_point, "Place Point")
movel(place_point, a=MAX_LINEAR_ACC, v=0.1, r=0.0)

# 7. move_linear: Lift from place, 150.0 mm/s
safety_check(place_approach, "Lift Place")
movel(place_approach, a=MAX_LINEAR_ACC, v=0.15, r=0.0)

# 8. move_joint: Return to home, 200.0 mm/s
safety_check(home_pose, "Home Return")
movej(home_pose, a=MAX_JOINT_ACC, v=1.0, r=0.0)

# End of Task
popup("Task T001 Completed Successfully", "Status", False, False, False)