# UR5e Collaborative Spot Welding - 3 Points (T012)
# Payload: 2.5 kg
# Mode: Collaborative (Low Speed, Supervision)

# Set Payload
set_payload(2.5, [0, 0, 0.05])

# Define Positions
# Home Position (Joint space)
j_home = [0, -1.5708, 0, -1.5708, 0, 0]

# Spot 1 (Approach and Weld)
p_approach_1 = p[0.45, -0.3, 0.3, 3.14159, 0, 0]
p_weld_1     = p[0.45, -0.3, 0.2, 3.14159, 0, 0]

# Spot 2 (Approach and Weld)
p_approach_2 = p[0.55, -0.3, 0.3, 3.14159, 0, 0]
p_weld_2     = p[0.55, -0.3, 0.2, 3.14159, 0, 0]

# Spot 3 (Approach only)
p_approach_3 = p[0.65, -0.3, 0.3, 3.14159, 0, 0]

# --- Motion Sequence ---

# 1. move_joint: Home, 200.0 mm/s equivalent (Slow joint speed)
movej(j_home, a=0.8, v=1.0)

# 2. move_linear: Approach spot 1, 200.0 mm/s
movel(p_approach_1, a=0.5, v=0.2)

# 3. move_linear: Descend to spot 1, 80.0 mm/s
movel(p_weld_1, a=0.2, v=0.08)

# Weld Activation A7 (Spot 1)
set_digital_out(0, True)
sleep(0.5)  # Weld dwell time
set_digital_out(0, False)

# 4. move_linear: Lift from spot 1, 150.0 mm/s
movel(p_approach_1, a=0.3, v=0.15)

# 5. move_linear: Move to spot 2, 200.0 mm/s
movel(p_approach_2, a=0.5, v=0.2)

# 6. move_linear: Descend to spot 2, 80.0 mm/s
movel(p_weld_2, a=0.2, v=0.08)

# Weld Activation A7 (Spot 2)
set_digital_out(0, True)
sleep(0.5)  # Weld dwell time
set_digital_out(0, False)

# 7. move_linear: Lift from spot 2, 150.0 mm/s
movel(p_approach_2, a=0.3, v=0.15)

# 8. move_linear: Move to spot 3, 200.0 mm/s
movel(p_approach_3, a=0.5, v=0.2)

# End of Task