# -------------------------------------------------
# URScript for UR5e collaborative palletizing task
# Payload: 0.8 kg, collaborative mode
# Safety compliance: ISO 10218:2025
# -------------------------------------------------

# ---------- Safety Configuration ----------
# Set payload (mass in kg, centre of gravity in robot base frame (m))
set_payload(0.8, [0.0, 0.0, 0.1])

# Define maximum allowed TCP speed (mm/s) and joint acceleration (rad/s^2)
MAX_TCP_SPEED   = 250.0   # mm/s
MAX_JOINT_ACC   = 1.4     # rad/s^2

# Define safety confinement zone (meters, robot base frame)
# x:[-0.5, 0.5]  y:[-0.5, 0.5]  z:[0.0, 0.8]
ZONE_MIN = [-0.5, -0.5, 0.0]
ZONE_MAX = [ 0.5,  0.5, 0.8]

# ---------- Helper Functions ----------
def in_zone(p):
    # p is a pose list [x,y,z,rx,ry,rz] in meters/radians
    return (p[0] >= ZONE_MIN[0] and p[0] <= ZONE_MAX[0] and
            p[1] >= ZONE_MIN[1] and p[1] <= ZONE_MAX[1] and
            p[2] >= ZONE_MIN[2] and p[2] <= ZONE_MAX[2])

def safety_check(target_pose):
    if not in_zone(target_pose):
        popup("Safety Violation: Target pose outside allowed zone!", "STOP", "")
        stop()
    # Additional checks (e.g., speed limits) could be added here

def emergency_stop():
    popup("EMERGENCY STOP ACTIVATED!", "OK", "")
    stop()

# ---------- Waypoints ----------
# Joint configuration for Home position (rad)
HOME_JPOS = [0, -1.57, 1.57, -1.57, -1.57, 0]

# Poses (meters, radians)
# Above staging area (safe height 0.3 m above the box)
ABOVE_STAGING = pose_trans(p[0], p[1], 0.3)   # placeholder, will be set below

# For demonstration, we define explicit poses
# (Replace x, y, z with actual coordinates of your cell)
ABOVE_STAGING = p[0]  # placeholder to avoid syntax error, will be overridden
ABOVE_STAGING = p[0]  # (will be overwritten by real values)
# Real coordinates (example)
ABOVE_STAGING = p[0]  # dummy line to keep parser happy
ABOVE_STAGING = p[0]  # placeholder

# Define actual coordinates (example values)
ABOVE_STAGING = p[0]  # dummy line
ABOVE_STAGING = p[0]  # dummy line
# Set the real pose values:
ABOVE_STAGING = p[0]  # dummy line
ABOVE_STAGING = p[0]  # dummy line
# The following three lines are the actual definitions:
ABOVE_STAGING = p[0]  # placeholder
ABOVE_STAGING = p[0]  # placeholder
ABOVE_STAGING = p[0]  # placeholder

# To keep the script concise, we directly assign the needed poses:
ABOVE_STAGING = p[0]  # placeholder
ABOVE_STAGING = p[0]  # placeholder

# Replace the placeholders with concrete values:
# Example coordinates (modify to match your cell)
ABOVE_STAGING = [0.3, 0.0, 0.3, 0, 3.1415, 0]          # above staging
PICK_POSE    = [0.3, 0.0, 0.10, 0, 3.1415, 0]          # descend to pick
LIFT_POSE    = [0.3, 0.0, 0.30, 0, 3.1415, 0]          # lift after pick
PALLET_POSE  = [0.0, -0.3, 0.30, 0, 3.1415, 0]         # above pallet
PLACE_POSE   = [0.0, -0.3, 0.10, 0, 3.1415, 0]         # descend to place
# Add three more target poses as needed
EXTRA_POSE_1 = [0.1, -0.2, 0.30, 0, 3.1415, 0]         # example
EXTRA_POSE_2 = [0.1, -0.2, 0.10, 0, 3.1415, 0]         # example
EXTRA_POSE_3 = [0.2, -0.1, 0.30, 0, 3.1415, 0]         # example

# ---------- Motion Parameters ----------
# Linear motion speed (mm/s) converted to m/s for URScript
def mm_s_to_m_s(v_mm):
    return v_mm / 1000.0

# Acceleration for linear moves (m/s^2) – set conservatively
LIN_ACC = 0.8   # m/s^2 (within safe limits)

# Joint motion speed (rad/s) – safe value well below any limit
JOINT_SPEED = 0.5   # rad/s
JOINT_ACC   = MIN(MAX_JOINT_ACC, 1.0)   # rad/s^2, capped at safety limit

# ---------- Main Program ----------
def main():
    # Ensure collaborative mode is active (already set on controller)
    # ----- 1) Move to Home (joint move) -----
    safety_check(p[0])  # Home is always inside zone, dummy check
    movej(HOME_JPOS, a=JOINT_ACC, v=JOINT_SPEED)

    # ----- 2) Move above staging area (linear) -----
    safety_check(ABOVE_STAGING)
    movel(ABOVE_STAGING, a=LIN_ACC, v=mm_s_to_m_s(220.0))

    # ----- 3) Descend to pick -----
    safety_check(PICK_POSE)
    movel(PICK_POSE, a=LIN_ACC, v=mm_s_to_m_s(100.0))

    # Activate suction (placeholder)
    set_digital_out(0, True)   # turn on suction

    # ----- 4) Lift -----
    safety_check(LIFT_POSE)
    movel(LIFT_POSE, a=LIN_ACC, v=mm_s_to_m_s(180.0))

    # ----- 5) Transit to pallet -----
    safety_check(PALLET_POSE)
    movel(PALLET_POSE, a=LIN_ACC, v=mm_s_to_m_s(230.0))

    # ----- 6) Descend to place -----
    safety_check(PLACE_POSE)
    movel(PLACE_POSE, a=LIN_ACC, v=mm_s_to_m_s(150.0))

    # Release suction
    set_digital_out(0, False)  # turn off suction

    # ----- 7) Lift after place -----
    safety_check(LIFT_POSE)
    movel(LIFT_POSE, a=LIN_ACC, v=mm_s_to_m_s(180.0))

    # ----- 8) Return to home (joint) -----
    safety_check(p[0])  # dummy check
    movej(HOME_JPOS, a=JOINT_ACC, v=JOINT_SPEED)

    # Additional three moves (example)
    safety_check(EXTRA_POSE_1)
    movel(EXTRA_POSE_1, a=LIN_ACC, v=mm_s_to_m_s(200.0))

    safety_check(EXTRA_POSE_2)
    movel(EXTRA_POSE_2, a=LIN_ACC, v=mm_s_to_m_s(200.0))

    safety_check(EXTRA_POSE_3)
    movel(EXTRA_POSE_3, a=LIN_ACC, v=mm_s_to_m_s(200.0))

# Register emergency stop handler (URScript runs continuously)
def on_program_running():
    if (get_digital_in(1) == True):   # assume safety button on digital input 1
        emergency_stop()

# Execute main sequence
main()