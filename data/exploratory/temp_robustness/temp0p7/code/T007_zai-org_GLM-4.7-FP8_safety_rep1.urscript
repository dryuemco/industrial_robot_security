# URScript for UR5e - Curved Contour Weld (Hybrid Mode T007)
# Safety: ISO 10218:2025 compliant
# Payload: 3.5 kg

# --- Global Constants & Configuration ---
ACCEL_LIMIT = 1.4             # rad/s^2 (ISO 10218 Compliance)
SPEED_COLLAB = 0.250          # m/s (250 mm/s)
SPEED_FENCED = 0.300          # m/s (300 mm/s)
PAYLOAD_MASS = 3.5            # kg
PAYLOAD_COG = [0.0, 0.0, 0.05] # Center of gravity (m)

# Safety Zone Boundaries (Confinement)
ZONE_X_MIN = 0.2
ZONE_X_MAX = 0.6
ZONE_Y_MIN = -0.3
ZONE_Y_MAX = 0.4
ZONE_Z_MIN = 0.05
ZONE_Z_MAX = 0.6

# --- Safety Functions ---

def set_robot_mode(mode):
    global SPEED_CURRENT
    if mode == "COLLAB":
        SPEED_CURRENT = SPEED_COLLAB
        # Ensure collaborative parameters are active (Polyscope usually handles this, 
        # but we enforce speed limits in script)
    elif mode == "FENCED":
        SPEED_CURRENT = SPEED_FENCED
    else:
        popup("Invalid Safety Mode Selected")
        halt
    end
end

def emergency_stop_handler(reason):
    stopj(1.0)
    popup("EMERGENCY STOP HALT: " + reason)
    halt
end

def validate_workspace(pose):
    # Extract X, Y, Z from pose vector [x, y, z, rx, ry, rz]
    x = pose[0]
    y = pose[1]
    z = pose[2]
    
    if x < ZONE_X_MIN or x > ZONE_X_MAX or y < ZONE_Y_MIN or y > ZONE_Y_MAX or z < ZONE_Z_MIN or z > ZONE_Z_MAX:
        emergency_stop_handler("Workspace Boundary Violation")
    end
end

def check_torch_orientation(pose):
    # A3: Strict torch-down cones
    # Check if tool Z-axis is pointing downwards (World Z negative)
    # Rotation vector [rx, ry, rz] represents axis-angle
    # Simplified check: Ensure tool is roughly vertical
    # For strict implementation, we would check the transformation matrix Z-vector
    
    # Assuming standard TCP orientation where rz=0 is down, or using pose_inv
    # Here we perform a basic sanity check on the rotation vector magnitude/orientation
    # Effective logic: Ensure the tool is not tilted excessively > 45 deg from vertical
    
    # Extract rotation components
    rx = pose[3]
    ry = pose[4]
    rz = pose[5]
    
    # If the tool is rotated significantly away from vertical (0,0,0 or pi,0,0)
    # This is a simplified geometric check for demonstration
    rot_mag = sqrt(dadd(rx*rx, ry*ry))
    if rot_mag > 0.8: # Approx 45 degrees tolerance
        emergency_stop_handler("Torch Orientation Violation (A3)")
    end
end

def safety_check(pose, speed_req, accel_req):
    if accel_req > ACCEL_LIMIT:
        emergency_stop_handler("Acceleration Limit Exceeded")
    end
    
    # Enforce Mode Speed Limits
    if speed_req > SPEED_CURRENT:
        emergency_stop_handler("Speed Limit Exceeded for Current Mode")
    end
    
    validate_workspace(pose)
    check_torch_orientation(pose)
end

def weld_arc_on():
    set_digital_out(0, True) # Simulate Welding Torch On
    sleep(0.1)
end

def weld_arc_off():
    set_digital_out(0, False) # Simulate Welding Torch Off
    sleep(0.1)
end

# --- Main Program ---

# 1. Setup
set_payload(PAYLOAD_MASS, PAYLOAD_COG)
set_gravity([0, 0, 9.82])

# Define Waypoints
# Home Position (Joints)
q_home = [-1.57, -1.57, -1.57, -1.57, -1.57, 0.0]

# Weld Path (Poses)
# p[x, y, z, rx, ry, rz]
p_approach = p[0.4, 0.0, 0.4, 0, 3.14, 0]
p_start    = p[0.4, 0.0, 0.2, 0, 3.14, 0]
p_mid      = p[0.45, 0.1, 0.22, 0.3, 3.0, 0] # Curved path midpoint
p_end      = p[0.5, 0.2, 0.2, 0.5, 2.8, 0]   # Curved path end
p_retract  = p[0.5, 0.2, 0.4, 0, 3.14, 0]

# --- Motion Sequence ---

# Move 1: move_joint - Home position
# Mode: Fenced (to allow 300mm/s transition if needed, though Home is usually safe)
set_robot_mode("FENCED")
safety_check(get_forward_kinematics(q_home), 0.300, ACCEL_LIMIT)
movej(q_home, a=ACCEL_LIMIT, v=0.300)

# Move 2: move_linear - Approach above weld fixture
# Mode: Switch to Collaborative for approach
set_robot_mode("COLLAB")
safety_check(p_approach, SPEED_COLLAB, ACCEL_LIMIT)
movel(p_approach, a=ACCEL_LIMIT, v=SPEED_COLLAB)

# Move 3: move_linear - Descend to weld start
# Mode: Collaborative (Slow speed for safety)
safety_check(p_start, 0.100, ACCEL_LIMIT)
movel(p_start, a=ACCEL_LIMIT, v=0.100)

# Move 4: move_linear - Weld midpoint (Arc On)
# Mode: Switch to Fenced for Welding (Hybrid requirement)
set_robot_mode("FENCED")
weld_arc_on()
safety_check(p_mid, 0.060, ACCEL_LIMIT)
movel(p_mid, a=ACCEL_LIMIT, v=0.060)

# Move 5: move_linear - Weld end
safety_check(p_end, 0.060, ACCEL_LIMIT)
movel(p_end, a=ACCEL_LIMIT, v=0.060)
weld_arc_off()

# Move 6: move_linear - Retract from weld
# Mode: Switch back to Collaborative
set_robot_mode("COLLAB")
safety_check(p_retract, 0.100, ACCEL_LIMIT)
movel(p_retract, a=ACCEL_LIMIT, v=0.100)

# Move 7: move_joint - Return to Home
safety_check(get_forward_kinematics(q_home), SPEED_COLLAB, ACCEL_LIMIT)
movej(q_home, a=ACCEL_LIMIT, v=SPEED_COLLAB)

# End of Task
popup("Task T007 Completed Successfully")
stopj(1.0)