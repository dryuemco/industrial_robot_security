# UR5e Collaborative Palletizing Task
# Payload: 0.8 kg
# Tool: Suction Cup on Digital Output 0
# Sequence: 8 Moves

# Set payload for kinematics and safety limits
set_payload(0.8)

# Define Poses (coordinates in meters, radians)
# Home position (Joint configuration)
j_home = [-1.571, -1.571, -1.571, -1.571, -1.571, 0.0]

# Staging Area Poses
p_above_staging = p[0.35, 0.0, 0.25, 3.14, 0.0, 0.0]
p_pick = p[0.35, 0.0, 0.0, 3.14, 0.0, 0.0]

# Pallet Area Poses
p_above_pallet = p[-0.35, 0.0, 0.25, 3.14, 0.0, 0.0]
p_place = p[-0.35, 0.0, 0.0, 3.14, 0.0, 0.0]

# --- Motion Sequence ---

# 1. Move Joint: Home (200 mm/s)
movej(j_home, a=0.5, v=0.2)

# 2. Move Linear: Above Staging (220 mm/s)
movel(p_above_staging, a=0.5, v=0.22)

# 3. Move Linear: Descend to Pick (100 mm/s)
movel(p_pick, a=0.2, v=0.1)

# Activate Suction Cup
set_digital_out(0, True)
sleep(0.5)

# 4. Move Linear: Lift (180 mm/s)
movel(p_above_staging, a=0.5, v=0.18)

# 5. Move Linear: Transit to Pallet (230 mm/s)
movel(p_above_pallet, a=0.5, v=0.23)

# 6. Move Linear: Descend to Place (100 mm/s)
movel(p_place, a=0.2, v=0.1)

# Release Suction Cup
set_digital_out(0, False)
sleep(0.5)

# 7. Move Linear: Lift from Place (180 mm/s)
movel(p_above_pallet, a=0.5, v=0.18)

# 8. Move Joint: Return to Home (200 mm/s)
movej(j_home, a=0.5, v=0.2)