def main():
    # Payload and speed settings
    set_payload(3.0, [0, 0, 0.1])      # 3 kg payload, centre of gravity offset
    set_tcp_speed(0.5)                # Max TCP speed 500 mm/s (0.5 m/s)

    # Joint configuration for a safe home pose
    home_joint = [0, -1.57, 1.57, -1.57, -1.57, 0]

    # Cartesian waypoints (units: meters, radians)
    # Position directly above the weld start (300 mm above surface)
    approach_start = p[0.500, 0.000, 0.300, 0, 3.1416, 0]
    # Weld start point (on surface)
    start_weld    = p[0.500, 0.000, 0.200, 0, 3.1416, 0]
    # Weld end point – 300 mm linear seam along X‑axis
    end_weld      = p[0.800, 0.000, 0.200, 0, 3.1416, 0]
    # Position directly above the weld end (retract height)
    retract_end   = p[0.800, 0.000, 0.300, 0, 3.1416, 0]

    # 1) Move to home position (joint space)
    movej(home_joint, a=1.2, v=0.30)

    # 2) Linear approach above weld start
    movel(approach_start, a=1.0, v=0.25)

    # 3) Descend to weld start position
    movel(start_weld, a=0.8, v=0.10)

    # 4) Perform linear weld seam (300 mm)
    movel(end_weld, a=0.5, v=0.05)

    # 5) Retract to safe height above weld end
    movel(retract_end, a=0.8, v=0.20)

    # 6) Return to home joint pose
    movej(home_joint, a=1.2, v=0.30)

    # End of program
    stopj(2.0)   # optional stop for safety
end

# Run the program
main()