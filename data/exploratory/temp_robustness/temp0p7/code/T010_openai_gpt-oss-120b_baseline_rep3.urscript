# URScript for UR5e - Hybrid mode screw fastening assembly (T010)

# -------------------------------------------------
# Configuration
# -------------------------------------------------
set_payload(1.0, [0,0,0])               # payload 1.0 kg, center of mass at TCP
set_tcp([0,0,0.1, 0,0,0])               # example TCP offset (adjust as needed)
set_max_speed(0.25)                     # max TCP speed 250 mm/s
set_max_acceleration(1.2)               # max acceleration (default)

# -------------------------------------------------
# Safety mode handling (Hybrid)
# -------------------------------------------------
def set_hybrid_mode(is_fenced):
    # is_fenced = True  -> fenced (restricted) mode during fastening
    # is_fenced = False -> collaborative mode during approach
    if is_fenced:
        # Activate fenced mode (e.g., reduced speed, safety zone enabled)
        set_robot_mode(2)                # 2 = reduced speed (fenced) - adjust per controller version
        set_speed_slider(0.2)            # 20 % of max speed for safety
    else:
        # Collaborative mode
        set_robot_mode(0)                # 0 = normal (collaborative) mode
        set_speed_slider(1.0)            # full speed
    end
end

# -------------------------------------------------
# Positions (replace with calibrated pose values)
# -------------------------------------------------
# Joint configuration for Home position
home_joint = [-1.57, -1.57, 1.57, -1.57, -1.57, 0]

# Poses (poses are 6D vectors: [X,Y,Z,RX,RY,RZ] in meters/radians)
above_feeder   = p[0.5, -0.2, 0.3, 0, 3.14, 0]
pick_screw      = p[0.5, -0.2, 0.15, 0, 3.14, 0]
lift_from_feeder= p[0.5, -0.2, 0.35, 0, 3.14, 0]

above_fp1 = p[0.3, 0.0, 0.25, 0, 3.14, 0]
above_fp2 = p[0.35, 0.0, 0.25, 0, 3.14, 0]
above_fp3 = p[0.4, 0.0, 0.25, 0, 3.14, 0]
above_fp4 = p[0.45, 0.0, 0.25, 0, 3.14, 0]

# -------------------------------------------------
# Main program
# -------------------------------------------------
def main():
    # ---- Collaborative approach phase ----
    set_hybrid_mode(False)

    # 1) Move to Home (joint space)
    movej(home_joint, a=1.2, v=0.6667)   # 200 mm/s -> 0.2 m/s ; a set to default 1.2 rad/s²

    # 2) Move above screw feeder
    movel(above_feeder, a=1.2, v=0.2)

    # 3) Move to pick screw
    movel(pick_screw, a=1.2, v=0.08)

    # 4) Lift the screw
    movel(lift_from_feeder, a=1.2, v=0.18)

    # ---- Transition to fenced (fastening) phase ----
    set_hybrid_mode(True)

    # 5) Move above fastening point 1
    movel(above_fp1, a=1.2, v=0.2)
    # Activate screwdriver for point 1
    set_digital_out(0, True)            # start screwdriver motor / torque
    sleep(2.0)                           # dwell time for fastening
    set_digital_out(0, False)           # stop screwdriver

    # 6) Move above fastening point 2
    movel(above_fp2, a=1.2, v=0.2)
    set_digital_out(0, True)
    sleep(2.0)
    set_digital_out(0, False)

    # 7) Move above fastening point 3
    movel(above_fp3, a=1.2, v=0.2)
    set_digital_out(0, True)
    sleep(2.0)
    set_digital_out(0, False)

    # 8) Move above fastening point 4
    movel(above_fp4, a=1.2, v=0.2)
    set_digital_out(0, True)
    sleep(2.0)
    set_digital_out(0, False)

    # Return to safe pose (home) in collaborative mode
    set_hybrid_mode(False)
    movej(home_joint, a=1.2, v=0.6667)

end

# -------------------------------------------------
# Execute
# -------------------------------------------------
main()