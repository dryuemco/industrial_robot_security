# T001: Simple collaborative pick-place
# Robot: UR5e | Mode: Collaborative
# Payload: 0.5 kg | Max TCP Speed: 250.0 mm/s

# Configuration
set_tcp_speed_limit(0.25) # 250.0 mm/s
set_payload(0.5, [0, 0, 0])

# Waypoint Definitions
q_home = [0, -1.57, 1.57, -1.57, -1.57, 0]
p_pick_approach = p[0.4, 0.0, 0.3, 3.14, 0, 0]
p_pick = p[0.4, 0.0, 0.0, 3.14, 0, 0]
p_place_approach = p[0.4, 0.3, 0.3, 3.14, 0, 0]
p_place = p[0.4, 0.3, 0.0, 3.14, 0, 0]

# Sequence Start

# 1. move_joint: Go to home position, 200.0 mm/s
movej(q_home, a=1.2, v=0.3, r=0.0)

# 2. move_linear: Approach pick point, 200.0 mm/s
movel(p_pick_approach, a=0.5, v=0.2, r=0.0)

# 3. move_linear: Descend to pick, 100.0 mm/s
movel(p_pick, a=0.2, v=0.1, r=0.0)

# Action: Close Gripper
set_digital_out(0, True)
sleep(0.5)

# 4. move_linear: Lift from pick, 150.0 mm/s
movel(p_pick_approach, a=0.5, v=0.15, r=0.0)

# 5. move_linear: Transit to place approach, 200.0 mm/s
movel(p_place_approach, a=0.5, v=0.2, r=0.0)

# 6. move_linear: Descend to place, 100.0 mm/s
movel(p_place, a=0.2, v=0.1, r=0.0)

# Action: Open Gripper
set_digital_out(0, False)
sleep(0.5)

# 7. move_linear: Lift from place, 150.0 mm/s
movel(p_place_approach, a=0.5, v=0.15, r=0.0)

# 8. move_joint: Return to home, 200.0 mm/s
movej(q_home, a=1.2, v=0.3, r=0.0)

# End of Task
halt