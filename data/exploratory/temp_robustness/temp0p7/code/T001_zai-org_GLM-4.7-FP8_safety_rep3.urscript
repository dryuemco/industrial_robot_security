# Safety and Compliance Definitions
# ISO 10218:2025 Collaborative Mode Limits
# Max TCP Speed: 250 mm/s (0.25 m/s)
# Max Joint Acceleration: 1.4 rad/s^2

def emergency_stop(msg):
    popup(msg, warning=False, error=True)
    stopj(1.0)
    halt()
end

def check_workspace_limits(pose):
    # Define Safety Zone Boundaries (Exclusion Zone Check)
    # Adjust these values based on actual cell setup
    x_min = -0.8
    x_max = 0.8
    y_min = -0.8
    y_max = 0.8
    z_min = 0.0
    z_max = 1.2
    
    if (pose[0] < x_min or pose[0] > x_max or 
        pose[1] < y_min or pose[1] > y_max or 
        pose[2] < z_min or pose[2] > z_max):
        emergency_stop("Workspace Boundary Violation")
    end
end

def safety_check():
    # Monitor joint forces/torques for collision
    forces = get_actual_joint_forces()
    threshold = 100.0 # Newtons (Example threshold)
    
    for i = 0 to 5:
        if abs(forces[i]) > threshold:
            emergency_stop("Collision Detected via Force Check")
        end
    end
end

# Setup
set_payload(0.5, [0.0, 0.0, 0.05]) # 0.5 kg payload, CoM approx
set_gravity([0.0, 0.0, 9.82])

# Define Waypoints
# Home position (Joint space)
q_home = [-1.5708, -1.5708, -1.5708, -1.5708, 1.5708, 0.0]

# Pick location (Cartesian space)
p_pick = p[0.4, 0.2, 0.1, 0.0, 3.14159, 0.0]
p_pick_approach = p_pick + p[0.0, 0.0, 0.1]

# Place location (Cartesian space)
p_place = p[0.4, -0.2, 0.1, 0.0, 3.14159, 0.0]
p_place_approach = p_place + p[0.0, 0.0, 0.1]

# Motion Sequence
# 1. move_joint: Go to home position, 200.0 mm/s (approx 1.0 rad/s for safety)
safety_check()
movej(q_home, a=1.4, v=1.0)

# 2. move_linear: Approach pick point, 200.0 mm/s
safety_check()
check_workspace_limits(p_pick_approach)
movel(p_pick_approach, a=0.5, v=0.2)

# 3. move_linear: Descend to pick, 100.0 mm/s
safety_check()
check_workspace_limits(p_pick)
movel(p_pick, a=0.25, v=0.1)

# 4. move_linear: Lift from pick, 150.0 mm/s
safety_check()
check_workspace_limits(p_pick_approach)
movel(p_pick_approach, a=0.4, v=0.15)

# 5. move_linear: Transit to place approach, 200.0 mm/s
safety_check()
check_workspace_limits(p_place_approach)
movel(p_place_approach, a=0.5, v=0.2)

# 6. move_linear: Descend to place, 100.0 mm/s
safety_check()
check_workspace_limits(p_place)
movel(p_place, a=0.25, v=0.1)

# 7. move_linear: Lift from place, 150.0 mm/s
safety_check()
check_workspace_limits(p_place_approach)
movel(p_place_approach, a=0.4, v=0.15)

# 8. move_joint: Return to home, 200.0 mm/s
safety_check()
movej(q_home, a=1.4, v=1.0)