def main():
    # -------------------------------------------------
    # Configuration
    # -------------------------------------------------
    set_payload(3.5, [0, 0, 0.1])               # payload in kg, CoG in robot base frame (m)
    set_tcp([0, 0, 0.2, 0, 0, 0])               # TCP offset (m, rad)

    # -------------------------------------------------
    # Speed settings (m/s for linear moves, rad/s for joint moves)
    # -------------------------------------------------
    lin_speed   = 0.300    # 300 mm/s
    lin_speed_approach = 0.250   # 250 mm/s
    lin_speed_descend  = 0.100   # 100 mm/s
    lin_speed_weld     = 0.060   # 60 mm/s
    joint_speed = 0.5               # approx 30 deg/s

    # -------------------------------------------------
    # Poses (all positions are defined in the robot base frame)
    # -------------------------------------------------
    # Home joint configuration (example)
    home_joint = [-1.57, -1.57, 1.57, -1.57, -1.57, 0]

    # Approach point – 150 mm above the weld fixture
    approach_pose = p[0.200, 0.000, 0.400, 0, 3.1415, 0]

    # Weld start – 100 mm above the fixture, then descend 100 mm
    start_pose    = p[0.200, 0.000, 0.300, 0, 3.1415, 0]

    # Weld midpoint – along the curved arc
    mid_pose      = p[0.400, 0.100, 0.300, 0, 3.1415, 0]

    # Weld end – final point of the arc
    end_pose      = p[0.600, 0.000, 0.300, 0, 3.1415, 0]

    # Retract point – lift 150 mm after welding
    retract_pose  = p[0.600, 0.000, 0.450, 0, 3.1415, 0]

    # -------------------------------------------------
    # Execution
    # -------------------------------------------------
    # 1) Move to Home (joint move)
    movej(home_joint, a=1.2, v=joint_speed)

    # 2) Approach above weld fixture (linear move)
    movel(approach_pose, a=1.2, v=lin_speed_approach)

    # 3) Descend to weld start (linear move)
    movel(start_pose, a=1.2, v=lin_speed_descend)

    # -------------------------------------------------
    # Enable welding (digital output 0 = torch ON)
    # -------------------------------------------------
    set_digital_output(0, True)
    sync()  # ensure output is set before motion

    # 4) Weld midpoint (linear move)
    movel(mid_pose, a=0.8, v=lin_speed_weld)

    # 5) Weld end (linear move)
    movel(end_pose, a=0.8, v=lin_speed_weld)

    # -------------------------------------------------
    # Disable welding (torch OFF)
    # -------------------------------------------------
    set_digital_output(0, False)
    sync()

    # 6) Retract to safe height (linear move)
    movel(retract_pose, a=1.2, v=lin_speed_descend)

    # 7) Return to Home (joint move)
    movej(home_joint, a=1.2, v=joint_speed)

    # -------------------------------------------------
    # End of program
    # -------------------------------------------------
    stopj(2)   # bring robot to a controlled stop
end

# -------------------------------------------------
# Run the program
# -------------------------------------------------
main()