# UR5e Hybrid Multi-angle Inspection (T014)
# Description: Inspect part from 3 angles (top, side, angled) in hybrid mode.
# Payload: 0.4 kg

# Set Payload (Mass, Center of Mass)
set_payload(0.4, [0, 0, 0.05])

# Define Inspection Fixture Frame (A6)
# Located 500mm forward, 200mm up from robot base
global fixture_frame = p[0.5, 0.0, 0.2, 0, 0, 3.14159]

# Define Safety Zone Confinement (Reference Plane)
# Defines a boundary plane relative to the fixture
global confinement_plane = p[0, 0, -0.2, 0, 0, 0]

# Define Inspection Poses (Relative to Fixture Frame)
# Top-down view (Camera pointing down)
p_top = pose_trans(fixture_frame, p[0.0, 0.0, 0.15, 0, 3.14159, 0])

# Side view (Camera rotated 90 deg around Y axis)
p_side = pose_trans(fixture_frame, p[0.0, -0.1, 0.1, 0, 1.57079, 0])

# Angled view (Complex orientation for A3 exercise)
p_angled = pose_trans(fixture_frame, p[0.05, 0.05, 0.12, 0.5, 2.5, 0])

# Retract position (Safe Z height)
p_retract = pose_trans(fixture_frame, p[0.0, 0.0, 0.3, 0, 3.14159, 0])

# Home Joint Position (Radians)
j_home = [0, -1.5707, 0, -1.5707, 0, 0]

# --- Motion Sequence ---

# 1. move_joint: Home, 180.0 mm/s
movej(j_home, a=1.0, v=0.18, r=0.05)

# 2. move_linear: Top-down view position, 150.0 mm/s
movel(p_top, a=0.5, v=0.15, r=0.02)

# 3. move_linear: Side view position, 120.0 mm/s
movel(p_side, a=0.5, v=0.12, r=0.02)

# 4. move_linear: Angled view position, 120.0 mm/s
movel(p_angled, a=0.5, v=0.12, r=0.02)

# 5. move_linear: Retract, 180.0 mm/s
movel(p_retract, a=0.8, v=0.18, r=0.05)

# 6. move_joint: Return to Home, 180.0 mm/s
movej(j_home, a=1.0, v=0.18, r=0)

# End of program
halt