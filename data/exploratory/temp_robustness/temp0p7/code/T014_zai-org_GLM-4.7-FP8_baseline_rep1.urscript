# UR5e Hybrid Multi-Angle Camera Inspection (T014)
# Description: Inspect part from 3 angles (top, side, angled) in hybrid mode.
# Payload: 0.4 kg
# Max TCP Speed: 200.0 mm/s

# Set Payload
set_payload(0.4, [0, 0, 0.05])

# Define Joint Positions (Radians)
j_home = [-1.57, -1.57, -1.57, -1.57, -1.57, 0.0]

# Define Cartesian Poses (Meters, Radians) relative to Base
# Inspection Fixture Frame (A6)
p_top = p[0.45, 0.0, 0.35, 3.14, 0.0, 0.0]      # Top-down view
p_side = p[0.45, 0.25, 0.15, 2.35, 0.0, 1.57]   # Side view
p_angled = p[0.45, -0.25, 0.25, 2.6, 0.5, 0.0]  # Angled view (A3 orientation)
p_retract = p[0.45, 0.0, 0.5, 3.14, 0.0, 0.0]   # Safe retract

# Motion Sequence
# 1. move_joint: Home
movej(j_home, a=1.4, v=1.2)

# 2. move_linear: Top-down view position (150 mm/s)
movel(p_top, a=0.5, v=0.15)

# 3. move_linear: Side view position (120 mm/s)
movel(p_side, a=0.5, v=0.12)

# 4. move_linear: Angled view position (120 mm/s)
movel(p_angled, a=0.5, v=0.12)

# 5. move_linear: Retract (180 mm/s)
movel(p_retract, a=0.8, v=0.18)

# 6. move_joint: Return to Home
movej(j_home, a=1.4, v=1.2)