# URScript for UR5e - Task: Dual-zone pick-place (T011)
# Mode: Hybrid
# Payload: 1.2 kg

# Set Payload (Mass in kg, Center of Mass relative to tool flange)
set_payload(1.2, [0.0, 0.0, 0.0])

# --- Waypoint Definitions ---
# Joint configuration for Home position (radians)
q_home = [-0.12, -1.57, -1.57, -1.74, -1.57, 0.0]

# Cartesian Poses (x, y, z, rx, ry, rz) in meters and radians
# p_storage_above: Approach position for storage bin
p_storage_above = [0.45, -0.30, 0.35, 3.14, 0.0, 0.0]
# p_storage_pick: Actual pick position inside bin
p_storage_pick = [0.45, -0.30, 0.05, 3.14, 0.0, 0.0]
# p_handoff_above: Approach position for collaborative handoff
p_handoff_above = [0.45, 0.40, 0.35, 2.35, 0.0, 0.0]
# p_handoff_place: Actual handoff position (operator zone)
p_handoff_place = [0.45, 0.40, 0.15, 2.35, 0.0, 0.0]

# --- Motion Sequence ---

# 1. move_joint: Home, 250.0 mm/s
movej(q_home, a=1.2, v=0.25, r=0.0)

# 2. move_linear: Above storage bin, 280.0 mm/s
movel(p_storage_above, a=1.2, v=0.28, r=0.0)

# 3. move_linear: Descend to pick, 120.0 mm/s
movel(p_storage_pick, a=0.5, v=0.12, r=0.0)

# --- Action: Gripper Close ---
set_standard_digital_out(0, True)
sleep(0.5)

# 4. move_linear: Lift from bin, 200.0 mm/s
movel(p_storage_above, a=1.0, v=0.20, r=0.0)

# 5. move_linear: Transit to handoff zone, 250.0 mm/s
movel(p_handoff_above, a=1.2, v=0.25, r=0.0)

# 6. move_linear: Descend to handoff, 150.0 mm/s (Collaborative speed)
movel(p_handoff_place, a=0.5, v=0.15, r=0.0)

# --- Action: Gripper Open (Handoff) ---
set_standard_digital_out(0, False)
sleep(0.5)

# 7. move_linear: Retract from handoff, 200.0 mm/s
movel(p_handoff_above, a=1.0, v=0.20, r=0.0)

# 8. move_joint: Return to Home, 250.0 mm/s
movej(q_home, a=1.2, v=0.25, r=0.0)

# End of program