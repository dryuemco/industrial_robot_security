# URScript for UR5e: EUR-pallet 2x2 layer (T003)
# Configuration: Hybrid Mode, Payload 4.5kg, Max Speed 300mm/s

# Set Payload (Mass kg, Center of Mass m)
set_payload(4.5, [0, 0, 0])

# Define Safety Zone (A2 - Confinement with Pallet Boundary)
# Limits robot motion to a specific volume around the pallet area
# Format: [min_x, max_x, min_y, max_y, min_z, max_z]
set_pos_confinement(True, [0.2, 0.9, -0.3, 0.7, -0.2, 0.5])

# --- Waypoint Definitions ---
# Joint positions (radians)
j_home = [0, -1.5708, 1.5708, -1.5708, -1.5708, 0]

# Pose coordinates (x, y, z, rx, ry, rz) in meters and radians
# Conveyor Pick Area
p_approach_pick = p[0.5, -0.4, 0.3, 0, 3.14159, 0]
p_pick          = p[0.5, -0.4, 0.1, 0, 3.14159, 0]

# EUR-Pallet Area (Position 0,0)
p_transit_pallet = p[0.4, 0.3, 0.3, 0, 3.14159, 0]
p_place          = p[0.4, 0.3, 0.1, 0, 3.14159, 0]

# --- Helper Functions for Gripper (Generic Digital IO) ---
def grip_close():
    set_digital_out(0, True)
    sleep(0.5)

def grip_open():
    set_digital_out(0, False)
    sleep(0.5)

# --- Motion Sequence (8 Moves) ---

# 1. Move Joint: Home position (250.0 mm/s)
movej(j_home, a=1.2, v=0.25)

# 2. Move Linear: Approach conveyor pick — above (250.0 mm/s)
movel(p_approach_pick, a=0.5, v=0.25)

# 3. Move Linear: Descend to pick (100.0 mm/s)
movel(p_pick, a=0.2, v=0.10)

# Action: Close Gripper
grip_close()

# 4. Move Linear: Lift from conveyor (200.0 mm/s)
movel(p_approach_pick, a=0.4, v=0.20)

# 5. Move Linear: Transit to pallet position (0,0) (280.0 mm/s)
movel(p_transit_pallet, a=0.8, v=0.28)

# 6. Move Linear: Descend to place (100.0 mm/s)
movel(p_place, a=0.2, v=0.10)

# Action: Open Gripper
grip_open()

# 7. Move Linear: Lift from pallet (200.0 mm/s)
movel(p_transit_pallet, a=0.4, v=0.20)

# 8. Move Joint: Home position (250.0 mm/s)
movej(j_home, a=1.2, v=0.25)

# End of Task