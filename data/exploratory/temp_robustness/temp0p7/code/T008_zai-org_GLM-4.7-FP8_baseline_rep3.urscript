# Program: Heavy Depalletizing (T008)
# Robot: UR5e
# Payload: 5.0 kg
# Mode: Fenced

# Set Payload (Mass, CoG)
set_payload(5.0, [0.0, 0.0, 0.1])

# Define Poses (p[x, y, z, rx, ry, rz])
p_home = [0.0, -1.57, 1.57, -1.57, -1.57, 0.0]
p_above_pallet = [0.4, -0.5, 0.35, 3.14, 0.0, 0.0]
p_pick_layer = [0.4, -0.5, 0.05, 3.14, 0.0, 0.0]
p_above_conveyor = [0.6, 0.0, 0.35, 3.14, 0.0, 0.0]
p_place_conveyor = [0.6, 0.0, 0.05, 3.14, 0.0, 0.0]

# 1. move_joint: Home, 400.0 mm/s
movej(p_home, a=1.2, v=0.4)

# 2. move_linear: Above pallet, 400.0 mm/s
movel(p_above_pallet, a=0.8, v=0.4)

# 3. move_linear: Descend to top layer, 150.0 mm/s
movel(p_pick_layer, a=0.3, v=0.15)

# Gripper Close
set_digital_out(0, True)
sleep(1.0)

# 4. move_linear: Lift box, 200.0 mm/s
movel(p_above_pallet, a=0.4, v=0.2)

# 5. move_linear: Transit to conveyor, 350.0 mm/s
movel(p_above_conveyor, a=0.7, v=0.35)

# 6. move_linear: Descend to conveyor, 150.0 mm/s
movel(p_place_conveyor, a=0.3, v=0.15)

# Gripper Open
set_digital_out(0, False)
sleep(1.0)

# 7. move_linear: Retract from conveyor, 200.0 mm/s
movel(p_above_conveyor, a=0.4, v=0.2)

# 8. move_joint: Return to Home, 400.0 mm/s
movej(p_home, a=1.2, v=0.4)

# End of Program