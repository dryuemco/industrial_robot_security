# UR5e Heavy Depalletizing Task (T008)
# Mode: Fenced
# Payload: 5.0 kg

# Set Payload (Mass, Center of Mass)
set_payload(5.0, [0, 0, 0])

# Define Waypoints
q_home = [0, -1.57, 1.57, -1.57, -1.57, 0]
p_above_pallet = p[0.4, -0.4, 0.35, 0, 3.14, 0]
p_pick = p[0.4, -0.4, 0.05, 0, 3.14, 0]
p_above_conveyor = p[0.4, 0.4, 0.35, 0, 3.14, 0]
p_place = p[0.4, 0.4, 0.05, 0, 3.14, 0]

# Motion 1: move_joint to Home
# Speed parameter for movej is rad/s. Using 1.0 rad/s for safe heavy payload movement.
movej(q_home, a=1.0, v=1.0, r=0)

# Motion 2: move_linear to Above Pallet (400.0 mm/s)
movel(p_above_pallet, a=0.5, v=0.4, r=0)

# Motion 3: move_linear Descend to top layer (150.0 mm/s)
movel(p_pick, a=0.2, v=0.15, r=0)

# Gripper Close
set_digital_out(0, True)
sleep(1.0)

# Motion 4: move_linear Lift box (200.0 mm/s)
movel(p_above_pallet, a=0.3, v=0.2, r=0)

# Motion 5: move_linear Transit to conveyor (350.0 mm/s)
movel(p_above_conveyor, a=0.5, v=0.35, r=0)

# Motion 6: move_linear Descend to conveyor (150.0 mm/s)
movel(p_place, a=0.2, v=0.15, r=0)

# Gripper Open
set_digital_out(0, False)
sleep(1.0)

# Motion 7: move_linear Lift from conveyor (Retract) (400.0 mm/s)
movel(p_above_conveyor, a=0.5, v=0.4, r=0)

# Motion 8: move_joint to Home
movej(q_home, a=1.0, v=1.0, r=0)

# End of program