# -------------------------------------------------
# URScript for UR5e – Hybrid mode palletizing task
# -------------------------------------------------
# Safety compliance (ISO 10218:2025)
#   • Max TCP speed: 0.250 m/s (250 mm/s)
#   • Max joint acceleration: 1.4 rad/s^2
#   • All motions include speed & acceleration limits
#   • Safety checks before each motion
#   • Emergency stop handler
# -------------------------------------------------

# ------------------- Configuration -----------------
set_payload(4.5, [0,0,0.1])          # payload mass (kg) and CoM (m)
set_joint_acceleration(1.4)        # joint acceleration limit (rad/s^2)

# Define workspace boundaries (meters)
# Adjust these limits to match the actual robot cell
workspace_min = p[-0.8, -0.8, 0.0, 0, 0, 0]
workspace_max = p[ 0.8,  0.8, 1.2, 0, 0, 0]

# Safety zone (confinement) – pallet area (example)
pallet_zone_min = p[0.2, -0.4, 0.0, 0, 0, 0]
pallet_zone_max = p[0.6,  0.0, 0.5, 0, 0, 0]

# -------------------------------------------------
# Helper functions
# -------------------------------------------------
def safety_check(pose):
    # Verify pose is inside overall workspace
    inside = (pose[0] >= workspace_min[0] and pose[0] <= workspace_max[0] and
              pose[1] >= workspace_min[1] and pose[1] <= workspace_max[1] and
              pose[2] >= workspace_min[2] and pose[2] <= workspace_max[2])
    if not inside:
        popup("Safety violation: Pose outside workspace!", True)
        halt()
    return inside
end

def zone_check(pose):
    # Verify pose is inside the defined pallet zone (used for collaborative part)
    inside = (pose[0] >= pallet_zone_min[0] and pose[0] <= pallet_zone_max[0] and
              pose[1] >= pallet_zone_min[1] and pose[1] <= pallet_zone_max[1] and
              pose[2] >= pallet_zone_min[2] and pose[2] <= pallet_zone_max[2])
    if not inside:
        popup("Safety violation: Pose outside pallet zone!", True)
        halt()
    return inside
end

def emergency_stop_handler():
    # Simple e‑stop monitor – can be expanded with digital inputs
    if get_digital_in(0) == True:   # assume DI0 is e‑stop button
        popup("Emergency stop activated!", True)
        halt()
    end
end

# -------------------------------------------------
# Motion parameters (speed in m/s, accel in m/s^2)
# -------------------------------------------------
joint_speed   = 0.25               # 250 mm/s for joint move (approx.)
joint_accel   = 0.5                # safe joint acceleration (rad/s^2)

lin_speed_max = 0.250              # 250 mm/s (max allowed)
lin_accel_max = 0.5                # linear acceleration (m/s^2)

# -------------------------------------------------
# Waypoints (all positions in meters)
# -------------------------------------------------
# Home position (joint configuration)
home_joint = [-1.57, -1.57, 1.57, -1.57, -1.57, 0]

# Conveyor pick positions (example coordinates)
pick_above   = p[0.0, -0.6, 0.3, 0, 3.14, 0]   # 30 cm above conveyor
pick_down    = p[0.0, -0.6, 0.05, 0, 3.14, 0]  # approach to pick

# Lift after pick
lift_up      = p[0.0, -0.6, 0.3, 0, 3.14, 0]

# Pallet grid positions (2x2)
pallet_pos_00 = p[0.25, -0.2, 0.1, 0, 3.14, 0]   # cell (0,0)
pallet_pos_10 = p[0.45, -0.2, 0.1, 0, 3.14, 0]   # cell (1,0)
pallet_pos_01 = p[0.25, -0.0, 0.1, 0, 3.14, 0]   # cell (0,1)
pallet_pos_11 = p[0.45, -0.0, 0.1, 0, 3.14, 0]   # cell (1,1)

# -------------------------------------------------
# Main program
# -------------------------------------------------
def main():
    # Ensure robot starts in safe mode (collaborative near conveyor)
    set_robot_mode(2)   # 2 = collaborative mode (UR5e specific)

    # 1) Move to Home position (joint move)
    safety_check(pose_from_joint(home_joint))
    movej(home_joint, a=joint_accel, v=joint_speed)

    # 2) Approach conveyor – above pick point
    safety_check(pick_above)
    movel(pick_above, a=lin_accel_max, v=lin_speed_max)

    # 3) Descend to pick
    safety_check(pick_down)
    movel(pick_down, a=lin_accel_max, v=0.10)   # 100 mm/s

    # 4) Lift from conveyor
    safety_check(lift_up)
    movel(lift_up, a=lin_accel_max, v=0.20)    # 200 mm/s

    # 5) Transit to pallet cell (0,0)
    safety_check(pallet_pos_00)
    zone_check(pallet_pos_00)                  # collaborative zone check
    movel(pallet_pos_00, a=lin_accel_max, v=lin_speed_max)

    # 6) Place box (simple pause to simulate release)
    sleep(0.5)

    # 7) Move to pallet cell (1,0)
    safety_check(pallet_pos_10)
    zone_check(pallet_pos_10)
    movel(pallet_pos_10, a=lin_accel_max, v=lin_speed_max)
    sleep(0.5)

    # 8) Move to pallet cell (0,1)
    safety_check(pallet_pos_01)
    zone_check(pallet_pos_01)
    movel(pallet_pos_01, a=lin_accel_max, v=lin_speed_max)
    sleep(0.5)

    # 9) Move to pallet cell (1,1)
    safety_check(pallet_pos_11)
    zone_check(pallet_pos_11)
    movel(pallet_pos_11, a=lin_accel_max, v=lin_speed_max)
    sleep(0.5)

    # Return to Home
    safety_check(pose_from_joint(home_joint))
    movej(home_joint, a=joint_accel, v=joint_speed)

    popup("Task completed safely.", False)
end

# -------------------------------------------------
# Helper to convert joint list to pose for safety_check
# -------------------------------------------------
def pose_from_joint(joints):
    # Forward kinematics placeholder – URScript provides get_forward_kin()
    # Using built‑in function get_forward_kin() for actual robot
    return get_forward_kin(joints)
end

# -------------------------------------------------
# Run program with e‑stop monitoring loop
# -------------------------------------------------
def run():
    while True:
        emergency_stop_handler()
        main()
        break
    end
end

run()