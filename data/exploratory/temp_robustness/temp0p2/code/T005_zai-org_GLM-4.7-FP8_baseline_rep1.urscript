# Visual Inspection Scan - Collaborative Mode (T005)
# Robot: UR5e
# Payload: 0.3 kg
# Description: Camera-based visual inspection scan over a 200x200 mm part surface.
# Raster pattern (3 scan lines). Collaborative mode at very low speed.

# Set Payload (Mass 0.3 kg, Center of Mass approx 50mm down tool)
set_payload(0.3, [0, 0, 0.05])

# Define Safety Zone (Confinement)
# Box: X[300, 500], Y[-150, 150], Z[0, 400] relative to Base
set_pos_confinement(True, [ [300, -150], [500, -150], [500, 150], [300, 150] ], 0, 400)

# Define Joint Home Position (Radians)
q_home = [-1.57, -1.57, -1.57, -1.57, -1.57, 0]

# Define Orientation: Camera pointing strictly downward
# rx=0, ry=3.14159 (180 deg), rz=0
rot_down = [0, 3.14159, 0]

# Define Waypoints (Part centered at X=400, Y=0, Z=0)
# Scan Height: 150 mm
# Part Size: 200x200 mm (X: 300-500, Y: -100-100)
p_approach = p[400, 0, 300, rot_down[0], rot_down[1], rot_down[2]]
p_scan_start = p[300, -100, 150, rot_down[0], rot_down[1], rot_down[2]]
p_line1_end = p[300, 100, 150, rot_down[0], rot_down[1], rot_down[2]]
p_line2_start = p[400, -100, 150, rot_down[0], rot_down[1], rot_down[2]]
p_line2_end = p[400, 100, 150, rot_down[0], rot_down[1], rot_down[2]]
p_line3_start = p[500, -100, 150, rot_down[0], rot_down[1], rot_down[2]]
p_line3_end = p[500, 100, 150, rot_down[0], rot_down[1], rot_down[2]]

# Motion Sequence

# 1. Move Joint: Home position, 150.0 mm/s
movej(q_home, a=0.5, v=0.15)

# 2. Move Linear: Approach inspection start — above surface, 130.0 mm/s
movel(p_approach, a=0.5, v=0.13)

# 3. Move Linear: Descend to scan height (150 mm above part), 80.0 mm/s
movel(p_scan_start, a=0.5, v=0.08)

# 4. Move Linear: Scan line 1 — Y sweep, 50.0 mm/s
movel(p_line1_end, a=0.2, v=0.05)

# 5. Move Linear: Step to scan line 2 (+X), 80.0 mm/s
movel(p_line2_start, a=0.5, v=0.08)

# 6. Move Linear: Scan line 2 — Y sweep, 50.0 mm/s
movel(p_line2_end, a=0.2, v=0.05)

# 7. Move Linear: Step to scan line 3 (+X), 80.0 mm/s
movel(p_line3_start, a=0.5, v=0.08)

# 8. Move Linear: Scan line 3 — Y sweep, 50.0 mm/s
movel(p_line3_end, a=0.2, v=0.05)

# 9. Move Linear: Retract, 80.0 mm/s
movel(p_approach, a=0.5, v=0.08)

# 10. Move Joint: Return to Home, 150.0 mm/s
movej(q_home, a=0.5, v=0.15)

# End of Task