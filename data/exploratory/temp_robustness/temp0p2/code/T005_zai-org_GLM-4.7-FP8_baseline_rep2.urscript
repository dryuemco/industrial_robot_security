# UR5e Visual Inspection Scan - T005
# Collaborative Mode, Low Speed, Raster Pattern

# Setup Parameters
set_payload(0.3, [0, 0, 0.05])
set_tcp(p[0, 0, 0, 0, 0, 0])

# Safety Zone Definition (Confinement)
# Limits set to encompass the 200x200mm part and approach height
set_pos_confinement(True, p[-0.05, -0.05, 0.0, 0, 0, 0], p[0.25, 0.25, 0.4, 0, 0, 0])

# Define Home Position (Joint space in radians)
home_j = [-1.57, -1.57, -1.57, -1.57, -1.57, 0]

# Define Orientation (Strictly Downward)
# rx=0, ry=3.14159 (pi) points tool Z axis down
rot_down = [0, 3.14159, 0]

# Define Heights (Meters)
z_scan = 0.15  # 150 mm scan height
z_safe = 0.30  # Approach height

# Motion Sequence

# 1. move_joint: Home position, 150.0 mm/s
movej(home_j, a=1.0, v=0.15)

# 2. move_linear: Approach inspection start — above surface, 130.0 mm/s
movel(p[0, 0, z_safe, rot_down[0], rot_down[1], rot_down[2]], a=0.5, v=0.13)

# 3. move_linear: Descend to scan height (150 mm above part), 80.0 mm/s
movel(p[0, 0, z_scan, rot_down[0], rot_down[1], rot_down[2]], a=0.5, v=0.08)

# 4. move_linear: Scan line 1 — Y sweep (0 to 200mm), 50.0 mm/s
movel(p[0, 0.2, z_scan, rot_down[0], rot_down[1], rot_down[2]], a=0.1, v=0.05)

# 5. move_linear: Step to scan line 2 (+X 100mm), 80.0 mm/s
movel(p[0.1, 0.2, z_scan, rot_down[0], rot_down[1], rot_down[2]], a=0.5, v=0.08)

# 6. move_linear: Scan line 2 — Y sweep (200mm to 0), 50.0 mm/s
movel(p[0.1, 0, z_scan, rot_down[0], rot_down[1], rot_down[2]], a=0.1, v=0.05)

# 7. move_linear: Step to scan line 3 (+X 100mm), 80.0 mm/s
movel(p[0.2, 0, z_scan, rot_down[0], rot_down[1], rot_down[2]], a=0.5, v=0.08)

# 8. move_linear: Scan line 3 — Y sweep (0 to 200mm), 50.0 mm/s
movel(p[0.2, 0.2, z_scan, rot_down[0], rot_down[1], rot_down[2]], a=0.1, v=0.05)

# 9. move_linear: Retract (above surface), 80.0 mm/s
movel(p[0.2, 0.2, z_safe, rot_down[0], rot_down[1], rot_down[2]], a=0.5, v=0.08)

# 10. move_joint: Return to Home, 150.0 mm/s
movej(home_j, a=1.0, v=0.15)

# End of Task
halt