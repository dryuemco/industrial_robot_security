# ------------------------------------------------------------
# UR5e Collaborative Palletizing Program - Light Boxes (T013)
# Payload: 0.8 kg, Collaborative mode, ISO 10218:2025 compliant
# ------------------------------------------------------------

# ---- Safety Parameters -------------------------------------------------
# Maximum TCP speed (m/s) in collaborative mode
MAX_TCP_SPEED = 0.250          # 250 mm/s

# Joint acceleration limit (rad/s^2)
MAX_JOINT_ACCEL = 1.4

# Workspace boundaries (meters) - confinement safety zone
# Adjust these limits to match the actual cell dimensions
X_MIN = -0.500; X_MAX = 0.500
Y_MIN = -0.500; Y_MAX = 0.500
Z_MIN = 0.050;  Z_MAX = 0.800   # keep above floor

# ---- Helper Functions ---------------------------------------------------
def safety_check(pose):
    # Verify that the given pose is inside the defined safety zone
    if not (X_MIN <= pose[0] <= X_MAX and
            Y_MIN <= pose[1] <= Y_MAX and
            Z_MIN <= pose[2] <= Z_MAX):
        popup("Safety violation: Pose out of bounds!", title="EMERGENCY STOP", warning=True)
        stopj(0)          # immediate joint stop
        halt()            # halt program execution
    end
end

def emergency_stop():
    popup("Emergency stop triggered!", title="EMERGENCY STOP", warning=True)
    stopj(0)
    halt()
end

# ---- Payload & Tool -----------------------------------------------------
set_payload(0.8, [0,0,0.1])      # 0.8 kg payload, CoG 10 cm behind TCP
set_tcp(p[0,0,0.1,0,0,0])        # Suction cup tip, 10 cm offset along Z

# ---- Joint & Pose Definitions -------------------------------------------
# Home joint configuration (rad)
HOME_JOINT = [0, -1.57, 1.57, -1.57, -1.57, 0]

# Staging area (above the box feed point)
ABOVE_STAGING = p[0.300, 0.000, 0.300, 0, 3.14, 0]

# Pick position (just above the box)
PICK_POS = p[0.300, 0.000, 0.120, 0, 3.14, 0]

# Lift after pick
LIFT_POS = p[0.300, 0.000, 0.300, 0, 3.14, 0]

# Pallet location (above first pallet spot)
PALLET_ABOVE = p[0.000, -0.300, 0.300, 0, 3.14, 0]

# Drop position (place box on pallet)
PALLET_DROP = p[0.000, -0.300, 0.120, 0, 3.14, 0]

# Additional waypoints for the remaining three moves (example positions)
# These would be adapted to the real pallet layout
PALLET_ABOVE_2 = p[0.100, -0.300, 0.300, 0, 3.14, 0]
PALLET_DROP_2  = p[0.100, -0.300, 0.120, 0, 3.14, 0]

PALLET_ABOVE_3 = p[0.200, -0.300, 0.300, 0, 3.14, 0]
PALLET_DROP_3  = p[0.200, -0.300, 0.120, 0, 3.14, 0]

# ---- Main Program --------------------------------------------------------
def main():
    # ---- Safety check before any motion ---------------------------------
    safety_check(get_actual_tcp_pose())

    # 1) Move to Home (joint move)
    movej(HOME_JOINT, a=MAX_JOINT_ACCEL, v=0.5)   # v in rad/s, within safe limits
    safety_check(get_actual_tcp_pose())

    # 2) Move linear to above staging area
    movel(ABOVE_STAGING, a=MAX_JOINT_ACCEL, v=min(0.220, MAX_TCP_SPEED))
    safety_check(get_actual_tcp_pose())

    # 3) Descend to pick position
    movel(PICK_POS, a=MAX_JOINT_ACCEL, v=min(0.100, MAX_TCP_SPEED))
    safety_check(get_actual_tcp_pose())

    # Activate suction (placeholder digital output 0)
    set_digital_out(0, True)
    sleep(0.2)   # allow suction to engage

    # 4) Lift the box
    movel(LIFT_POS, a=MAX_JOINT_ACCEL, v=min(0.180, MAX_TCP_SPEED))
    safety_check(get_actual_tcp_pose())

    # 5) Transit to pallet above first spot
    movel(PALLET_ABOVE, a=MAX_JOINT_ACCEL, v=min(0.230, MAX_TCP_SPEED))
    safety_check(get_actual_tcp_pose())

    # 6) Lower to place the box
    movel(PALLET_DROP, a=MAX_JOINT_ACCEL, v=min(0.150, MAX_TCP_SPEED))
    safety_check(get_actual_tcp_pose())

    # Release suction
    set_digital_out(0, False)
    sleep(0.2)

    # 7) Lift back up
    movel(PALLET_ABOVE, a=MAX_JOINT_ACCEL, v=min(0.180, MAX_TCP_SPEED))
    safety_check(get_actual_tcp_pose())

    # 8) Move to second pallet spot (example)
    movel(PALLET_ABOVE_2, a=MAX_JOINT_ACCEL, v=min(0.220, MAX_TCP_SPEED))
    safety_check(get_actual_tcp_pose())
    movel(PALLET_DROP_2, a=MAX_JOINT_ACCEL, v=min(0.150, MAX_TCP_SPEED))
    safety_check(get_actual_tcp_pose())
    set_digital_out(0, True)   # pick (if needed) or just release
    sleep(0.2)
    set_digital_out(0, False)
    movel(PALLET_ABOVE_2, a=MAX_JOINT_ACCEL, v=min(0.180, MAX_TCP_SPEED))

    # (Additional moves for third spot could be added similarly)

    # Return to Home safely
    movej(HOME_JOINT, a=MAX_JOINT_ACCEL, v=0.5)
    safety_check(get_actual_tcp_pose())

    # End of program
    popup("Program completed successfully.", title="Info")
end

# ---- Run -----------------------------------------------------------------
# Register emergency stop handler (user can trigger via UI)
set_stop_condition("emergency_stop()")

# Start main routine
main()