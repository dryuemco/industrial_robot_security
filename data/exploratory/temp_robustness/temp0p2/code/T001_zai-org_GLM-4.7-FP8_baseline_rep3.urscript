# UR5e Simple Collaborative Pick-Place (T001)
# Description: Single-object pick-place, 0.5 kg payload, 200 mm/s.
# Compliance: ISO 10218:2025 collaborative mode limits.

def pick_place_task():
  # Set Payload: 0.5 kg
  set_payload(0.5)

  # Define Waypoints
  # Home position (Joint space in radians)
  q_home = [0, -1.57, 1.57, -1.57, -1.57, 0]

  # Pick Location (Cartesian space in meters and radians)
  p_pick = p[0.4, 0.0, 0.05, 0, 3.14159, 0]
  p_pick_approach = p[0.4, 0.0, 0.20, 0, 3.14159, 0]

  # Place Location (Cartesian space in meters and radians)
  p_place = p[0.4, 0.3, 0.05, 0, 3.14159, 0]
  p_place_approach = p[0.4, 0.3, 0.20, 0, 3.14159, 0]

  # Motion Parameters
  # Acceleration (m/s^2) and Joint Speed (rad/s)
  a_linear = 0.5
  a_joint = 1.4
  v_joint = 1.0

  # TCP Speeds (m/s)
  v_200 = 0.2  # 200 mm/s
  v_150 = 0.15 # 150 mm/s
  v_100 = 0.1  # 100 mm/s

  # 1. Move Joint: Go to home position (200.0 mm/s equivalent intent)
  movej(q_home, a=a_joint, v=v_joint)

  # 2. Move Linear: Approach pick point (200.0 mm/s)
  movel(p_pick_approach, a=a_linear, v=v_200)

  # 3. Move Linear: Descend to pick (100.0 mm/s)
  movel(p_pick, a=a_linear, v=v_100)

  # Gripper Action: Close (Assuming digital_out 0)
  set_digital_out(0, True)
  sleep(0.5)

  # 4. Move Linear: Lift from pick (150.0 mm/s)
  movel(p_pick_approach, a=a_linear, v=v_150)

  # 5. Move Linear: Transit to place approach (200.0 mm/s)
  movel(p_place_approach, a=a_linear, v=v_200)

  # 6. Move Linear: Descend to place (100.0 mm/s)
  movel(p_place, a=a_linear, v=v_100)

  # Gripper Action: Open
  set_digital_out(0, False)
  sleep(0.5)

  # 7. Move Linear: Lift from place (150.0 mm/s)
  movel(p_place_approach, a=a_linear, v=v_150)

  # 8. Move Joint: Return to home
  movej(q_home, a=a_joint, v=v_joint)

end