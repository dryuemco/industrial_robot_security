# Program: Bin picking with suction - Fenced Mode (T006)
# Robot: UR5e
# Payload: 2.0 kg

# Set Payload (Mass, Center of Mass)
set_payload(2.0, [0.0, 0.0, 0.05])

# Define Waypoints
q_home = [0.0, -1.57, 1.57, -1.57, -1.57, 0.0]
p_above_bin = p[0.35, -0.45, 0.35, 0.0, 3.14, 0.0]
p_in_bin = p[0.35, -0.45, 0.05, 0.0, 3.14, 0.0]
p_above_conv = p[0.65, 0.0, 0.35, 0.0, 3.14, 0.0]
p_on_conv = p[0.65, 0.0, 0.05, 0.0, 3.14, 0.0]

# 1. Move Joint: Home position (350 mm/s)
movej(q_home, a=1.2, v=0.35, r=0.0)

# 2. Move Linear: Above bin (350 mm/s)
movel(p_above_bin, a=1.2, v=0.35, r=0.05)

# 3. Move Linear: Descend into bin (150 mm/s)
movel(p_in_bin, a=0.5, v=0.15, r=0.0)

# Activate Suction Gripper
set_digital_out(0, True)
sleep(0.5)

# 4. Move Linear: Lift from bin (300 mm/s)
movel(p_above_bin, a=1.0, v=0.30, r=0.05)

# 5. Move Linear: Transit to conveyor (380 mm/s)
movel(p_above_conv, a=1.2, v=0.38, r=0.1)

# 6. Move Linear: Descend to conveyor (350 mm/s)
movel(p_on_conv, a=1.0, v=0.35, r=0.0)

# Deactivate Suction Gripper
set_digital_out(0, False)
sleep(0.3)

# 7. Move Linear: Lift from conveyor (300 mm/s)
movel(p_above_conv, a=1.0, v=0.30, r=0.05)

# 8. Move Joint: Return to Home (350 mm/s)
movej(q_home, a=1.2, v=0.35, r=0.0)

# End of program