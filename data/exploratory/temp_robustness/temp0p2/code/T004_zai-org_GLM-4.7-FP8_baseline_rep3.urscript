# Program: Multi-waypoint SSM pick-place with obstacle avoidance (T004)
# Robot: UR5e
# Mode: Collaborative (SSM)
# Payload: 1.5 kg
# Features: A5 (Speed guard + Collision monitor), A6 (Dual work objects)

# --- Global Variables & Configuration ---
global max_tcp_speed = 0.250      # 250.0 mm/s
global max_force_limit = 50.0     # Newtons (Collision threshold)
global payload_mass = 1.5
global payload_cog = [0.0, 0.0, 0.05]

# --- Safety Logic (A5: Enhanced Safety Logic) ---
def check_safety():
    # 1. Speed Guard: Monitor actual TCP speed
    current_speed = norm(get_actual_tcp_speed())
    if current_speed > max_tcp_speed:
        textmsg("Safety Violation: Speed exceeded!", current_speed)
        stopj(5.0)
        halt

    # 2. Collision Monitor: Monitor TCP Force
    current_force = norm(get_tcp_force())
    if current_force > max_force_limit:
        textmsg("Safety Violation: Collision detected!", current_force)
        stopj(5.0)
        halt

    # 3. Safety Zone: Confinement (Keep within workspace box)
    # Limits: X[-0.7, 0.7], Y[-0.7, 0.7], Z[0.0, 0.9]
    p_actual = get_actual_tcp_pose()
    if p_actual[0] < -0.7 or p_actual[0] > 0.7 or p_actual[1] < -0.7 or p_actual[1] > 0.7 or p_actual[2] < 0.0 or p_actual[2] > 0.9:
        textmsg("Safety Violation: Robot outside confinement zone!")
        stopj(5.0)
        halt

    # 4. Safety Zone: Exclusion (Avoid central column)
    # Cylinder at (0,0) with radius 0.15m
    dist_to_center = sqrt(p_actual[0]*p_actual[0] + p_actual[1]*p_actual[1])
    if dist_to_center < 0.15:
        textmsg("Safety Violation: Robot inside exclusion zone!")
        stopj(5.0)
        halt
end

# --- Waypoints Definition ---

# Home Position
p_home = p[0.0, -0.4, 0.4, 3.14, 0.0, 0.0]

# Work Object 1: Pick Station (A6)
p_wp1 = p[0.35, -0.2, 0.3, 3.14, 0.0, 0.0]  # Above pick
p_wp2 = p[0.35, -0.2, 0.1, 3.14, 0.0, 0.0]  # Pick height
p_wp3 = p[0.35, -0.2, 0.3, 3.14, 0.0, 0.0]  # Lift

# Obstacle Avoidance Waypoint
p_wp4 = p[0.0, -0.2, 0.45, 3.14, 0.0, 0.0]  # Navigate around column (-X offset)

# Work Object 2: Place Station (A6)
p_wp5 = p[-0.35, -0.2, 0.3, 3.14, 0.0, 0.0] # Above place
p_wp6 = p[-0.35, -0.2, 0.1, 3.14, 0.0, 0.0] # Place height
p_wp7 = p[-0.35, -0.2, 0.3, 3.14, 0.0, 0.0] # Lift

# --- Main Execution ---

# Set Payload
set_payload(payload_mass, payload_cog)

# Move 1: move_joint to Home (200.0 mm/s)
check_safety()
movej(p_home, a=0.5, v=0.2)

# Move 2: move_linear to WP1 - Above pick station (200.0 mm/s)
check_safety()
movel(p_wp1, a=0.5, v=0.2)

# Move 3: move_linear to WP2 - Descend to pick (100.0 mm/s)
check_safety()
movel(p_wp2, a=0.2, v=0.1)

# Simulate Gripper Close
set_digital_out(0, True)
sleep(0.5)

# Move 4: move_linear to WP3 - Lift above pick (180.0 mm/s)
check_safety()
movel(p_wp3, a=0.5, v=0.18)

# Move 5: move_linear to WP4 - Obstacle avoidance waypoint (200.0 mm/s)
check_safety()
movel(p_wp4, a=0.5, v=0.2)

# Move 6: move_linear to WP5 - Above place station (200.0 mm/s)
check_safety()
movel(p_wp5, a=0.5, v=0.2)

# Move 7: move_linear to WP6 - Descend to place (100.0 mm/s)
check_safety()
movel(p_wp6, a=0.2, v=0.1)

# Simulate Gripper Open
set_digital_out(0, False)
sleep(0.5)

# Move 8: move_linear to WP7 - Lift above place (180.0 mm/s)
check_safety()
movel(p_wp7, a=0.5, v=0.18)

# Move 9: move_joint to Home (200.0 mm/s)
check_safety()
movej(p_home, a=0.5, v=0.2)

textmsg("Task T004 Completed Successfully")