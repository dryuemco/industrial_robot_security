# Safety Definitions and Constants
def safety_check():
  # Check if robot is in normal operating mode
  if (get_safety_mode() != 1):
    popup("Safety Violation: Robot not in Normal Mode")
    halt
  end
  # Verify speed limits are respected
  current_speed = get_actual_tcp_speed()
  if (current_speed > 0.15): # 150 mm/s limit
    popup("Safety Violation: TCP Speed Exceeded")
    stopj(1.0)
    halt
  end
end

def check_zone(pose):
  # Safety Zone Boundaries (meters)
  x_min = 0.25
  x_max = 0.55
  y_min = -0.15
  y_max = 0.15
  z_min = 0.10
  z_max = 0.30
  
  # Check if target pose is within boundaries
  if (pose[0] < x_min or pose[0] > x_max or pose[1] < y_min or pose[1] > y_max or pose[2] < z_min or pose[2] > z_max):
    popup("Safety Zone Violation: Target Out of Bounds")
    halt
  end
end

thread emergency_stop_handler():
  while True:
    # Monitor for external E-stop signal (simulated on Digital Input 8)
    # or internal safety fault
    if (get_digital_in(8) == False or get_safety_mode() > 1):
      popup("Emergency Stop Triggered")
      stopj(1.0)
      halt
    end
    sleep(0.1)
  end
end

# Main Program
set_payload(0.3, [0, 0, 0.05]) # 0.3 kg payload, CoM approx
set_gravity([0, 0, 9.82])

# Start Safety Thread
thread emergency_stop_handler()

# Motion Parameters
# Max Joint Acceleration: 1.4 rad/s^2
# Max TCP Speed: 0.15 m/s (150 mm/s)
accel_limit = 1.4

# Orientation: Pointing strictly downward (A3)
# Assuming standard mounting, rx=pi points tool Z down
rot_down = [3.14159, 0, 0]

# Waypoints
home_j = [-1.57, -1.57, -1.57, -1.57, -1.57, 0]

# Inspection Area: 200x200mm, centered at x=0.4, y=0.0
# Scan Height: 150mm (0.15m) above part (z=0.15)
p_approach = p[0.4, 0.0, 0.25, rot_down[0], rot_down[1], rot_down[2]]
p_scan_start = p[0.3, -0.1, 0.15, rot_down[0], rot_down[1], rot_down[2]]
p_line1_end = p[0.3, 0.1, 0.15, rot_down[0], rot_down[1], rot_down[2]]
p_line2_start = p[0.4, 0.1, 0.15, rot_down[0], rot_down[1], rot_down[2]]
p_line2_end = p[0.4, -0.1, 0.15, rot_down[0], rot_down[1], rot_down[2]]
p_line3_start = p[0.5, -0.1, 0.15, rot_down[0], rot_down[1], rot_down[2]]
p_line3_end = p[0.5, 0.1, 0.15, rot_down[0], rot_down[1], rot_down[2]]

# Move 1: move_joint - Home position
safety_check()
movej(home_j, a=accel_limit, v=0.15)

# Move 2: move_linear - Approach inspection start
safety_check()
check_zone(p_approach)
movel(p_approach, a=accel_limit, v=0.13)

# Move 3: move_linear - Descend to scan height
safety_check()
check_zone(p_scan_start)
movel(p_scan_start, a=accel_limit, v=0.08)

# Move 4: move_linear - Scan line 1 (Y sweep)
safety_check()
check_zone(p_line1_end)
movel(p_line1_end, a=accel_limit, v=0.05)

# Move 5: move_linear - Step to scan line 2 (+X)
safety_check()
check_zone(p_line2_start)
movel(p_line2_start, a=accel_limit, v=0.08)

# Move 6: move_linear - Scan line 2 (Y sweep return)
safety_check()
check_zone(p_line2_end)
movel(p_line2_end, a=accel_limit, v=0.05)

# Move 7: move_linear - Step to scan line 3 (+X)
safety_check()
check_zone(p_line3_start)
movel(p_line3_start, a=accel_limit, v=0.08)

# Move 8: move_linear - Scan line 3 (Y sweep)
safety_check()
check_zone(p_line3_end)
movel(p_line3_end, a=accel_limit, v=0.05)

# Move 9: move_linear - Retract from surface
safety_check()
check_zone(p_approach)
movel(p_approach, a=accel_limit, v=0.08)

# Move 10: move_joint - Return to Home
safety_check()
movej(home_j, a=accel_limit, v=0.15)

# Cleanup
kill emergency_stop_handler