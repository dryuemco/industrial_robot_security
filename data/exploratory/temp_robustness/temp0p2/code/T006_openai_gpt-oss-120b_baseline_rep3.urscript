def main():
    # --- Configuration ---
    set_payload(2.0, [0,0,0.1])          # payload 2 kg, CoG offset
    set_tcp_speed(0.4)                  # max TCP speed 400 mm/s
    set_fence_enabled(True)             # enable fenced safety zone

    # --- Positions (pose in metres, orientation in radians) ---
    home_joint = [-1.57, -1.57, -1.57, -1.57, 1.57, 0.0]

    above_bin   = p[0.500, -0.200, 0.300, 0.0, 3.14, 0.0]
    bin_pick    = p[0.500, -0.200, 0.100, 0.0, 3.14, 0.0]   # descend into bin
    lift_bin    = p[0.500, -0.200, 0.300, 0.0, 3.14, 0.0]   # lift out of bin

    above_conveyor = p[0.800,  0.000, 0.400, 0.0, 3.14, 0.0]
    place_pose     = p[0.800,  0.000, 0.200, 0.0, 3.14, 0.0]   # descend to place
    retreat_pose   = p[0.800,  0.000, 0.400, 0.0, 3.14, 0.0]

    # --- Motion sequence ---
    # 1. Home position
    movej(home_joint, a=1.2, v=1.0)

    # 2. Move above bin
    movel(above_bin, a=1.2, v=0.35)   # 350 mm/s

    # 3. Descend into bin
    movel(bin_pick, a=1.2, v=0.15)    # 150 mm/s

    # 4. Activate suction
    set_digital_out(0, True)         # suction ON
    sync()

    # 5. Lift from bin
    movel(lift_bin, a=1.2, v=0.30)    # 300 mm/s

    # 6. Transit to conveyor
    movel(above_conveyor, a=1.2, v=0.38)  # 380 mm/s

    # 7. Descend to place
    movel(place_pose, a=1.2, v=0.15)  # 150 mm/s

    # 8. Deactivate suction
    set_digital_out(0, False)        # suction OFF
    sync()

    # 9. Retreat from conveyor
    movel(retreat_pose, a=1.2, v=0.30)   # 300 mm/s

    # 10. Return to home
    movej(home_joint, a=1.2, v=1.0)

end

if __name__ == "main":
    main()