# URScript for UR5e - Hybrid mode palletizing 2x2 grid
# Payload and TCP
set_payload(4.5, [0,0,0.1])   # 4.5 kg payload, center of gravity 10 cm above TCP
set_tcp(p[0,0,0.1,0,0,0])     # default TCP

# Safety limits (confinement to pallet area)
# Joint speed limit 0.3 m/s, Cartesian speed limit 0.3 m/s
set_safety_limits(
    joint_limits = [2*PI, 2*PI, 2*PI, 2*PI, 2*PI, 2*PI],
    speed_limits = [0.3, 0.3, 0.3, 0.3, 0.3, 0.3],
    force_limits = [150,150,150,150,150,150]
)

# Home joint position
home_q = [-1.57, -1.57, -1.57, -1.57, 1.57, 0]

# Conveyor pick pose (above)
pick_above = p[0.5, -0.2, 0.35, 0, 3.14, 0]   # x,y,z in meters, orientation in rad
# Pick pose (descend)
pick_pose  = p[0.5, -0.2, 0.10, 0, 3.14, 0]

# Pallet grid positions (2x2) – bottom‑left corner is (0.3, -0.15)
grid_spacing = 0.15   # 150 mm between centers
grid_origin  = p[0.3, -0.15, 0.10, 0, 3.14, 0]

# Generate the four grid poses
def make_grid_pose(ix, iy):
    return pose_trans(p[grid_origin[0] + ix*grid_spacing,
                        grid_origin[1] + iy*grid_spacing,
                        grid_origin[2]],
                     rot_z(grid_origin[5]))

grid_poses = [
    make_grid_pose(0,0),
    make_grid_pose(1,0),
    make_grid_pose(0,1),
    make_grid_pose(1,1)
]

# Motion parameters
a_joint = 1.2          # rad/s^2
v_joint = 0.25         # 250 mm/s -> 0.25 m/s
a_linear = 1.2         # m/s^2
v_fast   = 0.28        # 280 mm/s -> 0.28 m/s
v_slow   = 0.10        # 100 mm/s -> 0.10 m/s
v_lift   = 0.20        # 200 mm/s -> 0.20 m/s

# -----------------------------------------------------------------
# Start program
def main():
    # 1. Move to home
    movej(home_q, a_joint, v_joint, 0, 0)

    # 2. Approach conveyor (above pick)
    movel(pick_above, a_linear, v_fast, 0, 0)

    # 3. Descend to pick
    movel(pick_pose, a_linear, v_slow, 0, 0)

    # 4. Close gripper (placeholder)
    # set_digital_out(0, True)   # assume output 0 controls gripper close
    sleep(0.5)

    # 5. Lift from conveyor
    movel(pick_above, a_linear, v_lift, 0, 0)

    # 6. Transit to first pallet cell (collaborative zone near conveyor)
    #   Hybrid: keep speed limited to 0.25 m/s (already set by safety limits)
    movel(grid_poses[0], a_linear, v_fast, 0, 0)

    # 7. Place first box
    movel(p[grid_poses[0][0], grid_poses[0][1], 0.05, 0, 3.14, 0],
          a_linear, v_slow, 0, 0)
    # set_digital_out(0, False)  # open gripper
    sleep(0.5)

    # 8. Lift after placement
    movel(grid_poses[0], a_linear, v_lift, 0, 0)

    # Repeat for remaining three cells
    for i in range(1,4):
        # Transit to next cell (fenced mode – speed limited by safety limits)
        movel(grid_poses[i], a_linear, v_fast, 0, 0)

        # Lower to place
        movel(p[grid_poses[i][0], grid_poses[i][1], 0.05, 0, 3.14, 0],
              a_linear, v_slow, 0, 0)

        # Open gripper
        # set_digital_out(0, False)
        sleep(0.5)

        # Lift
        movel(grid_poses[i], a_linear, v_lift, 0, 0)

    # Return to home
    movej(home_q, a_joint, v_joint, 0, 0)

# Execute
main()