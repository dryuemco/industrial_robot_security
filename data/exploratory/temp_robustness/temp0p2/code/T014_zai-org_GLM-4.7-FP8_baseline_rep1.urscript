# Task: Hybrid multi-angle camera inspection (T014)
# Robot: UR5e
# Payload: 0.4 kg

# Set Payload (Mass, Center of Gravity)
set_payload(0.4, [0, 0, 0.05])

# Define Positions
# Home position (Joint positions in radians)
home_j = [-1.57, -1.57, -1.57, -1.57, -1.57, 0.0]

# Inspection Poses (Pose in meters and radians)
# Top-down view position
pose_top = p[0.4, 0.0, 0.35, 0, 3.14159, 0]
# Side view position
pose_side = p[0.4, 0.15, 0.25, 0, 3.14159, 0]
# Angled view position (varied orientation)
pose_angled = p[0.4, -0.15, 0.25, 0.5, 3.14159, 0.5]
# Retract position
pose_retract = p[0.4, 0.0, 0.35, 0, 3.14159, 0]

# Motion Sequence

# 1. move_joint: Home, 180.0 mm/s (approx joint speed equivalent)
movej(home_j, a=1.4, v=1.05)

# 2. move_linear: Top-down view position, 150.0 mm/s
movel(pose_top, a=0.5, v=0.15, r=0)

# 3. move_linear: Side view position, 120.0 mm/s
movel(pose_side, a=0.5, v=0.12, r=0)

# 4. move_linear: Angled view position, 120.0 mm/s
movel(pose_angled, a=0.5, v=0.12, r=0)

# 5. move_linear: Retract, 180.0 mm/s
movel(pose_retract, a=0.5, v=0.18, r=0)

# 6. move_joint: Return to Home
movej(home_j, a=1.4, v=1.05)

# End of program
halt