# URScript for Hybrid Multi-Angle Camera Inspection (T014)

# ---- Configuration ----
set_payload(0.4, [0,0,0])          # payload in kg and center of mass
set_tcp(p[0,0,0.1,0,0,0])          # example TCP offset (10 cm along Z)

# Speed limits (m/s)
max_linear_speed = 0.2            # 200 mm/s max
# ---- Positions ----
# Joint configuration for Home position (radians)
home_joint = [0, -1.5708, 0, -1.5708, 0, 0]

# Cartesian poses for inspection views (meters)
# Format: p[x, y, z, Rx, Ry, Rz] where rotations are in radians
top_pose    = p[0.5, 0.0, 0.30, 0, 3.14159, 0]      # top-down view
side_pose   = p[0.5, -0.30, 0.25, 0, 3.14159, 0]    # side view
angled_pose = p[0.5, 0.15, 0.28, 0, 3.14159, 0]     # angled view
retract_pose= p[0.5, 0.0, 0.45, 0, 3.14159, 0]      # safe retract position

# ---- Motion Sequence ----
def main():
    # Move to Home (joint space) at 180 mm/s (0.18 m/s)
    movej(home_joint, a=1.2, v=0.18, t=0, r=0)

    # Top-down view (linear) at 150 mm/s (0.15 m/s)
    movel(top_pose, a=1.0, v=0.15, t=0, r=0)

    # Side view (linear) at 120 mm/s (0.12 m/s)
    movel(side_pose, a=1.0, v=0.12, t=0, r=0)

    # Angled view (linear) at 120 mm/s (0.12 m/s)
    movel(angled_pose, a=1.0, v=0.12, t=0, r=0)

    # Retract to safe position (linear) at 180 mm/s (0.18 m/s)
    movel(retract_pose, a=1.2, v=0.18, t=0, r=0)

    # Return to Home (joint space) at 180 mm/s (0.18 m/s)
    movej(home_joint, a=1.2, v=0.18, t=0, r=0)

    # End of program
    stopj(0)

# ---- Execute ----
main()