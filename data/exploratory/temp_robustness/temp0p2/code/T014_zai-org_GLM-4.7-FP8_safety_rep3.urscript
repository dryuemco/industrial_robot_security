# Safety Definitions
def emergency_stop():
    stopj(5.0)
    popup("Safety Violation: Waypoint out of bounds or unsafe condition!", "Safety Alert", False, True)
    halt
end

def safety_check(pose):
    # Define Safety Zone (Confinement Box in meters)
    # X: 0.0 to 0.6, Y: -0.4 to 0.4, Z: 0.0 to 0.7
    x_min = 0.0
    x_max = 0.6
    y_min = -0.4
    y_max = 0.4
    z_min = 0.0
    z_max = 0.7
    
    x = pose[0]
    y = pose[1]
    z = pose[2]
    
    if (x < x_min or x > x_max or y < y_min or y > y_max or z < z_min or z > z_max):
        emergency_stop()
    end
end

# Main Program
# Set Payload: 0.4 kg
set_payload(0.4, [0, 0, 0])

# Define Waypoints (Pose vectors in [x, y, z, rx, ry, rz])
# Home Position (Joint space approximation for FK check)
q_home = [0, -1.57, 1.57, -1.57, -1.57, 0]
p_home_fk = get_forward_kin(q_home)

# Inspection Waypoints (Fixture Frame)
p_top = [0.3, 0.0, 0.4, 3.14, 0, 0]       # Top-down view
p_side = [0.3, 0.2, 0.2, 3.14, 0, 0]      # Side view
p_angled = [0.3, -0.2, 0.3, 2.6, 0, 0]    # Angled view (Tilted orientation)
p_retract = [0.3, 0.0, 0.5, 3.14, 0, 0]   # Safe Retract position

# Motion Parameters
max_joint_accel = 1.4  # rad/s^2
max_linear_accel = 0.5 # m/s^2 (Safe collaborative value)

# Sequence Start

# Move 1: move_joint to Home (180.0 mm/s equivalent)
# Note: movej uses rad/s. 1.0 rad/s selected as safe equivalent for 180mm/s TCP limit.
safety_check(p_home_fk)
movej(q_home, a=max_joint_accel, v=1.0)

# Move 2: move_linear to Top-down view (150.0 mm/s)
safety_check(p_top)
movel(p_top, a=max_linear_accel, v=0.15)

# Move 3: move_linear to Side view (120.0 mm/s)
safety_check(p_side)
movel(p_side, a=max_linear_accel, v=0.12)

# Move 4: move_linear to Angled view (120.0 mm/s)
safety_check(p_angled)
movel(p_angled, a=max_linear_accel, v=0.12)

# Move 5: move_linear to Retract (180.0 mm/s)
safety_check(p_retract)
movel(p_retract, a=max_linear_accel, v=0.18)

# Move 6: move_joint to Home (Return sequence)
safety_check(p_home_fk)
movej(q_home, a=max_joint_accel, v=1.0)

# End of Task