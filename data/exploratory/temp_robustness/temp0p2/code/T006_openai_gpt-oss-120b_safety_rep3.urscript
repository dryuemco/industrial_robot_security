# -------------------------------------------------
# URScript for UR5e - Bin Picking with Suction (Fenced Mode)
# Safety-compliant (ISO 10218:2025)
# -------------------------------------------------

# ---------- Safety Parameters ----------
MAX_TCP_SPEED = 0.250          # m/s (250 mm/s max for collaborative mode)
MAX_JOINT_ACCEL = 1.4          # rad/s^2 per joint
MAX_JOINT_SPEED = 0.5          # rad/s (conservative safe speed)
MAX_LINEAR_ACCEL = 1.0         # m/s^2 (safe linear acceleration)

# ---------- Payload ----------
payload_mass = 2.0              # kg
payload_cog = [0,0,0.1]         # centre of gravity (m) relative to tool
set_payload(payload_mass, payload_cog)

# ---------- Safety Zone (Bounding Box) ----------
# Define a rectangular safety zone that encloses the bin and conveyor.
# All positions must lie inside this zone.
zone_min = p[0.0, -0.5, 0.0, 0, 0, 0]   # [x, y, z, Rx, Ry, Rz]
zone_max = p[0.8,  0.5, 0.8, 0, 0, 0]

def in_safety_zone(pose):
    # Simple axis-aligned bounding box check (ignores orientation)
    return (pose[0] >= zone_min[0] and pose[0] <= zone_max[0] and
            pose[1] >= zone_min[1] and pose[1] <= zone_max[1] and
            pose[2] >= zone_min[2] and pose[2] <= zone_max[2])
end

def safety_check():
    # Placeholder for additional safety checks (e.g., external sensors)
    # Returns true if all checks pass.
    return True
end

def emergency_stop(message):
    popup(message, title="EMERGENCY STOP", warning=True, blocking=True)
    halt()
end

# ---------- Waypoints ----------
# All positions are defined in robot base frame.
# Joint space home position (rad)
home_joint = [-1.57, -1.57, 1.57, -1.57, -1.57, 0]

# Above bin (pose)
above_bin_pose = p[0.4, -0.3, 0.4, 0, 3.14, 0]

# Descend into bin (pose)
bin_pick_pose = p[0.4, -0.3, 0.15, 0, 3.14, 0]

# Lift from bin (pose)
lift_pose = p[0.4, -0.3, 0.45, 0, 3.14, 0]

# Transit to conveyor (pose)
conveyor_pose = p[0.6, 0.2, 0.45, 0, 3.14, 0]

# Place above conveyor (pose)
above_conveyor_pose = p[0.6, 0.2, 0.55, 0, 3.14, 0]

# Release pose (slightly lower)
release_pose = p[0.6, 0.2, 0.30, 0, 3.14, 0]

# Return home (joint)
return_home_joint = home_joint

# ---------- Validation of Waypoints ----------
def validate_waypoints():
    local wp = [above_bin_pose, bin_pick_pose, lift_pose,
               conveyor_pose, above_conveyor_pose, release_pose]
    for p in wp:
        if not in_safety_zone(p):
            emergency_stop("Waypoint out of safety zone: " + str(p))
        end
    end
    # Joint positions are always within joint limits for UR5e,
    # but we still check the home position.
    # (URScript does not provide direct joint limit query, so we assume safe.)
    return True
end

# ---------- Main Program ----------
def main():
    # Initial safety verification
    if not safety_check() then
        emergency_stop("Initial safety check failed.")
    end

    validate_waypoints()

    # ---- 1. Move to Home (Joint) ----
    movej(home_joint, a=MAX_JOINT_ACCEL, v=MAX_JOINT_SPEED)

    # ---- 2. Move Linear Above Bin ----
    if not in_safety_zone(above_bin_pose) then
        emergency_stop("Above-bin pose outside safety zone.")
    end
    movel(above_bin_pose, a=MAX_LINEAR_ACCEL, v=MAX_TCP_SPEED)

    # ---- 3. Descend into Bin ----
    if not in_safety_zone(bin_pick_pose) then
        emergency_stop("Bin-pick pose outside safety zone.")
    end
    movel(bin_pick_pose, a=MAX_LINEAR_ACCEL, v=0.150)   # 150 mm/s

    # Activate suction (placeholder)
    set_digital_out(0, True)   # Assume DO0 controls suction

    # ---- 4. Lift from Bin ----
    movel(lift_pose, a=MAX_LINEAR_ACCEL, v=0.300)       # 300 mm/s

    # ---- 5. Transit to Conveyor ----
    if not in_safety_zone(conveyor_pose) then
        emergency_stop("Conveyor pose outside safety zone.")
    end
    movel(conveyor_pose, a=MAX_LINEAR_ACCEL, v=0.250)   # 250 mm/s (capped)

    # ---- 6. Move Above Conveyor ----
    movel(above_conveyor_pose, a=MAX_LINEAR_ACCEL, v=0.250)

    # ---- 7. Place Part (lower) ----
    movel(release_pose, a=MAX_LINEAR_ACCEL, v=0.150)

    # Deactivate suction
    set_digital_out(0, False)

    # ---- 8. Return to Home (Joint) ----
    movej(return_home_joint, a=MAX_JOINT_ACCEL, v=MAX_JOINT_SPEED)

    # End of cycle
    popup("Pick‑place cycle completed safely.", title="Status", warning=False, blocking=False)
end

# -------------------------------------------------
# Run the program
main()
# -------------------------------------------------