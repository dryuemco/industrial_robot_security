# Program: T011 Dual-zone pick-place
# Robot: UR5e
# Mode: Hybrid
# Payload: 1.2 kg
# Description: Pick from fenced storage, place in collaborative handoff zone.

# --- Configuration ---
set_payload(1.2, [0, 0, 0.05])
set_tcp(p[0, 0, 0.15, 0, 0, 0])

# --- Zone Definitions (Simulated via I/O for Hybrid Mode) ---
# Configurable Out 0: Active in Storage Zone (Confinement)
# Configurable Out 1: Active in Handoff Zone (Exclusion/Collaborative)

# --- Pose Definitions ---
p_home = [-1.57, -1.57, -1.57, -1.57, -1.57, 0]
p_storage_above = p[0.35, -0.45, 0.35, 3.14, 0, 0]
p_storage_pick = p[0.35, -0.45, 0.10, 3.14, 0, 0]
p_handoff_above = p[0.55, 0.35, 0.35, 0, 3.14, 0]
p_handoff_place = p[0.55, 0.35, 0.15, 0, 3.14, 0]

# --- Motion Sequence ---

# 1. move_joint: Home, 250.0 mm/s
movej(p_home, a=1.2, v=0.25)

# 2. move_linear: Above storage bin, 280.0 mm/s
# Entering Storage Zone (Confinement)
set_configurable_digital_out(0, True)
movel(p_storage_above, a=1.0, v=0.28)

# 3. move_linear: Descend to pick, 120.0 mm/s
movel(p_storage_pick, a=0.5, v=0.12)

# --- Pick Action ---
set_digital_out(0, True)
sleep(0.5)

# 4. move_linear: Lift from bin, 200.0 mm/s
movel(p_storage_above, a=0.8, v=0.20)

# Exiting Storage Zone
set_configurable_digital_out(0, False)

# 5. move_linear: Transit to handoff zone, 250.0 mm/s
# Entering Handoff Zone (Exclusion/Collaborative)
set_configurable_digital_out(1, True)
movel(p_handoff_above, a=1.2, v=0.25)

# 6. move_linear: Descend to handoff, 150.0 mm/s
movel(p_handoff_place, a=0.5, v=0.15)

# --- Place Action ---
set_digital_out(0, False)
sleep(0.5)

# 7. move_linear: Retract from handoff, 250.0 mm/s
movel(p_handoff_above, a=0.8, v=0.25)

# Exiting Handoff Zone
set_configurable_digital_out(1, False)

# 8. move_joint: Return to Home, 250.0 mm/s
movej(p_home, a=1.2, v=0.25)

# End of Program