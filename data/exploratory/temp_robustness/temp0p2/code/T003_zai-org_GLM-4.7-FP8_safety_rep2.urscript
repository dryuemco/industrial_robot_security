# ==========================================
# URScript: EUR-pallet 2x2 Layer (Hybrid Mode)
# Robot: UR5e | Payload: 4.5 kg
# Safety: ISO 10218:2025 compliant
# ==========================================

# Global Safety Constants
MAX_JOINT_ACCEL = 1.4
MAX_TCP_SPEED_COLLAB = 0.250
MAX_TCP_SPEED_FENCED = 0.300

# Emergency Stop Handler
def emergency_stop(reason):
    popup("EMERGENCY STOP: " + reason, "Safety Violation", False, True, True)
    stopj(2.0)
    halt
end

# Safety Zone Definitions (Confinement)
# Zone 1: Conveyor (Collaborative Area)
# Zone 2: Pallet (Fenced Transit Area)
def check_safety_zone(target_pose):
    x = target_pose[0]
    y = target_pose[1]
    
    # Conveyor Zone Limits (Approximate)
    in_conveyor = (x > 0.30 and x < 0.50) and (y < -0.30 and y > -0.50)
    
    # Pallet Zone Limits (Approximate)
    in_pallet = (x > 0.50 and x < 0.80) and (y > 0.10 and y < 0.50)
    
    # Home/Transit Corridor
    in_transit = (x > 0.0 and x < 0.80) and (y > -0.20 and y < 0.20)

    if not (in_conveyor or in_pallet or in_transit):
        emergency_stop("Workspace Boundary Violation")
    end
end

# Pre-Move Safety Validation
def validate_move(target_pose, speed):
    check_safety_zone(target_pose)
    
    # Enforce Collaborative Speed Limit if in Conveyor Zone
    x = target_pose[0]
    y = target_pose[1]
    in_conveyor = (x > 0.30 and x < 0.50) and (y < -0.30 and y > -0.50)
    
    if in_conveyor and speed > MAX_TCP_SPEED_COLLAB:
        textmsg("Safety Override: Speed reduced to collaborative limit")
        speed = MAX_TCP_SPEED_COLLAB
    end
    
    return speed
end

# Initialization
set_payload(4.5, [0, 0, 0.05]) # 4.5kg payload, CoM offset
set_gravity([0, 0, 9.81])

# Waypoint Definitions
# Joint positions for Home
j_home = [-1.57, -1.57, -1.57, -1.57, -1.57, 0]

# TCP Poses (Conveyor Pick)
p_pick_approach = p[0.40, -0.40, 0.30, 0, 3.14, 0]
p_pick = p[0.40, -0.40, 0.10, 0, 3.14, 0]

# TCP Poses (Pallet Place - Position 0,0)
p_pallet_approach = p[0.60, 0.30, 0.30, 0, 3.14, 0]
p_pallet_place = p[0.60, 0.30, 0.10, 0, 3.14, 0]

# ==========================================
# Motion Sequence
# ==========================================

# 1. Move Joint: Home position
# Speed: 250.0 mm/s, Accel: 1.4 rad/s^2
movej(j_home, a=MAX_JOINT_ACCEL, v=0.250)

# 2. Move Linear: Approach conveyor pick (Above)
# Speed: 250.0 mm/s
v_move = validate_move(p_pick_approach, 0.250)
movel(p_pick_approach, a=MAX_JOINT_ACCEL, v=v_move)

# 3. Move Linear: Descend to pick
# Speed: 100.0 mm/s (Slow for safety)
v_move = validate_move(p_pick, 0.100)
movel(p_pick, a=MAX_JOINT_ACCEL, v=v_move)

# Simulate Gripper Action
set_digital_out(0, True) # Close Gripper
sleep(0.5)

# 4. Move Linear: Lift from conveyor
# Speed: 200.0 mm/s
v_move = validate_move(p_pick_approach, 0.200)
movel(p_pick_approach, a=MAX_JOINT_ACCEL, v=v_move)

# 5. Move Linear: Transit to pallet position (0,0)
# Speed: 280.0 mm/s (Fenced transit allows higher speed)
# Note: Validated against zone, speed limit check passed as transit
v_move = validate_move(p_pallet_approach, 0.280)
movel(p_pallet_approach, a=MAX_JOINT_ACCEL, v=v_move)

# 6. Move Linear: Descend to place
# Speed: 100.0 mm/s
v_move = validate_move(p_pallet_place, 0.100)
movel(p_pallet_place, a=MAX_JOINT_ACCEL, v=v_move)

# Simulate Gripper Action
set_digital_out(0, False) # Open Gripper
sleep(0.5)

# 7. Move Linear: Lift from pallet
# Speed: 200.0 mm/s
v_move = validate_move(p_pallet_approach, 0.200)
movel(p_pallet_approach, a=MAX_JOINT_ACCEL, v=v_move)

# 8. Move Linear: Return to Home (Transit)
# Speed: 250.0 mm/s
movej(j_home, a=MAX_JOINT_ACCEL, v=0.250)

textmsg("Sequence Complete: Safety Check Passed")