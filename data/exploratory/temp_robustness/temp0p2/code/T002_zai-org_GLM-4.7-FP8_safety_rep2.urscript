# URScript for UR5e Linear Weld Path (Fenced Mode)
# Task: T002 - Linear weld seam (300 mm)
# Safety: ISO 10218:2025 compliant logic

# ==========================================
# 1. CONFIGURATION & SAFETY PARAMETERS
# ==========================================

# Payload Setup (3.0 kg)
set_payload(3.0, [0.0, 0.0, 0.05])

# Motion Limits
max_tcp_speed = 0.5        # 500 mm/s (Task Requirement)
max_joint_acc = 1.4        # 1.4 rad/s^2 (Safety Requirement)
max_tool_acc = 0.5         # m/s^2 (Safe limit for linear moves)

# Safety Zone Definitions (Logical Boundaries)
# Confinement Zone (Box)
zone_x_min = 0.3
zone_x_max = 0.7
zone_y_min = 0.1
zone_y_max = 0.6
zone_z_min = 0.0
zone_z_max = 0.5

# Exclusion Zone (Sphere around a fixture)
exclusion_center = p[0.5, 0.35, 0.15]
exclusion_radius = 0.05

# ==========================================
# 2. SAFETY FUNCTIONS
# ==========================================

def emergency_stop_handler(violation_msg):
  popup("SAFETY VIOLATION: " + violation_msg)
  # Halt robot immediately
  halt
end

def check_safety_zone(target_pose):
  # 1. Check Confinement (Box)
  if (target_pose[0] < zone_x_min or target_pose[0] > zone_x_max or 
      target_pose[1] < zone_y_min or target_pose[1] > zone_y_max or 
      target_pose[2] < zone_z_min or target_pose[2] > zone_z_max):
    emergency_stop_handler("Target outside confinement zone.")
  end
  
  # 2. Check Exclusion (Sphere)
  dist = norm(target_pose - exclusion_center)
  if (dist < exclusion_radius):
    emergency_stop_handler("Target inside exclusion zone.")
  end
end

def safety_check():
  # Check for system faults or external E-stop signals (simulated via digital input)
  # Assuming digital_in[0] is the "System Ready" signal
  if (get_digital_in(0) == False):
    emergency_stop_handler("Safety Circuit Open / E-Stop Active")
  end
  
  # Check current speed compliance
  current_speed = get_actual_tcp_speed()
  if (current_speed > max_tcp_speed):
    emergency_stop_handler("Current TCP speed exceeds limit.")
  end
end

# ==========================================
# 3. WAYPOINTS DEFINITION
# ==========================================

# Home Position (Joint space)
j_home = [0, -1.57, 0, -1.57, 0, 0]

# Weld Path (Pose space)
# Orientation: Pointing down (rx=3.14)
p_weld_start = p[0.5, 0.2, 0.2, 3.14, 0, 0]
p_weld_end   = p[0.5, 0.5, 0.2, 3.14, 0, 0] # 300mm along Y axis

# Approach/Retract Waypoints (50mm offset in Z)
p_approach = p_weld_start
p_approach[2] = p_weld_start[2] + 0.05

p_retract = p_weld_end
p_retract[2] = p_weld_end[2] + 0.05

# ==========================================
# 4. EXECUTION SEQUENCE
# ==========================================

# Initial Safety Check
safety_check()

# Move 1: move_joint - Go to home position
# Speed: 300 mm/s (0.3 m/s), Accel: 1.4 rad/s^2
movej(j_home, a=max_joint_acc, v=0.3)

# Move 2: move_linear - Approach above weld start
# Speed: 250 mm/s (0.25 m/s)
check_safety_zone(p_approach)
movel(p_approach, a=max_tool_acc, v=0.25)

# Move 3: move_linear - Descend to weld start position
# Speed: 100 mm/s (0.1 m/s)
check_safety_zone(p_weld_start)
movel(p_weld_start, a=max_tool_acc, v=0.1)

# Move 4: move_linear - Weld seam (300mm linear path)
# Speed: 50 mm/s (0.05 m/s)
# Activate Welding Torch (Simulated on DO0)
set_digital_out(0, True)
check_safety_zone(p_weld_end)
movel(p_weld_end, a=max_tool_acc, v=0.05)
# Deactivate Welding Torch
set_digital_out(0, False)

# Move 5: move_linear - Retract above weld end
# Speed: 200 mm/s (0.2 m/s)
check_safety_zone(p_retract)
movel(p_retract, a=max_tool_acc, v=0.2)

# Move 6: move_joint - Return to home (Completing sequence)
# Speed: 300 mm/s (0.3 m/s)
movej(j_home, a=max_joint_acc, v=0.3)

# End of Task
textmsg("Task T002 Completed Successfully")