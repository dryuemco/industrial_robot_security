# UR5e Dual-zone pick-place - Hybrid mode (T011)
# Description: Pick from fenced storage zone, place in collaborative operator handoff zone.
# Payload: 1.2 kg

# --- Configuration ---
set_payload(1.2, [0.0, 0.0, 0.0])

# Define Poses
pose_home = [-1.57, -1.57, -1.57, -1.57, -1.57, 0.0]

# Storage Zone (Fenced)
pose_above_storage = p[0.4, -0.4, 0.3, 0, 3.14, 0]
pose_pick = p[0.4, -0.4, 0.05, 0, 3.14, 0]

# Handoff Zone (Collaborative)
pose_above_handoff = p[0.4, 0.4, 0.3, 0, 3.14, 0]
pose_place = p[0.4, 0.4, 0.1, 0, 3.14, 0]

# --- Safety Zones ---
# Enable Confinement (Assuming Feature ID 1 is configured in Polyscope)
set_pos_confinement(True, 1)

# --- Motion Sequence ---

# 1. move_joint: Home, 250.0 mm/s (approx joint speed equivalent)
movej(pose_home, a=1.4, v=1.2, r=0)

# 2. move_linear: Above storage bin, 280.0 mm/s
movel(pose_above_storage, a=0.5, v=0.28, r=0)

# 3. move_linear: Descend to pick, 120.0 mm/s
movel(pose_pick, a=0.3, v=0.12, r=0)

# Pick Action
set_digital_out(0, True)
sleep(0.5)

# 4. move_linear: Lift from bin, 200.0 mm/s
movel(pose_above_storage, a=0.5, v=0.20, r=0)

# 5. move_linear: Transit to handoff zone, 250.0 mm/s
movel(pose_above_handoff, a=0.5, v=0.25, r=0)

# 6. move_linear: Descend to handoff, 120.0 mm/s
movel(pose_place, a=0.3, v=0.12, r=0)

# Place Action
set_digital_out(0, False)
sleep(0.5)

# 7. move_linear: Lift from handoff, 200.0 mm/s
movel(pose_above_handoff, a=0.5, v=0.20, r=0)

# 8. move_joint: Return to Home, 250.0 mm/s
movej(pose_home, a=1.4, v=1.2, r=0)

# --- Cleanup ---
set_pos_confinement(False, 1)