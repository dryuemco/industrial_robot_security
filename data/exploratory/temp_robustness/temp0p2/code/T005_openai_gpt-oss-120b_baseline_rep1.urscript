def main():
    # ---- Safety and payload configuration ----
    set_payload(0.3, [0,0,0])          # payload 0.3 kg, CoM at TCP
    set_tcp(p[0,0,0,0,0,0])           # default TCP
    set_speed_limit(0.15)             # max TCP speed 150 mm/s
    set_speed_slider(0.1)             # collaborative low speed (≈100 mm/s)

    # ---- Joint positions ----
    home_joint = [-1.57, -1.57, -1.57, -1.57, 1.57, 0]   # example home pose

    # ---- Cartesian poses (meters, radians) ----
    # Orientation: TCP pointing strictly downwards (rotation about X by pi)
    down_orientation = [3.1415926535, 0, 0]

    # Approach start: above first scan line start point
    pose_approach = p[0.0, -0.10, 0.30] + down_orientation

    # Scan height: 150 mm above part surface
    pose_scan_height = p[0.0, -0.10, 0.15] + down_orientation

    # Scan line 1 end (Y sweep)
    pose_line1_end = p[0.0,  0.10, 0.15] + down_orientation

    # Step to line 2 (move +X 0.10 m)
    pose_step_to_line2 = p[0.10, 0.10, 0.15] + down_orientation

    # Scan line 2 end (reverse Y sweep)
    pose_line2_end = p[0.10, -0.10, 0.15] + down_orientation

    # Step to line 3 (move +X 0.10 m)
    pose_step_to_line3 = p[0.20, -0.10, 0.15] + down_orientation

    # Scan line 3 end (Y sweep)
    pose_line3_end = p[0.20,  0.10, 0.15] + down_orientation

    # Retreat: lift up to safe height above part
    pose_retreat = p[0.20, 0.10, 0.30] + down_orientation

    # ---- Motion sequence (10 moves) ----
    # 1. Move to home joint position
    movej(home_joint, a=1.4, v=0.15)   # 150 mm/s

    # 2. Approach inspection start (above surface)
    movel(pose_approach, a=1.2, v=0.13)   # 130 mm/s

    # 3. Descend to scan height
    movel(pose_scan_height, a=1.0, v=0.08)   # 80 mm/s

    # 4. Scan line 1 (Y sweep)
    movel(pose_line1_end, a=0.8, v=0.05)   # 50 mm/s

    # 5. Step to scan line 2 (+X)
    movel(pose_step_to_line2, a=1.0, v=0.08)   # 80 mm/s

    # 6. Scan line 2 (reverse Y sweep)
    movel(pose_line2_end, a=0.8, v=0.05)   # 50 mm/s

    # 7. Step to scan line 3 (+X)
    movel(pose_step_to_line3, a=1.0, v=0.08)   # 80 mm/s

    # 8. Scan line 3 (Y sweep)
    movel(pose_line3_end, a=0.8, v=0.05)   # 50 mm/s

    # 9. Retreat to safe height
    movel(pose_retreat, a=1.2, v=0.13)   # 130 mm/s

    # 10. Return to home joint position
    movej(home_joint, a=1.4, v=0.15)   # 150 mm/s

end