# UR5e EUR-pallet 2x2 layer - Hybrid Mode (T003)
# Payload: 4.5 kg
# Safety: Zone confinement active (A2), Hybrid mode (Fenced transit / Collaborative pick)

# Set Payload (4.5 kg, Center of Mass at TCP)
set_payload(4.5, [0, 0, 0])

# Define Positions
# Home Joint Position
q_home = [-1.57, -1.57, -1.57, -1.57, -1.57, 0]

# Conveyor Pick Positions (x, y, z, rx, ry, rz)
p_conv_approach = p[0.5, -0.5, 0.3, 2.2, -2.2, 0]
p_conv_pick = p[0.5, -0.5, 0.1, 2.2, -2.2, 0]

# Pallet Place Positions (0,0 grid location)
p_pallet_approach = p[0.5, 0.5, 0.3, 3.14, 0, 0]
p_pallet_place = p[0.5, 0.5, 0.1, 3.14, 0, 0]

# Gripper Helper Functions
def gripper_close():
    set_digital_out(0, True)
end

def gripper_open():
    set_digital_out(0, False)
end

# --- Motion Sequence ---

# 1. move_joint: Home position, 250.0 mm/s (approx joint speed)
movej(q_home, a=1.4, v=1.0)

# 2. move_linear: Approach conveyor pick — above, 250.0 mm/s
movel(p_conv_approach, a=0.5, v=0.25)

# 3. move_linear: Descend to pick, 100.0 mm/s
movel(p_conv_pick, a=0.2, v=0.10)

# Action: Close Gripper
gripper_close()
sleep(0.5)

# 4. move_linear: Lift from conveyor, 200.0 mm/s
movel(p_conv_approach, a=0.5, v=0.20)

# 5. move_linear: Transit to pallet position (0,0), 280.0 mm/s
# Note: Entering fenced zone for transit
movel(p_pallet_approach, a=0.5, v=0.28)

# 6. move_linear: Descend to place, 100.0 mm/s
movel(p_pallet_place, a=0.2, v=0.10)

# Action: Open Gripper
gripper_open()
sleep(0.5)

# 7. move_linear: Lift from pallet, 200.0 mm/s
movel(p_pallet_approach, a=0.5, v=0.20)

# 8. move_joint: Return to Home position, 250.0 mm/s
movej(q_home, a=1.4, v=1.0)

# End of Task