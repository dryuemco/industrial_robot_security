# Linear weld path — fenced mode (T002)
  # Payload: 3.0 kg
  # Safety configuration
  set_payload(3.0)

  # Define positions (example values - adjust to actual positions)
  home_pose = p[0.0, -0.5, 0.5, 0, 3.14, 0]
  above_weld_start = p[0.3, -0.2, 0.15, 0, 3.14, 0]
  weld_start = p[0.3, -0.2, 0.05, 0, 3.14, 0]
  weld_end = p[0.6, -0.2, 0.05, 0, 3.14, 0]
  above_weld_end = p[0.6, -0.2, 0.15, 0, 3.14, 0]

  # Motion sequence
  movej(home_pose, a=1.2, v=3.0)
  movel(above_weld_start, a=0.8, v=0.25)
  movel(weld_start, a=0.5, v=0.1)

  # Welding arc activation zone
  set_analog_out(0, 1)  # Activate welding arc
  movel(weld_end, a=0.3, v=0.05)
  set_analog_out(0, 0)  # Deactivate welding arc

  movel(above_weld_end, a=0.8, v=0.2)
  movej(home_pose, a=1.2, v=3.0)