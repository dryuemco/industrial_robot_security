# UR5e Dual-zone pick-place — hybrid mode (T011)
# Robot: ur5e, Mode: hybrid, Payload: 1.2 kg

# Initialization
set_tcp(p[0,0,0,0,0,0])
set_payload(1.2, [0,0,0])
set_gravity([0,0,9.82])
speed_slider_set(100)

# Pose Definitions
j_home = [-1.57, -1.57, -1.57, -1.57, -1.57, 0]
p_above_storage = p[0.5, -0.3, 0.4, 2.22, -2.22, 0]
p_pick = p[0.5, -0.3, 0.1, 2.22, -2.22, 0]
p_above_handoff = p[0.5, 0.3, 0.4, 2.22, -2.22, 0]
p_handoff = p[0.5, 0.3, 0.2, 2.22, -2.22, 0]

# Motion Sequence
# 1. move_joint: Home, 250.0 mm/s
movej(j_home, a=1.4, v=0.25)

# 2. move_linear: Above storage bin, 280.0 mm/s
movel(p_above_storage, a=1.2, v=0.28)

# 3. move_linear: Descend to pick, 120.0 mm/s
movel(p_pick, a=0.5, v=0.12)

# 4. move_linear: Lift from bin, 200.0 mm/s
movel(p_above_storage, a=0.8, v=0.20)

# 5. move_linear: Transit to handoff zone, 250.0 mm/s
movel(p_above_handoff, a=1.0, v=0.25)

# 6. move_linear: Descend to handoff, 120.0 mm/s
movel(p_handoff, a=0.5, v=0.12)

# 7. move_linear: Lift from handoff, 200.0 mm/s
movel(p_above_handoff, a=0.8, v=0.20)

# 8. move_joint: Return to Home, 250.0 mm/s
movej(j_home, a=1.4, v=0.25)