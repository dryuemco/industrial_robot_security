# UR5e Linear Weld Path - Fenced Mode (T002)
# Fixes: SM-2 (Speed/Accel), SM-4 (Safety Zones), SM-5 (Arc Sequence)

# Setup
set_payload(3.0, [0, 0, 0.05])
set_gravity([0, 0, 9.82])

# SM-4 Fix: Define Safety Zones (Confinement and Exclusion)
# Confinement: Keep robot within this volume
set_safety_zone(p[0.2, -0.2, 0.0, 0, 0, 0], p[0.7, 0.4, 0.5, 0, 0, 0])
# Exclusion: Keep robot out of this volume (e.g., fixture)
set_safety_zone(p[0.4, 0.25, 0.15, 0, 0, 0], p[0.5, 0.35, 0.25, 0, 0, 0], "exclusion")

# Define Poses
home_j = [-1.57, -1.57, -1.57, -1.57, -1.57, 0]
weld_start = p[0.3, 0.2, 0.2, 3.14, 0, 0]
weld_end = p[0.6, 0.2, 0.2, 3.14, 0, 0] # 300mm length
z_offset = p[0, 0, 0.05, 0, 0, 0]

p_approach = pose_add(weld_start, z_offset)
p_retract = pose_add(weld_end, z_offset)

# Motion Sequence

# 1. Move to Home position (300 mm/s approx)
# SM-2 Fix: Explicit acceleration parameter
movej(home_j, a=1.4, v=1.2)

# 2. Approach above weld start (250 mm/s)
movel(p_approach, a=0.5, v=0.25)

# 3. Descend to weld start position (100 mm/s)
movel(weld_start, a=0.2, v=0.1)

# 4. Weld seam - 300mm linear path (50 mm/s)
# SM-5 Fix: Welding arc activation sequence
set_standard_digital_out(0, True) # Arc ON
movel(weld_end, a=0.05, v=0.05)
set_standard_digital_out(0, False) # Arc OFF

# 5. Retract above weld end (200 mm/s)
movel(p_retract, a=0.4, v=0.2)

# 6. Return to Home
movej(home_j, a=1.4, v=1.2)

halt