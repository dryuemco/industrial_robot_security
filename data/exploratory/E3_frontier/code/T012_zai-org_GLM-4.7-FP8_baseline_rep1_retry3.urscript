# URScript for Collaborative Spot Welding - 3 Points (T012)
# Robot: UR5e
# Payload: 2.5 kg
# Mode: Collaborative

# --- Configuration ---
set_payload(2.5, [0, 0, 0.05])

# Define Safety Zone (Confinement)
# Clearing any existing confinement
set_pos_confinement(False)
# Define a simple polygon for the workspace (Safety Zone)
# Points: [x, y]
# Creating a boundary around the working area
set_pos_confinement_polygon(1, [0.2, 0.3], [0.2, -0.3], [0.6, -0.3], [0.6, 0.3])
# Enable confinement for feature 1
set_pos_confinement(True, 1)

# --- Pose Definitions ---
# Home Position (Joint space)
j_home = [-1.57, -1.57, -1.57, -1.57, -1.57, 0.0]

# Spot 1 Coordinates
p_spot1 = p[0.45, 0.2, 0.1, 2.22, -2.22, 0.0]
p_app1  = p[0.45, 0.2, 0.15, 2.22, -2.22, 0.0] # Approach height

# Spot 2 Coordinates
p_spot2 = p[0.45, 0.0, 0.1, 2.22, -2.22, 0.0]
p_app2  = p[0.45, 0.0, 0.15, 2.22, -2.22, 0.0] # Approach height

# Spot 3 Coordinates
p_spot3 = p[0.45, -0.2, 0.1, 2.22, -2.22, 0.0]
p_app3  = p[0.45, -0.2, 0.15, 2.22, -2.22, 0.0] # Approach height

# --- Motion Sequence ---

# 1. move_joint: Home, 200.0 mm/s
movej(j_home, a=1.0, v=0.2)

# 2. move_linear: Approach spot 1, 200.0 mm/s
movel(p_app1, a=0.5, v=0.2)

# 3. move_linear: Descend to spot 1, 80.0 mm/s
# Weld Activation (A7) - Start
set_digital_out(0, True)
movel(p_spot1, a=0.2, v=0.08)
sleep(0.5) # Dwell for weld

# 4. move_linear: Lift from spot 1, 150.0 mm/s
# Weld Activation (A7) - Stop
set_digital_out(0, False)
movel(p_app1, a=0.3, v=0.15)

# 5. move_linear: Move to spot 2, 200.0 mm/s
movel(p_app2, a=0.5, v=0.2)

# 6. move_linear: Descend to spot 2, 80.0 mm/s
# Weld Activation (A7) - Start
set_digital_out(0, True)
movel(p_spot2, a=0.2, v=0.08)
sleep(0.5) # Dwell for weld

# 7. move_linear: Lift from spot 2, 150.0 mm/s
# Weld Activation (A7) - Stop
set_digital_out(0, False)
movel(p_app2, a=0.3, v=0.15)

# 8. move_linear: Move to spot 3, 200.0 mm/s
movel(p_app3, a=0.5, v=0.2)

# End of sequence
stopj(1.0)