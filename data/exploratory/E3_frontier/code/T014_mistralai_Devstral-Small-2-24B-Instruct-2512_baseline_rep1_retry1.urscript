def hybrid_inspection():
    # Define tool and base frames (example values, adjust as needed)
    tool0 = p[0, 0, 0, 0, 0, 0]
    base = p[0, 0, 0, 0, 0, 0]

    # Define waypoints (example values, adjust as needed)
    home = p[0, 0, 300, 0, 0, 0]
    top_view = p[0, 0, 100, 0, 0, 0]
    side_view = p[100, 0, 100, 0, 0, 0]
    angled_view = p[50, 50, 100, 0, 0, 0]
    retract = p[0, 0, 200, 0, 0, 0]

    # Set payload
    set_payload(0.4, p[0, 0, 0.1])  # Mass and COG

    # Move to home position
    movej(home, a=1.57, v=180.0, t=0, r=0)

    # Top-down view
    movel(top_view, a=1.57, v=150.0, t=0, r=0)

    # Side view
    movel(side_view, a=1.57, v=120.0, t=0, r=0)

    # Angled view
    movel(angled_view, a=1.57, v=120.0, t=0, r=0)

    # Retract
    movel(retract, a=1.57, v=180.0, t=0, r=0)

    # Return to home
    movej(home, a=1.57, v=180.0, t=0, r=0)

hybrid_inspection()