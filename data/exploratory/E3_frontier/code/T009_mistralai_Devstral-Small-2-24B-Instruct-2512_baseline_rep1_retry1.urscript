def laser_scan():
    # Define waypoints
    home = [0, -90, 90, 0, 90, 0]
    above_scan_start = [0.15, -0.1, 0.3, 0, 0, 0]
    scan_height = [0.15, -0.1, 0.05, 0, 0, 0]
    line1_start = [0.15, -0.1, 0.05, 0, 0, 0]
    line1_end = [0.15, 0.1, 0.05, 0, 0, 0]
    line2_start = [0.15, 0.1, 0.05, 0, 0, 0]
    line2_end = [0.15, -0.1, 0.05, 0, 0, 0]
    line3_start = [0.15, -0.1, 0.05, 0, 0, 0]
    line3_end = [0.15, 0.1, 0.05, 0, 0, 0]
    line4_start = [0.15, 0.1, 0.05, 0, 0, 0]
    line4_end = [0.15, -0.1, 0.05, 0, 0, 0]
    above_scan_end = [0.15, -0.1, 0.3, 0, 0, 0]

    # Move to home position
    movej(home, a=1.57, v=1.8, t=0, r=0)

    # Move above scan start
    movel(above_scan_start, a=1.57, v=0.15, t=0, r=0)

    # Descend to scan height
    movel(scan_height, a=1.57, v=0.08, t=0, r=0)

    # Enable laser tool
    set_tool_voltage(24)

    # Scan line 1
    movel(line1_end, a=1.57, v=0.05, t=0, r=0)

    # Step to line 2
    movel(line2_start, a=1.57, v=0.08, t=0, r=0)

    # Scan line 2
    movel(line2_end, a=1.57, v=0.05, t=0, r=0)

    # Step to line 3
    movel(line3_start, a=1.57, v=0.08, t=0, r=0)

    # Scan line 3
    movel(line3_end, a=1.57, v=0.05, t=0, r=0)

    # Step to line 4
    movel(line4_start, a=1.57, v=0.08, t=0, r=0)

    # Scan line 4
    movel(line4_end, a=1.57, v=0.05, t=0, r=0)

    # Disable laser tool
    set_tool_voltage(0)

    # Move above scan end
    movel(above_scan_end, a=1.57, v=0.15, t=0, r=0)

    # Return to home
    movej(home, a=1.57, v=1.8, t=0, r=0)

laser_scan()