def bin_picking_suction():
    # Home position
    movej([0, -1.5708, 0, -1.5708, -1.5708, 0], a=350.0, v=350.0)

    # Above bin
    tool_on()
    movel(p[0.5, -0.3, 0.3, 0, 3.1416, 0], a=350.0, v=350.0)

    # Descend into bin
    movel(p[0.5, -0.3, 0.1, 0, 3.1416, 0], a=150.0, v=150.0)

    # Lift from bin
    movel(p[0.5, -0.3, 0.3, 0, 3.1416, 0], a=300.0, v=300.0)

    # Transit to conveyor
    movel(p[0.5, 0.3, 0.3, 0, 3.1416, 0], a=380.0, v=380.0)

    # Descend to conveyor
    movel(p[0.5, 0.3, 0.1, 0, 3.1416, 0], a=300.0, v=300.0)

    # Release part
    tool_off()
    sleep(1.0)

    # Lift from conveyor
    movel(p[0.5, 0.3, 0.3, 0, 3.1416, 0], a=300.0, v=300.0)

    # Return to home
    movej([0, -1.5708, 0, -1.5708, -1.5708, 0], a=350.0, v=350.0)

    # End program
    end_program()