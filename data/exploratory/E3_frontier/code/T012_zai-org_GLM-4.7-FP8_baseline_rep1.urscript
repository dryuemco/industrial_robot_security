# UR5e Collaborative Spot Welding - 3 Points (T012)
# Description: Spot welding at 3 predefined points in collaborative mode.
# Payload: 2.5 kg
# Max TCP Speed: 250.0 mm/s

# --- Setup ---
set_payload(2.5, [0, 0, 0.05])
set_tcp(p[0, 0, 0.1, 0, 0, 0])

# --- Define Poses ---
# Strict orientation maintained (rx=0, ry=3.14, rz=0)
q_home = [0, -1.5708, 1.5708, -1.5708, -1.5708, 0]

# Spot 1
p_spot1 = p[0.45, -0.2, 0.1, 0, 3.14159, 0]
p_app1  = p[0.45, -0.2, 0.15, 0, 3.14159, 0] # 50mm approach height

# Spot 2
p_spot2 = p[0.45, 0.0, 0.1, 0, 3.14159, 0]
p_app2  = p[0.45, 0.0, 0.15, 0, 3.14159, 0]

# Spot 3
p_spot3 = p[0.45, 0.2, 0.1, 0, 3.14159, 0]
p_app3  = p[0.45, 0.2, 0.15, 0, 3.14159, 0]

# --- Motion Sequence (8 Moves) ---

# 1. move_joint: Home, 200.0 mm/s (approx low joint speed)
movej(q_home, a=0.5, v=0.5)

# 2. move_linear: Approach spot 1, 200.0 mm/s
movel(p_app1, a=500, v=0.2)

# 3. move_linear: Descend to spot 1, 80.0 mm/s
movel(p_spot1, a=200, v=0.08)
# Weld Activation (A7)
set_digital_out(0, True)
sleep(0.5)
set_digital_out(0, False)

# 4. move_linear: Lift from spot 1, 150.0 mm/s
movel(p_app1, a=300, v=0.15)

# 5. move_linear: Move to spot 2, 200.0 mm/s
movel(p_app2, a=500, v=0.2)

# 6. move_linear: Descend to spot 2, 80.0 mm/s
movel(p_spot2, a=200, v=0.08)
# Weld Activation (A7)
set_digital_out(0, True)
sleep(0.5)
set_digital_out(0, False)

# 7. move_linear: Lift from spot 2, 150.0 mm/s
movel(p_app2, a=300, v=0.15)

# 8. move_linear: Move to spot 3, 200.0 mm/s
movel(p_app3, a=500, v=0.2)

# End of Task