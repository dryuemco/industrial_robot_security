def palletizing_routine():
    # Set payload and tool center point
    set_payload(0.8)
    set_tcp(p[0, 0, 0.1, 0, 0, 0])

    # Safety configuration
    conf = {
        "joint_speed": 1.0,
        "joint_acceleration": 1.2,
        "tcp_speed": 0.25,
        "tcp_acceleration": 0.5
    }

    # Waypoints (example coordinates - adjust to your setup)
    home_pose = p[0.0, -0.5, 0.5, 0, 3.14, 0]
    above_staging = p[0.3, -0.2, 0.3, 0, 3.14, 0]
    pick_pose = p[0.3, -0.2, 0.15, 0, 3.14, 0]
    lift_pose = p[0.3, -0.2, 0.3, 0, 3.14, 0]
    transit_pose = p[0.6, -0.2, 0.3, 0, 3.14, 0]
    above_pallet = p[0.6, -0.5, 0.3, 0, 3.14, 0]
    place_pose = p[0.6, -0.5, 0.15, 0, 3.14, 0]
    return_pose = p[0.6, -0.5, 0.3, 0, 3.14, 0]

    # Main routine
    while True:
        # Move to home position
        movej(home_pose, a=conf["joint_acceleration"], v=conf["joint_speed"])

        # Wait for box to be staged
        textmsg("Waiting for box...")
        wait(0.5)

        # Move above staging area
        movel(above_staging, a=conf["tcp_acceleration"], v=0.22)

        # Descend to pick position
        movel(pick_pose, a=conf["tcp_acceleration"], v=0.1)

        # Activate suction
        set_digital_out(0, True)
        sleep(0.5)

        # Lift box
        movel(lift_pose, a=conf["tcp_acceleration"], v=0.18)

        # Transit to pallet area
        movel(transit_pose, a=conf["tcp_acceleration"], v=0.23)

        # Move above pallet
        movel(above_pallet, a=conf["tcp_acceleration"], v=0.2)

        # Descend to place position
        movel(place_pose, a=conf["tcp_acceleration"], v=0.1)

        # Release suction
        set_digital_out(0, False)
        sleep(0.5)

        # Return to above pallet position
        movel(return_pose, a=conf["tcp_acceleration"], v=0.18)

        # Check for emergency stop or program stop
        if get_standard_digital_in(8):
            break
        end
    end
end

# Start the program
palletizing_routine()