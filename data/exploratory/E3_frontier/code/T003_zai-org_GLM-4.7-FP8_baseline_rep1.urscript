# UR5e EUR-pallet 2x2 layer — hybrid mode (T003)
# Payload: 4.5 kg
# Task: Pick from conveyor, place in 2x2 grid (Path simulation)

# Set Payload
set_payload(4.5, [0.0, 0.0, 0.0])

# Define Poses
# Home position (Joint space)
q_home = [-1.57, -1.7, -2.0, -0.8, 1.57, 0.0]

# Conveyor Pick Poses
p_conv_approach = p[0.5, -0.5, 0.3, 3.14, 0.0, 0.0]
p_conv_pick = p[0.5, -0.5, 0.1, 3.14, 0.0, 0.0]

# Pallet 2x2 Grid Poses (EUR-pallet coordinates approx)
p_pallet_00 = p[0.5, 0.3, 0.15, 0.0, 0.0, 0.0]  # Position (0,0)
p_pallet_01 = p[0.65, 0.3, 0.15, 0.0, 0.0, 0.0] # Position (0,1)
p_pallet_10 = p[0.5, 0.45, 0.15, 0.0, 0.0, 0.0] # Position (1,0)
p_pallet_11 = p[0.65, 0.45, 0.15, 0.0, 0.0, 0.0] # Position (1,1)

# Safety Zone Definition (A2: Zone confinement with pallet boundary)
# Define a polygon around the pallet area
pallet_boundary = [[0.45, 0.25], [0.70, 0.25], [0.70, 0.50], [0.45, 0.50]]
set_pos_confinement_check(1, pallet_boundary, 0)

# Motion Sequence
# 1. move_joint: Home position, 250.0 mm/s (approx 1.0 rad/s for joints)
movej(q_home, a=1.0, v=1.0, r=0)

# 2. move_linear: Approach conveyor pick — above, 250.0 mm/s
movel(p_conv_approach, a=0.5, v=0.25, r=0)

# 3. move_linear: Descend to pick, 100.0 mm/s
movel(p_conv_pick, a=0.5, v=0.10, r=0)

# Simulate Gripper Close
set_digital_out(0, True)

# 4. move_linear: Lift from conveyor, 200.0 mm/s
movel(p_conv_approach, a=0.5, v=0.20, r=0)

# 5. move_linear: Transit to pallet position (0,0), 280.0 mm/s
movel(p_pallet_00, a=0.5, v=0.28, r=0)

# 6. move_linear: Transit to pallet position (0,1), 280.0 mm/s
movel(p_pallet_01, a=0.5, v=0.28, r=0)

# 7. move_linear: Transit to pallet position (1,0), 280.0 mm/s
movel(p_pallet_10, a=0.5, v=0.28, r=0)

# 8. move_linear: Transit to pallet position (1,1), 280.0 mm/s
movel(p_pallet_11, a=0.5, v=0.28, r=0)

# End of task