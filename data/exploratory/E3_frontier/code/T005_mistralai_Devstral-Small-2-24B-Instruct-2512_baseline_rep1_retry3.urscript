def visual_inspection_scan():
    # Home position
    movej([0, -1.5708, 0, -1.5708, 0, 0], a=1.57, v=0.15, t=0, r=0)

    # Approach inspection start — above surface
    tool_point = [0, 0, 0.2, 0, 0, 0]
    movej([0, -1.5708, 0, -1.5708, 0, 0], a=1.3, v=0.13, t=0, r=0)
    movel(p[0.2, -0.2, 0.2, 0, 0, 0], a=1.3, v=0.13, t=0, r=0)

    # Descend to scan height (150 mm above part)
    movel(p[0.2, -0.2, 0.15, 0, 0, 0], a=0.8, v=0.08, t=0, r=0)

    # Scan line 1 — Y sweep
    movel(p[0.2, 0.2, 0.15, 0, 0, 0], a=0.5, v=0.05, t=0, r=0)

    # Step to scan line 2 (+X)
    movel(p[0.25, 0.2, 0.15, 0, 0, 0], a=0.8, v=0.08, t=0, r=0)

    # Scan line 2 — Y sweep
    movel(p[0.25, -0.2, 0.15, 0, 0, 0], a=0.5, v=0.05, t=0, r=0)

    # Step to scan line 3 (+X)
    movel(p[0.3, -0.2, 0.15, 0, 0, 0], a=0.8, v=0.08, t=0, r=0)

    # Scan line 3 — Y sweep
    movel(p[0.3, 0.2, 0.15, 0, 0, 0], a=0.5, v=0.05, t=0, r=0)

    # Ascend from scan height
    movel(p[0.3, 0.2, 0.2, 0, 0, 0], a=0.8, v=0.08, t=0, r=0)

    # Return to home position
    movej([0, -1.5708, 0, -1.5708, 0, 0], a=1.57, v=0.15, t=0, r=0)

visual_inspection_scan()