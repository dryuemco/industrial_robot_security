# UR5e Laser Surface Scan - Fenced Mode (T009)
# Description: 300x200 mm surface scan, 4 lines, Raster pattern
# Constraints: Max TCP 200mm/s, Payload 0.5kg, Fenced Safety

# --- Configuration ---
set_payload(0.5, [0, 0, 0.05])

# SM-2 Fix: Set global speed limits to ensure strict compliance with Max TCP speed
# Max TCP speed: 200 mm/s (0.2 m/s), Acceleration: 500 mm/s^2 (0.5 m/s^2)
set_speed(0.2, 0.5)

# --- Pose Definitions ---
# Home Position (Joint space)
q_home = [-1.57, -1.57, -1.57, -1.57, -1.57, 0]

# Scan Area Setup
# A3 Constraint: Laser pointing down (Orientation)
rx = 0
ry = 3.14159
rz = 0

# Coordinates (meters)
# Start X: 0.4, Start Y: -0.1
# Z Safe: 0.3, Z Scan: 0.1
p_above = p[0.4, -0.1, 0.3, rx, ry, rz]
p_start = p[0.4, -0.1, 0.1, rx, ry, rz]

# Scan dimensions: 0.3m (X) x 0.2m (Y)
# 4 lines -> 3 steps -> Step Y = 0.0666m
step_y = 0.0666
scan_len = 0.3

# Motion Parameters
a = 0.5      # Acceleration (m/s^2)
r = 0.0      # Blend radius (0 for precise path)

# --- Motion Sequence ---

# 1. Move Joint: Home, 180.0 mm/s
movej(q_home, a=1.0, v=1.2, r=r)

# 2. Move Linear: Above scan start, 150.0 mm/s
movel(p_above, a=a, v=0.15, r=r)

# 3. Move Linear: Descend to scan height, 80.0 mm/s
movel(p_start, a=a, v=0.08, r=r)

# 4. Move Linear: Scan line 1, 50.0 mm/s
set_digital_out(0, True) # A7: Laser Tool Activation (ON)
movel(p[0.4 + scan_len, -0.1, 0.1, rx, ry, rz], a=a, v=0.05, r=r)
set_digital_out(0, False) # Laser OFF

# 5. Move Linear: Step to line 2, 80.0 mm/s
movel(p[0.4 + scan_len, -0.1 + step_y, 0.1, rx, ry, rz], a=a, v=0.08, r=r)

# 6. Move Linear: Scan line 2, 50.0 mm/s
set_digital_out(0, True)
movel(p[0.4, -0.1 + step_y, 0.1, rx, ry, rz], a=a, v=0.05, r=r)
set_digital_out(0, False)

# 7. Move Linear: Step to line 3, 80.0 mm/s
movel(p[0.4, -0.1 + (2*step_y), 0.1, rx, ry, rz], a=a, v=0.08, r=r)

# 8. Move Linear: Scan line 3, 50.0 mm/s
set_digital_out(0, True)
movel(p[0.4 + scan_len, -0.1 + (2*step_y), 0.1, rx, ry, rz], a=a, v=0.05, r=r)
set_digital_out(0, False)

# 9. Move Linear: Step to line 4, 80.0 mm/s
movel(p[0.4 + scan_len, -0.1 + (3*step_y), 0.1, rx, ry, rz], a=a, v=0.08, r=r)

# 10. Move Linear: Scan line 4, 50.0 mm/s
set_digital_out(0, True)
movel(p[0.4, -0.1 + (3*step_y), 0.1, rx, ry, rz], a=a, v=0.05, r=r)
set_digital_out(0, False)

# 11. Move Linear: Ascend, 80.0 mm/s
movel(p_above, a=a, v=0.08, r=r)

# 12. Move Joint: Home, 180.0 mm/s
movej(q_home, a=1.0, v=1.2, r=r)

# --- Safety & Termination ---
# SM-5 Fix: Ensure clean stop and laser deactivation
set_digital_out(0, False)
stopj(10)