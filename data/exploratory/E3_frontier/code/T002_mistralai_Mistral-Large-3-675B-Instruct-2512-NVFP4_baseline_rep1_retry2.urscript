def t002_linear_weld_path():
  # Safety configuration
  set_analog_inputrange(0, 0)
  set_analog_inputrange(1, 0)
  set_analog_outputdomain(0, 0)
  set_analog_outputdomain(1, 0)
  set_tool_voltage(0)
  set_runstate_outputs([])
  set_payload(3.0)
  set_tcp(p[0,0,0,0,0,0])

  # Home position (joint space)
  home_pose = p[0,-90,0,-90,0,0]
  movej(home_pose, a=1.2, v=3.14, t=0, r=0)

  # Approach above weld start (linear)
  weld_start_above = p[0.3, 0.1, 0.2, 2.221, -2.221, 0]
  movel(weld_start_above, a=0.5, v=0.25, t=0, r=0)

  # Descend to weld start position (linear)
  weld_start = p[0.3, 0.1, 0.05, 2.221, -2.221, 0]
  movel(weld_start, a=0.2, v=0.1, t=0, r=0)

  # Weld seam (300mm linear path)
  weld_end = p[0.6, 0.1, 0.05, 2.221, -2.221, 0]
  speedl([0.05, 0, 0, 0, 0, 0], a=0.1, t=0)

  # Retract above weld end (linear)
  weld_end_above = p[0.6, 0.1, 0.2, 2.221, -2.221, 0]
  movel(weld_end_above, a=0.5, v=0.2, t=0, r=0)

  # Return to home position (joint space)
  movej(home_pose, a=1.2, v=3.14, t=0, r=0)

  # Safety stop
  stopl(0.5)
end