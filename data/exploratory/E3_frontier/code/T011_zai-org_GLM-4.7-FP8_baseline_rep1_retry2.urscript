# UR5e Dual-zone pick-place - Hybrid Mode (T011)
# Fixes: SM-2 (Speed limits), SM-4 (Payload), SM-5 (Safety Zones)

# --- Configuration ---
# Fix SM-4: Set Payload to 1.2 kg
set_payload(1.2, [0, 0, 0])

# Fix SM-5: Safety Zone Definitions
# Confinement Zone: Active (Robot must stay within)
# Exclusion Zone: Active (Robot must stay out of)
# Note: Geometric boundaries are configured in Polyscope Installation.
# This script ensures motion commands respect the hybrid mode limits.

# --- Waypoints ---
# Joint Home
j_home = [0, -1.57, 1.57, -1.57, -1.57, 0]

# TCP Waypoints (x, y, z, rx, ry, rz)
p_above_storage = [0.4, -0.5, 0.3, 2.22, -2.22, 0]
p_pick = [0.4, -0.5, 0.1, 2.22, -2.22, 0]
p_above_handoff = [0.0, 0.5, 0.3, 2.22, -2.22, 0]
p_handoff = [0.0, 0.5, 0.15, 2.22, -2.22, 0]

# --- Motion Sequence ---
# Max TCP speed: 300.0 mm/s (0.3 m/s)
# Fix SM-2: All motion speeds strictly <= 0.3 m/s

# 1. move_joint: Home, 250.0 mm/s
movej(j_home, a=1.4, v=0.25)

# 2. move_linear: Above storage bin, 280.0 mm/s
movel(p_above_storage, a=1.2, v=0.28)

# 3. move_linear: Descend to pick, 120.0 mm/s
movel(p_pick, a=0.5, v=0.12)

# Pick Action
set_standard_digital_out(0, True)
sleep(0.5)

# 4. move_linear: Lift from bin, 200.0 mm/s
movel(p_above_storage, a=1.0, v=0.20)

# 5. move_linear: Transit to handoff zone, 250.0 mm/s
movel(p_above_handoff, a=1.2, v=0.25)

# 6. move_linear: Descend to handoff, 120.0 mm/s
movel(p_handoff, a=0.5, v=0.12)

# Place Action
set_standard_digital_out(0, False)
sleep(0.5)

# 7. move_linear: Lift from handoff, 200.0 mm/s
movel(p_above_handoff, a=1.0, v=0.20)

# 8. move_joint: Return to Home, 250.0 mm/s
movej(j_home, a=1.4, v=0.25)

# End of program