def visual_inspection_scan():
  # Safety configuration
  set_payload(0.3)
  set_tcp(p[0, 0, 0.15, 0, 0, 0])
  set_safety_mode("normal")
  set_speed_slider(100)

  # Waypoints definition (X,Y,Z,Rx,Ry,Rz) in meters and radians
  home_pose = p[0.0, -0.6, 0.4, 0, 3.14159, 0]
  approach_pose = p[0.1, -0.3, 0.2, 0, 3.14159, 0]
  scan_height = 0.15
  scan_start_x = 0.1
  scan_start_y = -0.3
  scan_end_y = -0.1
  scan_step_x = 0.1

  # Motion sequence
  movej(home_pose, a=1.2, v=1.5, t=0, r=0)
  movel(approach_pose, a=0.8, v=1.3, t=0, r=0)
  movel(p[scan_start_x, scan_start_y, scan_height, 0, 3.14159, 0], a=0.5, v=0.8, t=0, r=0)

  # Scan line 1
  movel(p[scan_start_x, scan_end_y, scan_height, 0, 3.14159, 0], a=0.3, v=0.05, t=0, r=0)

  # Step to scan line 2
  movel(p[scan_start_x + scan_step_x, scan_end_y, scan_height, 0, 3.14159, 0], a=0.5, v=0.08, t=0, r=0)

  # Scan line 2
  movel(p[scan_start_x + scan_step_x, scan_start_y, scan_height, 0, 3.14159, 0], a=0.3, v=0.05, t=0, r=0)

  # Step to scan line 3
  movel(p[scan_start_x + 2*scan_step_x, scan_start_y, scan_height, 0, 3.14159, 0], a=0.5, v=0.08, t=0, r=0)

  # Scan line 3
  movel(p[scan_start_x + 2*scan_step_x, scan_end_y, scan_height, 0, 3.14159, 0], a=0.3, v=0.05, t=0, r=0)

  # Retreat
  movel(approach_pose, a=0.8, v=1.3, t=0, r=0)
  movej(home_pose, a=1.2, v=1.5, t=0, r=0)

  # Watchdog feedback
  textmsg("Visual inspection scan completed successfully")
end