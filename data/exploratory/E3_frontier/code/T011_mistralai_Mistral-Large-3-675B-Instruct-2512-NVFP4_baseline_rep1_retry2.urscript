# Dual-zone pick-place in hybrid mode (T011)
# Payload: 1.2 kg
# Safety zones: confinement and exclusion

# Safety configuration
set_analog_inputrange(0, 0)
set_analog_inputrange(1, 0)
set_analog_outputdomain(0, 0)
set_analog_outputdomain(1, 0)
set_tool_voltage(0)
set_runstate_outputs([])
set_payload(1.2)
set_tcp(p[0,0,0,0,0,0])

# Safety plane configuration (confinement)
confined_zone = p[0,0,0.1,0,0,0]
safety PlaneConfined(1, confined_zone, [1,0,0,0])

# Safety plane configuration (exclusion)
exclusion_zone = p[0,0,-0.1,0,0,0]
safety PlaneExclusion(2, exclusion_zone, [1,0,0,0])

# Speed limits
hybrid_mode_speed = 300.0
collaborative_mode_speed = 250.0

# Waypoints
home_pose = p[0,-0.5,0.3,0,3.14,0]
above_bin_pose = p[0.3,-0.4,0.15,0,3.14,0]
pick_pose = p[0.3,-0.4,0.05,0,3.14,0]
lift_pose = p[0.3,-0.4,0.15,0,3.14,0]
above_handoff_pose = p[0.5,-0.2,0.2,0,3.14,0]
handoff_pose = p[0.5,-0.2,0.1,0,3.14,0]
lift_handoff_pose = p[0.5,-0.2,0.2,0,3.14,0]
return_pose = p[0.4,-0.3,0.25,0,3.14,0]

# Main program
def main():
    # Enable hybrid mode
    enter_hybrid_mode()

    # Move 1: Home (joint move)
    speed_j = 1.05
    movej(home_pose, a=1.2, v=speed_j, r=0)

    # Move 2: Above storage bin (linear move)
    speed_l = 0.28
    movel(above_bin_pose, a=1.2, v=speed_l, r=0)

    # Move 3: Descend to pick (linear move)
    speed_l = 0.12
    movel(pick_pose, a=0.5, v=speed_l, r=0)

    # Gripper close (simulated)
    set_digital_out(0, True)
    sleep(0.5)

    # Move 4: Lift from bin (linear move)
    speed_l = 0.2
    movel(lift_pose, a=1.2, v=speed_l, r=0)

    # Transition to collaborative mode
    exit_hybrid_mode()

    # Move 5: Transit to handoff zone (linear move)
    speed_l = 0.25
    movel(above_handoff_pose, a=1.2, v=speed_l, r=0)

    # Move 6: Descend to handoff (linear move)
    speed_l = 0.1
    movel(handoff_pose, a=0.5, v=speed_l, r=0)

    # Gripper open (simulated)
    set_digital_out(0, False)
    sleep(0.5)

    # Move 7: Lift from handoff (linear move)
    speed_l = 0.2
    movel(lift_handoff_pose, a=1.2, v=speed_l, r=0)

    # Move 8: Return to safe position (linear move)
    speed_l = 0.25
    movel(return_pose, a=1.2, v=speed_l, r=0)

    # Re-enter hybrid mode
    enter_hybrid_mode()

end

# Safety watchdog
thread watchdog_thread():
    while True:
        watchdog_feed()
        sleep(0.1)
    end
end

# Start watchdog thread
thread_id = run watchdog_thread()

# Run main program
main()

# Stop watchdog thread
kill thread_id