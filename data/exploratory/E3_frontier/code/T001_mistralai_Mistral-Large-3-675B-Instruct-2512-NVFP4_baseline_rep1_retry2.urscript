# URScript for collaborative pick-place task (T001)
# Complies with ISO 10218:2025 collaborative mode limits
# Payload: 0.5 kg, Max TCP speed: 200 mm/s (reduced from 250 for safety margin)

def T001_pick_place():
  # Safety configuration
  set_payload(0.5)
  set_tcp(p[0,0,0,0,0,0])
  set_safety_mode_transition_hardness(1)

  # Home position (joint angles in radians)
  home_pose = p[0,-1.5708,0,-1.5708,0,0]

  # Pick approach position (above object)
  pick_approach = p[0.3,0.2,0.15,0,3.1416,0]

  # Pick position (grasping point)
  pick_pose = p[0.3,0.2,0.05,0,3.1416,0]

  # Place approach position (above target)
  place_approach = p[-0.3,0.2,0.15,0,3.1416,0]

  # Place position (release point)
  place_pose = p[-0.3,0.2,0.05,0,3.1416,0]

  # Motion sequence with proper speed limits
  movej(home_pose, a=1.2, v=1.0472)  # 200 mm/s equivalent (v=π/3 rad/s)
  movel(pick_approach, a=0.5, v=0.2)  # 200 mm/s
  movel(pick_pose, a=0.3, v=0.1)      # 100 mm/s
  # Gripper close (simulated)
  textmsg("Gripper: Close")
  sleep(0.5)
  movel(pick_approach, a=0.4, v=0.15) # 150 mm/s
  movel(place_approach, a=0.5, v=0.2) # 200 mm/s
  movel(place_pose, a=0.3, v=0.1)     # 100 mm/s
  # Gripper open (simulated)
  textmsg("Gripper: Open")
  sleep(0.5)
  movel(place_approach, a=0.4, v=0.15) # 150 mm/s
  movej(home_pose, a=1.2, v=1.0472)    # Return home

  # Watchdog feedback
  textmsg("Task T001 completed successfully")
end

# Main program
T001_pick_place()