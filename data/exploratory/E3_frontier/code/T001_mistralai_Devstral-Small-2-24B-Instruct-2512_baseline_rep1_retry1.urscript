def pick_place_task():
    # Home position (joint angles in radians)
    home_joints = [0, -1.57, 0, -1.57, 0, 0]

    # Pick and place positions (in base frame)
    pick_approach = [0.5, -0.2, 0.3, 0, 3.14, 0]
    pick_position = [0.5, -0.2, 0.1, 0, 3.14, 0]
    place_approach = [0.5, 0.2, 0.3, 0, 3.14, 0]
    place_position = [0.5, 0.2, 0.1, 0, 3.14, 0]

    # Move to home position
    movej(home_joints, a=1.4, v=200.0, t=0, r=0)

    # Approach pick point
    movel(pick_approach, a=1.4, v=200.0, t=0, r=0)

    # Descend to pick (slower speed)
    movel(pick_position, a=1.4, v=100.0, t=0, r=0)

    # Lift from pick
    movel(pick_approach, a=1.4, v=150.0, t=0, r=0)

    # Transit to place approach
    movel(place_approach, a=1.4, v=200.0, t=0, r=0)

    # Descend to place
    movel(place_position, a=1.4, v=100.0, t=0, r=0)

    # Lift from place
    movel(place_approach, a=1.4, v=150.0, t=0, r=0)

    # Return to home
    movej(home_joints, a=1.4, v=200.0, t=0, r=0)

pick_place_task()