# URScript for UR5e heavy depalletizing in fenced mode
# Payload: 5.0 kg (max for UR5e)
# Max TCP speed: 0.45 m/s (450 mm/s)

# -------------------------------------------------
# Configuration
# -------------------------------------------------
set_payload(5.0, 0.0)          # payload mass (kg), center of mass (ignored here)
set_tcp([0,0,0,0,0,0])        # default TCP, adjust if needed
set_fence_mode(True)          # enable fenced mode (confinement safety zone)

# -------------------------------------------------
# Define target poses (position [x,y,z] in meters, orientation as quaternion [qx,qy,qz,qw])
# Replace these placeholder values with the actual calibrated positions.
# -------------------------------------------------
pose_home          = p[0.0, -0.5, 0.5, 0, 3.14159, 0]   # Home position
pose_above_pallet  = p[0.3, -0.4, 0.6, 0, 3.14159, 0]   # Above pallet, safe height
pose_top_layer     = p[0.3, -0.4, 0.2, 0, 3.14159, 0]   # Descend to top layer of boxes
pose_lift_box      = p[0.3, -0.4, 0.4, 0, 3.14159, 0]   # Lift box after grasp
pose_conveyor      = p[0.6, -0.2, 0.4, 0, 3.14159, 0]   # Position above conveyor
pose_place_box     = p[0.6, -0.2, 0.2, 0, 3.14159, 0]   # Place box on conveyor
pose_retreat       = p[0.6, -0.2, 0.5, 0, 3.14159, 0]   # Retreat after placing
pose_safe_home     = p[0.0, -0.5, 0.5, 0, 3.14159, 0]   # Return to safe home

# -------------------------------------------------
# Motion parameters
# -------------------------------------------------
joint_speed      = 1.0      # rad/s, safe joint speed for movej
joint_acceleration = 1.2    # rad/s^2
tcp_speed_fast   = 0.4      # m/s (400 mm/s)
tcp_speed_slow   = 0.15     # m/s (150 mm/s)
tcp_speed_medium = 0.2      # m/s (200 mm/s)
tcp_speed_transit= 0.35     # m/s (350 mm/s)
tcp_acceleration = 1.2      # m/s^2

# -------------------------------------------------
# Main program
# -------------------------------------------------
def main():
    # 1. Move to Home joint configuration
    movej(pose_home, a=joint_acceleration, v=joint_speed)

    # 2. Move linearly above the pallet
    movel(pose_above_pallet, a=tcp_acceleration, v=tcp_speed_fast)

    # 3. Descend to the top layer of boxes (slow approach)
    movel(pose_top_layer, a=tcp_acceleration, v=tcp_speed_slow)

    # 4. Lift the box (medium speed)
    movel(pose_lift_box, a=tcp_acceleration, v=tcp_speed_medium)

    # 5. Transit to the conveyor (fast)
    movel(pose_conveyor, a=tcp_acceleration, v=tcp_speed_transit)

    # 6. Lower box onto conveyor (slow)
    movel(pose_place_box, a=tcp_acceleration, v=tcp_speed_slow)

    # 7. Retreat to safe height above conveyor (fast)
    movel(pose_retreat, a=tcp_acceleration, v=tcp_speed_fast)

    # 8. Return to Home position
    movej(pose_safe_home, a=joint_acceleration, v=joint_speed)

    # End of program
    stopj(0)   # ensure robot stops

# -------------------------------------------------
# Execute
# -------------------------------------------------
main()