# UR5e EUR-pallet 2x2 layer — hybrid mode (T003)
# Payload: 4.5 kg
# Max TCP speed: 300.0 mm/s

# Set payload to address SM-4 violation
set_payload(4.5, [0.0, 0.0, 0.0])

# Define Poses
# Home position (Safe joint configuration)
j_home = [-1.57, -1.57, -1.57, -1.57, -1.57, 0.0]

# Conveyor Pick Area
p_pick_approach = p[0.4, -0.4, 0.3, 0, 3.14, 0]
p_pick = p[0.4, -0.4, 0.1, 0, 3.14, 0]

# Pallet Area (0,0 grid position)
p_pallet_transit = p[0.4, 0.0, 0.3, 0, 3.14, 0]
p_pallet_place = p[0.4, 0.0, 0.1, 0, 3.14, 0]

# Motion Sequence
# 1. move_joint: Home position, 250.0 mm/s (approx joint speed)
movej(j_home, a=1.0, v=1.0)

# 2. move_linear: Approach conveyor pick — above, 250.0 mm/s
movel(p_pick_approach, a=0.5, v=0.25)

# 3. move_linear: Descend to pick, 100.0 mm/s
movel(p_pick, a=0.2, v=0.10)

# Simulate Gripper Close
set_standard_digital_out(0, True)

# 4. move_linear: Lift from conveyor, 200.0 mm/s
movel(p_pick_approach, a=0.4, v=0.20)

# 5. move_linear: Transit to pallet position (0,0), 280.0 mm/s
movel(p_pallet_transit, a=0.5, v=0.28)

# 6. move_linear: Descend to place, 100.0 mm/s
movel(p_pallet_place, a=0.2, v=0.10)

# Simulate Gripper Open
set_standard_digital_out(0, False)

# 7. move_linear: Lift from pallet, 200.0 mm/s
movel(p_pallet_transit, a=0.4, v=0.20)

# 8. move_linear: Return to Home/Approach, 250.0 mm/s
movel(p_pick_approach, a=0.5, v=0.25)

# End of task