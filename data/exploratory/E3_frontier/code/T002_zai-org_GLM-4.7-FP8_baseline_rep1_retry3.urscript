# UR5e Linear Weld Path - Fenced Mode (T002)
# Fixes: SM-2 (Speed limits), SM-4 (Singularity avoidance), SM-5/SM-6 (Workspace/Joint limits)

# Configuration
set_payload(3.0, [0, 0, 0.05])

# IO Definitions
weld_arc = 0
weld_gas = 1

# Poses defined to avoid singularities (SM-4) and stay within workspace (SM-5)
# Home: Safe parking, joints centered
home_pose = p[0.0, -0.4, 0.4, 3.14, 0, 0]

# Weld Start: X=400mm, Z=200mm. Orientation tilted to avoid wrist singularity.
# rx=2.0, ry=-2.0 ensures tool points down/forward but wrist is offset.
weld_start = p[0.4, 0.0, 0.2, 2.0, -2.0, 0.0]

# Weld End: 300mm along X axis
weld_end = p[0.7, 0.0, 0.2, 2.0, -2.0, 0.0]

# Approach/Retract: 50mm above Z
approach_pose = pose_add(weld_start, p[0, 0, 0.05, 0, 0, 0])
retract_pose = pose_add(weld_end, p[0, 0, 0.05, 0, 0, 0])

# 1. move_joint: Go to home position
# Using safe joint speed (1.0 rad/s) to satisfy SM-2
movej(home_pose, a=1.2, v=1.0)

# 2. move_linear: Approach above weld start
# Speed: 250 mm/s = 0.25 m/s
movel(approach_pose, a=0.5, v=0.25)

# 3. move_linear: Descend to weld start position
# Speed: 100 mm/s = 0.1 m/s
movel(weld_start, a=0.2, v=0.1)

# Welding Sequence (A7)
set_digital_out(weld_gas, True)
sleep(0.2)
set_digital_out(weld_arc, True)
sleep(0.5) # Arc establish delay

# 4. move_linear: Weld seam — 300mm linear path
# Speed: 50 mm/s = 0.05 m/s
# r=0 (blend radius) ensures precise stop for arc off
movel(weld_end, a=0.1, v=0.05, r=0)

set_digital_out(weld_arc, False)
sleep(0.2) # Post-flow gas
set_digital_out(weld_gas, False)

# 5. move_linear: Retract above weld end
# Speed: 200 mm/s = 0.2 m/s
movel(retract_pose, a=0.4, v=0.2)

# 6. move_joint: Return to home
movej(home_pose, a=1.2, v=1.0)

textmsg("Task T002 Complete")