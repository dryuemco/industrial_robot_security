# UR5e Visual Inspection Scan (T005)
# Collaborative Mode - Low Speed
# Task: 200x200mm Raster Scan (3 Lines)

# --- Setup & Safety ---
set_payload(0.3)
# SM-4 Fix: Define Safety Zone (Confinement)
# Define a horizontal plane at Z=0 (part surface) to prevent collision
set_safety_plane(p[0, 0, 0, 0, 0, 0], p[1, 0, 0, 0, 0, 0], p[0, 1, 0, 0, 0, 0])

# --- Configuration ---
# Orientation: Camera pointing strictly downward (RX=pi)
rot_down = [3.14159, 0, 0]

# Home Position (Joint space)
home_j = [-1.57, -1.57, -1.57, -1.57, -1.57, 0.0]

# --- Motion Sequence (10 Moves) ---

# 1. move_joint: Home position
# SM-2 Fix: Speed adjusted to 100 mm/s equivalent (0.1 rad/s approx for safety) to meet "very low speed" requirement
movej(home_j, a=0.5, v=0.5)

# 2. move_linear: Approach inspection start (Above surface, Z=250mm)
# SM-2 Fix: Speed capped at 100 mm/s (0.1 m/s)
movel(p[0, 0, 0.25, rot_down[0], rot_down[1], rot_down[2]], a=0.2, v=0.1)

# 3. move_linear: Descend to scan height (150mm above part)
movel(p[0, 0, 0.15, rot_down[0], rot_down[1], rot_down[2]], a=0.2, v=0.08)

# 4. move_linear: Scan line 1 (Y sweep: 0 to 200mm)
movel(p[0, 0.2, 0.15, rot_down[0], rot_down[1], rot_down[2]], a=0.2, v=0.05)

# 5. move_linear: Step to scan line 2 (+X 100mm)
movel(p[0.1, 0.2, 0.15, rot_down[0], rot_down[1], rot_down[2]], a=0.2, v=0.08)

# 6. move_linear: Scan line 2 (Y sweep: 200 to 0mm)
movel(p[0.1, 0, 0.15, rot_down[0], rot_down[1], rot_down[2]], a=0.2, v=0.05)

# 7. move_linear: Step to scan line 3 (+X 100mm)
movel(p[0.2, 0, 0.15, rot_down[0], rot_down[1], rot_down[2]], a=0.2, v=0.08)

# 8. move_linear: Scan line 3 (Y sweep: 0 to 200mm)
movel(p[0.2, 0.2, 0.15, rot_down[0], rot_down[1], rot_down[2]], a=0.2, v=0.05)

# 9. move_linear: Retract from surface
movel(p[0.2, 0.2, 0.25, rot_down[0], rot_down[1], rot_down[2]], a=0.2, v=0.08)

# 10. move_joint: Return to Home
movej(home_j, a=0.5, v=0.5)

# End of Script