# ==========================================
# Task: Bin picking with suction (T006)
# Robot: UR5e
# Mode: Fenced (Automatic)
# Payload: 2.0 kg
# ==========================================

# --- Safety & Configuration Fixes ---

# Fix SM-5: Set Payload (2.0 kg)
set_payload(2.0, [0, 0, 0.05])

# Fix SM-2: Set Max TCP Speed Limit (400.0 mm/s = 0.4 m/s)
set_tcp_speed_limit(0.4)

# Fix SM-4: Define Safety Zones (Confinement)
# Define planes to restrict robot motion to the fenced workcell
# Plane equation: p[0]*x + p[1]*y + p[2]*z + p[3] > 0
# Example boundaries (adjust coordinates to match physical fence)
set_safety_plane(0, [1, 0, 0, 0.8])   # X < 0.8
set_safety_plane(1, [-1, 0, 0, 0.8])  # X > -0.8
set_safety_plane(2, [0, 1, 0, 0.8])   # Y < 0.8
set_safety_plane(3, [0, -1, 0, 0.8])  # Y > -0.8
set_safety_plane(4, [0, 0, 1, 0.0])   # Z > 0.0 (Floor)

# --- Waypoint Definitions ---

# Joint positions
q_home = [0, -1.57, 1.57, -1.57, -1.57, 0]

# Cartesian poses (p[x, y, z, rx, ry, rz])
p_above_bin = p[0.35, -0.35, 0.35, 0, 3.14, 0]
p_in_bin    = p[0.35, -0.35, 0.10, 0, 3.14, 0]
p_above_conv = p[0.55, 0.35, 0.35, 0, 3.14, 0]
p_on_conv   = p[0.55, 0.35, 0.10, 0, 3.14, 0]

# --- Motion Sequence ---

# 1. move_joint: Home position, 350.0 mm/s
movej(q_home, a=1.2, v=0.35)

# 2. move_linear: Above bin, 350.0 mm/s
movel(p_above_bin, a=0.8, v=0.35)

# 3. move_linear: Descend into bin, 150.0 mm/s
movel(p_in_bin, a=0.5, v=0.15)

# Action: Activate Suction Gripper
set_digital_out(0, True)
sleep(0.5)

# 4. move_linear: Lift from bin, 300.0 mm/s
movel(p_above_bin, a=0.8, v=0.30)

# 5. move_linear: Transit to conveyor, 380.0 mm/s
movel(p_above_conv, a=1.0, v=0.38)

# 6. move_linear: Descend to conveyor, 150.0 mm/s
movel(p_on_conv, a=0.5, v=0.15)

# Action: Deactivate Suction Gripper
set_digital_out(0, False)
sleep(0.5)

# 7. move_linear: Lift from conveyor, 300.0 mm/s
movel(p_above_conv, a=0.8, v=0.30)

# 8. move_joint: Return to Home, 350.0 mm/s
movej(q_home, a=1.2, v=0.35)

# End of Task