def heavy_depalletizing():
  # Set payload and tool center point
  set_payload(5.0)
  set_tcp(p[0,0,0,0,0,0])

  # Safety configuration
  conf = {"safety_mode": "fenced", "safety_status": "guarded", "speed_slider": 1.0}

  # Waypoints (example coordinates - adjust to your actual setup)
  home_pose = p[0.0, -1.57, 1.57, -1.57, -1.57, 0.0]
  above_pallet = p[0.5, -0.3, 0.3, -1.57, -1.57, 0.0]
  top_layer = p[0.5, -0.3, 0.1, -1.57, -1.57, 0.0]
  lift_box = p[0.5, -0.3, 0.2, -1.57, -1.57, 0.0]
  transit_conveyor = p[1.0, -0.3, 0.3, -1.57, -1.57, 0.0]
  above_conveyor = p[1.0, -0.3, 0.2, -1.57, -1.57, 0.0]
  place_box = p[1.0, -0.3, 0.1, -1.57, -1.57, 0.0]
  retreat = p[1.0, -0.3, 0.3, -1.57, -1.57, 0.0]

  # Motion sequence with safety checks
  while True:
    # Move to home position
    if not get_analog_in(0) > 2.0:  # Safety input check
      halt
    end
    movej(home_pose, a=1.2, v=0.4, r=0.0)

    # Move above pallet
    if not get_analog_in(0) > 2.0:
      halt
    end
    movel(above_pallet, a=1.2, v=0.4, r=0.0)

    # Descend to top layer
    if not get_analog_in(0) > 2.0:
      halt
    end
    movel(top_layer, a=0.6, v=0.15, r=0.0)

    # Lift box
    if not get_analog_in(0) > 2.0:
      halt
    end
    movel(lift_box, a=0.8, v=0.2, r=0.0)

    # Transit to conveyor
    if not get_analog_in(0) > 2.0:
      halt
    end
    movel(transit_conveyor, a=1.2, v=0.35, r=0.0)

    # Move above conveyor
    if not get_analog_in(0) > 2.0:
      halt
    end
    movel(above_conveyor, a=1.2, v=0.35, r=0.0)

    # Place box
    if not get_analog_in(0) > 2.0:
      halt
    end
    movel(place_box, a=0.6, v=0.15, r=0.0)

    # Retreat
    if not get_analog_in(0) > 2.0:
      halt
    end
    movel(retreat, a=1.2, v=0.4, r=0.0)
  end
end

# Start the program
heavy_depalletizing()