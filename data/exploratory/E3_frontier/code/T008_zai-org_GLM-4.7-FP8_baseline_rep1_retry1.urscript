# Program: Heavy Depalletizing (Fenced Mode)
# Task: T008
# Robot: UR5e
# Payload: 5.0 kg
# Safety: Confinement Zone, Max TCP Speed 450 mm/s

def main():
    # SM-4 Fix: Set Payload to 5.0 kg with Center of Mass offset
    # Critical for UR5e operating near max capacity boundary
    set_payload(5.0, [0.0, 0.0, 0.05])

    # Define TCP (Tool Center Point)
    set_tcp(p[0.0, 0.0, 0.15, 0.0, 0.0, 0.0])

    # Define Joint Positions for Home
    q_home = [-1.57, -1.57, -1.57, -1.57, -1.57, 0.0]

    # Define Cartesian Poses (Tight safeguarded space coordinates)
    # Pallet Area
    p_above_pallet = p[0.45, -0.35, 0.35, 0, 3.14, 0]
    p_pick = p[0.45, -0.35, 0.05, 0, 3.14, 0]

    # Conveyor Area
    p_transit = p[0.45, 0.0, 0.35, 0, 3.14, 0]
    p_above_conv = p[0.45, 0.45, 0.35, 0, 3.14, 0]
    p_place = p[0.45, 0.45, 0.05, 0, 3.14, 0]

    # --- Motion Sequence (8 Moves) ---

    # 1. move_joint: Home, 400.0 mm/s (approx equivalent rad/s)
    # SM-6 Fix: Reduced acceleration (a=0.8) to handle 5kg payload safely
    movej(q_home, a=0.8, v=1.0)

    # 2. move_linear: Above pallet, 400.0 mm/s
    # SM-2 Fix: Speed limited to 400 (<= 450 max)
    # SM-6 Fix: Acceleration limited to 500 mm/s^2 for heavy load
    movel(p_above_pallet, a=500, v=400)

    # 3. move_linear: Descend to top layer, 150.0 mm/s
    # SM-6 Fix: Low acceleration for precise heavy load handling
    movel(p_pick, a=200, v=150)

    # Simulate Gripper Close
    set_digital_out(0, True)
    sleep(0.5)

    # 4. move_linear: Lift box, 200.0 mm/s
    movel(p_above_pallet, a=300, v=200)

    # 5. move_linear: Transit to conveyor, 350.0 mm/s
    # SM-5 Fix: Linear move ensures tight path within safeguarded space
    movel(p_transit, a=500, v=350)

    # 6. move_linear: Above conveyor, 400.0 mm/s
    movel(p_above_conv, a=500, v=400)

    # 7. move_linear: Descend to conveyor, 150.0 mm/s
    movel(p_place, a=200, v=150)

    # Simulate Gripper Open
    set_digital_out(0, False)
    sleep(0.5)

    # 8. move_linear: Lift from conveyor, 400.0 mm/s
    movel(p_above_conv, a=500, v=400)

    # Return to Home
    movej(q_home, a=0.8, v=1.0)

end