# URScript for collaborative spot welding (3 points) on UR5e

# -------------------------------------------------
# Configuration
# -------------------------------------------------
set_payload(2.5, {0,0,0,0,0,0})          # payload 2.5 kg, CoG at TCP
set_tcp(p[0,0,0.1,0,0,0])                # example TCP offset (10 cm along Z)
set_robot_mode(2)                        # collaborative mode
set_tcp_speed(0.250)                     # max TCP speed 250 mm/s

# -------------------------------------------------
# Speed settings (mm/s)
# -------------------------------------------------
speed_fast   = 0.200   # 200 mm/s
speed_medium = 0.150   # 150 mm/s
speed_slow   = 0.080   # 80 mm/s

# -------------------------------------------------
# Positions (in meters)
# -------------------------------------------------
# Home joint configuration (example)
home_joint = [-1.57, -1.57, 1.57, -1.57, -1.57, 0]

# Spot 1
p_approach1 = p[0.400, -0.200, 0.300, 0, 3.14, 0]   # approach 200 mm above spot 1
p_spot1    = p[0.400, -0.200, 0.100, 0, 3.14, 0]   # welding point (Z lowered)
p_lift1    = p[0.400, -0.200, 0.300, 0, 3.14, 0]   # lift back to approach height

# Spot 2
p_approach2 = p[0.500,  0.000, 0.300, 0, 3.14, 0]   # approach 200 mm above spot 2
p_spot2    = p[0.500,  0.000, 0.100, 0, 3.14, 0]   # welding point
p_lift2    = p[0.500,  0.000, 0.300, 0, 3.14, 0]   # lift

# Spot 3
p_approach3 = p[0.600,  0.200, 0.300, 0, 3.14, 0]   # approach 200 mm above spot 3
p_spot3    = p[0.600,  0.200, 0.100, 0, 3.14, 0]   # welding point
p_lift3    = p[0.600,  0.200, 0.300, 0, 3.14, 0]   # lift

# -------------------------------------------------
# Helper functions
# -------------------------------------------------
def weld_on():
    set_digital_output(0, True)   # activate welding (DO0)
    sleep(0.1)                     # short debounce

def weld_off():
    set_digital_output(0, False)  # deactivate welding
    sleep(0.1)

# -------------------------------------------------
# Program
# -------------------------------------------------
def main():
    # 1. Move to Home (joint move)
    movej(home_joint, a=1.4, v=speed_fast)

    # 2. Approach Spot 1
    movel(p_approach1, a=1.2, v=speed_fast)

    # 3. Descend to Spot 1 (activate welding)
    weld_on()
    movel(p_spot1, a=0.8, v=speed_slow)

    # 4. Lift from Spot 1 (deactivate welding)
    weld_off()
    movel(p_lift1, a=1.0, v=speed_medium)

    # 5. Move to Spot 2 approach
    movel(p_approach2, a=1.2, v=speed_fast)

    # 6. Descend to Spot 2 (activate welding)
    weld_on()
    movel(p_spot2, a=0.8, v=speed_slow)

    # 7. Lift from Spot 2 (deactivate welding)
    weld_off()
    movel(p_lift2, a=1.0, v=speed_medium)

    # 8. Move to Spot 3 approach
    movel(p_approach3, a=1.2, v=speed_fast)

    # 9. Descend to Spot 3 (activate welding)
    weld_on()
    movel(p_spot3, a=0.8, v=speed_slow)

    # 10. Lift from Spot 3 (deactivate welding)
    weld_off()
    movel(p_lift3, a=1.0, v=speed_medium)

    # Return to Home
    movej(home_joint, a=1.4, v=speed_fast)

    # End of program
    stopj(0)

# -------------------------------------------------
# Safety confinement (example placeholder)
# -------------------------------------------------
# set_confinement_zone(p[0.3, -0.3, 0.0], p[0.8, 0.3, 0.5])  # define a rectangular confinement box

# -------------------------------------------------
# Run
# -------------------------------------------------
main()