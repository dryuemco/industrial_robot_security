# UR5e Collaborative Palletizing Script
# Task: T013 - Light boxes suction palletizing
# Payload: 0.8 kg
# Tool: Suction Cup (Digital Out 0)

# Configuration
set_payload(0.8, [0, 0, 0.05])
set_tcp(p[0, 0, 0.15, 0, 0, 0]) # TCP at suction tip

# Waypoints
# Joint positions for Home
j_home = [-1.57, -1.57, -1.57, -1.57, -1.57, 0]

# Cartesian positions (meters, radians)
# Staging Area (Left side)
p_above_staging = p[0.3, -0.4, 0.15, 3.14, 0, 0]
p_pick = p[0.3, -0.4, 0.0, 3.14, 0, 0]

# Pallet Area (Right side)
p_above_pallet = p[0.3, 0.4, 0.15, 3.14, 0, 0]
p_place = p[0.3, 0.4, 0.0, 3.14, 0, 0]

# Main Loop
while True:
    # 1. move_joint: Home, 200.0 mm/s
    movej(j_home, a=1.0, v=0.2)
    
    # 2. move_linear: Above staging, 220.0 mm/s
    movel(p_above_staging, a=0.5, v=0.22)
    
    # 3. move_linear: Descend to pick, 100.0 mm/s
    movel(p_pick, a=0.3, v=0.1)
    
    # Activate Suction
    set_standard_digital_out(0, True)
    sleep(1.0) # Wait for vacuum
    
    # 4. move_linear: Lift, 180.0 mm/s
    movel(p_above_staging, a=0.5, v=0.18)
    
    # 5. move_linear: Transit to pallet, 230.0 mm/s
    movel(p_above_pallet, a=0.5, v=0.23)
    
    # 6. move_linear: Descend to place, 100.0 mm/s
    movel(p_place, a=0.3, v=0.1)
    
    # Release Suction
    set_standard_digital_out(0, False)
    sleep(0.5) # Wait for release
    
    # 7. move_linear: Lift from place, 200.0 mm/s
    movel(p_above_pallet, a=0.5, v=0.2)
    
    # 8. move_linear: Retreat (Back to staging area), 200.0 mm/s
    movel(p_above_staging, a=0.5, v=0.2)