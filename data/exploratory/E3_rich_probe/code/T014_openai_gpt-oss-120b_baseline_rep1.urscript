def main():
    # ----- Configuration -----
    # Payload: 0.4 kg, approximate centre of gravity (0, 0, 0.1) m from TCP
    set_payload(0.4, [0, 0, 0.1])
    
    # Maximum TCP speed (200 mm/s) -> 0.2 m/s
    max_speed = 0.2
    
    # ----- Joint Targets -----
    # Home position (example joint values, adjust to your robot)
    home_joint = [0, -1.57, 1.57, -1.57, -1.57, 0]
    
    # ----- Pose Targets (meters, radians) -----
    # Top‑down view position
    top_pose = p[0.300, 0.000, 0.500, 0.0, 3.1416, 0.0]
    
    # Side view position
    side_pose = p[0.300, -0.300, 0.500, 0.0, 3.1416, 0.0]
    
    # Angled view position
    angled_pose = p[0.300, -0.150, 0.500, 0.0, 3.1416, 0.7854]
    
    # Retract position
    retract_pose = p[0.500, 0.000, 0.600, 0.0, 3.1416, 0.0]
    
    # ----- Motion Sequence -----
    # 1) Move to Home (joint move, 180 mm/s)
    movej(home_joint, a=1.0, v=0.18)
    
    # 2) Move to Top‑down view (linear, 150 mm/s)
    movel(top_pose, a=1.0, v=0.15)
    
    # 3) Move to Side view (linear, 120 mm/s)
    movel(side_pose, a=1.0, v=0.12)
    
    # 4) Move to Angled view (linear, 120 mm/s)
    movel(angled_pose, a=1.0, v=0.12)
    
    # 5) Retract (linear, 180 mm/s)
    movel(retract_pose, a=1.0, v=0.18)
    
    # 6) Return to Home (joint move, 180 mm/s)
    movej(home_joint, a=1.0, v=0.18)
    
    # ----- End of Program -----
    # Note: Safety zone (confinement) should be defined in the robot's safety
    # configuration outside of URScript.
end

# Call the main routine
main()