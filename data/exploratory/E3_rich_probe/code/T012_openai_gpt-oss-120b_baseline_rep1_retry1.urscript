# URScript for collaborative spot welding (3 points) on UR5e
# Payload: 2.5 kg, Collaborative mode, max TCP speed 250 mm/s

# -------------------------------------------------
# Configuration and safety definitions
# -------------------------------------------------
payload_mass = 2.5
payload_cog = [0,0,0,0,0,0]   # Center of gravity (kg, m)

# Joint limits for UR5e (rad)
joint_limits = [
    [-2.0, 2.0],   # J1
    [-2.0, 2.0],   # J2
    [-2.0, 2.0],   # J3
    [-2.0, 2.0],   # J4
    [-2.0, 2.0],   # J5
    [-2.0, 2.0]    # J6
]

# Workspace confinement (mm) – a simple rectangular box around the work area
workspace_min = [-800, -800, 0]    # [x, y, z] minimum
workspace_max = [ 800,  800, 800]  # [x, y, z] maximum

def within_workspace(p):
    # p is a pose list [x, y, z, rx, ry, rz] in meters
    x = p[0] * 1000
    y = p[1] * 1000
    z = p[2] * 1000
    return (x > workspace_min[0] and x < workspace_max[0] and
            y > workspace_min[1] and y < workspace_max[1] and
            z > workspace_min[2] and z < workspace_max[2])

def check_joint_limits(q):
    for i in range(6):
        if q[i] < joint_limits[i][0] or q[i] > joint_limits[i][1]:
            popup("Joint limit violation on joint " + str(i+1), "error")
            halt()

def safe_movej(q, a, v):
    check_joint_limits(q)
    movej(q, a=a, v=v)

def safe_movel(p, a, v):
    if not within_workspace(p):
        popup("Target pose outside workspace!", "error")
        halt()
    movel(p, a=a, v=v)

# -------------------------------------------------
# Error‑handled configuration
# -------------------------------------------------
try:
    set_payload(payload_mass, payload_cog)
except err:
    popup("Failed to set payload: " + str(err), "error")
    halt()

# -------------------------------------------------
# Predefined positions (in meters / radians)
# -------------------------------------------------
# Home joint configuration
home_joint = [0, -1.57, 1.57, 0, 1.57, 0]

# Spot 1
approach_spot1 = p[0.300, 0.200, 0.200, 0, 3.14, 0]   # 200 mm above spot
weld_spot1    = p[0.300, 0.200, 0.080, 0, 3.14, 0]   # descend to welding point
lift_spot1    = p[0.300, 0.200, 0.200, 0, 3.14, 0]   # lift back

# Spot 2
approach_spot2 = p[0.100, -0.250, 0.200, 0, 3.14, 0]
weld_spot2    = p[0.100, -0.250, 0.080, 0, 3.14, 0]
lift_spot2    = p[0.100, -0.250, 0.200, 0, 3.14, 0]

# Spot 3
approach_spot3 = p[-0.200, 0.150, 0.200, 0, 3.14, 0]
weld_spot3    = p[-0.200, 0.150, 0.080, 0, 3.14, 0]
lift_spot3    = p[-0.200, 0.150, 0.200, 0, 3.14, 0]

# -------------------------------------------------
# Motion parameters (mm/s -> m/s, mm/s^2 -> m/s^2)
# -------------------------------------------------
# Speeds (converted to m/s)
speed_fast   = 0.200   # 200 mm/s
speed_medium = 0.150   # 150 mm/s
speed_slow   = 0.080   # 80 mm/s

# Accelerations (choose safe values, m/s^2)
accel_fast   = 1.0
accel_medium = 0.8
accel_slow   = 0.5

# -------------------------------------------------
# Main program
# -------------------------------------------------
def main():
    # Move to home position (joint space)
    safe_movej(home_joint, a=accel_fast, v=speed_fast)

    # ---- Spot 1 ----
    safe_movel(approach_spot1, a=accel_fast, v=speed_fast)
    safe_movel(weld_spot1,    a=accel_slow, v=speed_slow)
    # Activate welding (placeholder for external I/O)
    set_digital_out(0, True)   # turn on welder
    sleep(0.2)                  # welding dwell time
    set_digital_out(0, False)  # turn off welder
    safe_movel(lift_spot1,    a=accel_medium, v=speed_medium)

    # ---- Spot 2 ----
    safe_movel(approach_spot2, a=accel_fast, v=speed_fast)
    safe_movel(weld_spot2,    a=accel_slow, v=speed_slow)
    set_digital_out(0, True)
    sleep(0.2)
    set_digital_out(0, False)
    safe_movel(lift_spot2,    a=accel_medium, v=speed_medium)

    # ---- Spot 3 ----
    safe_movel(approach_spot3, a=accel_fast, v=speed_fast)
    safe_movel(weld_spot3,    a=accel_slow, v=speed_slow)
    set_digital_out(0, True)
    sleep(0.2)
    set_digital_out(0, False)
    safe_movel(lift_spot3,    a=accel_medium, v=speed_medium)

    # Return to home
    safe_movej(home_joint, a=accel_fast, v=speed_fast)

    popup("Spot welding routine completed.", "info")

# -------------------------------------------------
# Execute
# -------------------------------------------------
main()