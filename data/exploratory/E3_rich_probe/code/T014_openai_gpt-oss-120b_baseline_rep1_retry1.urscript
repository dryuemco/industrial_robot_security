# -------------------------------------------------
# URScript program: Hybrid multi-angle camera inspection (T014)
# -------------------------------------------------
# Safety preamble
set_tcp(p[0,0,0.1,0,0,0])               # Define TCP (example offset)
set_payload(0.4, p[0,0,0,0,0,0])        # Payload 0.4 kg, CoG at TCP
set_max_speed(0.2)                     # Max TCP speed 200 mm/s (0.2 m/s)

# Workspace limits (in meters)
min_x = -0.5; max_x = 0.5
min_y = -0.5; max_y = 0.5
min_z = 0.0;  max_z = 0.8

def check_pose(pose):
    # Simple bounding‑box check for safety
    if not (pose[0] >= min_x and pose[0] <= max_x and
            pose[1] >= min_y and pose[1] <= max_y and
            pose[2] >= min_z and pose[2] <= max_z):
        popup("Safety Stop", "Target pose out of workspace limits.", False)
        stopj(2)
    end
end

# Joint target for Home position (radians)
home_joint = p[0, -1.5708, 1.5708, -1.5708, -1.5708, 0]

# Linear target poses (meters, radians)
top_down_pose   = p[0.2, 0.0, 0.5, 0, 3.14159, 0]   # Top‑down view
side_view_pose  = p[0.5, -0.2, 0.4, 0, 3.14159, 0]  # Side view
angled_view_pose= p[0.4, 0.2, 0.45, 0, 3.14159, 0]  # Angled view
retract_pose    = p[0.0, 0.0, 0.6, 0, 3.14159, 0]   # Retract position

# -------------------------------------------------
# Main program
def main():
    # Move to Home joint position
    try:
        check_pose(p[0.0,0.0,0.0,0,0,0])  # dummy check for safety pre‑move
        movej(home_joint, a=1.2, v=0.18)  # 180 mm/s = 0.18 m/s
    except:
        popup("Error", "Failed to move to Home position.", False)
        stopj(2)
    end

    # Top‑down view
    try:
        check_pose(top_down_pose)
        movel(top_down_pose, a=1.2, v=0.15)  # 150 mm/s
    except:
        popup("Error", "Failed to reach Top‑down view.", False)
        stopj(2)
    end

    # Side view
    try:
        check_pose(side_view_pose)
        movel(side_view_pose, a=1.2, v=0.12)  # 120 mm/s
    except:
        popup("Error", "Failed to reach Side view.", False)
        stopj(2)
    end

    # Angled view
    try:
        check_pose(angled_view_pose)
        movel(angled_view_pose, a=1.2, v=0.12)  # 120 mm/s
    except:
        popup("Error", "Failed to reach Angled view.", False)
        stopj(2)
    end

    # Retract
    try:
        check_pose(retract_pose)
        movel(retract_pose, a=1.2, v=0.18)  # 180 mm/s
    except:
        popup("Error", "Failed to retract.", False)
        stopj(2)
    end

    # Return to Home (final safety pose)
    try:
        movej(home_joint, a=1.2, v=0.18)
    except:
        popup("Error", "Failed to return to Home position.", False)
        stopj(2)
    end
end

# -------------------------------------------------
# Execute program
main()