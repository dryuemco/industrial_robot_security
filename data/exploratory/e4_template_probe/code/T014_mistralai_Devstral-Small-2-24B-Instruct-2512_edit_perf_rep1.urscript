# Task: T014 — Hybrid multi-angle camera inspection
# Optimized for faster cycle time
# Operating mode: hybrid | Max TCP speed: 0.200 m/s
# Robot: ur5e

def task_T014():
  # [0] E-Stop verify
  if (get_digital_in(0) == True):
    popup("E-Stop active — aborting program.", error=True)
    halt
  end

  # [1] Home (faster joint move)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4000, v=0.4500)

  # [2] Top-down view position (increased speed)
  movel(p[0.400000, 0.000000, 0.250000, 0.0000, 3.1416, 0.0000], a=0.3000, v=0.2000, r=0.0100)

  # [3] Camera trigger ON
  set_digital_out(2, True)

  # [4] Capture top view (reduced sleep time)
  sleep(0.2000)

  # [5] Camera trigger OFF
  set_digital_out(2, False)

  # [6] Side view position (increased speed)
  movel(p[0.400000, -0.150000, 0.150000, 0.0000, 3.1416, 0.0000], a=0.3000, v=0.2000, r=0.0100)

  # [7] Camera trigger ON
  set_digital_out(2, True)

  # [8] Capture side view (reduced sleep time)
  sleep(0.2000)

  # [9] Camera trigger OFF
  set_digital_out(2, False)

  # [10] Angled view position (increased speed)
  movel(p[0.350000, 0.100000, 0.200000, 0.0000, 3.1416, 0.0000], a=0.3000, v=0.2000, r=0.0100)

  # [11] Camera trigger ON
  set_digital_out(2, True)

  # [12] Capture angled view (reduced sleep time)
  sleep(0.2000)

  # [13] Camera trigger OFF
  set_digital_out(2, False)

  # [14] Retract (increased speed)
  movel(p[0.350000, 0.000000, 0.350000, 0.0000, 3.1416, 0.0000], a=0.3000, v=0.2000, r=0.0100)

  # [15] Return home (faster joint move)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4000, v=0.4500)

end

# Entry point
task_T014()