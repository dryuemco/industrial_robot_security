# Program: T009 Laser surface scan
# Robot: UR5e
# Mode: Fenced
# Payload: 0.5 kg

# Set payload
set_payload(0.5)

# Define Home Joint Position
j_home = [-1.57, -1.57, -1.57, -1.57, -1.57, 0.0]

# Define Scan Poses (Orientation: Pointing Down)
# Surface: 300x200mm, 4 lines, Spacing: 66.67mm
# Start X: 400mm, Start Y: 0mm, Scan Z: 150mm, Safe Z: 300mm
# Orientation vector: [0, 3.14, 0] (180 deg around Y axis)

p_above_start = p[0.4, 0.0, 0.3, 0, 3.14, 0]
p_scan_start = p[0.4, 0.0, 0.15, 0, 3.14, 0]

# Line 1
p_l1_end = p[0.7, 0.0, 0.15, 0, 3.14, 0]

# Line 2 (Zig-Zag)
p_l2_start = p[0.7, 0.0667, 0.15, 0, 3.14, 0]
p_l2_end = p[0.4, 0.0667, 0.15, 0, 3.14, 0]

# Line 3
p_l3_start = p[0.4, 0.1333, 0.15, 0, 3.14, 0]
p_l3_end = p[0.7, 0.1333, 0.15, 0, 3.14, 0]

# Line 4
p_l4_start = p[0.7, 0.2, 0.15, 0, 3.14, 0]
p_l4_end = p[0.4, 0.2, 0.15, 0, 3.14, 0]

# Motion Sequence

# 1. move_joint: Home, 180.0 mm/s
movej(j_home, a=1.4, v=0.18)

# 2. move_linear: Above scan start, 150.0 mm/s
movel(p_above_start, a=0.5, v=0.15)

# 3. move_linear: Descend to scan height, 80.0 mm/s
movel(p_scan_start, a=0.2, v=0.08)

# Activate Laser (A7)
set_standard_digital_out(0, True)

# 4. move_linear: Scan line 1, 50.0 mm/s
movel(p_l1_end, a=0.1, v=0.05)

# 5. move_linear: Step to line 2, 80.0 mm/s
movel(p_l2_start, a=0.2, v=0.08)

# 6. move_linear: Scan line 2, 50.0 mm/s
movel(p_l2_end, a=0.1, v=0.05)

# 7. move_linear: Step to line 3, 80.0 mm/s
movel(p_l3_start, a=0.2, v=0.08)

# 8. move_linear: Scan line 3, 50.0 mm/s
movel(p_l3_end, a=0.1, v=0.05)

# 9. move_linear: Step to line 4, 80.0 mm/s
movel(p_l4_start, a=0.2, v=0.08)

# 10. move_linear: Scan line 4, 50.0 mm/s
movel(p_l4_end, a=0.1, v=0.05)

# Deactivate Laser
set_standard_digital_out(0, False)

# 11. move_linear: Retract to safe height, 150.0 mm/s
movel(p_above_start, a=0.5, v=0.15)

# 12. move_joint: Home, 180.0 mm/s
movej(j_home, a=1.4, v=0.18)

# End of program