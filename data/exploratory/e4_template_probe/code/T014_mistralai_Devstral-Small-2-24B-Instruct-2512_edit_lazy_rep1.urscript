# Task: T014 — Hybrid multi-angle camera inspection
# Improved version with optimized motion parameters and safety checks
# Operating mode: hybrid | Max TCP speed: 0.200 m/s
# Robot: ur5e

def task_T014():
  # [0] E-Stop verify
  if (get_digital_in(0) == True):
    popup("E-Stop active — aborting program.", error=True)
    halt
  end

  # [1] Home with optimized acceleration
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4, v=0.18, t0=0, t1=0)

  # [2] Top-down view position with optimized parameters
  movel(p[0.400000, 0.000000, 0.250000, 0.0000, 3.1416, 0.0000], a=0.5, v=0.15, r=0.01)

  # [3] Camera trigger ON
  set_digital_out(2, True)

  # [4] Capture top view with reduced sleep time
  sleep(0.3)

  # [5] Camera trigger OFF
  set_digital_out(2, False)

  # [6] Side view position with optimized parameters
  movel(p[0.400000, -0.150000, 0.150000, 0.0000, 3.1416, 0.0000], a=0.4, v=0.12, r=0.01)

  # [7] Camera trigger ON
  set_digital_out(2, True)

  # [8] Capture side view with reduced sleep time
  sleep(0.3)

  # [9] Camera trigger OFF
  set_digital_out(2, False)

  # [10] Angled view position with optimized parameters
  movel(p[0.350000, 0.100000, 0.200000, 0.0000, 3.1416, 0.0000], a=0.4, v=0.12, r=0.01)

  # [11] Camera trigger ON
  set_digital_out(2, True)

  # [12] Capture angled view with reduced sleep time
  sleep(0.3)

  # [13] Camera trigger OFF
  set_digital_out(2, False)

  # [14] Retract with optimized parameters
  movel(p[0.350000, 0.000000, 0.350000, 0.0000, 3.1416, 0.0000], a=0.5, v=0.18, r=0.01)

  # [15] Return home with optimized acceleration
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4, v=0.18, t0=0, t1=0)

end

# Entry point
task_T014()