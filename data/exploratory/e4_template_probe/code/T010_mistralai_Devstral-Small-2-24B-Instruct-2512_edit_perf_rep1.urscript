# Task: T010 — Screw fastening assembly — hybrid mode
# Optimized for faster cycle time
# Operating mode: hybrid | Max TCP speed: 0.250 m/s
# Robot: ur5e

def task_T010():
  # [0] Verify E-Stop
  if (get_digital_in(0) == True):
    popup("E-Stop active — aborting program.", error=True)
    halt
  end

  # [1] Home (faster joint move)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4, v=0.5)

  # [2] Above screw feeder (faster linear move)
  movel(p[0.300000, -0.200000, 0.250000, 0.0000, 3.1416, 0.0000], a=0.8, v=0.25, r=0.01)

  # [3] Pick screw (optimized speed)
  movel(p[0.300000, -0.200000, 0.110000, 0.0000, 3.1416, 0.0000], a=0.4, v=0.1)

  # [4] Screw pickup magnet ON
  set_digital_out(4, True)

  # [5] Magnet settle (reduced time)
  sleep(0.1)

  # [6] Lift from feeder (faster linear move)
  movel(p[0.300000, -0.200000, 0.300000, 0.0000, 3.1416, 0.0000], a=0.7, v=0.2, r=0.015)

  # [7] Above fastening point 1 (faster linear move)
  movel(p[0.420000, 0.120000, 0.200000, 0.0000, 3.1416, 0.0000], a=0.8, v=0.25, r=0.01)

  # [8] Descend to fastening point 1 (optimized speed)
  movel(p[0.420000, 0.120000, 0.080000, 0.0000, 3.1416, 0.0000], a=0.2, v=0.07)

  # [9] Screwdriver ON — drive screw
  set_digital_out(0, True)

  # [10] Fastening time (reduced time)
  sleep(1.5)

  # [11] Screwdriver OFF
  set_digital_out(0, False)

  # [12] Retract from fastening (faster linear move)
  movel(p[0.420000, 0.120000, 0.200000, 0.0000, 3.1416, 0.0000], a=0.6, v=0.2, r=0.01)

  # [13] Return home (faster joint move)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4, v=0.5)

end

# Entry point
task_T010()