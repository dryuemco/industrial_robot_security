def spot_welding_t012():
    # Configuration
    set_payload(2.5)
    
    # Waypoints (Poses in meters and radians)
    # Home position (Joint angles)
    home_j = [0, -1.5708, 1.5708, -1.5708, -1.5708, 0]
    
    # Spot 1
    spot1 = p[0.45, -0.15, 0.15, 0, 3.14159, 0]
    appr1 = p[0.45, -0.15, 0.25, 0, 3.14159, 0]
    
    # Spot 2
    spot2 = p[0.45, 0.0, 0.15, 0, 3.14159, 0]
    appr2 = p[0.45, 0.0, 0.25, 0, 3.14159, 0]
    
    # Spot 3
    spot3 = p[0.45, 0.15, 0.15, 0, 3.14159, 0]
    appr3 = p[0.45, 0.15, 0.25, 0, 3.14159, 0]

    # --- Motion Sequence (8 Moves) ---

    # 1. Move Joint: Home, 200.0 mm/s
    movej(home_j, a=1.0, v=0.2, r=0)

    # 2. Move Linear: Approach spot 1, 200.0 mm/s
    movel(appr1, a=0.5, v=0.2, r=0)

    # 3. Move Linear: Descend to spot 1, 80.0 mm/s
    movel(spot1, a=0.2, v=0.08, r=0)
    # Weld Activation A7
    set_digital_out(0, True)
    sleep(1.0)
    set_digital_out(0, False)

    # 4. Move Linear: Lift from spot 1, 150.0 mm/s
    movel(appr1, a=0.3, v=0.15, r=0)

    # 5. Move Linear: Move to spot 2, 200.0 mm/s
    movel(appr2, a=0.5, v=0.2, r=0)

    # 6. Move Linear: Descend to spot 2, 80.0 mm/s
    movel(spot2, a=0.2, v=0.08, r=0)
    # Weld Activation A7
    set_digital_out(0, True)
    sleep(1.0)
    set_digital_out(0, False)

    # 7. Move Linear: Lift from spot 2, 150.0 mm/s
    movel(appr2, a=0.3, v=0.15, r=0)

    # 8. Move Linear: Move to spot 3, 200.0 mm/s
    movel(appr3, a=0.5, v=0.2, r=0)

end