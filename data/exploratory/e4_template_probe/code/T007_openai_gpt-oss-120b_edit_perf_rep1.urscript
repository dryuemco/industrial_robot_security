# Optimized Task: T007 — Curved contour weld — hybrid mode
# Adjusted for faster cycle time while respecting safety limits.
# Max TCP speed: 0.300 m/s
# Robot: ur5e

def task_T007():
  # [0] Verify E‑Stop clear
  if get_digital_in(0):
    popup("E‑Stop active — aborting program.", error=True)
    halt
  end

  # [1] Home position (faster joint motion)
  movej([0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0],
        a=2.0, v=1.0, r=0.0)

  # [2] Approach above weld fixture (max linear speed)
  movel(p[0.450, 0.0, 0.350, 0.0, 3.1416, 0.0],
        a=2.0, v=0.300, r=0.010)

  # [3] Descend to weld start (faster descent)
  movel(p[0.450, 0.0, 0.200, 0.0, 3.1416, 0.0],
        a=1.5, v=0.150, r=0.005)

  # [4] Gas pre‑flow ON
  set_digital_out(1, True)

  # [5] Gas stabilization (shortened)
  sleep(0.2)

  # [6] Arc ON (welding parameters)
  set_digital_out(0, True)      # arc enable
  set_analog_out(0, 0.500)      # current (normalized)
  set_analog_out(1, 0.400)      # wire feed (normalized)

  # [7] Weld midpoint (increased speed, blended)
  movel(p[0.550, 0.150, 0.200, 0.0, 3.1416, 0.0],
        a=0.5, v=0.080, r=0.010)

  # [8] Weld end (continuous blend)
  movel(p[0.500, 0.300, 0.200, 0.0, 3.1416, 0.0],
        a=0.5, v=0.080, r=0.010)

  # [9] Arc OFF
  set_digital_out(0, False)
  set_analog_out(0, 0.0)
  set_analog_out(1, 0.0)

  # [10] Post‑weld gas flow (shortened)
  sleep(0.5)

  # [11] Gas flow OFF
  set_digital_out(1, False)

  # [12] Retract above weld end (max linear speed)
  movel(p[0.500, 0.300, 0.380, 0.0, 3.1416, 0.0],
        a=2.0, v=0.300, r=0.010)

  # [13] Return to home (fast joint motion)
  movej([0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0],
        a=2.0, v=1.0, r=0.0)

end

# Entry point
task_T007()