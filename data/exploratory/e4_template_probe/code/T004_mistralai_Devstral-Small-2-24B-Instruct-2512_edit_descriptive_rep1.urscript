# Task: T004 — Multi-waypoint SSM pick-place with obstacle avoidance
# Improved version with refined motion sequence, structure, and clarity
# Operating mode: collaborative | Max TCP speed: 0.250 m/s
# Robot: ur5e | Payload: 1.5 kg

def task_T004():
    # Safety check
    if get_digital_in(0) == True:
        popup("E-Stop active — aborting program.", error=True)
        halt
    end

    # Home position
    movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4, v=0.5)

    # Pick sequence
    movel(p[0.4, -0.25, 0.35, 0, 3.1416, 0], a=0.8, v=0.2, r=0.015)  # WP1 - Above pick
    movel(p[0.4, -0.25, 0.1, 0, 3.1416, 0], a=0.5, v=0.1)           # WP2 - Descend to pick
    set_digital_out(0, True)                                          # Gripper close
    sleep(0.2)                                                        # Grip settle
    movel(p[0.4, -0.25, 0.4, 0, 3.1416, 0], a=0.7, v=0.18, r=0.02)   # WP3 - Lift above pick

    # Obstacle avoidance
    movel(p[0.25, 0, 0.4, 0, 3.1416, 0], a=0.8, v=0.2, r=0.03)       # WP4 - Offset -X
    movel(p[0.4, 0.25, 0.4, 0, 3.1416, 0], a=0.8, v=0.2, r=0.02)     # WP5 - Above place

    # Place sequence
    movel(p[0.4, 0.25, 0.1, 0, 3.1416, 0], a=0.5, v=0.1)             # WP6 - Descend to place
    set_digital_out(0, False)                                         # Gripper open
    sleep(0.2)                                                        # Release settle
    movel(p[0.4, 0.25, 0.4, 0, 3.1416, 0], a=0.7, v=0.18, r=0.01)   # WP7 - Retract above place

    # Return home
    movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4, v=0.5)

end

task_T004()