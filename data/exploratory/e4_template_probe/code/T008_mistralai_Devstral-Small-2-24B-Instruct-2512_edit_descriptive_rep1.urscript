# Task: T008 — Heavy depalletizing — fenced mode
# Robot: ur5e | Mode: fenced | Max TCP speed: 0.450 m/s
# Payload: 5.0 kg | Safety: confinement

def task_T008():
    # Safety check
    if get_digital_in(0) == True:
        popup("E-Stop active — aborting program.", error=True)
        halt
    end

    # [1] Home position
    movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4, v=1.0)

    # [2] Approach pallet
    movel(p[0.5, -0.25, 0.5, 0.0, 3.1416, 0.0], a=1.5, v=0.4, r=0.02)

    # [3] Descend to box
    movel(p[0.5, -0.25, 0.32, 0.0, 3.1416, 0.0], a=0.6, v=0.15)

    # [4] Gripper close
    set_digital_out(0, True)
    sleep(0.5)

    # [5] Lift box
    movel(p[0.5, -0.25, 0.5, 0.0, 3.1416, 0.0], a=0.8, v=0.2, r=0.015)

    # [6] Transit to conveyor
    movel(p[0.5, 0.25, 0.4, 0.0, 3.1416, 0.0], a=1.2, v=0.35, r=0.02)

    # [7] Place box
    movel(p[0.5, 0.25, 0.12, 0.0, 3.1416, 0.0], a=0.5, v=0.12)

    # [8] Gripper open
    set_digital_out(0, False)
    sleep(0.3)

    # [9] Retract
    movel(p[0.5, 0.25, 0.4, 0.0, 3.1416, 0.0], a=1.5, v=0.35, r=0.01)

    # [10] Return home
    movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4, v=1.0)

end

task_T008()