# Task: T015 — Laser marking — fenced mode (Optimized)
# Operating mode: fenced | Max TCP speed: 0.400 m/s
# Robot: ur5e

def task_T015():
  # E-Stop verify
  if (get_digital_in(0) == True):
    popup("E-Stop active — aborting program.", error=True)
    halt
  end

  # [1] Home (faster joint move)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4, v=1.0)

  # [2] Above marking surface (faster linear move)
  movel(p[0.400000, -0.080000, 0.200000, 0.0000, 3.1416, 0.0000], a=1.2, v=0.4, r=0.01)

  # [3] Descend to marking height (optimized acceleration)
  movel(p[0.400000, -0.080000, 0.100000, 0.0000, 3.1416, 0.0000], a=0.8, v=0.15, r=0.003)

  # [4] Laser ON
  set_digital_out(3, True)

  # [5] Mark line 1 (increased speed)
  movel(p[0.500000, -0.080000, 0.100000, 0.0000, 3.1416, 0.0000], a=0.3, v=0.1, r=0.003)

  # [6] Step to line 2 (increased speed)
  movel(p[0.500000, 0.000000, 0.100000, 0.0000, 3.1416, 0.0000], a=0.4, v=0.12, r=0.003)

  # [7] Mark line 2 reverse (increased speed)
  movel(p[0.400000, 0.000000, 0.100000, 0.0000, 3.1416, 0.0000], a=0.3, v=0.1, r=0.003)

  # [8] Step to line 3 (increased speed)
  movel(p[0.400000, 0.080000, 0.100000, 0.0000, 3.1416, 0.0000], a=0.4, v=0.12, r=0.003)

  # [9] Mark line 3 (increased speed)
  movel(p[0.500000, 0.080000, 0.100000, 0.0000, 3.1416, 0.0000], a=0.3, v=0.1)

  # [10] Laser OFF
  set_digital_out(3, False)

  # [11] Retract (faster linear move)
  movel(p[0.450000, 0.000000, 0.300000, 0.0000, 3.1416, 0.0000], a=1.2, v=0.4, r=0.01)

  # [12] Return home (faster joint move)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4, v=1.0)

end

# Entry point
task_T015()