# Task: T006 — Bin picking with suction — fenced mode
# Optimized for faster cycle time
# Operating mode: fenced | Max TCP speed: 0.400 m/s
# Robot: ur5e

def task_T006():
  # [0] Verify E-Stop clear
  if (get_digital_in(0) == True):
    popup("E-Stop active — aborting program.", error=True)
    halt
  end

  # [1] Home position (increased speed)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4000, v=1.0000)

  # [2] Above bin (increased speed)
  movel(p[0.450000, -0.200000, 0.350000, 0.0000, 3.1416, 0.0000], a=1.5000, v=0.4000, r=0.0150)

  # [3] Descend into bin (increased speed)
  movel(p[0.450000, -0.200000, 0.100000, 0.0000, 3.1416, 0.0000], a=0.8000, v=0.2000)

  # [4] Suction ON
  set_digital_out(0, True)

  # [5] Vacuum settle (reduced time)
  sleep(0.2000)

  # [6] Lift from bin (increased speed)
  movel(p[0.450000, -0.200000, 0.400000, 0.0000, 3.1416, 0.0000], a=1.2000, v=0.4000, r=0.0150)

  # [7] Transit to conveyor (increased speed)
  movel(p[0.450000, 0.250000, 0.400000, 0.0000, 3.1416, 0.0000], a=1.8000, v=0.4000, r=0.0200)

  # [8] Descend to drop (increased speed)
  movel(p[0.450000, 0.250000, 0.150000, 0.0000, 3.1416, 0.0000], a=1.0000, v=0.2500)

  # [9] Suction OFF
  set_digital_out(0, False)

  # [10] Release settle (reduced time)
  sleep(0.1000)

  # [11] Retract above conveyor (increased speed)
  movel(p[0.450000, 0.250000, 0.400000, 0.0000, 3.1416, 0.0000], a=1.5000, v=0.4000, r=0.0100)

  # [12] Return to home (increased speed)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4000, v=1.0000)

end

# Entry point
task_T006()