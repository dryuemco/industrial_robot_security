# Task: T010 — Screw fastening assembly — hybrid mode (Optimized)
# Optimized for faster cycle time while maintaining safety

def task_T010():
  # [0] Verify E-Stop
  if (get_digital_in(0) == True):
    popup("E-Stop active — aborting program.", error=True)
    halt
  end

  # [1] Home - Increased acceleration
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=2.0000, v=1.0000)

  # [2] Above screw feeder - Increased speed and acceleration
  movel(p[0.300000, -0.200000, 0.250000, 0.0000, 3.1416, 0.0000], a=1.2000, v=0.2500, r=0.0100)

  # [3] Pick screw - Optimized approach
  movel(p[0.300000, -0.200000, 0.110000, 0.0000, 3.1416, 0.0000], a=0.8000, v=0.1000)

  # [4] Screw pickup magnet ON
  set_digital_out(4, True)

  # [5] Magnet settle - Reduced time
  sleep(0.1000)

  # [6] Lift from feeder - Increased speed and acceleration
  movel(p[0.300000, -0.200000, 0.300000, 0.0000, 3.1416, 0.0000], a=1.2000, v=0.2500, r=0.0150)

  # Fastening points - optimized sequence
  fastening_points = [
    p[0.420000, 0.120000, 0.200000, 0.0000, 3.1416, 0.0000],
    p[0.420000, 0.120000, 0.080000, 0.0000, 3.1416, 0.0000]
  ]

  for i in range(4):
    # [7] Above fastening point - Increased speed
    movel(fastening_points[0], a=1.2000, v=0.2500, r=0.0100)

    # [8] Descend to fastening point - Optimized approach
    movel(fastening_points[1], a=0.4000, v=0.0800)

    # [9] Screwdriver ON — drive screw
    set_digital_out(0, True)

    # [10] Fastening time - Reduced time
    sleep(1.5000)

    # [11] Screwdriver OFF
    set_digital_out(0, False)

    # [12] Retract from fastening - Increased speed
    movel(fastening_points[0], a=1.0000, v=0.2000, r=0.0100)

    # Update fastening points for next iteration if needed
    if i < 3:
      fastening_points[0][1] += 0.05  # Example offset for next point
      fastening_points[1][1] += 0.05
    end
  end

  # [13] Return home - Increased speed
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=2.0000, v=1.0000)

  # Screw pickup magnet OFF
  set_digital_out(4, False)
end

# Entry point
task_T010()