# Task: T003 — EUR-pallet 2x2 layer — hybrid mode
# Improved version with enhanced safety, efficiency, and readability
# Operating mode: hybrid | Max TCP speed: 0.300 m/s
# Robot: ur5e | Payload: 4.5 kg

def task_T003():
    # [0] Safety checks
    if (get_digital_in(0) == True):
        popup("E-Stop active — aborting program.", error=True)
        halt
    end

    # [1] Home position with reduced speed for safety
    movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4000, v=0.2500, t=0, r=0)

    # [2] Initialize pallet grid positions
    pallet_positions = [
        [0.500000, 0.300000, 0.400000],  # (0,0)
        [0.700000, 0.300000, 0.400000],  # (200,0)
        [0.500000, 0.500000, 0.400000],  # (0,200)
        [0.700000, 0.500000, 0.400000]   # (200,200)
    ]

    # [3] Main pick-and-place loop
    for i in range(4):
        # Approach conveyor pick — above
        movel(p[0.500000, -0.300000, 0.350000, 0.0000, 3.1416, 0.0000], a=1.0000, v=0.2500, r=0.0200)

        # Descend to pick with reduced speed
        movel(p[0.500000, -0.300000, 0.100000, 0.0000, 3.1416, 0.0000], a=0.5000, v=0.1000, r=0.0100)

        # Gripper CLOSE — grasp box
        set_digital_out(0, True)

        # Grip settle time
        sleep(0.3000)

        # Lift from conveyor
        movel(p[0.500000, -0.300000, 0.400000, 0.0000, 3.1416, 0.0000], a=0.8000, v=0.2000, r=0.0150)

        # Transit to pallet position
        movel(p[pallet_positions[i][0], pallet_positions[i][1], pallet_positions[i][2], 0.0000, 3.1416, 0.0000], a=1.2000, v=0.2800, r=0.0200)

        # Descend to pallet place position
        movel(p[pallet_positions[i][0], pallet_positions[i][1], 0.120000, 0.0000, 3.1416, 0.0000], a=0.5000, v=0.1000, r=0.0100)

        # Gripper OPEN — release box
        set_digital_out(0, False)

        # Release settle
        sleep(0.2000)

        # Retract above pallet
        movel(p[pallet_positions[i][0], pallet_positions[i][1], 0.400000, 0.0000, 3.1416, 0.0000], a=1.0000, v=0.2000, r=0.0100)

    # [4] Return to home
    movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4000, v=0.2500, t=0, r=0)

end

# Entry point
task_T003()