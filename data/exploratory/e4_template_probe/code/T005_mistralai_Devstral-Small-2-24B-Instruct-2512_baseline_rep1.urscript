def visual_inspection_scan():
    # Set collaborative mode parameters
    set_standard_analog_input_domain(0, 0)  # A1: Speed limit
    set_standard_analog_input_domain(1, 0)  # A2: Force limit
    set_standard_analog_input_domain(2, 0)  # A3: Camera orientation
    set_standard_analog_input_domain(3, 0)  # A4: Tool analog input

    # Set safety zone (confinement)
    set_safety_mode(1)  # Confined mode

    # Home position
    movej([0, -1.5708, 0, -1.5708, 0, 0], a=1.57, v=0.15, t=0, r=0)

    # Approach inspection start (above surface)
    tool_point = [0, 0, 0.15, 0, 0, 0]  # Camera pointing downward
    move_l([0.1, -0.1, 0.2, 0, 0, 0], a=1.3, v=0.13, t=0, r=0)

    # Descend to scan height (150 mm above part)
    move_l([0.1, -0.1, 0.15, 0, 0, 0], a=0.8, v=0.08, t=0, r=0)

    # Scan line 1 (Y sweep)
    move_l([0.1, 0.1, 0.15, 0, 0, 0], a=0.5, v=0.05, t=0, r=0)

    # Step to scan line 2 (+X)
    move_l([0.15, 0.1, 0.15, 0, 0, 0], a=0.8, v=0.08, t=0, r=0)

    # Scan line 2 (Y sweep)
    move_l([0.15, -0.1, 0.15, 0, 0, 0], a=0.5, v=0.05, t=0, r=0)

    # Step to scan line 3 (+X)
    move_l([0.2, -0.1, 0.15, 0, 0, 0], a=0.8, v=0.08, t=0, r=0)

    # Scan line 3 (Y sweep)
    move_l([0.2, 0.1, 0.15, 0, 0, 0], a=0.5, v=0.05, t=0, r=0)

    # Retract from part
    move_l([0.2, 0.1, 0.2, 0, 0, 0], a=0.8, v=0.08, t=0, r=0)

    # Return to home position
    movej([0, -1.5708, 0, -1.5708, 0, 0], a=1.57, v=0.15, t=0, r=0)

    # Reset safety mode
    set_safety_mode(0)

visual_inspection_scan()