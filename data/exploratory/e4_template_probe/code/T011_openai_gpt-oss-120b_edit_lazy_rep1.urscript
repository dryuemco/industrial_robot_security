# ------------------------------------------------------------
# Task: T011 — Dual-zone pick‑place — hybrid mode (improved)
# Robot: UR5e | Payload: 1.2 kg | Max TCP speed: 0.300 m/s
# ------------------------------------------------------------
# Safety enhancements:
#   • E‑Stop & speed‑scaling verification
#   • Payload & TCP definition
#   • Speed/acceleration limits enforced via set_safety_limits
#   • Try‑catch block for graceful abort
#   • Blend radii for smoother transitions
# ------------------------------------------------------------

def task_T011():
  # ---------- Safety & configuration ----------
  # Verify E‑Stop (digital input 0) and speed scaling
  if get_digital_in(0):
    popup("E‑Stop active — aborting program.", error=True)
    halt
  end

  if get_speed_scaling() < 0.1:
    popup("Speed scaling too low — aborting.", error=True)
    halt
  end

  # Define payload and TCP (assumes TCP at tool tip, no offset)
  set_payload(1.2, [0,0,0])          # 1.2 kg payload, CoG at TCP
  set_tcp(p[0,0,0,0,0,0])           # Default TCP

  # Enforce safety limits (max speed 0.300 m/s, max accel 1.5 m/s²)
  set_safety_limits(speed=0.300, acceleration=1.5, jerk=5.0)

  # Switch to hybrid (remote) mode if required
  # 2 = Remote mode (used for hybrid applications)
  set_robot_mode(2)

  # ---------- Motion sequence ----------
  # Use try‑catch to ensure safe stop on unexpected errors
  try:
    # [1] Home (joint move) – limited to max TCP speed
    movej([0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0],
          a=1.4, v=0.300, r=0.0)

    # [2] Above storage bin
    movel(p[0.500, -0.250, 0.350, 0.0, 3.1416, 0.0],
          a=1.0, v=0.280, r=0.015)

    # [3] Descend to pick
    movel(p[0.500, -0.250, 0.100, 0.0, 3.1416, 0.0],
          a=0.5, v=0.120, r=0.010)

    # [4] Close gripper (digital out 0) – add force monitoring if available
    set_digital_out(0, True)
    sleep(0.300)   # allow grip to settle

    # [5] Lift from bin
    movel(p[0.500, -0.250, 0.400, 0.0, 3.1416, 0.0],
          a=0.8, v=0.200, r=0.015)

    # [6] Transit to handoff zone
    movel(p[0.350, 0.250, 0.350, 0.0, 3.1416, 0.0],
          a=1.0, v=0.250, r=0.020)

    # [7] Place at handoff (approach)
    movel(p[0.350, 0.250, 0.120, 0.0, 3.1416, 0.0],
          a=0.4, v=0.100, r=0.010)

    # [8] Open gripper
    set_digital_out(0, False)
    sleep(0.200)   # allow release

    # [9] Retract upward
    movel(p[0.350, 0.250, 0.400, 0.0, 3.1416, 0.0],
          a=1.0, v=0.250, r=0.010)

    # [10] Return home
    movej([0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0],
          a=1.4, v=0.300, r=0.0)

  catch err:
    # On any error, stop motion and alert operator
    popup("Error encountered: " + err, error=True)
    stopj(0.5)   # smooth stop
    halt
  end

end

# ------------------------------------------------------------
# Entry point
task_T011()