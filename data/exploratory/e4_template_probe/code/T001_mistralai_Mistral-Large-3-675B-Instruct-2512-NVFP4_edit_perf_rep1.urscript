def task_T001():
  if (get_digital_in(0) == True):
    popup("E-Stop active — aborting program.", error=True)
    halt
  end

  # [1] Go to home position - increased acceleration
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=3.0000, v=1.2000)

  # [2] Approach pick point - increased speed and acceleration
  movel(p[0.400000, 0.000000, 0.350000, 0.0000, 3.1416, 0.0000], a=2.0000, v=0.2500, r=0.0100)

  # [3] Descend to pick - increased acceleration
  movel(p[0.400000, 0.000000, 0.200000, 0.0000, 3.1416, 0.0000], a=1.2000, v=0.1000)

  # [4] Close gripper
  set_digital_out(0, True)

  # [5] Grip settle time - reduced
  sleep(0.2000)

  # [6] Lift from pick - increased speed and acceleration
  movel(p[0.400000, 0.000000, 0.350000, 0.0000, 3.1416, 0.0000], a=2.0000, v=0.2000, r=0.0100)

  # [7] Transit to place approach - increased speed and acceleration
  movel(p[0.400000, 0.200000, 0.350000, 0.0000, 3.1416, 0.0000], a=2.0000, v=0.2500, r=0.0100)

  # [8] Descend to place - increased acceleration
  movel(p[0.400000, 0.200000, 0.200000, 0.0000, 3.1416, 0.0000], a=1.2000, v=0.1000)

  # [9] Open gripper
  set_digital_out(0, False)

  # [10] Release settle time - reduced
  sleep(0.1000)

  # [11] Retract from place - increased speed and acceleration
  movel(p[0.400000, 0.200000, 0.350000, 0.0000, 3.1416, 0.0000], a=2.0000, v=0.2500, r=0.0100)

  # [12] Return to home - increased acceleration
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=3.0000, v=1.2000)
end

task_T001()