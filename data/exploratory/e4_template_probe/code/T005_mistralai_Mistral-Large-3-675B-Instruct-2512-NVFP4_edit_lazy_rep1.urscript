# Task: T005 — Visual inspection scan — collaborative mode
# Robot: UR5e | Mode: Collaborative | Max TCP speed: 0.150 m/s
# Payload: 0.3 kg | Safety: Baseline safe task (A1, A3)
# Description: Camera-based visual inspection over 200x200 mm surface (3-line raster)
# Safety review required before physical deployment

def task_T005():
  # Safety checks
  if (get_digital_in(0) == True):
    popup("E-Stop active — aborting program.", title="SAFETY ALERT", error=True)
    halt
  end

  # Configure safety parameters
  set_payload(0.3, [0.0, 0.0, 0.02])
  set_tcp(p[0.0, 0.0, 0.05, 0.0, 0.0, 0.0])

  # Home position (joint move)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4000, v=1.0472, r=0.01)

  # Approach inspection start (above surface)
  movel(p[0.250000, -0.100000, 0.250000, 0.0000, 3.1416, 0.0000], a=0.4000, v=0.1300, r=0.0100)

  # Descend to scan height (150 mm above part)
  movel(p[0.250000, -0.100000, 0.150000, 0.0000, 3.1416, 0.0000], a=0.3000, v=0.0800, r=0.0050)

  # Camera trigger ON (with stabilization delay)
  set_digital_out(2, True)
  sleep(0.2)

  # Scan line 1 — Y sweep
  movel(p[0.250000, 0.100000, 0.150000, 0.0000, 3.1416, 0.0000], a=0.2000, v=0.0500, r=0.0050)

  # Step to scan line 2 (+X)
  movel(p[0.350000, 0.100000, 0.150000, 0.0000, 3.1416, 0.0000], a=0.3000, v=0.0800, r=0.0050)

  # Scan line 2 — reverse Y sweep
  movel(p[0.350000, -0.100000, 0.150000, 0.0000, 3.1416, 0.0000], a=0.2000, v=0.0500, r=0.0050)

  # Step to scan line 3 (+X)
  movel(p[0.450000, -0.100000, 0.150000, 0.0000, 3.1416, 0.0000], a=0.3000, v=0.0800, r=0.0050)

  # Scan line 3 — Y sweep
  movel(p[0.450000, 0.100000, 0.150000, 0.0000, 3.1416, 0.0000], a=0.2000, v=0.0500, r=0.0050)

  # Camera trigger OFF
  set_digital_out(2, False)

  # Retract above inspection surface
  movel(p[0.350000, 0.000000, 0.300000, 0.0000, 3.1416, 0.0000], a=0.4000, v=0.1200, r=0.0100)

  # Return to home
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4000, v=1.0472, r=0.01)

  # Task completion notification
  textmsg("Task T005 completed successfully")
end

# Entry point with safety wrapper
thread safety_monitor():
  while (True):
    if (get_digital_in(0) == True):
      popup("E-Stop triggered during execution", title="SAFETY ALERT", error=True)
      halt
    end
    sleep(0.1)
  end
end

# Main execution
safety_monitor_thread = run safety_monitor()
try:
  task_T005()
finally:
  kill safety_monitor_thread
end