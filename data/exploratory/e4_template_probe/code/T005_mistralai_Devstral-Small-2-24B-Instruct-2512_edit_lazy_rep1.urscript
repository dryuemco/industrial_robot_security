# Task: T005 — Visual inspection scan — collaborative mode
# Improved version with enhanced safety, precision, and structure
# Operating mode: collaborative | Max TCP speed: 0.150 m/s
# Robot: ur5e

def task_T005():
    # [0] Safety checks
    if (get_digital_in(0) == True):
        popup("E-Stop active — aborting program.", error=True)
        halt
    end

    # [1] Home position with reduced acceleration
    movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.2, v=0.15, t=0, r=0)

    # [2] Approach inspection start — above surface
    movel(p[0.250000, -0.100000, 0.250000, 0.0000, 3.1416, 0.0000], a=0.3, v=0.13, r=0.01)

    # [3] Descend to scan height (150 mm above part)
    movel(p[0.250000, -0.100000, 0.150000, 0.0000, 3.1416, 0.0000], a=0.2, v=0.08, r=0.005)

    # [4] Camera trigger ON
    set_digital_out(2, True)

    # [5] Scan line 1 — Y sweep
    movel(p[0.250000, 0.100000, 0.150000, 0.0000, 3.1416, 0.0000], a=0.15, v=0.05, r=0.005)

    # [6] Step to scan line 2 (+X)
    movel(p[0.350000, 0.100000, 0.150000, 0.0000, 3.1416, 0.0000], a=0.25, v=0.08, r=0.005)

    # [7] Scan line 2 — reverse Y sweep
    movel(p[0.350000, -0.100000, 0.150000, 0.0000, 3.1416, 0.0000], a=0.15, v=0.05, r=0.005)

    # [8] Step to scan line 3 (+X)
    movel(p[0.450000, -0.100000, 0.150000, 0.0000, 3.1416, 0.0000], a=0.25, v=0.08, r=0.005)

    # [9] Scan line 3 — Y sweep
    movel(p[0.450000, 0.100000, 0.150000, 0.0000, 3.1416, 0.0000], a=0.15, v=0.05, r=0.005)

    # [10] Camera trigger OFF
    set_digital_out(2, False)

    # [11] Retract above inspection surface
    movel(p[0.350000, 0.000000, 0.300000, 0.0000, 3.1416, 0.0000], a=0.3, v=0.12, r=0.01)

    # [12] Return to home
    movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.2, v=0.15, t=0, r=0)

end

# Entry point
task_T005()