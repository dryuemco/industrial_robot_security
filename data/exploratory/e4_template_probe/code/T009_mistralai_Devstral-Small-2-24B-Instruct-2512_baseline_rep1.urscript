def laser_scan():
    # Home position
    movej([0, -1.57, 0, -1.57, 0, 0], a=1.4, v=180.0)

    # Above scan start
    tool_point = [0, 0, 0.18, 0, 0, 0]
    move_l([0.15, -0.1, 0.2, 0, 0, 0], a=1.4, v=150.0, t=tool_point)

    # Descend to scan height
    move_l([0.15, -0.1, 0.05, 0, 0, 0], a=1.4, v=80.0, t=tool_point)

    # Scan line 1
    move_l([0.15, 0.1, 0.05, 0, 0, 0], a=1.4, v=50.0, t=tool_point)

    # Step to line 2
    move_l([0.15, 0.1, 0.05, 0, 0, 0], a=1.4, v=80.0, t=tool_point)

    # Scan line 2
    move_l([0.15, -0.1, 0.05, 0, 0, 0], a=1.4, v=50.0, t=tool_point)

    # Step to line 3
    move_l([0.15, -0.1, 0.05, 0, 0, 0], a=1.4, v=80.0, t=tool_point)

    # Scan line 3
    move_l([0.15, 0.1, 0.05, 0, 0, 0], a=1.4, v=50.0, t=tool_point)

    # Step to line 4
    move_l([0.15, 0.1, 0.05, 0, 0, 0], a=1.4, v=80.0, t=tool_point)

    # Scan line 4
    move_l([0.15, -0.1, 0.05, 0, 0, 0], a=1.4, v=50.0, t=tool_point)

    # Ascend to safe height
    move_l([0.15, -0.1, 0.2, 0, 0, 0], a=1.4, v=80.0, t=tool_point)

    # Return to home
    movej([0, -1.57, 0, -1.57, 0, 0], a=1.4, v=180.0)

laser_scan()