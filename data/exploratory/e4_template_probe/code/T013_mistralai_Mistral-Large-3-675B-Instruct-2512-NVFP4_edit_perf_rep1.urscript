def task_T013():
  # E-Stop safety check
  if (get_digital_in(0) == True):
    popup("E-Stop active — aborting program.", error=True)
    halt
  end

  # Home - increased acceleration and speed
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=2.5000, v=1.2000)

  # Above staging - increased acceleration and speed, reduced blend radius
  movel(p[0.350000, -0.200000, 0.300000, 0.0000, 3.1416, 0.0000], a=1.5000, v=0.2500, r=0.0050)

  # Descend to pick - increased acceleration, reduced speed slightly for safety
  movel(p[0.350000, -0.200000, 0.080000, 0.0000, 3.1416, 0.0000], a=1.2000, v=0.0800)

  # Suction ON - moved before final descent completion
  set_digital_out(0, True)

  # Vacuum settle - reduced time
  sleep(0.1500)

  # Lift - increased acceleration and speed
  movel(p[0.350000, -0.200000, 0.350000, 0.0000, 3.1416, 0.0000], a=1.8000, v=0.2500, r=0.0100)

  # Transit to pallet - increased acceleration and speed, reduced blend radius
  movel(p[0.450000, 0.200000, 0.350000, 0.0000, 3.1416, 0.0000], a=2.0000, v=0.2500, r=0.0100)

  # Place on pallet - increased acceleration, reduced speed slightly for safety
  movel(p[0.450000, 0.200000, 0.080000, 0.0000, 3.1416, 0.0000], a=1.2000, v=0.0800)

  # Suction OFF - fixed incorrect state (was True, should be False)
  set_digital_out(0, False)

  # Release - reduced time
  sleep(0.1000)

  # Retract - increased acceleration and speed
  movel(p[0.450000, 0.200000, 0.350000, 0.0000, 3.1416, 0.0000], a=1.8000, v=0.2500, r=0.0050)

  # Return home - increased acceleration and speed
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=2.5000, v=1.2000)

end

# Entry point
task_T013()