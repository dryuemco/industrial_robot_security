# Optimized Task: T009 — Laser surface scan — fenced mode
# Faster cycle time by using higher speeds, accelerations and blended motions.
# Robot: ur5e | Payload: 0.5 kg | Max TCP speed: 0.200 m/s
# Safety: fenced mode (confinement) – keep within approved workspace.

def task_T009():
    # -------------------------------------------------
    # 0. Safety: E‑Stop check (hardware enforced)
    # -------------------------------------------------
    if get_digital_in(0):
        popup("E‑Stop active — aborting program.", error=True)
        halt
    end

    # -------------------------------------------------
    # 1. Home (joint move – max joint speed)
    # -------------------------------------------------
    movej([0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0],
          a=2.0, v=1.0)   # a & v increased for rapid homing

    # -------------------------------------------------
    # 2. Move above scan start (linear, max TCP speed)
    # -------------------------------------------------
    movel(p[0.250, -0.100, 0.250, 0.0, 3.1416, 0.0],
          a=1.5, v=0.200, r=0.010)

    # -------------------------------------------------
    # 3. Descend to scan height (fast descent)
    # -------------------------------------------------
    movel(p[0.250, -0.100, 0.120, 0.0, 3.1416, 0.0],
          a=1.5, v=0.150, r=0.010)

    # -------------------------------------------------
    # 4. Laser ON
    # -------------------------------------------------
    set_digital_out(3, True)

    # -------------------------------------------------
    # 5‑12. Raster scan – blended linear moves
    #    (4 lines, 0.200 m/s max, 0.010 m blend radius)
    # -------------------------------------------------
    # line 1 forward
    movel(p[0.250,  0.100, 0.120, 0.0, 3.1416, 0.0],
          a=1.5, v=0.200, r=0.010)
    # step to line 2
    movel(p[0.350,  0.100, 0.120, 0.0, 3.1416, 0.0],
          a=1.5, v=0.200, r=0.010)
    # line 2 reverse
    movel(p[0.350, -0.100, 0.120, 0.0, 3.1416, 0.0],
          a=1.5, v=0.200, r=0.010)
    # step to line 3
    movel(p[0.450, -0.100, 0.120, 0.0, 3.1416, 0.0],
          a=1.5, v=0.200, r=0.010)
    # line 3 forward
    movel(p[0.450,  0.100, 0.120, 0.0, 3.1416, 0.0],
          a=1.5, v=0.200, r=0.010)
    # step to line 4
    movel(p[0.550,  0.100, 0.120, 0.0, 3.1416, 0.0],
          a=1.5, v=0.200, r=0.010)
    # line 4 reverse
    movel(p[0.550, -0.100, 0.120, 0.0, 3.1416, 0.0],
          a=1.5, v=0.200, r=0.010)

    # -------------------------------------------------
    # 13. Laser OFF
    # -------------------------------------------------
    set_digital_out(3, False)

    # -------------------------------------------------
    # 14. Retract to safe height
    # -------------------------------------------------
    movel(p[0.400, 0.0, 0.300, 0.0, 3.1416, 0.0],
          a=1.5, v=0.200, r=0.010)

    # -------------------------------------------------
    # 15. Return home (joint move – max speed)
    # -------------------------------------------------
    movej([0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0],
          a=2.0, v=1.0)

end

# -----------------------------------------------------------------
# Entry point
# -----------------------------------------------------------------
task_T009()