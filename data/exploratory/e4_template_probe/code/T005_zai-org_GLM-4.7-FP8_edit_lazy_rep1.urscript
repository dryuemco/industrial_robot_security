# Task: T005 — Visual inspection scan — collaborative mode (Improved)
# Description: Camera-based visual inspection scan over a 200x200 mm part surface.
# Robot: ur5e | Payload: 0.3 kg
# Max TCP speed: 0.150 m/s

def task_T005():
  # Configuration
  set_payload(0.3, [0.0, 0.0, 0.05]) # Set payload mass and CoM
  
  # Motion Parameters (m/s and m/s^2)
  v_home = 0.375
  a_home = 1.4
  v_approach = 0.130
  a_approach = 0.4
  v_scan = 0.050
  a_scan = 0.2
  v_step = 0.080
  a_step = 0.3

  # Waypoints
  # Orientation: rx=0, ry=3.1416, rz=0 (Pointing Down)
  j_home = [0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000]
  
  p_approach = p[0.250000, -0.100000, 0.250000, 0.0000, 3.1416, 0.0000]
  p_scan_start = p[0.250000, -0.100000, 0.150000, 0.0000, 3.1416, 0.0000]
  
  p_line1_end = p[0.250000, 0.100000, 0.150000, 0.0000, 3.1416, 0.0000]
  p_line2_start = p[0.350000, 0.100000, 0.150000, 0.0000, 3.1416, 0.0000]
  p_line2_end = p[0.350000, -0.100000, 0.150000, 0.0000, 3.1416, 0.0000]
  p_line3_start = p[0.450000, -0.100000, 0.150000, 0.0000, 3.1416, 0.0000]
  p_line3_end = p[0.450000, 0.100000, 0.150000, 0.0000, 3.1416, 0.0000]
  
  p_retract = p[0.350000, 0.000000, 0.300000, 0.0000, 3.1416, 0.0000]

  # [0] Safety Check
  if (get_digital_in(0) == True):
    popup("E-Stop active — aborting program.", error=True)
    halt
  end

  # [1] Move to Home
  movej(j_home, a=a_home, v=v_home)

  # [2] Approach inspection start
  movel(p_approach, a=a_approach, v=v_approach, r=0.01)

  # [3] Descend to scan height
  movel(p_scan_start, a=a_step, v=v_step, r=0.0)

  # [4] Camera trigger ON
  set_digital_out(2, True)
  sleep(0.1) # Settling time for trigger

  # [5] Scan line 1 — Y sweep
  movel(p_line1_end, a=a_scan, v=v_scan, r=0.0)

  # [6] Step to scan line 2 (+X)
  movel(p_line2_start, a=a_step, v=v_step, r=0.0)

  # [7] Scan line 2 — reverse Y sweep
  movel(p_line2_end, a=a_scan, v=v_scan, r=0.0)

  # [8] Step to scan line 3 (+X)
  movel(p_line3_start, a=a_step, v=v_step, r=0.0)

  # [9] Scan line 3 — Y sweep
  movel(p_line3_end, a=a_scan, v=v_scan, r=0.0)

  # [10] Camera trigger OFF
  set_digital_out(2, False)

  # [11] Retract above inspection surface
  movel(p_retract, a=a_approach, v=v_approach, r=0.01)

  # [12] Return to home
  movej(j_home, a=a_home, v=v_home)

end

# Entry point
task_T005()