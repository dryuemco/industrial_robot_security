# Optimized Task: T004 — Multi-waypoint SSM pick‑place with obstacle avoidance
# Collaborative mode, max TCP speed 0.250 m/s, payload 1.5 kg
# Optimizations: higher speeds/accelerations, reduced dwell times, larger blend radii

def task_T004():
  # Safety: ensure E‑Stop is not active
  if get_digital_in(0):
    popup("E‑Stop active — aborting program.", error=True)
    halt
  end

  # Set payload and TCP (adjust as needed for the actual end‑effector)
  set_payload(1.5, [0,0,0.1])   # 1.5 kg, CoG offset
  set_tcp(p[0,0,0.1,0,0,0])     # example TCP, modify for real tool

  # Home position – faster joint motion
  movej([0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0],
        a=2.0, v=1.0, r=0.0)

  # ---- Pick Phase ---------------------------------------------------------
  # Above pick station
  movel(p[0.400, -0.250, 0.350, 0.0, 3.1416, 0.0],
        a=1.2, v=0.250, r=0.04)

  # Descend to pick – keep a lower speed for safety/precision
  movel(p[0.400, -0.250, 0.100, 0.0, 3.1416, 0.0],
        a=0.8, v=0.120, r=0.01)

  # Close gripper
  set_digital_out(0, True)
  sleep(0.10)   # reduced settle time

  # Lift above pick
  movel(p[0.400, -0.250, 0.400, 0.0, 3.1416, 0.0],
        a=1.2, v=0.250, r=0.04)

  # ---- Transport Phase ----------------------------------------------------
  # Obstacle avoidance waypoint (offset in -X)
  movel(p[0.250, 0.000, 0.400, 0.0, 3.1416, 0.0],
        a=1.2, v=0.250, r=0.05)

  # Above place station
  movel(p[0.400, 0.250, 0.400, 0.0, 3.1416, 0.0],
        a=1.2, v=0.250, r=0.04)

  # Descend to place
  movel(p[0.400, 0.250, 0.100, 0.0, 3.1416, 0.0],
        a=0.8, v=0.120, r=0.01)

  # Open gripper
  set_digital_out(0, False)
  sleep(0.10)   # reduced release settle time

  # Retract above place
  movel(p[0.400, 0.250, 0.400, 0.0, 3.1416, 0.0],
        a=1.2, v=0.250, r=0.04)

  # Return to home
  movej([0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0],
        a=2.0, v=1.0, r=0.0)

end

# Entry point
task_T004()