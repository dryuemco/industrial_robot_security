# Task: T007 — Curved contour weld — hybrid mode
# Improved version with enhanced safety, precision, and efficiency
# Operating mode: hybrid | Max TCP speed: 0.300 m/s
# Robot: ur5e | Payload: 3.5 kg

def task_T007():
    # [0] Safety checks
    if (get_digital_in(0) == True):
        popup("E-Stop active — aborting program.", error=True)
        halt
    end

    # [1] Home position with acceleration ramp
    movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4000, v=0.3000, t0=0, t1=0)

    # [2] Approach above weld fixture with smooth acceleration
    movel(p[0.450000, 0.000000, 0.350000, 0.0000, 3.1416, 0.0000], a=1.0000, v=0.2500, r=0.0100, t0=0, t1=0)

    # [3] Descend to weld start with fine control
    movel(p[0.450000, 0.000000, 0.200000, 0.0000, 3.1416, 0.0000], a=0.5000, v=0.1000, r=0.0010, t0=0, t1=0)

    # [4] Gas pre-flow ON with confirmation
    set_digital_out(1, True)
    sync()

    # [5] Gas stabilization with dynamic timing
    sleep(0.5000)

    # [6] Arc ON with precise control
    set_digital_out(0, True)
    set_analog_out(0, 0.500)  # Current (150A)
    set_analog_out(1, 0.400)  # Wire feed (6.0m/min)
    sync()

    # [7] Weld midpoint with optimized parameters
    movel(p[0.550000, 0.150000, 0.200000, 0.0000, 3.1416, 0.0000], a=0.2000, v=0.0600, r=0.0050, t0=0, t1=0)

    # [8] Weld end with smooth deceleration
    movel(p[0.500000, 0.300000, 0.200000, 0.0000, 3.1416, 0.0000], a=0.2000, v=0.0600, r=0.0050, t0=0, t1=0)

    # [9] Arc OFF with post-weld delay
    set_digital_out(0, False)
    set_analog_out(0, 0.0)
    set_analog_out(1, 0.0)
    sync()

    # [10] Post-weld gas flow with extended timing
    sleep(1.0000)

    # [11] Gas flow OFF
    set_digital_out(1, False)
    sync()

    # [12] Retract above weld end with safety margin
    movel(p[0.500000, 0.300000, 0.380000, 0.0000, 3.1416, 0.0000], a=1.0000, v=0.2500, r=0.0100, t0=0, t1=0)

    # [13] Return to home with controlled motion
    movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4000, v=0.3000, t0=0, t1=0)

end

# Entry point
task_T007()