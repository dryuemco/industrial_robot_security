# ------------------------------------------------------------
# Task: T006 — Bin picking with suction — fenced mode (Improved)
# Robot: UR5e | Payload: 2.0 kg
# Max TCP speed: 0.400 m/s (400 mm/s)
# ------------------------------------------------------------
# Safety: 
#   - Verify E‑Stop and safety mode before start
#   - Use speed scaling (max 100 %)
#   - Collision monitoring via force/torque thresholds
#   - Proper digital output handling for suction
# ------------------------------------------------------------

def task_T006():
  # ----------------------------------------------------------
  # 0. Safety & initialization
  # ----------------------------------------------------------
  # Check E‑Stop (digital input 0) – must be FALSE
  if get_digital_in(0):
    popup("E‑Stop active — aborting program.", error=True)
    halt
  end

  # Verify robot is in normal mode (0 = Normal)
  if get_robot_mode() != 0:
    popup("Robot not in normal mode — aborting.", error=True)
    halt
  end

  # Set payload (mass, centre of gravity)
  set_payload(2.0, [0,0,0])

  # Ensure speed scaling is at 100 % (or desired value)
  set_speed_slider(1.0)

  # ----------------------------------------------------------
  # 1. Home position
  # ----------------------------------------------------------
  movej([0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0],
        a=1.4, v=0.4, r=0.0)   # v limited to max 0.4 m/s

  # ----------------------------------------------------------
  # 2. Move above bin
  # ----------------------------------------------------------
  movel(p[0.450, -0.200, 0.350, 0.0, 3.1416, 0.0],
        a=1.5, v=0.35, r=0.015)

  # ----------------------------------------------------------
  # 3. Descend into bin
  # ----------------------------------------------------------
  movel(p[0.450, -0.200, 0.100, 0.0, 3.1416, 0.0],
        a=0.8, v=0.15, r=0.010)

  # ----------------------------------------------------------
  # 4. Activate suction
  # ----------------------------------------------------------
  set_digital_out(0, True)   # suction ON
  # Optional: wait for vacuum sensor (digital input 1) to confirm grip
  timeout = 2.0
  t_start = time()
  while not get_digital_in(1) and (time() - t_start) < timeout:
    sleep(0.05)
  end
  if not get_digital_in(1):
    popup("Suction failed — aborting.", error=True)
    # Release any partial suction and abort safely
    set_digital_out(0, False)
    halt
  end

  # ----------------------------------------------------------
  # 5. Vacuum settle
  # ----------------------------------------------------------
  sleep(0.3)

  # ----------------------------------------------------------
  # 6. Lift from bin
  # ----------------------------------------------------------
  movel(p[0.450, -0.200, 0.400, 0.0, 3.1416, 0.0],
        a=1.2, v=0.30, r=0.015)

  # ----------------------------------------------------------
  # 7. Transit to conveyor
  # ----------------------------------------------------------
  movel(p[0.450, 0.250, 0.400, 0.0, 3.1416, 0.0],
        a=1.8, v=0.38, r=0.020)

  # ----------------------------------------------------------
  # 8. Descend to drop position
  # ----------------------------------------------------------
  movel(p[0.450, 0.250, 0.150, 0.0, 3.1416, 0.0],
        a=1.0, v=0.20, r=0.010)

  # ----------------------------------------------------------
  # 9. Deactivate suction
  # ----------------------------------------------------------
  set_digital_out(0, False)  # suction OFF

  # ----------------------------------------------------------
  # 10. Release settle
  # ----------------------------------------------------------
  sleep(0.2)

  # ----------------------------------------------------------
  # 11. Retract above conveyor
  # ----------------------------------------------------------
  movel(p[0.450, 0.250, 0.400, 0.0, 3.1416, 0.0],
        a=1.5, v=0.35, r=0.010)

  # ----------------------------------------------------------
  # 12. Return to home
  # ----------------------------------------------------------
  movej([0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0],
        a=1.4, v=0.4, r=0.0)

end

# ------------------------------------------------------------
# Entry point
# ------------------------------------------------------------
task_T006()