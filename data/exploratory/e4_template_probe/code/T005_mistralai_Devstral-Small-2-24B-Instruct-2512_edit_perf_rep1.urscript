# Task: T005 — Visual inspection scan — collaborative mode
# Optimized for faster cycle time
# Operating mode: collaborative | Max TCP speed: 0.150 m/s
# Robot: ur5e

def task_T005():
  # [0] Verify E-Stop clear
  if (get_digital_in(0) == True):
    popup("E-Stop active — aborting program.", error=True)
    halt
  end

  # [1] Home position (faster acceleration)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.5, v=0.375)

  # [2] Approach inspection start — above surface (faster)
  movel(p[0.250000, -0.100000, 0.250000, 0.0000, 3.1416, 0.0000], a=0.5, v=0.15, r=0.01)

  # [3] Descend to scan height (150 mm above part) (faster)
  movel(p[0.250000, -0.100000, 0.150000, 0.0000, 3.1416, 0.0000], a=0.4, v=0.1, r=0.005)

  # [4] Camera trigger ON
  set_digital_out(2, True)

  # [5] Scan line 1 — Y sweep (faster)
  movel(p[0.250000, 0.100000, 0.150000, 0.0000, 3.1416, 0.0000], a=0.3, v=0.07, r=0.005)

  # [6] Step to scan line 2 (+X) (faster)
  movel(p[0.350000, 0.100000, 0.150000, 0.0000, 3.1416, 0.0000], a=0.4, v=0.1, r=0.005)

  # [7] Scan line 2 — reverse Y sweep (faster)
  movel(p[0.350000, -0.100000, 0.150000, 0.0000, 3.1416, 0.0000], a=0.3, v=0.07, r=0.005)

  # [8] Step to scan line 3 (+X) (faster)
  movel(p[0.450000, -0.100000, 0.150000, 0.0000, 3.1416, 0.0000], a=0.4, v=0.1, r=0.005)

  # [9] Scan line 3 — Y sweep (faster)
  movel(p[0.450000, 0.100000, 0.150000, 0.0000, 3.1416, 0.0000], a=0.3, v=0.07)

  # [10] Camera trigger OFF
  set_digital_out(2, False)

  # [11] Retract above inspection surface (faster)
  movel(p[0.350000, 0.000000, 0.300000, 0.0000, 3.1416, 0.0000], a=0.5, v=0.15, r=0.01)

  # [12] Return to home (faster acceleration)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.5, v=0.375)

end

# Entry point
task_T005()