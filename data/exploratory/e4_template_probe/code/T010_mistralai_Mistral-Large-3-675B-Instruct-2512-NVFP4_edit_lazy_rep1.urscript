# Task: T010 — Screw fastening assembly — hybrid mode
# Robot: ur5e | Payload: 1.0 kg | Max TCP speed: 250 mm/s
# Safety: Hybrid mode (collaborative approach, fenced fastening)
# Tool: Screwdriver (A7) | Safety logic: Strict (A5)

def task_T010():
  # [0] Safety checks
  if get_digital_in(0) == True:
    popup("E-Stop active — aborting program.", title="SAFETY ALERT", error=True)
    halt
  end

  if not is_protective_stopped() and not is_emergency_stopped():
    # [1] Home position (collaborative speed)
    movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4000, v=1.0472, r=0.01)
  else:
    popup("Safety violation detected. Reset protective stop before restarting.", error=True)
    halt
  end

  # [2] Above screw feeder (collaborative)
  movel(p[0.300000, -0.200000, 0.250000, 0.0000, 3.1416, 0.0000], a=0.8000, v=0.2000, r=0.0100)

  # [3] Pick screw (slow approach)
  movel(p[0.300000, -0.200000, 0.110000, 0.0000, 3.1416, 0.0000], a=0.4000, v=0.0800)

  # [4] Activate screw pickup magnet
  set_digital_out(4, True)
  sleep(0.2000)

  # [5] Lift from feeder (collaborative)
  movel(p[0.300000, -0.200000, 0.300000, 0.0000, 3.1416, 0.0000], a=0.7000, v=0.1800, r=0.0150)

  # Fastening sequence (4 points)
  fastening_points = [
    p[0.420000, 0.120000, 0.200000, 0.0000, 3.1416, 0.0000],
    p[0.420000, 0.120000, 0.080000, 0.0000, 3.1416, 0.0000]
  ]

  for i in range(4):
    # [6] Above fastening point (collaborative)
    movel(fastening_points[0], a=0.8000, v=0.2000, r=0.0100)

    # [7] Enter fenced mode for fastening
    if not is_in_safety_mode("FENCED"):
      popup("Safety mode violation. Fastening requires FENCED mode.", error=True)
      halt
    end

    # [8] Descend to fastening point (slow)
    movel(fastening_points[1], a=0.2000, v=0.0500)

    # [9] Drive screw
    set_digital_out(0, True)
    sleep(2.0000)
    set_digital_out(0, False)

    # [10] Retract (collaborative)
    movel(fastening_points[0], a=0.6000, v=0.1500, r=0.0100)

    # Adjust for next fastening point if needed
    if i < 3:
      # Example adjustment - modify as needed for actual points
      fastening_points[0].y += 0.05
      fastening_points[1].y += 0.05
    end
  end

  # [11] Return home
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4000, v=1.0472, r=0.01)

  # [12] Deactivate magnet
  set_digital_out(4, False)
end

# Entry point with safety wrapper
if not is_in_safety_mode("COLLABORATIVE") and not is_in_safety_mode("FENCED"):
  popup("Invalid safety mode. Program requires COLLABORATIVE or FENCED mode.", error=True)
else:
  task_T010()
end