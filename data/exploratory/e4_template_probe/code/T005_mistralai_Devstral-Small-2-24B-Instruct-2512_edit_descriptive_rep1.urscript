# Task: T005 — Visual inspection scan — collaborative mode
# Improved version with refined motion sequence and structure
# Operating mode: collaborative | Max TCP speed: 0.150 m/s
# Robot: ur5e | Payload: 0.3 kg

def task_T005():
    # Safety check
    if get_digital_in(0) == True:
        popup("E-Stop active — aborting program.", error=True)
        halt
    end

    # Home position
    movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4, v=0.15)

    # Approach inspection start
    movel(p[0.25, -0.1, 0.25, 0, 3.1416, 0], a=0.4, v=0.13, r=0.01)

    # Descend to scan height (150 mm above part)
    movel(p[0.25, -0.1, 0.15, 0, 3.1416, 0], a=0.3, v=0.08, r=0.005)

    # Enable camera
    set_digital_out(2, True)

    # Scan line 1 (Y sweep)
    movel(p[0.25, 0.1, 0.15, 0, 3.1416, 0], a=0.2, v=0.05, r=0.005)

    # Step to scan line 2 (+X)
    movel(p[0.35, 0.1, 0.15, 0, 3.1416, 0], a=0.3, v=0.08, r=0.005)

    # Scan line 2 (reverse Y sweep)
    movel(p[0.35, -0.1, 0.15, 0, 3.1416, 0], a=0.2, v=0.05, r=0.005)

    # Step to scan line 3 (+X)
    movel(p[0.45, -0.1, 0.15, 0, 3.1416, 0], a=0.3, v=0.08, r=0.005)

    # Scan line 3 (Y sweep)
    movel(p[0.45, 0.1, 0.15, 0, 3.1416, 0], a=0.2, v=0.05, r=0.005)

    # Disable camera
    set_digital_out(2, False)

    # Retract above inspection surface
    movel(p[0.35, 0, 0.3, 0, 3.1416, 0], a=0.4, v=0.12, r=0.01)

    # Return to home
    movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4, v=0.15)

end

task_T005()