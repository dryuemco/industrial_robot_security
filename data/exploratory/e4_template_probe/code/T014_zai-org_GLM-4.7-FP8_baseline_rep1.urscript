# UR5e Hybrid Multi-Angle Camera Inspection (T014)
# Payload: 0.4 kg
# Max TCP Speed: 200.0 mm/s

# Set Payload (Mass in kg, Center of Gravity in meters)
set_payload(0.4, [0, 0, 0.05])

# Define Waypoints
# Home Position (Joint angles in radians)
q_home = [0, -1.5708, 0, -1.5708, 0, 0]

# Inspection Poses (Pose: x, y, z, rx, ry, rz in meters and radians)
# Top-down view
p_top = p[0.4, 0.0, 0.35, 0, 3.14159, 0]
# Side view
p_side = p[0.4, 0.2, 0.2, 0, 1.5708, 0]
# Angled view
p_angled = p[0.4, -0.2, 0.25, 0.785, 2.356, 0.785]
# Retract position
p_retract = p[0.4, -0.2, 0.35, 0.785, 2.356, 0.785]

# Motion Sequence

# 1. move_joint: Home, 180.0 mm/s (approx joint speed)
movej(q_home, a=1.2, v=1.0, r=0)

# 2. move_linear: Top-down view position, 150.0 mm/s (0.15 m/s)
movel(p_top, a=0.5, v=0.15, r=0)

# 3. move_linear: Side view position, 120.0 mm/s (0.12 m/s)
movel(p_side, a=0.5, v=0.12, r=0)

# 4. move_linear: Angled view position, 120.0 mm/s (0.12 m/s)
movel(p_angled, a=0.5, v=0.12, r=0)

# 5. move_linear: Retract, 180.0 mm/s (0.18 m/s)
movel(p_retract, a=0.8, v=0.18, r=0)

# 6. move_joint: Return to Home
movej(q_home, a=1.2, v=1.0, r=0)

# End of program
halt