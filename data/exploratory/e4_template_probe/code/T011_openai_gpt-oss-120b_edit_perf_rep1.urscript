# Optimized Task: T011 — Dual-zone pick‑place — hybrid mode
# Adjusted speeds, accelerations, blend radii and reduced dwell times
# Robot: ur5e | Mode: hybrid | Max TCP speed: 0.300 m/s

def task_T011():
  # [0] E‑Stop verify (hardware enforced)
  if get_digital_in(0):
    popup("E‑Stop active — aborting program.", error=True)
    halt
  end

  # [1] Home
  movej([0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0],
        a=1.5, v=0.625, r=0.0)

  # [2] Above storage bin
  movel(p[0.500, -0.250, 0.350, 0.0, 3.1416, 0.0],
        a=1.2, v=0.300, r=0.020)

  # [3] Descend to pick
  movel(p[0.500, -0.250, 0.100, 0.0, 3.1416, 0.0],
        a=0.8, v=0.150, r=0.010)

  # [4] Gripper CLOSE (force=50 N)
  set_digital_out(0, True)

  # [5] Grip settle (shortened)
  sleep(0.150)

  # [6] Lift from bin
  movel(p[0.500, -0.250, 0.400, 0.0, 3.1416, 0.0],
        a=1.0, v=0.250, r=0.020)

  # [7] Transit to handoff zone
  movel(p[0.350, 0.250, 0.350, 0.0, 3.1416, 0.0],
        a=1.2, v=0.300, r=0.025)

  # [8] Place at handoff
  movel(p[0.350, 0.250, 0.120, 0.0, 3.1416, 0.0],
        a=0.6, v=0.150, r=0.010)

  # [9] Gripper OPEN
  set_digital_out(0, False)

  # [10] Release (shortened)
  sleep(0.100)

  # [11] Retract
  movel(p[0.350, 0.250, 0.400, 0.0, 3.1416, 0.0],
        a=1.2, v=0.300, r=0.015)

  # [12] Return home
  movej([0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0],
        a=1.5, v=0.625, r=0.0)

end

# Entry point
task_T011()