# URScript for UR5e Collaborative Pick-Place Task T001
# Compliance: ISO 10218:2025

# --- Configuration ---
MAX_TCP_SPEED = 0.25       # 250 mm/s
MAX_JOINT_ACCEL = 1.4      # 1.4 rad/s^2
MAX_LINEAR_ACCEL = 0.5     # m/s^2 (Conservative for collaborative mode)
PAYLOAD_MASS = 0.5         # kg
PAYLOAD_COG = [0.0, 0.0, 0.05] # Center of gravity (m)

# Safety Zone Definition (Operational Envelope)
# Exclusion Zone: Robot must stay within these bounds
ZONE_X_MIN = 0.1
ZONE_X_MAX = 0.6
ZONE_Y_MIN = -0.4
ZONE_Y_MAX = 0.4
ZONE_Z_MIN = 0.0
ZONE_Z_MAX = 0.5

# --- Safety Functions ---

def emergency_stop_handler(violation_type):
    stopj(1.0)
    popup("EMERGENCY STOP: " + violation_type, warning=False, error=True)
    halt

def check_safety_zone():
    current_pose = get_actual_tcp_pose()
    x = current_pose[0]
    y = current_pose[1]
    z = current_pose[2]
    
    if x < ZONE_X_MIN or x > ZONE_X_MAX or y < ZONE_Y_MIN or y > ZONE_Y_MAX or z < ZONE_Z_MIN or z > ZONE_Z_MAX:
        emergency_stop_handler("Safety Zone Boundary Violation")

def check_speed_limits():
    # Get current TCP speed vector [vx, vy, vz, wx, wy, wz]
    v_vec = get_actual_tcp_speed()
    # Calculate linear speed magnitude
    v_linear = sqrt(v_vec[0]*v_vec[0] + v_vec[1]*v_vec[1] + v_vec[2]*v_vec[2])
    
    if v_linear > MAX_TCP_SPEED:
        emergency_stop_handler("TCP Speed Limit Exceeded")

def safety_check():
    check_safety_zone()
    check_speed_limits()

def validate_workspace(target_pose):
    # Basic reach check (UR5e max reach approx 0.85m)
    dist = sqrt(target_pose[0]**2 + target_pose[1]**2 + target_pose[2]**2)
    if dist > 0.85:
        emergency_stop_handler("Target Out of Workspace")

# --- Main Program ---

# 1. Set Payload
set_payload(PAYLOAD_MASS, PAYLOAD_COG)

# Define Waypoints
# Home position (Joint space)
j_home = [-1.57, -1.57, -1.57, -1.57, -1.57, 0.0]

# Pick location (Cartesian space)
p_pick = [0.3, -0.2, 0.1, 3.14, 0, 0]
p_pick_approach = p_pick
p_pick_approach[2] = p_pick_approach[2] + 0.05 # 50mm approach height

# Place location (Cartesian space)
p_place = [0.3, 0.2, 0.1, 3.14, 0, 0]
p_place_approach = p_place
p_place_approach[2] = p_place_approach[2] + 0.05 # 50mm approach height

# --- Motion Sequence ---

# Move 1: Go to home position (200 mm/s)
safety_check()
movej(j_home, a=MAX_JOINT_ACCEL, v=0.2)

# Move 2: Approach pick point (200 mm/s)
safety_check()
validate_workspace(p_pick_approach)
movel(p_pick_approach, a=MAX_LINEAR_ACCEL, v=0.2)

# Move 3: Descend to pick (100 mm/s)
safety_check()
validate_workspace(p_pick)
movel(p_pick, a=MAX_LINEAR_ACCEL, v=0.1)

# (Simulated Gripper Action: Close)
# set_digital_out(0, True) 
# sleep(0.5)

# Move 4: Lift from pick (150 mm/s)
safety_check()
movel(p_pick_approach, a=MAX_LINEAR_ACCEL, v=0.15)

# Move 5: Transit to place approach (200 mm/s)
safety_check()
validate_workspace(p_place_approach)
movel(p_place_approach, a=MAX_LINEAR_ACCEL, v=0.2)

# Move 6: Descend to place (100 mm/s)
safety_check()
validate_workspace(p_place)
movel(p_place, a=MAX_LINEAR_ACCEL, v=0.1)

# (Simulated Gripper Action: Open)
# set_digital_out(0, False)
# sleep(0.5)

# Move 7: Lift from place (150 mm/s)
safety_check()
movel(p_place_approach, a=MAX_LINEAR_ACCEL, v=0.15)

# Move 8: Return to home (200 mm/s)
safety_check()
movej(j_home, a=MAX_JOINT_ACCEL, v=0.2)

# End of Task
textmsg("Task T001 Completed Successfully")