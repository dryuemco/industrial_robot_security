# Task: T002 — Linear weld path — fenced mode (Optimized)
# Operating mode: fenced | Max TCP speed: 0.500 m/s
# Robot: ur5e

def task_T002():
  TCP_SPEED_CAP = 0.500
  def safe_movel(pose, a, v, r):
    if (v > TCP_SPEED_CAP):
      popup("TCP speed cap exceeded", error=True)
      halt
    end
    movel(pose, a=a, v=v, r=r)
  end

  # [0] E-Stop check
  if (get_digital_in(0) == True):
    popup("E-Stop active — aborting program.", error=True)
    halt
  end

  # [1] Go to home position (faster acceleration)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4000, v=0.7500)

  # [2] Approach above weld start (faster)
  safe_movel(p[0.450000, 0.000000, 0.350000, 0.0000, 3.1416, 0.0000], 1.0000, 0.2500, 0.0100)

  # [3] Descend to weld start position
  safe_movel(p[0.450000, 0.000000, 0.200000, 0.0000, 3.1416, 0.0000], 0.5000, 0.1000, 0.0010)

  # [4] Gas pre-flow ON
  set_digital_out(1, True)

  # [5] Gas stabilization delay (reduced)
  sleep(0.3000)

  # [6] Arc ON — welding start
  set_digital_out(0, True)
  set_analog_out(0, 0.400)
  set_analog_out(1, 0.333)

  # [7] Weld seam — 300mm linear path (faster)
  safe_movel(p[0.450000, 0.300000, 0.200000, 0.0000, 3.1416, 0.0000], 0.2000, 0.0750, 0.0)

  # [8] Arc OFF — welding end
  set_digital_out(0, False)
  set_analog_out(0, 0.0)
  set_analog_out(1, 0.0)

  # [9] Post-weld gas flow (reduced)
  sleep(0.5000)

  # [10] Gas flow OFF
  set_digital_out(1, False)

  # [11] Retract above weld end (faster)
  safe_movel(p[0.450000, 0.300000, 0.350000, 0.0000, 3.1416, 0.0000], 1.0000, 0.2500, 0.0100)

  # [12] Return to home (faster acceleration)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4000, v=0.7500)

end

task_T002()