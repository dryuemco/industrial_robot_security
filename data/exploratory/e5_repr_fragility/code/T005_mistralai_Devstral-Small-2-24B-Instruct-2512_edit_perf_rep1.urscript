# Task: T005 — Visual inspection scan — collaborative mode
# Optimized for faster cycle time
# Operating mode: collaborative | Max TCP speed: 0.150 m/s
# Robot: ur5e

def task_T005():
  TCP_SPEED_CAP = 0.150
  def safe_movel(pose, a, v, r):
    if (v > TCP_SPEED_CAP):
      popup("TCP speed cap exceeded", error=True)
      halt
    end
    movel(pose, a=a, v=v, r=r)
  end

  # [1] Home position (faster acceleration)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.5708, v=0.3750)

  # [2] Approach inspection start — above surface (increased speed)
  safe_movel(p[0.250000, -0.100000, 0.250000, 0.0000, 3.1416, 0.0000], 0.4000, 0.1500, 0.0100)

  # [3] Descend to scan height (150 mm above part) (increased speed)
  safe_movel(p[0.250000, -0.100000, 0.150000, 0.0000, 3.1416, 0.0000], 0.3000, 0.1000, 0.0050)

  # [4] Camera trigger ON
  set_digital_out(2, True)

  # [5] Scan line 1 — Y sweep (increased speed)
  safe_movel(p[0.250000, 0.100000, 0.150000, 0.0000, 3.1416, 0.0000], 0.2000, 0.0800, 0.0050)

  # [6] Step to scan line 2 (+X) (increased speed)
  safe_movel(p[0.350000, 0.100000, 0.150000, 0.0000, 3.1416, 0.0000], 0.3000, 0.1000, 0.0050)

  # [7] Scan line 2 — reverse Y sweep (increased speed)
  safe_movel(p[0.350000, -0.100000, 0.150000, 0.0000, 3.1416, 0.0000], 0.2000, 0.0800, 0.0050)

  # [8] Step to scan line 3 (+X) (increased speed)
  safe_movel(p[0.450000, -0.100000, 0.150000, 0.0000, 3.1416, 0.0000], 0.3000, 0.1000, 0.0050)

  # [9] Scan line 3 — Y sweep (increased speed)
  safe_movel(p[0.450000, 0.100000, 0.150000, 0.0000, 3.1416, 0.0000], 0.2000, 0.0800, 0.0050)

  # [10] Camera trigger OFF
  set_digital_out(2, False)

  # [11] Retract above inspection surface (increased speed)
  safe_movel(p[0.350000, 0.000000, 0.300000, 0.0000, 3.1416, 0.0000], 0.4000, 0.1500, 0.0100)

  # [12] Return to home (faster acceleration)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.5708, v=0.3750)

end

# Entry point
task_T005()