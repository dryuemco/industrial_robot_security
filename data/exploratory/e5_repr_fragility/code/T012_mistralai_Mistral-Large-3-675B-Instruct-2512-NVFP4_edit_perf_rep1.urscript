# Task: T012 — Collaborative spot welding — 3 points
# Optimized for faster cycle time while maintaining safety

def task_T012():
  TCP_SPEED_CAP = 0.250
  WELD_DWELL = 0.350
  HOME_POSE = [0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000]
  WELD_ON = [set_digital_out(0, True), set_analog_out(0, 0.267), set_analog_out(1, 0.000)]
  WELD_OFF = [set_digital_out(0, False), set_analog_out(0, 0.0), set_analog_out(1, 0.0)]

  def safe_movel(pose, a, v, r=0):
    movel(pose, a=a, v=min(v, TCP_SPEED_CAP), r=r)
  end

  # Safety check
  if get_digital_in(0):
    popup("E-Stop active — aborting program.", error=True)
    halt
  end

  # Home position
  movej(HOME_POSE, a=1.4, v=1.05)

  # Spot 1
  safe_movel(p[0.35, -0.1, 0.25, 0, 3.1416, 0], a=1.2, v=0.25, r=0.01)
  safe_movel(p[0.35, -0.1, 0.1, 0, 3.1416, 0], a=0.8, v=0.1)
  WELD_ON
  sleep(WELD_DWELL)
  WELD_OFF
  safe_movel(p[0.35, -0.1, 0.25, 0, 3.1416, 0], a=1.2, v=0.2, r=0.01)

  # Spot 2
  safe_movel(p[0.45, 0.0, 0.25, 0, 3.1416, 0], a=1.2, v=0.25, r=0.015)
  safe_movel(p[0.45, 0.0, 0.1, 0, 3.1416, 0], a=0.8, v=0.1)
  WELD_ON
  sleep(WELD_DWELL)
  WELD_OFF
  safe_movel(p[0.45, 0.0, 0.3, 0, 3.1416, 0], a=1.2, v=0.2, r=0.01)

  # Spot 3
  safe_movel(p[0.35, 0.1, 0.25, 0, 3.1416, 0], a=1.2, v=0.25, r=0.015)
  safe_movel(p[0.35, 0.1, 0.1, 0, 3.1416, 0], a=0.8, v=0.1)
  WELD_ON
  sleep(WELD_DWELL)
  WELD_OFF
  safe_movel(p[0.35, 0.1, 0.25, 0, 3.1416, 0], a=1.2, v=0.2, r=0.01)

  # Return home
  movej(HOME_POSE, a=1.4, v=1.05)
end

task_T012()