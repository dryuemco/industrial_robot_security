# Task: T011 — Dual-zone pick-place — hybrid mode (Optimized)
# Operating mode: hybrid | Max TCP speed: 0.300 m/s
# Robot: ur5e

def task_T011():
  TCP_SPEED_CAP = 0.300
  def safe_movel(pose, a, v, r):
    if (v > TCP_SPEED_CAP):
      popup("TCP speed cap exceeded", error=True)
      halt
    end
    movel(pose, a=a, v=v, r=r)
  end

  # [0] E-Stop verify
  if (get_digital_in(0) == True):
    popup("E-Stop active — aborting program.", error=True)
    halt
  end

  # [1] Home (optimized acceleration)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.8000, v=0.6250)

  # [2] Above storage bin (optimized speed)
  safe_movel(p[0.500000, -0.250000, 0.350000, 0.0000, 3.1416, 0.0000], 1.2000, 0.2800, 0.0150)

  # [3] Descend to pick (optimized acceleration)
  safe_movel(p[0.500000, -0.250000, 0.100000, 0.0000, 3.1416, 0.0000], 0.6000, 0.1200, 0.0)

  # [4] Gripper CLOSE
  set_digital_out(0, True)

  # [5] Grip settle (reduced sleep)
  sleep(0.2000)

  # [6] Lift from bin (optimized speed)
  safe_movel(p[0.500000, -0.250000, 0.400000, 0.0000, 3.1416, 0.0000], 1.0000, 0.2000, 0.0150)

  # [7] Transit to handoff zone (optimized speed)
  safe_movel(p[0.350000, 0.250000, 0.350000, 0.0000, 3.1416, 0.0000], 1.2000, 0.2800, 0.0200)

  # [8] Place at handoff (optimized acceleration)
  safe_movel(p[0.350000, 0.250000, 0.120000, 0.0000, 3.1416, 0.0000], 0.5000, 0.1200, 0.0)

  # [9] Gripper OPEN
  set_digital_out(0, False)

  # [10] Release (reduced sleep)
  sleep(0.1500)

  # [11] Retract (optimized speed)
  safe_movel(p[0.350000, 0.250000, 0.400000, 0.0000, 3.1416, 0.0000], 1.2000, 0.2800, 0.0100)

  # [12] Return home (optimized acceleration)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.8000, v=0.6250)

end

# Entry point
task_T011()