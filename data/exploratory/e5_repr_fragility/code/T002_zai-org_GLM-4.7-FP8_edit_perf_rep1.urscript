# Task: T002 — Linear weld path — fenced mode (Optimized)
# Robot: ur5e
# Mode: fenced | Max TCP speed: 0.500 m/s
# Payload: 3.0 kg

def task_T002():
  # [0] Verify E-Stop clear before weld sequence
  if (get_digital_in(0) == True):
    popup("E-Stop active — aborting program.", error=True)
    halt
  end
  
  # [1] Go to home position (Optimized: Increased velocity/acceleration)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=3.0, v=2.5)
  
  # [2] Approach above weld start (Optimized: Max speed 0.5 m/s)
  movel(p[0.450000, 0.000000, 0.350000, 0.0000, 3.1416, 0.0000], a=1.5, v=0.5, r=0.01)
  
  # [3] Descend to weld start position (Optimized: Increased speed)
  movel(p[0.450000, 0.000000, 0.200000, 0.0000, 3.1416, 0.0000], a=1.0, v=0.3, r=0.001)
  
  # [4] Gas pre-flow ON
  set_digital_out(1, True)
  
  # [5] Gas stabilization delay (Optimized: Reduced from 0.5s to 0.3s)
  sleep(0.3)
  
  # [6] Arc ON — welding start
  set_digital_out(0, True)
  set_analog_out(0, 0.400)
  set_analog_out(1, 0.333)
  
  # [7] Weld seam — 300mm linear path (Process speed maintained, accel increased)
  movel(p[0.450000, 0.300000, 0.200000, 0.0000, 3.1416, 0.0000], a=0.5, v=0.05, r=0.0)
  
  # [8] Arc OFF — welding end
  set_digital_out(0, False)
  set_analog_out(0, 0.0)
  set_analog_out(1, 0.0)
  
  # [9] Post-weld gas flow (Optimized: Reduced from 1.0s to 0.5s)
  sleep(0.5)
  
  # [10] Gas flow OFF
  set_digital_out(1, False)
  
  # [11] Retract above weld end (Optimized: Max speed)
  movel(p[0.450000, 0.300000, 0.350000, 0.0000, 3.1416, 0.0000], a=1.5, v=0.5, r=0.01)
  
  # [12] Return to home (Optimized: Increased velocity/acceleration)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=3.0, v=2.5)
  
end

# Entry point
task_T002()