# Task: T014 — Hybrid multi-angle camera inspection
# Optimized for faster cycle time
# Operating mode: hybrid | Max TCP speed: 0.200 m/s
# Robot: ur5e

def task_T014():
  TCP_SPEED_CAP = 0.200
  def safe_movel(pose, a, v, r):
    if (v > TCP_SPEED_CAP):
      popup("TCP speed cap exceeded", error=True)
      halt
    end
    movel(pose, a=a, v=v, r=r)
  end

  # [0] E-Stop verify
  if (get_digital_in(0) == True):
    popup("E-Stop active — aborting program.", error=True)
    halt
  end

  # [1] Home (faster acceleration)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.8000, v=0.5000)

  # [2] Top-down view position (increased speed)
  safe_movel(p[0.400000, 0.000000, 0.250000, 0.0000, 3.1416, 0.0000], 0.5000, 0.1800, 0.0100)

  # [3] Camera trigger ON
  set_digital_out(2, True)

  # [4] Capture top view (reduced sleep time)
  sleep(0.3000)

  # [5] Camera trigger OFF
  set_digital_out(2, False)

  # [6] Side view position (increased speed)
  safe_movel(p[0.400000, -0.150000, 0.150000, 0.0000, 3.1416, 0.0000], 0.4000, 0.1500, 0.0100)

  # [7] Camera trigger ON
  set_digital_out(2, True)

  # [8] Capture side view (reduced sleep time)
  sleep(0.3000)

  # [9] Camera trigger OFF
  set_digital_out(2, False)

  # [10] Angled view position (increased speed)
  safe_movel(p[0.350000, 0.100000, 0.200000, 0.0000, 3.1416, 0.0000], 0.4000, 0.1500, 0.0100)

  # [11] Camera trigger ON
  set_digital_out(2, True)

  # [12] Capture angled view (reduced sleep time)
  sleep(0.3000)

  # [13] Camera trigger OFF
  set_digital_out(2, False)

  # [14] Retract (increased speed)
  safe_movel(p[0.350000, 0.000000, 0.350000, 0.0000, 3.1416, 0.0000], 0.5000, 0.2000, 0.0100)

  # [15] Return home (faster acceleration)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.8000, v=0.5000)

end

# Entry point
task_T014()