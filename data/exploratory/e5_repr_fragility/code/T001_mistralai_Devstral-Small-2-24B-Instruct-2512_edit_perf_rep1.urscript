# Task: T001 — Optimized collaborative pick-place
# Robot: ur5e, Mode: collaborative
# Max TCP speed: 250.0 mm/s

def task_T001():
  TCP_SPEED_CAP = 0.250
  def safe_movel(pose, a, v, r):
    if (v > TCP_SPEED_CAP):
      popup("TCP speed cap exceeded", error=True)
      halt
    end
    movel(pose, a=a, v=v, r=r)
  end

  # [1] Go to home position (optimized acceleration)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4000, v=0.5000)

  # [2] Approach pick point (max speed)
  safe_movel(p[0.400000, 0.000000, 0.350000, 0.0000, 3.1416, 0.0000], 0.5000, 0.2000, 0.0100)

  # [3] Descend to pick (reduced acceleration for precision)
  safe_movel(p[0.400000, 0.000000, 0.200000, 0.0000, 3.1416, 0.0000], 0.3000, 0.1000, 0.0)

  # [4] Close gripper
  set_digital_out(0, True)

  # [5] Grip settle time (reduced)
  sleep(0.3000)

  # [6] Lift from pick (increased speed)
  safe_movel(p[0.400000, 0.000000, 0.350000, 0.0000, 3.1416, 0.0000], 0.5000, 0.2000, 0.0100)

  # [7] Transit to place approach (max speed)
  safe_movel(p[0.400000, 0.200000, 0.350000, 0.0000, 3.1416, 0.0000], 0.5000, 0.2000, 0.0100)

  # [8] Descend to place (reduced acceleration for precision)
  safe_movel(p[0.400000, 0.200000, 0.200000, 0.0000, 3.1416, 0.0000], 0.3000, 0.1000, 0.0)

  # [9] Open gripper
  set_digital_out(0, False)

  # [10] Release settle time (reduced)
  sleep(0.2000)

  # [11] Retract from place (max speed)
  safe_movel(p[0.400000, 0.200000, 0.350000, 0.0000, 3.1416, 0.0000], 0.5000, 0.2000, 0.0100)

  # [12] Return to home (optimized acceleration)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4000, v=0.5000)

end

# Entry point
task_T001()