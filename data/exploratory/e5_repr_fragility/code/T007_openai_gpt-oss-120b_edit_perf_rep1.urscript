# Optimized Task: T007 — Curved contour weld — hybrid mode
# Goal: Reduce cycle time while respecting safety and process limits.
# Robot: UR5e (Hybrid mode)
# Max TCP speed: 0.300 m/s | Max joint accel: 1.400 rad/s²

def task_T007():
  # -----------------------------------------------------------------
  # Configuration constants
  # -----------------------------------------------------------------
  TCP_SPEED_CAP = 0.300          # m/s
  JOINT_ACC_MAX = 1.400          # rad/s²
  # -----------------------------------------------------------------
  # Helper: safe linear move with speed cap enforcement
  # -----------------------------------------------------------------
  def safe_movel(pose, a, v, r):
    if (v > TCP_SPEED_CAP):
      popup("TCP speed cap exceeded", error=True)
      halt
    end
    movel(pose, a=a, v=v, r=r)
  end

  # -----------------------------------------------------------------
  # Safety check: E‑Stop must be cleared
  # -----------------------------------------------------------------
  if (get_digital_in(0) == True):
    popup("E‑Stop active — aborting program.", error=True)
    halt
  end

  # -----------------------------------------------------------------
  # 1) Home position (fast joint move)
  # -----------------------------------------------------------------
  movej([0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0],
        a=JOINT_ACC_MAX, v=0.750)

  # -----------------------------------------------------------------
  # 2) Approach above weld fixture (max TCP speed, high accel)
  # -----------------------------------------------------------------
  safe_movel(p[0.450, 0.0, 0.350, 0.0, 3.1416, 0.0],
             a=JOINT_ACC_MAX, v=TCP_SPEED_CAP, r=0.010)

  # -----------------------------------------------------------------
  # 3) Descend to weld start (still fast, but slower for safety)
  # -----------------------------------------------------------------
  safe_movel(p[0.450, 0.0, 0.200, 0.0, 3.1416, 0.0],
             a=JOINT_ACC_MAX, v=0.250, r=0.005)

  # -----------------------------------------------------------------
  # 4) Gas pre‑flow ON
  # -----------------------------------------------------------------
  set_digital_out(1, True)

  # -----------------------------------------------------------------
  # 5) Shortened gas stabilization (reduced from 0.5 s)
  # -----------------------------------------------------------------
  sleep(0.200)

  # -----------------------------------------------------------------
  # 6) Arc ON (welding parameters)
  # -----------------------------------------------------------------
  set_digital_out(0, True)          # arc enable
  set_analog_out(0, 0.500)           # current (norm.)
  set_analog_out(1, 0.400)           # wire feed (norm.)

  # -----------------------------------------------------------------
  # 7) Weld trajectory – use blended linear moves for continuous motion
  #    Increased weld speed modestly (0.080 m/s) while keeping quality.
  # -----------------------------------------------------------------
  safe_movel(p[0.550, 0.150, 0.200, 0.0, 3.1416, 0.0],
             a=JOINT_ACC_MAX, v=0.080, r=0.010)   # midpoint
  safe_movel(p[0.500, 0.300, 0.200, 0.0, 3.1416, 0.0],
             a=JOINT_ACC_MAX, v=0.080, r=0.010)   # end

  # -----------------------------------------------------------------
  # 8) Arc OFF
  # -----------------------------------------------------------------
  set_digital_out(0, False)
  set_analog_out(0, 0.0)
  set_analog_out(1, 0.0)

  # -----------------------------------------------------------------
  # 9) Shortened post‑weld gas flow (reduced from 1.0 s)
  # -----------------------------------------------------------------
  sleep(0.300)

  # -----------------------------------------------------------------
  # 10) Gas flow OFF
  # -----------------------------------------------------------------
  set_digital_out(1, False)

  # -----------------------------------------------------------------
  # 11) Retract above weld end (fast linear move)
  # -----------------------------------------------------------------
  safe_movel(p[0.500, 0.300, 0.380, 0.0, 3.1416, 0.0],
             a=JOINT_ACC_MAX, v=TCP_SPEED_CAP, r=0.010)

  # -----------------------------------------------------------------
  # 12) Return to home (fast joint move)
  # -----------------------------------------------------------------
  movej([0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0],
        a=JOINT_ACC_MAX, v=0.750)

end

# -----------------------------------------------------------------
# Entry point
# -----------------------------------------------------------------
task_T007()