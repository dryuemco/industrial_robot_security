# Task: T001 — Simple collaborative pick-place (Optimized)
# Operating mode: collaborative | Max TCP speed: 0.250 m/s
# Robot: ur5e
#
# Optimizations:
# - Increased linear speeds to max cap (0.25 m/s)
# - Increased accelerations for faster ramp-up
# - Increased blend radius (r) for non-critical waypoints
# - Reduced gripper settle times
# - Increased joint speeds for home movements

def task_T001():
  # [0] Verify E-Stop before start
  if (get_digital_in(0) == True):
    popup("E-Stop active — aborting program.", error=True)
    halt
  end
  
  # [1] Go to home position (Increased joint velocity)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4000, v=1.2000)
  
  # [2] Approach pick point (Max speed, higher accel, increased blend)
  movel(p[0.400000, 0.000000, 0.350000, 0.0000, 3.1416, 0.0000], a=1.2000, v=0.2500, r=0.0300)
  
  # [3] Descend to pick (Max speed, no blend for precision)
  movel(p[0.400000, 0.000000, 0.200000, 0.0000, 3.1416, 0.0000], a=1.2000, v=0.2500, r=0.0)
  
  # [4] Close gripper
  set_digital_out(0, True)
  
  # [5] Grip settle time (Reduced from 0.5s)
  sleep(0.1000)
  
  # [6] Lift from pick (Max speed, increased blend)
  movel(p[0.400000, 0.000000, 0.350000, 0.0000, 3.1416, 0.0000], a=1.2000, v=0.2500, r=0.0300)
  
  # [7] Transit to place approach (Max speed, increased blend)
  movel(p[0.400000, 0.200000, 0.350000, 0.0000, 3.1416, 0.0000], a=1.2000, v=0.2500, r=0.0300)
  
  # [8] Descend to place (Max speed, no blend for precision)
  movel(p[0.400000, 0.200000, 0.200000, 0.0000, 3.1416, 0.0000], a=1.2000, v=0.2500, r=0.0)
  
  # [9] Open gripper
  set_digital_out(0, False)
  
  # [10] Release settle time (Reduced from 0.3s)
  sleep(0.1000)
  
  # [11] Retract from place (Max speed, increased blend)
  movel(p[0.400000, 0.200000, 0.350000, 0.0000, 3.1416, 0.0000], a=1.2000, v=0.2500, r=0.0300)
  
  # [12] Return to home (Increased joint velocity)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4000, v=1.2000)
  
end

# Entry point
task_T001()