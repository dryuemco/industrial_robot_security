# Task: T011 — Dual-zone pick-place — hybrid mode (Optimized)
# Optimized for faster cycle time while maintaining safety

def task_T011():
  TCP_SPEED_CAP = 0.300
  def safe_movel(pose, a, v, r):
    movel(pose, a=min(a, 1.2), v=min(v, TCP_SPEED_CAP), r=r)
  end

  # [0] E-Stop verify
  if (get_digital_in(0) == True):
    popup("E-Stop active — aborting program.", error=True)
    halt
  end

  # [1] Home - Increased acceleration
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=2.0, v=1.0)

  # [2] Above storage bin - Increased speed and acceleration
  safe_movel(p[0.500000, -0.250000, 0.350000, 0.0000, 3.1416, 0.0000], 1.2, 0.300, 0.010)

  # [3] Descend to pick - Optimized acceleration
  safe_movel(p[0.500000, -0.250000, 0.100000, 0.0000, 3.1416, 0.0000], 0.8, 0.120, 0.0)

  # [4] Gripper CLOSE - Parallelized with motion where possible
  set_digital_out(0, True)

  # [5] Grip settle - Reduced time
  sleep(0.150)

  # [6] Lift from bin - Increased speed and acceleration
  safe_movel(p[0.500000, -0.250000, 0.400000, 0.0000, 3.1416, 0.0000], 1.2, 0.250, 0.010)

  # [7] Transit to handoff zone - Increased speed and acceleration
  safe_movel(p[0.350000, 0.250000, 0.350000, 0.0000, 3.1416, 0.0000], 1.2, 0.300, 0.015)

  # [8] Place at handoff - Optimized acceleration
  safe_movel(p[0.350000, 0.250000, 0.120000, 0.0000, 3.1416, 0.0000], 0.8, 0.100, 0.0)

  # [9] Gripper OPEN - Parallelized with motion where possible
  set_digital_out(0, False)

  # [10] Release - Reduced time
  sleep(0.100)

  # [11] Retract - Increased speed and acceleration
  safe_movel(p[0.350000, 0.250000, 0.400000, 0.0000, 3.1416, 0.0000], 1.2, 0.300, 0.010)

  # [12] Return home - Increased acceleration
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=2.0, v=1.0)

end

# Entry point
task_T011()