# Optimized Task: T011 — Dual-zone pick‑place — hybrid mode
# Robot: UR5e | Mode: hybrid | Max TCP speed: 0.300 m/s
# Payload: 1.2 kg
# Cycle time reduced by higher accelerations, increased speeds where safe,
# shorter gripper dwell times and blended motions.

def task_T011():
  # -----------------------------------------------------------------
  # Configuration
  # -----------------------------------------------------------------
  TCP_SPEED_CAP = 0.300          # m/s
  DEFAULT_ACC   = 1.400          # rad/s² for joint moves, m/s² for linear
  # Helper for speed‑capped linear moves with optional blending radius
  def safe_movel(pose, a, v, r):
    if v > TCP_SPEED_CAP then
      popup("TCP speed cap exceeded", error=True)
      halt
    end
    movel(pose, a=a, v=v, r=r)
  end

  # -----------------------------------------------------------------
  # Safety: E‑Stop check (hardware enforced, kept for simulation)
  # -----------------------------------------------------------------
  if get_digital_in(0) then
    popup("E‑Stop active — aborting program.", error=True)
    halt
  end

  # -----------------------------------------------------------------
  # 1) Home position
  # -----------------------------------------------------------------
  movej([0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0],
        a=DEFAULT_ACC, v=0.625)

  # -----------------------------------------------------------------
  # 2) Approach above storage bin (fast, blended)
  # -----------------------------------------------------------------
  safe_movel(p[0.500, -0.250, 0.350, 0.0, 3.1416, 0.0],
             a=DEFAULT_ACC, v=0.280, r=0.02)

  # -----------------------------------------------------------------
  # 3) Descend to pick (precise, no blend)
  # -----------------------------------------------------------------
  safe_movel(p[0.500, -0.250, 0.100, 0.0, 3.1416, 0.0],
             a=DEFAULT_ACC, v=0.150, r=0.0)

  # -----------------------------------------------------------------
  # 4) Close gripper
  # -----------------------------------------------------------------
  set_digital_out(0, True)      # close
  sleep(0.10)                    # reduced settle time

  # -----------------------------------------------------------------
  # 5) Lift from bin (blended into next move)
  # -----------------------------------------------------------------
  safe_movel(p[0.500, -0.250, 0.400, 0.0, 3.1416, 0.0],
             a=DEFAULT_ACC, v=0.250, r=0.02)

  # -----------------------------------------------------------------
  # 6) Transit to handoff zone (max speed, blended)
  # -----------------------------------------------------------------
  safe_movel(p[0.350, 0.250, 0.350, 0.0, 3.1416, 0.0],
             a=DEFAULT_ACC, v=0.300, r=0.02)

  # -----------------------------------------------------------------
  # 7) Place at handoff (precise)
  # -----------------------------------------------------------------
  safe_movel(p[0.350, 0.250, 0.120, 0.0, 3.1416, 0.0],
             a=DEFAULT_ACC, v=0.150, r=0.0)

  # -----------------------------------------------------------------
  # 8) Open gripper
  # -----------------------------------------------------------------
  set_digital_out(0, False)     # open
  sleep(0.10)                    # reduced release time

  # -----------------------------------------------------------------
  # 9) Retract upward (blended)
  # -----------------------------------------------------------------
  safe_movel(p[0.350, 0.250, 0.400, 0.0, 3.1416, 0.0],
             a=DEFAULT_ACC, v=0.300, r=0.02)

  # -----------------------------------------------------------------
  # 10) Return home
  # -----------------------------------------------------------------
  movej([0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0],
        a=DEFAULT_ACC, v=0.625)

end

# -----------------------------------------------------------------
# Entry point
# -----------------------------------------------------------------
task_T011()