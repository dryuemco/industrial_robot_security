def task_T013():
  TCP_SPEED_CAP = 0.250
  def safe_movel(pose, a, v, r):
    movel(pose, a=a, v=min(v, TCP_SPEED_CAP), r=r)
  end

  if (get_digital_in(0) == True):
    popup("E-Stop active — aborting program.", error=True)
    halt
  end

  home_pose = [0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000]
  above_staging = p[0.350000, -0.200000, 0.300000, 0.0000, 3.1416, 0.0000]
  pick_pose = p[0.350000, -0.200000, 0.080000, 0.0000, 3.1416, 0.0000]
  lift_pose = p[0.350000, -0.200000, 0.350000, 0.0000, 3.1416, 0.0000]
  transit_pose = p[0.450000, 0.200000, 0.350000, 0.0000, 3.1416, 0.0000]
  place_pose = p[0.450000, 0.200000, 0.080000, 0.0000, 3.1416, 0.0000]
  retract_pose = p[0.450000, 0.200000, 0.350000, 0.0000, 3.1416, 0.0000]

  movej(home_pose, a=1.4000, v=1.0000)

  safe_movel(above_staging, 1.2000, 0.2500, 0.0100)
  safe_movel(pick_pose, 0.8000, 0.2000, 0.0)

  set_digital_out(0, True)
  sleep(0.1500)

  safe_movel(lift_pose, 1.2000, 0.2500, 0.0150)
  safe_movel(transit_pose, 1.5000, 0.2500, 0.0150)
  safe_movel(place_pose, 0.8000, 0.2000, 0.0)

  set_digital_out(0, False)
  sleep(0.1000)

  safe_movel(retract_pose, 1.2000, 0.2500, 0.0100)
  movej(home_pose, a=1.4000, v=1.0000)
end

task_T013()