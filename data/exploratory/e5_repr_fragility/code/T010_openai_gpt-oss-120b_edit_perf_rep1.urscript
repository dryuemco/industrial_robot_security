# Optimized Task: T010 — Screw fastening assembly — hybrid mode
# Robot: UR5e | Payload: 1.0 kg | Max TCP speed: 0.250 m/s
# Safety: hybrid (collaborative approach, fenced fastening)

def task_T010():
    # -------------------------------------------------------------------------
    # Configuration
    # -------------------------------------------------------------------------
    TCP_SPEED_CAP = 0.250

    # Safe linear move with TCP speed cap check
    def safe_movel(pose, a, v, r):
        if (v > TCP_SPEED_CAP):
            popup("TCP speed cap exceeded", error=True)
            halt
        end
        movel(pose, a=a, v=v, r=r)
    end

    # -------------------------------------------------------------------------
    # Safety checks
    # -------------------------------------------------------------------------
    # E‑Stop (hardware enforced, but we abort if signal is active)
    if (get_digital_in(0) == True):
        popup("E‑Stop active — aborting program.", error=True)
        halt
    end

    # -------------------------------------------------------------------------
    # 1) Home position
    # -------------------------------------------------------------------------
    movej([0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0],
          a=1.4, v=0.5)

    # -------------------------------------------------------------------------
    # 2) Approach screw feeder (collaborative, max TCP speed)
    # -------------------------------------------------------------------------
    safe_movel(p[0.300, -0.200, 0.250, 0.0, 3.1416, 0.0],
               a=0.8, v=0.250, r=0.010)

    # -------------------------------------------------------------------------
    # 3) Pick screw (reduced speed for reliable pickup)
    # -------------------------------------------------------------------------
    safe_movel(p[0.300, -0.200, 0.110, 0.0, 3.1416, 0.0],
               a=0.4, v=0.080, r=0.0)

    # -------------------------------------------------------------------------
    # 4) Activate magnetic pickup
    # -------------------------------------------------------------------------
    set_digital_out(4, True)      # Magnet ON
    sleep(0.10)                    # Minimal settle time

    # -------------------------------------------------------------------------
    # 5) Lift screw (max TCP speed)
    # -------------------------------------------------------------------------
    safe_movel(p[0.300, -0.200, 0.300, 0.0, 3.1416, 0.0],
               a=0.7, v=0.250, r=0.015)

    # -------------------------------------------------------------------------
    # 6) Rapid travel to fastening zone (joint move – faster than linear)
    # -------------------------------------------------------------------------
    movej(p[0.420, 0.120, 0.200, 0.0, 3.1416, 0.0],
          a=1.4, v=0.250)

    # -------------------------------------------------------------------------
    # 7) Precise descent to fastening point 1
    # -------------------------------------------------------------------------
    safe_movel(p[0.420, 0.120, 0.080, 0.0, 3.1416, 0.0],
               a=0.2, v=0.080, r=0.0)

    # -------------------------------------------------------------------------
    # 8) Fasten screw
    # -------------------------------------------------------------------------
    set_digital_out(0, True)      # Screwdriver ON
    sleep(1.5)                     # Optimized fastening time
    set_digital_out(0, False)     # Screwdriver OFF

    # -------------------------------------------------------------------------
    # 9) Retract from fastening point (joint move for speed)
    # -------------------------------------------------------------------------
    movej(p[0.420, 0.120, 0.200, 0.0, 3.1416, 0.0],
          a=1.4, v=0.250)

    # -------------------------------------------------------------------------
    # 10) Return home
    # -------------------------------------------------------------------------
    movej([0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0],
          a=1.4, v=0.5)

    # -------------------------------------------------------------------------
    # Cleanup
    # -------------------------------------------------------------------------
    set_digital_out(4, False)     # Magnet OFF
end

# -------------------------------------------------------------------------
# Entry point
# -------------------------------------------------------------------------
task_T010()