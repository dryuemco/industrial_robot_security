# Optimized task: T013 — Collaborative suction palletizing (light boxes)
# Faster cycle time: increased speeds, reduced dwell, blended motions
# Robot: UR5e, collaborative mode, payload 0.8 kg, TCP speed cap 0.250 m/s

def task_T013():
    # -------------------------------------------------------------------------
    # Configuration
    # -------------------------------------------------------------------------
    TCP_SPEED_CAP = 0.250
    # Helper that enforces the TCP speed cap
    def safe_movel(pose, a, v, r):
        if v > TCP_SPEED_CAP then
            popup("TCP speed cap exceeded", error=True)
            halt
        end
        movel(pose, a=a, v=v, r=r)
    end

    # -------------------------------------------------------------------------
    # Safety check: E‑Stop
    # -------------------------------------------------------------------------
    if get_digital_in(0) then
        popup("E‑Stop active — aborting program.", error=True)
        halt
    end

    # -------------------------------------------------------------------------
    # Poses (pre‑computed for readability)
    # -------------------------------------------------------------------------
    pose_home      = p[0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000]
    pose_above_stg = p[0.3500, -0.2000, 0.3000, 0.0000, 3.1416, 0.0000]
    pose_pick      = p[0.3500, -0.2000, 0.0800, 0.0000, 3.1416, 0.0000]
    pose_lift      = p[0.3500, -0.2000, 0.3500, 0.0000, 3.1416, 0.0000]
    pose_above_pal = p[0.4500,  0.2000, 0.3500, 0.0000, 3.1416, 0.0000]
    pose_place     = p[0.4500,  0.2000, 0.0800, 0.0000, 3.1416, 0.0000]

    # -------------------------------------------------------------------------
    # 1) Home (fast joint motion)
    # -------------------------------------------------------------------------
    movej(pose_home, a=1.5, v=1.0)

    # -------------------------------------------------------------------------
    # 2) Approach staging area (max linear speed, small blend)
    # -------------------------------------------------------------------------
    safe_movel(pose_above_stg, a=0.7, v=0.250, r=0.010)

    # -------------------------------------------------------------------------
    # 3) Descend to pick (precise, no blend)
    # -------------------------------------------------------------------------
    safe_movel(pose_pick, a=0.4, v=0.100, r=0.0)

    # -------------------------------------------------------------------------
    # 4) Activate suction
    # -------------------------------------------------------------------------
    set_digital_out(0, True)   # suction ON

    # -------------------------------------------------------------------------
    # 5) Vacuum settle (shortened)
    # -------------------------------------------------------------------------
    sleep(0.10)

    # -------------------------------------------------------------------------
    # 6) Lift (max speed, blend into next move)
    # -------------------------------------------------------------------------
    safe_movel(pose_lift, a=0.6, v=0.250, r=0.015)

    # -------------------------------------------------------------------------
    # 7) Transit to pallet (max speed, blend)
    # -------------------------------------------------------------------------
    safe_movel(pose_above_pal, a=0.8, v=0.250, r=0.015)

    # -------------------------------------------------------------------------
    # 8) Place on pallet (precise)
    # -------------------------------------------------------------------------
    safe_movel(pose_place, a=0.4, v=0.100, r=0.0)

    # -------------------------------------------------------------------------
    # 9) Deactivate suction
    # -------------------------------------------------------------------------
    set_digital_out(0, False)  # suction OFF

    # -------------------------------------------------------------------------
    # 10) Release dwell (shortened)
    # -------------------------------------------------------------------------
    sleep(0.10)

    # -------------------------------------------------------------------------
    # 11) Retract (max speed, blend back to home)
    # -------------------------------------------------------------------------
    safe_movel(pose_above_pal, a=0.7, v=0.250, r=0.010)

    # -------------------------------------------------------------------------
    # 12) Return home (fast joint motion)
    # -------------------------------------------------------------------------
    movej(pose_home, a=1.5, v=1.0)

end

# -------------------------------------------------------------------------
# Entry point
# -------------------------------------------------------------------------
task_T013()