# Task: T003 — EUR-pallet 2x2 layer — hybrid mode
# Optimized for faster cycle time
# Operating mode: hybrid | Max TCP speed: 0.300 m/s
# Robot: ur5e

def task_T003():
  TCP_SPEED_CAP = 0.300
  def safe_movel(pose, a, v, r):
    if (v > TCP_SPEED_CAP):
      popup("TCP speed cap exceeded", error=True)
      halt
    end
    movel(pose, a=a, v=v, r=r)
  end

  # [1] Home position (faster joint move)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4000, v=0.6250)

  # [2] Approach conveyor pick — above (faster)
  safe_movel(p[0.500000, -0.300000, 0.350000, 0.0000, 3.1416, 0.0000], 1.0000, 0.2800, 0.0200)

  # [3] Descend to pick (faster)
  safe_movel(p[0.500000, -0.300000, 0.100000, 0.0000, 3.1416, 0.0000], 0.5000, 0.1200, 0.0)

  # [4] Gripper CLOSE — grasp box
  set_digital_out(0, True)

  # [5] Grip settle time (reduced)
  sleep(0.2000)

  # [6] Lift from conveyor (faster)
  safe_movel(p[0.500000, -0.300000, 0.400000, 0.0000, 3.1416, 0.0000], 0.8000, 0.2500, 0.0150)

  # [7] Transit to pallet position (0,0) (faster)
  safe_movel(p[0.500000, 0.300000, 0.400000, 0.0000, 3.1416, 0.0000], 1.2000, 0.2800, 0.0200)

  # [8] Descend to pallet place position (faster)
  safe_movel(p[0.500000, 0.300000, 0.120000, 0.0000, 3.1416, 0.0000], 0.5000, 0.1200, 0.0)

  # [9] Gripper OPEN — release box
  set_digital_out(0, False)

  # [10] Release settle (reduced)
  sleep(0.1500)

  # [11] Retract above pallet (faster)
  safe_movel(p[0.500000, 0.300000, 0.400000, 0.0000, 3.1416, 0.0000], 1.0000, 0.2500, 0.0100)

  # [12] Return to home (faster joint move)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4000, v=0.6250)

end

# Entry point
task_T003()