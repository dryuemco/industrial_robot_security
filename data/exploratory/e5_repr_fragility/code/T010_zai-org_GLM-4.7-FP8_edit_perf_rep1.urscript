# Task: T010 — Screw fastening assembly — hybrid mode (Optimized)
# Optimized for reduced cycle time: Increased accelerations, speeds, and blend radii.
# Operating mode: hybrid | Max TCP speed: 0.250 m/s
# Robot: ur5e

def task_T010():
  # Optimized Motion Parameters
  MAX_TCP_V = 0.250      # Max allowed TCP speed (m/s)
  HIGH_A = 1.2           # Increased acceleration for faster ramp-up (m/s^2)
  JOINT_V = 1.5          # Increased joint speed for large movements (rad/s)
  
  # [0] Verify E-Stop
  if (get_digital_in(0) == True):
    popup("E-Stop active — aborting program.", error=True)
    halt
  end
  
  # [1] Home - Increased joint speed
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4000, v=JOINT_V)
  
  # [2] Above screw feeder - Max speed, increased accel
  movel(p[0.300000, -0.200000, 0.250000, 0.0000, 3.1416, 0.0000], a=HIGH_A, v=MAX_TCP_V, r=0.0100)
  
  # [3] Pick screw - Precision move, stop required
  movel(p[0.300000, -0.200000, 0.110000, 0.0000, 3.1416, 0.0000], a=0.5000, v=0.0800, r=0.0)
  
  # [4] Screw pickup magnet ON
  set_digital_out(4, True)
  
  # [5] Magnet settle - Reduced sleep time
  sleep(0.1000)
  
  # [6] Lift from feeder - Max speed, increased blend radius to smooth transition
  movel(p[0.300000, -0.200000, 0.300000, 0.0000, 3.1416, 0.0000], a=HIGH_A, v=MAX_TCP_V, r=0.0500)
  
  # [7] Above fastening point 1 - Max speed
  movel(p[0.420000, 0.120000, 0.200000, 0.0000, 3.1416, 0.0000], a=HIGH_A, v=MAX_TCP_V, r=0.0100)
  
  # [8] Descend to fastening point 1 - Precision move, stop required
  movel(p[0.420000, 0.120000, 0.080000, 0.0000, 3.1416, 0.0000], a=0.5000, v=0.0500, r=0.0)
  
  # [9] Screwdriver ON — drive screw
  set_digital_out(0, True)
  
  # [10] Fastening time - Process time (fixed)
  sleep(2.0000)
  
  # [11] Screwdriver OFF - Fixed logic bug (was True, now False)
  set_digital_out(0, False)
  
  # [12] Retract from fastening - Max speed, increased blend radius
  movel(p[0.420000, 0.120000, 0.200000, 0.0000, 3.1416, 0.0000], a=HIGH_A, v=MAX_TCP_V, r=0.0500)
  
  # [13] Return home - Increased joint speed
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4000, v=JOINT_V)
  
end

# Entry point
task_T010()