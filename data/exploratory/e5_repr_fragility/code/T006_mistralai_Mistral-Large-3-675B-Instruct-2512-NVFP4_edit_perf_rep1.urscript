# Task: T006 — Bin picking with suction — fenced mode (Optimized)
# Optimized for faster cycle time while maintaining safety

def task_T006():
  TCP_SPEED_CAP = 0.400
  def safe_movel(pose, a, v, r):
    movel(pose, a=a, v=min(v, TCP_SPEED_CAP), r=r)
  end

  # [0] Verify E-Stop clear
  if (get_digital_in(0) == True):
    popup("E-Stop active — aborting program.", error=True)
    halt
  end

  # [1] Home position - increased acceleration
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=2.0000, v=1.2000)

  # [2] Above bin - increased speed and acceleration
  safe_movel(p[0.450000, -0.200000, 0.350000, 0.0000, 3.1416, 0.0000], 2.5000, 0.4000, 0.0100)

  # [3] Descend into bin - optimized acceleration
  safe_movel(p[0.450000, -0.200000, 0.100000, 0.0000, 3.1416, 0.0000], 1.2000, 0.1500, 0.0)

  # [4] Suction ON - parallel with motion
  set_digital_out(0, True)

  # [5] Lift from bin - increased speed and acceleration, reduced settle time
  safe_movel(p[0.450000, -0.200000, 0.400000, 0.0000, 3.1416, 0.0000], 2.0000, 0.4000, 0.0100)
  sleep(0.1000)

  # [6] Transit to conveyor - max speed and acceleration
  safe_movel(p[0.450000, 0.250000, 0.400000, 0.0000, 3.1416, 0.0000], 3.0000, 0.4000, 0.0150)

  # [7] Descend to drop - optimized acceleration
  safe_movel(p[0.450000, 0.250000, 0.150000, 0.0000, 3.1416, 0.0000], 1.5000, 0.2000, 0.0)

  # [8] Suction OFF - parallel with motion
  set_digital_out(0, False)

  # [9] Retract above conveyor - increased speed and acceleration
  safe_movel(p[0.450000, 0.250000, 0.400000, 0.0000, 3.1416, 0.0000], 2.5000, 0.4000, 0.0100)
  sleep(0.1000)

  # [10] Return to home - increased speed and acceleration
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=2.0000, v=1.2000)
end

# Entry point
task_T006()