# Task: T009 — Laser surface scan — fenced mode
# Optimized for faster cycle time
# Operating mode: fenced | Max TCP speed: 0.200 m/s
# Robot: ur5e

def task_T009():
  TCP_SPEED_CAP = 0.200
  def safe_movel(pose, a, v, r):
    if (v > TCP_SPEED_CAP):
      popup("TCP speed cap exceeded", error=True)
      halt
    end
    movel(pose, a=a, v=v, r=r)
  end

  # [1] Home (faster acceleration)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.8000, v=0.5000)

  # [2] Above scan start (faster)
  safe_movel(p[0.250000, -0.100000, 0.250000, 0.0000, 3.1416, 0.0000], 0.8000, 0.2000, 0.0100)

  # [3] Descend to scan height
  safe_movel(p[0.250000, -0.100000, 0.120000, 0.0000, 3.1416, 0.0000], 0.4000, 0.1000, 0.0050)

  # [4] Laser ON
  set_digital_out(3, True)

  # [5] Scan line 1 (faster)
  safe_movel(p[0.250000, 0.100000, 0.120000, 0.0000, 3.1416, 0.0000], 0.3000, 0.0800, 0.0050)

  # [6] Step to line 2 (faster)
  safe_movel(p[0.350000, 0.100000, 0.120000, 0.0000, 3.1416, 0.0000], 0.4000, 0.1000, 0.0050)

  # [7] Scan line 2 reverse (faster)
  safe_movel(p[0.350000, -0.100000, 0.120000, 0.0000, 3.1416, 0.0000], 0.3000, 0.0800, 0.0050)

  # [8] Step to line 3 (faster)
  safe_movel(p[0.450000, -0.100000, 0.120000, 0.0000, 3.1416, 0.0000], 0.4000, 0.1000, 0.0050)

  # [9] Scan line 3 (faster)
  safe_movel(p[0.450000, 0.100000, 0.120000, 0.0000, 3.1416, 0.0000], 0.3000, 0.0800, 0.0050)

  # [10] Step to line 4 (faster)
  safe_movel(p[0.550000, 0.100000, 0.120000, 0.0000, 3.1416, 0.0000], 0.4000, 0.1000, 0.0050)

  # [11] Scan line 4 reverse (faster)
  safe_movel(p[0.550000, -0.100000, 0.120000, 0.0000, 3.1416, 0.0000], 0.3000, 0.0800, 0.0050)

  # [12] Laser OFF
  set_digital_out(3, False)

  # [13] Retract (faster)
  safe_movel(p[0.400000, 0.000000, 0.300000, 0.0000, 3.1416, 0.0000], 0.8000, 0.2000, 0.0100)

  # [14] Return home (faster)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.8000, v=0.5000)

end

# Entry point
task_T009()