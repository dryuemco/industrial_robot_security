def task_T007():
  TCP_SPEED_CAP = 0.300
  def safe_movel(pose, a, v, r):
    if (v > TCP_SPEED_CAP):
      popup("TCP speed cap exceeded", error=True)
      halt
    end
    movel(pose, a=a, v=v, r=r)
  end

  if (get_digital_in(0) == True):
    popup("E-Stop active — aborting program.", error=True)
    halt
  end

  # [1] Home position - increased speed
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=2.0000, v=1.2000)

  # [2] Approach above weld fixture - increased speed
  safe_movel(p[0.450000, 0.000000, 0.350000, 0.0000, 3.1416, 0.0000], 1.5000, 0.3000, 0.0100)

  # [3] Descend to weld start - optimized acceleration
  safe_movel(p[0.450000, 0.000000, 0.200000, 0.0000, 3.1416, 0.0000], 1.0000, 0.1000, 0.0010)

  # [4] Gas pre-flow ON - parallel with motion
  set_digital_out(1, True)

  # [5] Gas stabilization - reduced time
  sleep(0.3000)

  # [6] Arc ON - parallel with motion start
  set_digital_out(0, True)
  set_analog_out(0, 0.500)
  set_analog_out(1, 0.400)

  # [7] Weld midpoint - increased speed while maintaining quality
  safe_movel(p[0.550000, 0.150000, 0.200000, 0.0000, 3.1416, 0.0000], 0.3000, 0.0800, 0.0050)

  # [8] Weld end - increased speed
  safe_movel(p[0.500000, 0.300000, 0.200000, 0.0000, 3.1416, 0.0000], 0.3000, 0.0800, 0.0)

  # [9] Arc OFF - parallel with motion start
  set_digital_out(0, False)
  set_analog_out(0, 0.0)
  set_analog_out(1, 0.0)

  # [10] Post-weld gas flow - reduced time
  sleep(0.5000)

  # [11] Gas flow OFF
  set_digital_out(1, False)

  # [12] Retract above weld end - increased speed
  safe_movel(p[0.500000, 0.300000, 0.380000, 0.0000, 3.1416, 0.0000], 1.5000, 0.3000, 0.0100)

  # [13] Return to home - increased speed
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=2.0000, v=1.2000)
end

task_T007()