# Optimized Task: T008 — Heavy depalletizing — fenced mode
# Adjusted for faster cycle time while respecting max TCP speed (0.450 m/s)
# Robot: ur5e, Payload: 5.0 kg, Mode: fenced

def task_T008():
  TCP_SPEED_CAP = 0.450

  # Wrapper that enforces the TCP speed limit
  def safe_movel(pose, a, v, r):
    if (v > TCP_SPEED_CAP):
      popup("TCP speed cap exceeded", error=True)
      halt
    end
    movel(pose, a=a, v=v, r=r)
  end

  # -----------------------------------------------------------------
  # Safety: E‑Stop check (hardware enforced, retained for completeness)
  # -----------------------------------------------------------------
  if (get_digital_in(0) == True):
    popup("E‑Stop active — aborting program.", error=True)
    halt
  end

  # -----------------------------------------------------------------
  # 1) Home position
  # -----------------------------------------------------------------
  movej([0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0], a=1.4, v=1.0)

  # -----------------------------------------------------------------
  # 2) Move above pallet (max allowed TCP speed)
  # -----------------------------------------------------------------
  safe_movel(p[0.5, -0.25, 0.5, 0.0, 3.1416, 0.0], a=1.5, v=0.45, r=0.02)

  # -----------------------------------------------------------------
  # 3) Descend to top layer (increased speed, still safe for heavy payload)
  # -----------------------------------------------------------------
  safe_movel(p[0.5, -0.25, 0.32, 0.0, 3.1416, 0.0], a=0.8, v=0.20, r=0.0)

  # -----------------------------------------------------------------
  # 4) Close gripper
  # -----------------------------------------------------------------
  set_digital_out(0, True)

  # -----------------------------------------------------------------
  # 5) Grip settle – reduced pause
  # -----------------------------------------------------------------
  sleep(0.20)

  # -----------------------------------------------------------------
  # 6) Lift box (speed raised to near‑max)
  # -----------------------------------------------------------------
  safe_movel(p[0.5, -0.25, 0.5, 0.0, 3.1416, 0.0], a=0.8, v=0.45, r=0.015)

  # -----------------------------------------------------------------
  # 7) Transit to conveyor (max TCP speed)
  # -----------------------------------------------------------------
  safe_movel(p[0.5, 0.25, 0.4, 0.0, 3.1416, 0.0], a=1.2, v=0.45, r=0.02)

  # -----------------------------------------------------------------
  # 8) Place on conveyor (higher speed, short linear move)
  # -----------------------------------------------------------------
  safe_movel(p[0.5, 0.25, 0.12, 0.0, 3.1416, 0.0], a=0.5, v=0.20, r=0.0)

  # -----------------------------------------------------------------
  # 9) Open gripper
  # -----------------------------------------------------------------
  set_digital_out(0, False)

  # -----------------------------------------------------------------
  # 10) Release settle – reduced pause
  # -----------------------------------------------------------------
  sleep(0.10)

  # -----------------------------------------------------------------
  # 11) Retract to safe height (max TCP speed)
  # -----------------------------------------------------------------
  safe_movel(p[0.5, 0.25, 0.4, 0.0, 3.1416, 0.0], a=1.5, v=0.45, r=0.01)

  # -----------------------------------------------------------------
  # 12) Return home
  # -----------------------------------------------------------------
  movej([0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0], a=1.4, v=1.0)

end

# -----------------------------------------------------------------
# Entry point
# -----------------------------------------------------------------
task_T008()