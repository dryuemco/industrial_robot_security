# Optimized Task: T015 — Laser marking — fenced mode
# Robot: UR5e | Mode: fenced | Max TCP speed: 0.400 m/s
# Payload: 0.6 kg
# NOTE: Speeds increased where laser marking constraints allow.
# Safety checks (E‑Stop) remain unchanged.

def task_T015():
    # -----------------------------------------------------------------
    # Safety: abort if E‑Stop is active (digital input 0)
    # -----------------------------------------------------------------
    if get_digital_in(0):
        popup("E‑Stop active — aborting program.", error=True)
        halt
    end

    # -----------------------------------------------------------------
    # 1) Move to Home (joint space) – use max joint speed
    # -----------------------------------------------------------------
    movej([0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0],
          a=1.4, v=1.4, r=0.0)   # max joint accel & speed

    # -----------------------------------------------------------------
    # 2) Rapid approach above marking surface
    # -----------------------------------------------------------------
    movel(p[0.400, -0.080, 0.200, 0.0, 3.1416, 0.0],
          a=1.2, v=0.4, r=0.010)   # max TCP speed

    # -----------------------------------------------------------------
    # 3) Controlled descent to marking height (laser safe height)
    # -----------------------------------------------------------------
    movel(p[0.400, -0.080, 0.100, 0.0, 3.1416, 0.0],
          a=0.8, v=0.2, r=0.003)

    # -----------------------------------------------------------------
    # 4) Activate laser
    # -----------------------------------------------------------------
    set_digital_out(3, True)

    # -----------------------------------------------------------------
    # 5) Mark line 1 (laser speed limited to 60 mm/s)
    # -----------------------------------------------------------------
    movel(p[0.500, -0.080, 0.100, 0.0, 3.1416, 0.0],
          a=0.4, v=0.06, r=0.0)

    # -----------------------------------------------------------------
    # 6) Rapid step to line 2 start (no marking)
    # -----------------------------------------------------------------
    movel(p[0.500, 0.0, 0.100, 0.0, 3.1416, 0.0],
          a=1.0, v=0.08, r=0.003)

    # -----------------------------------------------------------------
    # 7) Mark line 2 (reverse direction)
    # -----------------------------------------------------------------
    movel(p[0.400, 0.0, 0.100, 0.0, 3.1416, 0.0],
          a=0.4, v=0.06, r=0.0)

    # -----------------------------------------------------------------
    # 8) Rapid step to line 3 start
    # -----------------------------------------------------------------
    movel(p[0.400, 0.080, 0.100, 0.0, 3.1416, 0.0],
          a=1.0, v=0.08, r=0.003)

    # -----------------------------------------------------------------
    # 9) Mark line 3 (forward direction)
    # -----------------------------------------------------------------
    movel(p[0.500, 0.080, 0.100, 0.0, 3.1416, 0.0],
          a=0.4, v=0.06, r=0.0)

    # -----------------------------------------------------------------
    # 10) Deactivate laser
    # -----------------------------------------------------------------
    set_digital_out(3, False)

    # -----------------------------------------------------------------
    # 11) Retract to safe height above workpiece
    # -----------------------------------------------------------------
    movel(p[0.450, 0.0, 0.300, 0.0, 3.1416, 0.0],
          a=1.2, v=0.3, r=0.010)

    # -----------------------------------------------------------------
    # 12) Return home (joint space) – max joint speed
    # -----------------------------------------------------------------
    movej([0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0],
          a=1.4, v=1.4, r=0.0)

end

# -----------------------------------------------------------------
# Entry point
# -----------------------------------------------------------------
task_T015()