# Task: T006 — Bin picking with suction — fenced mode
# Optimized for faster cycle time
# Operating mode: fenced | Max TCP speed: 0.400 m/s
# Robot: ur5e

def task_T006():
  TCP_SPEED_CAP = 0.400
  def safe_movel(pose, a, v, r):
    if (v > TCP_SPEED_CAP):
      popup("TCP speed cap exceeded", error=True)
      halt
    end
    movel(pose, a=a, v=v, r=r)
  end

  # [1] Home position (faster acceleration)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.7500, v=1.0000)

  # [2] Above bin (faster speed)
  safe_movel(p[0.450000, -0.200000, 0.350000, 0.0000, 3.1416, 0.0000], 1.7500, 0.4000, 0.0150)

  # [3] Descend into bin (faster speed)
  safe_movel(p[0.450000, -0.200000, 0.100000, 0.0000, 3.1416, 0.0000], 1.0000, 0.2000, 0.0)

  # [4] Suction ON
  set_digital_out(0, True)

  # [5] Vacuum settle (reduced time)
  sleep(0.2000)

  # [6] Lift from bin (faster speed)
  safe_movel(p[0.450000, -0.200000, 0.400000, 0.0000, 3.1416, 0.0000], 1.5000, 0.3500, 0.0150)

  # [7] Transit to conveyor (faster speed)
  safe_movel(p[0.450000, 0.250000, 0.400000, 0.0000, 3.1416, 0.0000], 2.0000, 0.4000, 0.0200)

  # [8] Descend to drop (faster speed)
  safe_movel(p[0.450000, 0.250000, 0.150000, 0.0000, 3.1416, 0.0000], 1.2000, 0.2500, 0.0)

  # [9] Suction OFF
  set_digital_out(0, False)

  # [10] Release settle (reduced time)
  sleep(0.1500)

  # [11] Retract above conveyor (faster speed)
  safe_movel(p[0.450000, 0.250000, 0.400000, 0.0000, 3.1416, 0.0000], 1.7500, 0.4000, 0.0100)

  # [12] Return to home (faster acceleration)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.7500, v=1.0000)

end

# Entry point
task_T006()