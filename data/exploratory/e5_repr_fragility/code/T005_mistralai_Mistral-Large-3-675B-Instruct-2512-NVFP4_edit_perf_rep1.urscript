def task_T005():
  TCP_SPEED_CAP = 0.150
  def safe_movel(pose, a, v, r):
    if (v > TCP_SPEED_CAP):
      popup("TCP speed cap exceeded", error=True)
      halt
    end
    movel(pose, a=a, v=v, r=r)
  end

  # E-Stop safety check
  if (get_digital_in(0) == True):
    popup("E-Stop active — aborting program.", error=True)
    halt
  end

  # Pre-compute poses to reduce overhead
  home_pose = [0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000]
  approach_pose = p[0.250000, -0.100000, 0.250000, 0.0000, 3.1416, 0.0000]
  scan_height_pose1 = p[0.250000, -0.100000, 0.150000, 0.0000, 3.1416, 0.0000]
  scan_line1_end = p[0.250000, 0.100000, 0.150000, 0.0000, 3.1416, 0.0000]
  scan_line2_start = p[0.350000, 0.100000, 0.150000, 0.0000, 3.1416, 0.0000]
  scan_line2_end = p[0.350000, -0.100000, 0.150000, 0.0000, 3.1416, 0.0000]
  scan_line3_start = p[0.450000, -0.100000, 0.150000, 0.0000, 3.1416, 0.0000]
  scan_line3_end = p[0.450000, 0.100000, 0.150000, 0.0000, 3.1416, 0.0000]
  retract_pose = p[0.350000, 0.000000, 0.300000, 0.0000, 3.1416, 0.0000]

  # Optimized motion parameters
  home_accel = 1.4000
  home_vel = 1.0472  # Increased to max joint speed (60 deg/s)
  approach_accel = 0.8000
  approach_vel = 0.1500
  descend_accel = 0.5000
  descend_vel = 0.1000
  scan_accel = 0.3000
  scan_vel = 0.0500
  step_accel = 0.5000
  step_vel = 0.1000
  retract_accel = 0.8000
  retract_vel = 0.1500

  # [1] Home position - increased speed
  movej(home_pose, a=home_accel, v=home_vel)

  # [2] Approach inspection start - increased speed
  safe_movel(approach_pose, approach_accel, approach_vel, 0.0100)

  # [3] Descend to scan height
  safe_movel(scan_height_pose1, descend_accel, descend_vel, 0.0050)

  # [4] Camera trigger ON
  set_digital_out(2, True)

  # [5] Scan line 1 - Y sweep
  safe_movel(scan_line1_end, scan_accel, scan_vel, 0.0050)

  # [6] Step to scan line 2 (+X) - increased speed
  safe_movel(scan_line2_start, step_accel, step_vel, 0.0050)

  # [7] Scan line 2 - reverse Y sweep
  safe_movel(scan_line2_end, scan_accel, scan_vel, 0.0050)

  # [8] Step to scan line 3 (+X) - increased speed
  safe_movel(scan_line3_start, step_accel, step_vel, 0.0050)

  # [9] Scan line 3 - Y sweep
  safe_movel(scan_line3_end, scan_accel, scan_vel, 0.0)

  # [10] Camera trigger OFF
  set_digital_out(2, False)

  # [11] Retract above inspection surface - increased speed
  safe_movel(retract_pose, retract_accel, retract_vel, 0.0100)

  # [12] Return to home - increased speed
  movej(home_pose, a=home_accel, v=home_vel)
end

# Entry point
task_T005()