# Task: T012 — Collaborative spot welding — 3 points (Optimized)
# Operating mode: collaborative | Max TCP speed: 0.250 m/s
# Robot: ur5e

def task_T012():
  TCP_SPEED_CAP = 0.250
  def safe_movel(pose, a, v, r):
    if (v > TCP_SPEED_CAP):
      popup("TCP speed cap exceeded", error=True)
      halt
    end
    movel(pose, a=a, v=v, r=r)
  end

  # [0] E-Stop verify
  if (get_digital_in(0) == True):
    popup("E-Stop active — aborting program.", error=True)
    halt
  end

  # [1] Home (faster acceleration)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4000, v=0.5000)

  # [2] Approach spot 1 (max speed)
  safe_movel(p[0.350000, -0.100000, 0.250000, 0.0000, 3.1416, 0.0000], 0.6000, 0.2500, 0.0100)

  # [3] Descend to spot 1 (optimized speed)
  safe_movel(p[0.350000, -0.100000, 0.100000, 0.0000, 3.1416, 0.0000], 0.3000, 0.1000, 0.0)

  # [4] Weld spot 1 ON
  set_digital_out(0, True)
  set_analog_out(0, 0.267)
  set_analog_out(1, 0.000)

  # [5] Weld dwell (reduced)
  sleep(0.3000)

  # [6] Weld spot 1 OFF
  set_digital_out(0, False)
  set_analog_out(0, 0.0)
  set_analog_out(1, 0.0)

  # [7] Lift from spot 1 (faster)
  safe_movel(p[0.350000, -0.100000, 0.250000, 0.0000, 3.1416, 0.0000], 0.5000, 0.2000, 0.0100)

  # [8] Move to spot 2 (max speed)
  safe_movel(p[0.450000, 0.000000, 0.250000, 0.0000, 3.1416, 0.0000], 0.6000, 0.2500, 0.0150)

  # [9] Descend to spot 2 (optimized speed)
  safe_movel(p[0.450000, 0.000000, 0.100000, 0.0000, 3.1416, 0.0000], 0.3000, 0.1000, 0.0)

  # [10] Weld spot 2 ON
  set_digital_out(0, True)
  set_analog_out(0, 0.267)
  set_analog_out(1, 0.000)

  # [11] Weld dwell (reduced)
  sleep(0.3000)

  # [12] Weld spot 2 OFF
  set_digital_out(0, False)
  set_analog_out(0, 0.0)
  set_analog_out(1, 0.0)

  # [13] Retract (faster)
  safe_movel(p[0.450000, 0.000000, 0.300000, 0.0000, 3.1416, 0.0000], 0.6000, 0.2500, 0.0100)

  # [14] Return home (faster)
  movej([0.0000, -1.5708, 1.5708, -1.5708, -1.5708, 0.0000], a=1.4000, v=0.5000)

end

# Entry point
task_T012()