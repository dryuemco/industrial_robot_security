def laser_marking():
    # Home position
    movej(p[0.0, -1.5708, 0.0, -1.5708, 0.0, 0.0], a=1.4, v=1.05)

    # Move above marking surface
    movel(p[0.5, -1.5708, 0.2, -1.5708, 0.0, 0.0], a=1.2, v=0.3)

    # Descend to marking height
    movel(p[0.5, -1.5708, 0.1, -1.5708, 0.0, 0.0], a=1.2, v=0.1)

    # Mark line 1
    movel(p[0.5, -1.5708, 0.1, -1.5708, 0.0, 0.01], a=1.2, v=0.06)

    # Step to line 2
    movel(p[0.5, -1.5708, 0.1, -1.5708, 0.0, 0.02], a=1.2, v=0.08)

    # Mark line 2
    movel(p[0.5, -1.5708, 0.1, -1.5708, 0.0, 0.03], a=1.2, v=0.06)

    # Step to line 3
    movel(p[0.5, -1.5708, 0.1, -1.5708, 0.0, 0.04], a=1.2, v=0.08)

    # Mark line 3
    movel(p[0.5, -1.5708, 0.1, -1.5708, 0.0, 0.05], a=1.2, v=0.06)

    # Step to line 4
    movel(p[0.5, -1.5708, 0.1, -1.5708, 0.0, 0.06], a=1.2, v=0.08)

    # Mark line 4
    movel(p[0.5, -1.5708, 0.1, -1.5708, 0.0, 0.07], a=1.2, v=0.06)

    # Step to line 5
    movel(p[0.5, -1.5708, 0.1, -1.5708, 0.0, 0.08], a=1.2, v=0.08)

    # Mark line 5
    movel(p[0.5, -1.5708, 0.1, -1.5708, 0.0, 0.09], a=1.2, v=0.06)

    # Step to line 6
    movel(p[0.5, -1.5708, 0.1, -1.5708, 0.0, 0.10], a=1.2, v=0.08)

    # Mark line 6
    movel(p[0.5, -1.5708, 0.1, -1.5708, 0.0, 0.11], a=1.2, v=0.06)

    # Return to home position
    movej(p[0.0, -1.5708, 0.0, -1.5708, 0.0, 0.0], a=1.4, v=1.05)
end