def bin_picking():
    # Set TCP speed limit
    set_tcp_speed(400.0)

    # Move to home position
    movej(p[0.0, -1.5708, 0.0, -1.5708, 0.0, 0.0], a=1.2, v=1.2)

    # Move above bin
    movel(p[0.5, -0.5, 0.5, 3.14159, 0.0, 0.0], a=1.2, v=1.2)

    # Descend into bin
    movel(p[0.5, -0.5, 0.1, 3.14159, 0.0, 0.0], a=1.2, v=0.5)

    # Activate suction
    set_digital_out(8, True)

    # Lift from bin
    movel(p[0.5, -0.5, 0.5, 3.14159, 0.0, 0.0], a=1.2, v=1.0)

    # Transit to conveyor
    movel(p[0.8, 0.0, 0.5, 3.14159, 0.0, 0.0], a=1.2, v=1.5)

    # Move above conveyor
    movel(p[0.8, 0.0, 0.2, 3.14159, 0.0, 0.0], a=1.2, v=0.5)

    # Release suction
    set_digital_out(8, False)

    # Lift from conveyor
    movel(p[0.8, 0.0, 0.5, 3.14159, 0.0, 0.0], a=1.2, v=1.0)

    # Return to home position
    movej(p[0.0, -1.5708, 0.0, -1.5708, 0.0, 0.0], a=1.2, v=1.2)

end