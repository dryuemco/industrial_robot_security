def safety_check():
    if not is_within_safety_zone(get_tcp_pose()):
        popup("Safety violation: Outside safety zone!", True)
        halt()

def is_within_safety_zone(tcp_pose):
    # Define the safety zone boundaries (example values, adjust as needed)
    x_min = -0.5
    x_max = 0.5
    y_min = -0.5
    y_max = 0.5
    z_min = 0.5
    z_max = 1.5
    
    x = tcp_pose[0]
    y = tcp_pose[1]
    z = tcp_pose[2]
    
    return x >= x_min and x <= x_max and y >= y_min and y <= y_max and z >= z_min and z <= z_max

def main():
    set_payload(0.5, [0, 0, 0.05], [0, 0, 0, 0, 0, 0])
    
    # Home position
    safety_check()
    movej(p[0.0, -1.57, 0.0, -1.57, 0.0, 0.0], a=1.4, v=1.8)
    
    # Above scan start
    safety_check()
    movel(p[0.5, -0.5, 0.5, 3.14, 0, 0], a=1.4, v=1.5)
    
    # Descend to scan height
    safety_check()
    movel(p[0.5, -0.5, 0.1, 3.14, 0, 0], a=1.4, v=1.0)
    
    # Scan line 1
    safety_check()
    movel(p[0.8, -0.5, 0.1, 3.14, 0, 0], a=1.4, v=0.5)
    
    # Step to line 2
    safety_check()
    movel(p[0.8, -0.4, 0.1, 3.14, 0, 0], a=1.4, v=1.0)
    
    # Scan line 2
    safety_check()
    movel(p[0.5, -0.4, 0.1, 3.14, 0, 0], a=1.4, v=0.5)
    
    # Step to line 3
    safety_check()
    movel(p[0.5, -0.3, 0.1, 3.14, 0, 0], a=1.4, v=1.0)
    
    # Scan line 3
    safety_check()
    movel(p[0.8, -0.3, 0.1, 3.14, 0, 0], a=1.4, v=0.5)
    
    # Step to line 4
    safety_check()
    movel(p[0.8, -0.2, 0.1, 3.14, 0, 0], a=1.4, v=1.0)
    
    # Scan line 4
    safety_check()
    movel(p[0.5, -0.2, 0.1, 3.14, 0, 0], a=1.4, v=0.5)
    
    # Return to home
    safety_check()
    movej(p[0.0, -1.57, 0.0, -1.57, 0.0, 0.0], a=1.4, v=1.8)

main()