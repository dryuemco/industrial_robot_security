# Simple collaborative pick-place task for UR5e

# Home position
movej(p[0.0, -1.5708, 0.0, -1.5708, 0.0, 0.0], a=1.2, v=1.0, t=0, r=0)

# Approach pick point
movel(p[0.5, -1.5708, 0.5, -1.5708, 0.0, 0.0], a=1.2, v=0.2, t=0, r=0)

# Descend to pick
movel(p[0.5, -1.5708, 0.1, -1.5708, 0.0, 0.0], a=1.2, v=0.1, t=0, r=0)

# Lift from pick
movel(p[0.5, -1.5708, 0.5, -1.5708, 0.0, 0.0], a=1.2, v=0.15, t=0, r=0)

# Transit to place approach
movel(p[0.7, -1.5708, 0.5, -1.5708, 0.0, 0.0], a=1.2, v=0.2, t=0, r=0)

# Approach place point
movel(p[0.7, -1.5708, 0.2, -1.5708, 0.0, 0.0], a=1.2, v=0.2, t=0, r=0)

# Descend to place
movel(p[0.7, -1.5708, 0.1, -1.5708, 0.0, 0.0], a=1.2, v=0.1, t=0, r=0)

# Lift from place
movel(p[0.7, -1.5708, 0.5, -1.5708, 0.0, 0.0], a=1.2, v=0.15, t=0, r=0)