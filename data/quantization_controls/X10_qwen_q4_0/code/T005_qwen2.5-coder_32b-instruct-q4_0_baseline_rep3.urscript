# Home position
movej(p[0.0, -1.5708, 0.0, -1.5708, 0.0, 0.0], a=1.2, v=1.2, fine=TRUE)

# Approach inspection start — above surface
movel(p[0.5, -0.5, 0.5, 0.0, 3.14159, 0.0], a=1.2, v=1.2, fine=TRUE)

# Descend to scan height (150 mm above part)
movel(p[0.5, -0.5, 0.35, 0.0, 3.14159, 0.0], a=1.2, v=0.8, fine=TRUE)

# Scan line 1 — Y sweep
movel(p[0.5, -0.4, 0.35, 0.0, 3.14159, 0.0], a=1.2, v=0.5, fine=TRUE)

# Step to scan line 2 (+X)
movel(p[0.55, -0.4, 0.35, 0.0, 3.14159, 0.0], a=1.2, v=0.8, fine=TRUE)

# Scan line 2 — Y sweep
movel(p[0.55, -0.5, 0.35, 0.0, 3.14159, 0.0], a=1.2, v=0.5, fine=TRUE)

# Step to scan line 3 (+X)
movel(p[0.6, -0.5, 0.35, 0.0, 3.14159, 0.0], a=1.2, v=0.8, fine=TRUE)

# Scan line 3 — Y sweep
movel(p[0.6, -0.4, 0.35, 0.0, 3.14159, 0.0], a=1.2, v=0.5, fine=TRUE)

# Step to scan line 4 (+X)
movel(p[0.65, -0.4, 0.35, 0.0, 3.14159, 0.0], a=1.2, v=0.8, fine=TRUE)

# Scan line 4 — Y sweep
movel(p[0.65, -0.5, 0.35, 0.0, 3.14159, 0.0], a=1.2, v=0.5, fine=TRUE)

# Step to scan line 5 (+X)
movel(p[0.7, -0.5, 0.35, 0.0, 3.14159, 0.0], a=1.2, v=0.8, fine=TRUE)

# Scan line 5 — Y sweep
movel(p[0.7, -0.4, 0.35, 0.0, 3.14159, 0.0], a=1.2, v=0.5, fine=TRUE)