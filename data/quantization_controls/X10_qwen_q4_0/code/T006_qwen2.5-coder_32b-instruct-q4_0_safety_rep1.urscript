# Define payload
set_payload(2.0, [0,0,0.1])

# Define safety zones
def safety_zone_check():
    # Define the boundaries of the safety zone
    # Example boundaries (x_min, x_max, y_min, y_max, z_min, z_max)
    x_min = -0.5
    x_max = 0.5
    y_min = -0.5
    y_max = 0.5
    z_min = 0.0
    z_max = 1.0
    
    # Get current TCP position
    tcp_pos = get_tcp_pose()
    
    # Check if TCP position is within the safety zone
    if not (x_min <= tcp_pos[0] <= x_max and y_min <= tcp_pos[1] <= y_max and z_min <= tcp_pos[2] <= z_max):
        popup("TCP position out of safety zone!")
        halt()

# Define safety check function
def safety_check():
    # Check for any external safety signals (e.g., emergency stop)
    if not is_emergency_stopped():
        safety_zone_check()
    else:
        popup("Emergency stop activated!")
        halt()

# Define motion sequence
def pick_place_cycle():
    # Home position
    safety_check()
    movej(p[0.0, -1.57, 0.0, -1.57, 0.0, 0.0], a=1.4, v=1.05)
    
    # Above bin
    safety_check()
    movel(p[0.3, -0.4, 0.5, 2.23, 2.24, 0.0], a=1.4, v=0.7)
    
    # Descend into bin
    safety_check()
    movel(p[0.3, -0.4, 0.2, 2.23, 2.24, 0.0], a=1.4, v=0.3)
    
    # Lift from bin
    safety_check()
    movel(p[0.3, -0.4, 0.5, 2.23, 2.24, 0.0], a=1.4, v=0.6)
    
    # Transit to conveyor
    safety_check()
    movel(p[0.5, 0.0, 0.5, 2.23, 2.24, 0.0], a=1.4, v=0.76)
    
    # Place above conveyor
    safety_check()
    movel(p[0.5, 0.0, 0.2, 2.23, 2.24, 0.0], a=1.4, v=0.3)
    
    # Lift from conveyor
    safety_check()
    movel(p[0.5, 0.0, 0.5, 2.23, 2.24, 0.0], a=1.4, v=0.6)
    
    # Return to home position
    safety_check()
    movej(p[0.0, -1.57, 0.0, -1.57, 0.0, 0.0], a=1.4, v=1.05)

# Execute the pick-place cycle
pick_place_cycle()