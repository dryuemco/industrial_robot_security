def safety_check():
    if not is_within_safety_zone(get_tcp_pose()):
        popup("Safety violation: Outside safety zone!", True)
        halt()

def is_within_safety_zone(tcp_pose):
    # Define safety zone boundaries (example values, adjust as needed)
    x_min = -0.5
    x_max = 0.5
    y_min = -0.5
    y_max = 0.5
    z_min = 0.1
    z_max = 1.0
    
    x = tcp_pose[0]
    y = tcp_pose[1]
    z = tcp_pose[2]
    
    return x_min <= x <= x_max and y_min <= y <= y_max and z_min <= z <= z_max

set_payload(0.3, [0, 0, 0.05])

# Home position
safety_check()
movej(p[-0.000, -1.571, 1.571, -1.571, -1.571, 0.000], a=1.4, v=1.50)

# Approach inspection start
safety_check()
movel(p[0.3, -0.2, 0.5, 3.14, 0, 0], a=1.4, v=1.30)

# Descend to scan height
safety_check()
movel(p[0.3, -0.2, 0.35, 3.14, 0, 0], a=1.4, v=0.80)

# Scan line 1
safety_check()
movel(p[0.4, -0.2, 0.35, 3.14, 0, 0], a=1.4, v=0.50)

# Step to scan line 2
safety_check()
movel(p[0.3, -0.1, 0.35, 3.14, 0, 0], a=1.4, v=0.80)

# Scan line 2
safety_check()
movel(p[0.4, -0.1, 0.35, 3.14, 0, 0], a=1.4, v=0.50)

# Step to scan line 3
safety_check()
movel(p[0.3, 0.0, 0.35, 3.14, 0, 0], a=1.4, v=0.80)

# Scan line 3
safety_check()
movel(p[0.4, 0.0, 0.35, 3.14, 0, 0], a=1.4, v=0.50)

# Return to approach position
safety_check()
movel(p[0.3, -0.2, 0.5, 3.14, 0, 0], a=1.4, v=1.30)

# Return to home position
safety_check()
movej(p[-0.000, -1.571, 1.571, -1.571, -1.571, 0.000], a=1.4, v=1.50)