def bin_picking():
    # Set payload
    set_payload(2.0, [0, 0, 0.05])

    # Move to home position
    movej(p[0.0, -1.5708, 0.0, -1.5708, 0.0, 0.0], a=1.2, v=1.2, fine=TRUE)

    # Move above bin
    movel(p[0.5, -0.5, 0.5, 3.14, 0, 0], a=1.2, v=0.35)

    # Descend into bin
    movel(p[0.5, -0.5, 0.1, 3.14, 0, 0], a=1.2, v=0.15)

    # Activate suction
    set_digital_out(8, True)
    sleep(1)  # Wait for suction to activate

    # Lift from bin
    movel(p[0.5, -0.5, 0.5, 3.14, 0, 0], a=1.2, v=0.3)

    # Transit to conveyor
    movel(p[0.8, -0.2, 0.5, 3.14, 0, 0], a=1.2, v=0.38)

    # Move above conveyor
    movel(p[0.8, -0.2, 0.2, 3.14, 0, 0], a=1.2, v=0.38)

    # Place object
    set_digital_out(8, False)
    sleep(1)  # Wait for object to release

    # Lift from conveyor
    movel(p[0.8, -0.2, 0.5, 3.14, 0, 0], a=1.2, v=0.38)

    # Return to home position
    movej(p[0.0, -1.5708, 0.0, -1.5708, 0.0, 0.0], a=1.2, v=1.2, fine=TRUE)

end