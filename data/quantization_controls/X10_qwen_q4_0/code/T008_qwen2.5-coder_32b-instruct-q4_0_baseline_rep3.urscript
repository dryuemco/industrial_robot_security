# Define joint positions and Cartesian positions
defp home_joints = [0.0, -1.57, 0.0, -1.57, 0.0, 0.0]
defp above_pallet = p[0.5, -0.2, 0.5, 3.14, 0, 0]
defp top_layer = p[0.5, -0.2, 0.2, 3.14, 0, 0]
defp lift_box = p[0.5, -0.2, 0.3, 3.14, 0, 0]
defp conveyor = p[0.8, 0.0, 0.3, 3.14, 0, 0]
defp conveyor_above = p[0.8, 0.0, 0.5, 3.14, 0, 0]
defp conveyor_descend = p[0.8, 0.0, 0.2, 3.14, 0, 0]
defp conveyor_lift = p[0.8, 0.0, 0.3, 3.14, 0, 0]

# Set payload
set_payload(5.0, [0, 0, 0.1])

# Move to home position
movej(home_joints, a=1.4, v=1.05)

# Move above pallet
movel(above_pallet, a=1.2, v=0.4)

# Descend to top layer
movel(top_layer, a=1.2, v=0.15)

# Lift box
movel(lift_box, a=1.2, v=0.2)

# Transit to conveyor
movel(conveyor_above, a=1.2, v=0.35)

# Descend to conveyor
movel(conveyor_descend, a=1.2, v=0.15)

# Lift box on conveyor
movel(conveyor_lift, a=1.2, v=0.2)

# Return to home position
movej(home_joints, a=1.4, v=1.05)