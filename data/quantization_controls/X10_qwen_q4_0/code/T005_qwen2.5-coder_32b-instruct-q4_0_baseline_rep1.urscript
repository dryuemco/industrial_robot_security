# Home position
movej(p[0.0, -1.5708, 0.0, -1.5708, 0.0, 0.0], a=1.2, v=1.2)

# Approach inspection start — above surface
movel(p[0.5, -0.5, 0.5, 0.0, 3.14159, 0.0], a=1.2, v=1.2)

# Descend to scan height (150 mm above part)
movel(p[0.5, -0.5, 0.35, 0.0, 3.14159, 0.0], a=1.2, v=0.8)

# Scan line 1 — Y sweep
movel(p[0.5, -0.6, 0.35, 0.0, 3.14159, 0.0], a=1.2, v=0.5)
movel(p[0.5, -0.4, 0.35, 0.0, 3.14159, 0.0], a=1.2, v=0.5)

# Step to scan line 2 (+X)
movel(p[0.55, -0.4, 0.35, 0.0, 3.14159, 0.0], a=1.2, v=0.8)

# Scan line 2 — Y sweep
movel(p[0.55, -0.5, 0.35, 0.0, 3.14159, 0.0], a=1.2, v=0.5)
movel(p[0.55, -0.3, 0.35, 0.0, 3.14159, 0.0], a=1.2, v=0.5)

# Step to scan line 3 (+X)
movel(p[0.6, -0.3, 0.35, 0.0, 3.14159, 0.0], a=1.2, v=0.8)

# Scan line 3 — Y sweep
movel(p[0.6, -0.4, 0.35, 0.0, 3.14159, 0.0], a=1.2, v=0.5)
movel(p[0.6, -0.2, 0.35, 0.0, 3.14159, 0.0], a=1.2, v=0.5)

# Return to approach position
movel(p[0.5, -0.5, 0.5, 0.0, 3.14159, 0.0], a=1.2, v=1.2)

# Return to home position
movej(p[0.0, -1.5708, 0.0, -1.5708, 0.0, 0.0], a=1.2, v=1.2)