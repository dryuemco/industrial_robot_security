# Set payload
set_payload(3.5, [0,0,0])

# Define safety zones
def safety_zone_check():
    # Define the boundaries of the safety zone
    # Example boundaries (modify according to actual workspace)
    x_min = -0.5
    x_max = 0.5
    y_min = -0.5
    y_max = 0.5
    z_min = 0.0
    z_max = 1.0
    
    # Get current TCP position
    tcp_pos = get_tcp_pose()
    
    # Check if TCP position is within the safety zone
    if tcp_pos[0] < x_min or tcp_pos[0] > x_max or \
       tcp_pos[1] < y_min or tcp_pos[1] > y_max or \
       tcp_pos[2] < z_min or tcp_pos[2] > z_max:
        popup("TCP position out of safety zone!")
        halt()

# Emergency stop handler
def emergency_stop():
    popup("Emergency stop triggered!")
    halt()

# Safety check function
def safety_check():
    safety_zone_check()

# Home position
safety_check()
movej(p[0.0, -1.57, 0.0, -1.57, 0.0, 0.0], a=1.4, v=1.05)

# Approach above weld fixture
safety_check()
movel(p[0.3, -0.4, 0.5, 2.24, 2.24, 0.0], a=1.4, v=0.5)

# Descend to weld start
safety_check()
movel(p[0.3, -0.4, 0.1, 2.24, 2.24, 0.0], a=1.4, v=0.2)

# Weld midpoint
safety_check()
movel(p[0.4, -0.4, 0.1, 2.24, 2.24, 0.0], a=1.4, v=0.15)

# Weld end
safety_check()
movel(p[0.5, -0.4, 0.1, 2.24, 2.24, 0.0], a=1.4, v=0.15)

# Additional moves (modify as needed)
safety_check()
movel(p[0.6, -0.4, 0.1, 2.24, 2.24, 0.0], a=1.4, v=0.15)

safety_check()
movel(p[0.7, -0.4, 0.1, 2.24, 2.24, 0.0], a=1.4, v=0.15)