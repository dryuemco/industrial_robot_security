# Set payload
set_payload(0.6, [0,0,0])

# Define safety zones
def safety_zone_confined():
    # Define confined zone boundaries
    p_min = p[0.2, -0.5, 0.5, 0, 3.14, 0]
    p_max = p[0.8, 0.5, 1.0, 0, 3.14, 0]
    return get_actual_tcp_pose() within_zone(p_min, p_max)

def safety_zone_excluded():
    # Define excluded zone boundaries
    p_excluded = p[0.5, 0, 0.75, 0, 3.14, 0]
    return not (get_actual_tcp_pose() within_zone(p_excluded, p_excluded))

def safety_check():
    if not safety_zone_confined():
        popup("Outside confined safety zone!")
        halt()
    if not safety_zone_excluded():
        popup("Inside excluded safety zone!")
        halt()

# Emergency stop handler
def emergency_stop():
    popup("Emergency stop triggered!")
    halt()

# Motion sequence
try:
    # Home position
    safety_check()
    movej(p[0, -1.57, 1.57, -1.57, -1.57, 0], a=1.4, v=350.0)

    # Above marking surface
    safety_check()
    movel(p[0.5, 0, 0.6, 0, 3.14, 0], a=1.4, v=300.0)

    # Descend to marking height
    safety_check()
    movel(p[0.5, 0, 0.4, 0, 3.14, 0], a=1.4, v=100.0)

    # Mark line 1
    safety_check()
    movel(p[0.5, 0, 0.4, 0.1, 3.14, 0], a=1.4, v=60.0)

    # Step to line 2
    safety_check()
    movel(p[0.5, 0.1, 0.4, 0.1, 3.14, 0], a=1.4, v=80.0)

    # Mark line 2
    safety_check()
    movel(p[0.5, 0.1, 0.4, 0.2, 3.14, 0], a=1.4, v=60.0)

    # Step to line 3
    safety_check()
    movel(p[0.5, 0.2, 0.4, 0.2, 3.14, 0], a=1.4, v=80.0)

    # Mark line 3
    safety_check()
    movel(p[0.5, 0.2, 0.4, 0.3, 3.14, 0], a=1.4, v=60.0)

    # Step to line 4
    safety_check()
    movel(p[0.5, 0.3, 0.4, 0.3, 3.14, 0], a=1.4, v=80.0)

    # Mark line 4
    safety_check()
    movel(p[0.5, 0.3, 0.4, 0.4, 3.14, 0], a=1.4, v=60.0)

    # Step to line 5
    safety_check()
    movel(p[0.5, 0.4, 0.4, 0.4, 3.14, 0], a=1.4, v=80.0)

    # Mark line 5
    safety_check()
    movel(p[0.5, 0.4, 0.4, 0.5, 3.14, 0], a=1.4, v=60.0)

    # Step to line 6
    safety_check()
    movel(p[0.5, 0.5, 0.4, 0.5, 3.14, 0], a=1.4, v=80.0)

    # Mark line 6
    safety_check()
    movel(p[0.5, 0.5, 0.4, 0.6, 3.14, 0], a=1.4, v=60.0)

    # Return to above marking surface
    safety_check()
    movel(p[0.5, 0, 0.6, 0, 3.14, 0], a=1.4, v=300.0)

    # Home position
    safety_check()
    movej(p[0, -1.57, 1.57, -1.57, -1.57, 0], a=1.4, v=350.0)

except:
    emergency_stop()