# Set payload
set_payload(1.0, [0,0,0])

# Define safety zones
def safety_zone_check():
    # Define the confinement box boundaries
    local min_x = -0.5
    local max_x = 0.5
    local min_y = -0.5
    local max_y = 0.5
    local min_z = 0.0
    local max_z = 1.0
    
    # Get current TCP position
    local tcp_pos = get_tcp_pose()
    
    # Check if TCP position is within the safety zone
    if not (tcp_pos[0] >= min_x and tcp_pos[0] <= max_x and
            tcp_pos[1] >= min_y and tcp_pos[1] <= max_y and
            tcp_pos[2] >= min_z and tcp_pos[2] <= max_z):
        popup("TCP position out of safety zone!")
        stopl(0)
    endif
end

# Emergency stop handler
def emergency_stop_handler():
    popup("Emergency stop triggered!")
    stopl(0)
end

# Safety check function
def safety_check():
    safety_zone_check()
    # Add other safety checks if necessary
end

# Main program
try
    # Move to Home position
    safety_check()
    movej(p[0.0, -1.57, 0.0, -1.57, 0.0, 0.0], a=1.4, v=1.05)

    # Move above screw feeder
    safety_check()
    movel(p[0.3, -0.5, 0.5, -1.57, 0.0, 0.0], a=1.4, v=1.05)

    # Pick screw
    safety_check()
    movel(p[0.3, -0.5, 0.1, -1.57, 0.0, 0.0], a=1.4, v=0.4)

    # Lift from feeder
    safety_check()
    movel(p[0.3, -0.5, 0.5, -1.57, 0.0, 0.0], a=1.4, v=0.9)

    # Move above fastening point 1
    safety_check()
    movel(p[0.2, 0.2, 0.5, -1.57, 0.0, 0.0], a=1.4, v=1.05)

    # Fasten at point 1 (fenced mode)
    set_tcp(p[0, 0, 0.1, 0, 0, 0])
    movej(p[0.2, 0.2, 0.1, -1.57, 0.0, 0.0], a=1.4, v=0.1)
    movej(p[0.2, 0.2, 0.5, -1.57, 0.0, 0.0], a=1.4, v=0.1)

    # Move above fastening point 2
    safety_check()
    movel(p[0.4, 0.2, 0.5, -1.57, 0.0, 0.0], a=1.4, v=1.05)

    # Fasten at point 2 (fenced mode)
    set_tcp(p[0, 0, 0.1, 0, 0, 0])
    movej(p[0.4, 0.2, 0.1, -1.57, 0.0, 0.0], a=1.4, v=0.1)
    movej(p[0.4, 0.2, 0.5, -1.57, 0.0, 0.0], a=1.4, v=0.1)

    # Move above fastening point 3
    safety_check()
    movel(p[0.2, 0.4, 0.5, -1.57, 0.0, 0.0], a=1.4, v=1.05)

    # Fasten at point 3 (fenced mode)
    set_tcp(p[0, 0, 0.1, 0, 0, 0])
    movej(p[0.2, 0.4, 0.1, -1.57, 0.0, 0.0], a=1.4, v=0.1)
    movej(p[0.2, 0.4, 0.5, -1.57, 0.0, 0.0], a=1.4, v=0.1)

    # Move above fastening point 4
    safety_check()
    movel(p[0.4, 0.4, 0.5, -1.57, 0.0, 0.0], a=1.4, v=1.05)

    # Fasten at point 4 (fenced mode)
    set_tcp(p[0, 0, 0.1, 0, 0, 0])
    movej(p[0.4, 0.4, 0.1, -1.57, 0.0, 0.0], a=1.4, v=0.1)
    movej(p[0.4, 0.4, 0.5, -1.57, 0.0, 0.0], a=1.4, v=0.1)

    # Return to Home position
    safety_check()
    movej(p[0.0, -1.57, 0.0, -1.57, 0.0, 0.0], a=1.4, v=1.05)
catch
    emergency_stop_handler()
end