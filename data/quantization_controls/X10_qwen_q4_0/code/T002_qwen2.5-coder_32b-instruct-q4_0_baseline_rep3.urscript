# Linear weld path - fenced mode (T002)

# Go to home position
movej(p[0.0, -0.5, 0.5, 0, 3.14, 0], a=1.2, v=1.2)

# Approach above weld start
movel(p[0.3, -0.5, 0.5, 0, 3.14, 0], a=1.2, v=0.25)

# Descend to weld start position
movel(p[0.3, -0.5, 0.2, 0, 3.14, 0], a=1.2, v=0.1)

# Weld seam - 300mm linear path
movel(p[0.6, -0.5, 0.2, 0, 3.14, 0], a=1.2, v=0.05)

# Retract above weld end
movel(p[0.6, -0.5, 0.5, 0, 3.14, 0], a=1.2, v=0.2)

# Return to home position
movej(p[0.0, -0.5, 0.5, 0, 3.14, 0], a=1.2, v=1.2)