def safety_check():
    if not is_within_safety_zone(get_actual_tcp_pose()):
        popup("Safety violation: Outside safety zone!", True)
        halt()

def is_within_safety_zone(tcp_pose):
    # Define the safety zone boundaries (example values, adjust as necessary)
    x_min = -0.5
    x_max = 0.5
    y_min = -0.5
    y_max = 0.5
    z_min = 0.5
    z_max = 1.5
    
    x = tcp_pose[0]
    y = tcp_pose[1]
    z = tcp_pose[2]
    
    return x_min <= x <= x_max and y_min <= y <= y_max and z_min <= z <= z_max

def main():
    set_payload(0.5, [0, 0, 0.05])  # Set payload to 0.5 kg with center of mass at 50 mm below tool tip
    
    # Home position
    safety_check()
    movej(p[-0.000, -1.571, 1.571, -1.571, -1.571, 0.000], a=1.4, v=1.8)
    
    # Above scan start position
    safety_check()
    movel(p[0.3, -0.2, 0.5, 3.14, 0, 0], a=1.4, v=1.5)
    
    # Descend to scan height
    safety_check()
    movel(p[0.3, -0.2, 0.1, 3.14, 0, 0], a=1.4, v=1.0)
    
    # Scan line 1
    safety_check()
    movel(p[0.6, -0.2, 0.1, 3.14, 0, 0], a=1.4, v=0.5)
    
    # Step to line 2
    safety_check()
    movel(p[0.6, -0.2, 0.5, 3.14, 0, 0], a=1.4, v=1.0)
    movel(p[0.3, -0.1, 0.5, 3.14, 0, 0], a=1.4, v=1.0)
    movel(p[0.3, -0.1, 0.1, 3.14, 0, 0], a=1.4, v=1.0)
    
    # Scan line 2
    safety_check()
    movel(p[0.6, -0.1, 0.1, 3.14, 0, 0], a=1.4, v=0.5)
    
    # Step to line 3
    safety_check()
    movel(p[0.6, -0.1, 0.5, 3.14, 0, 0], a=1.4, v=1.0)
    movel(p[0.3, 0.0, 0.5, 3.14, 0, 0], a=1.4, v=1.0)
    movel(p[0.3, 0.0, 0.1, 3.14, 0, 0], a=1.4, v=1.0)
    
    # Scan line 3
    safety_check()
    movel(p[0.6, 0.0, 0.1, 3.14, 0, 0], a=1.4, v=0.5)
    
    # Step to line 4
    safety_check()
    movel(p[0.6, 0.0, 0.5, 3.14, 0, 0], a=1.4, v=1.0)
    movel(p[0.3, 0.1, 0.5, 3.14, 0, 0], a=1.4, v=1.0)
    movel(p[0.3, 0.1, 0.1, 3.14, 0, 0], a=1.4, v=1.0)
    
    # Scan line 4
    safety_check()
    movel(p[0.6, 0.1, 0.1, 3.14, 0, 0], a=1.4, v=0.5)
    
    # Return to home position
    safety_check()
    movej(p[-0.000, -1.571, 1.571, -1.571, -1.571, 0.000], a=1.4, v=1.8)

end