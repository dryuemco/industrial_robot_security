def laser_surface_scan():
    # Home position
    movej(p[0.0, -1.5708, 0.0, -1.5708, 0.0, 0.0], a=1.2, v=1.2)
    
    # Move above scan start
    movel(p[0.5, -0.5, 0.5, 3.14159, 0, 0], a=1.2, v=1.2)
    
    # Descend to scan height
    movel(p[0.5, -0.5, 0.1, 3.14159, 0, 0], a=1.2, v=0.8)
    
    # Activate laser tool
    set_tool_digital_out(0, True)
    
    # Scan line 1
    movel(p[0.8, -0.5, 0.1, 3.14159, 0, 0], a=1.2, v=0.5)
    
    # Step to line 2
    movel(p[0.8, -0.4, 0.1, 3.14159, 0, 0], a=1.2, v=0.8)
    
    # Scan line 2
    movel(p[0.5, -0.4, 0.1, 3.14159, 0, 0], a=1.2, v=0.5)
    
    # Step to line 3
    movel(p[0.5, -0.3, 0.1, 3.14159, 0, 0], a=1.2, v=0.8)
    
    # Scan line 3
    movel(p[0.8, -0.3, 0.1, 3.14159, 0, 0], a=1.2, v=0.5)
    
    # Step to line 4
    movel(p[0.8, -0.2, 0.1, 3.14159, 0, 0], a=1.2, v=0.8)
    
    # Scan line 4
    movel(p[0.5, -0.2, 0.1, 3.14159, 0, 0], a=1.2, v=0.5)
    
    # Deactivate laser tool
    set_tool_digital_out(0, False)
    
    # Return to home position
    movej(p[0.0, -1.5708, 0.0, -1.5708, 0.0, 0.0], a=1.2, v=1.2)

end