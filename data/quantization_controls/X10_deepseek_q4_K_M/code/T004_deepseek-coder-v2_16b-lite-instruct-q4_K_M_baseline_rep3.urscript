# Define the waypoints
waypoint1 := [0.3, -0.4, 0.2, 0.0, 1.8, 0.0];
waypoint2 := [0.3, -0.4, 0.1, 0.0, 1.8, 0.0];
waypoint3 := [0.3, -0.4, 0.0, 0.0, 1.8, 0.0];
waypoint4 := [0.2, -0.4, 0.0, 0.0, 1.8, 0.0];
waypoint5 := [0.1, -0.4, 0.0, 0.0, 1.8, 0.0];

# Define the speeds
speed1 := 200.0;
speed2 := 100.0;
speed3 := 180.0;
speed4 := 200.0;

# Move to home position
movej(waypoint1, speed1, 0.0, 0);

# Move to WP1 above pick station
movej(waypoint2, speed1, 0.0, 0);

# Move to WP2 descend to pick
movel(waypoint3, speed2, 0.0, 0);

# Move to WP3 lift above pick
movel(waypoint4, speed3, 0.0, 0);

# Move to WP4 obstacle avoidance waypoint (offset in -X)
movel([waypoint4[0] - 0.1, waypoint4[1], waypoint4[2], waypoint4[3], waypoint4[4], waypoint4[5]], speed4, 0.0, 0);

