# Define the positions for the robot to move to
def move_to_positions():
    # Home position
    movej([0.0, -1.8, 1.8, -1.5, 1.5, 0.0], 180.0, 0.5, 0.5)
    
    # Top-down view position
    movej([-0.5, -1.0, 1.5, -1.0, 1.5, 0.0], 150.0, 0.5, 0.5)
    
    # Side view position
    movej([-1.0, -1.5, 1.0, -1.5, 1.5, 0.0], 120.0, 0.5, 0.5)
    
    # Angled view position
    movej([-1.5, -2.0, 0.5, -2.0, 1.5, 0.0], 120.0, 0.5, 0.5)
    
    # Retract position
    movej([0.0, -1.8, 1.8, -1.5, 1.5, 0.0], 180.0, 0.5, 0.5)
    
# Call the function to execute the moves
move_to_positions()