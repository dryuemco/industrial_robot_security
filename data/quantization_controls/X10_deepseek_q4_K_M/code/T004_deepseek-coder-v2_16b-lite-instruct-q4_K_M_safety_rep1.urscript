# Define safety parameters
set_tool_payload(1.5, [0.0, 0.0, 0.0]);
set_payload(1.5, [0.0, 0.0, 0.0]);

# Define safety zones
def SAFE_ZONE_CONFINEMENT = [
    [0.2, 0.2, 0.0],
    [0.2, -0.2, 0.0],
    [-0.2, -0.2, 0.0],
    [-0.2, 0.2, 0.0]
];

def SAFE_ZONE_EXCLUSION = [
    [0.3, 0.3, 0.0],
    [0.3, -0.3, 0.0],
    [-0.3, -0.3, 0.0],
    [-0.3, 0.3, 0.0]
];

# Define waypoints
def WP1 = [0.5, 0.3, 0.2];
def WP2 = [0.5, -0.3, 0.1];
def WP3 = [0.5, 0.3, 0.3];
def WP4 = [0.4, -0.3, 0.2]; # Offset in -X direction to avoid obstacle
def WP5 = [0.6, -0.3, 0.2];
def WP6 = [0.6, 0.3, 0.2];
def WP7 = [0.4, 0.3, 0.2];
def WP8 = [0.4, -0.3, 0.3];
def WP9 = [0.6, -0.3, 0.3];

# Define speeds and accelerations
def SPEED_PICK_PLACE = 200.0;
def ACCELERATION = 1.4;

# Define obstacle position
def OBSTACLE_POSITION = [0.4, 0.0, 0.0];

# Define safety_check function
def safety_check() =
    if !check_collision(SAFE_ZONE_EXCLUSION) and !check_collision(SAFE_ZONE_CONFINEMENT) and !check_touch_intensity(SAFE_ZONE_EXCLUSION) and !check_touch_intensity(SAFE_ZONE_CONFINEMENT) then
        return true;
    else
        popup "Safety violation detected!";
        stop;
        return false;
    end

# Move to home position
movej([0.0, -pi/4, pi/3, -pi/4, pi/3, 0.0], SPEED_PICK_PLACE, ACCELERATION, safety_check: safety_check);

# Move to WP1 (above pick station)
movej(WP1, SPEED_PICK_PLACE, ACCELERATION, safety_check: safety_check);

# Move to WP2 (descend to pick)
movej(WP2, SPEED_PICK_PLACE, ACCELERATION, safety_check: safety_check);

# Move to WP3 (lift above pick)
movej(WP3, SPEED_PICK_PLACE, ACCELERATION, safety_check: safety_check);

# Move to WP4 (obstacle avoidance)
movej(WP4, SPEED_PICK_PLACE, ACCELERATION, safety_check: safety_check);

# Continue with remaining waypoints...

# Example for WP5 to WP9
movej(WP5, SPEED_PICK_PLACE, ACCELERATION, safety_check: safety_check);
movej(WP6, SPEED_PICK_PLACE, ACCELERATION, safety_check: safety_check);
movej(WP7, SPEED_PICK_PLACE, ACCELERATION, safety_check: safety_check);
movej(WP8, SPEED_PICK_PLACE, ACCELERATION, safety_check: safety_check);
movej(WP9, SPEED_PICK_PLACE, ACCELERATION, safety_check: safety_check);