# Define safety parameters
set_tool_digital_out(0, true); # Activate laser tool
set_payload(0.5, [0, 0, 0]); # Set payload

# Define safety zones
safety_zone([[0.3, -0.1, 0.7], [0.3, 0.1, 0.7], [0.3, 0.1, 0.9], [0.3, -0.1, 0.9]]);

# Define safety speeds and accelerations
set_default_acceleration(1.4); # Set default acceleration
set_default_velocity(200.0); # Set default velocity

# Define waypoints
waypoints = [
    [0.3, -0.1, 0.7],
    [0.3, 0.1, 0.7],
    [0.3, 0.1, 0.9],
    [0.3, -0.1, 0.9],
    [0.3, -0.1, 0.7],
    [0.3, -0.05, 0.7],
    [0.3, 0.05, 0.7],
    [0.3, 0.1, 0.7],
    [0.3, 0.1, 0.9],
    [0.3, 0.05, 0.9],
    [0.3, -0.05, 0.9],
    [0.3, -0.1, 0.9],
    [0.3, -0.1, 0.7]
];

# Execute motion commands
for i = 0 to 12
    move_linear(waypoints[i], 200.0, 1.4);
end

# Deactivate laser tool
set_tool_digital_out(0, false);