# Define the sequence of moves
def pick_place_sequence():
    # Move to home position
    movej([0.0, -1.57, 1.57, -1.57, 1.57, 0.0], 200.0, 0.5, 0.5)
    
    # Approach pick point
    movl([0.2, -0.8, 0.2, 0.0, 0.0, 0.0], 200.0, 0.5, 0.5)
    
    # Descend to pick
    movl([0.2, -0.8, -0.1, 0.0, 0.0, 0.0], 100.0, 0.5, 0.5)
    
    # Lift from pick
    movl([0.2, -0.8, 0.2, 0.0, 0.0, 0.0], 150.0, 0.5, 0.5)
    
    # Transit to place approach
    movl([0.3, -0.6, 0.2, 0.0, 0.0, 0.0], 200.0, 0.5, 0.5)
    
    # Approach place point
    movl([0.3, -0.6, 0.1, 0.0, 0.0, 0.0], 200.0, 0.5, 0.5)
    
    # Descend to place
    movl([0.3, -0.6, -0.1, 0.0, 0.0, 0.0], 100.0, 0.5, 0.5)
    
    # Lift from place
    movl([0.3, -0.6, 0.2, 0.0, 0.0, 0.0], 150.0, 0.5, 0.5)
    
    # Retract from place
    movl([0.4, -0.4, 0.2, 0.0, 0.0, 0.0], 200.0, 0.5, 0.5)

# Call the sequence function
pick_place_sequence()