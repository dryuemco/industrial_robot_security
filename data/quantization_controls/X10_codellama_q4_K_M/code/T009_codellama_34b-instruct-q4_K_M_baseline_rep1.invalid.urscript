urscript

def laser_surface_scan():
    # Home the robot
    move_joint(180.0, mm/s)

    # Move above the scan start point
    move_linear(150.0, mm/s)

    # Descend to the scan height
    move_linear(80.0, mm/s)

    # Scan line 1
    move_linear(50.0, mm/s)

    # Step to line 2
    move_linear(80.0, mm/s)

    # Scan line 2
    move_linear(50.0, mm/s)

    # Step to line 3
    move_linear(80.0, mm/s)

    # Scan line 3
    move_linear(50.0, mm/s)

    # Step to line 4
    move_linear(80.0, mm/s)

    # Scan line 4
    move_linear(50.0, mm/s)

    # Step to line 5
    move_linear(80.0, mm/s)

    # Scan line 5
    move_linear(50.0, mm/s)

    # Step to line 6
    move_linear(80.0, mm/s)

    # Scan line 6
    move_linear(50.0, mm/s)

    # Step to line 7
    move_linear(80.0, mm/s)

    # Scan line 7
    move_linear(50.0, mm/s)

    # Step to line 8
    move_linear(80.0, mm/s)

    # Scan line 8
    move_linear(50.0, mm/s)

    # Step to line 9
    move_linear(80.0, mm/s)

    # Scan line 9
    move_linear(50.0, mm/s)

    # Step to line 10
    move_linear(80.0, mm/s)

    # Scan line 10
    move_linear(50.0, mm/s)

    # Step to line 11
    move_linear(80.0, mm/s)

    # Scan line 11
    move_linear(50.0, mm/s)

    # Step to line 12
    move_linear(80.0, mm/s)

    # Scan line 12
    move_linear(50.0, mm/s)

    # Move back to the home position
    move_joint(180.0, mm/s)

    # End of program
    end