# Define constants
HOME_POSITION = [0.0, -0.785, 1.5, -1.57, 1.57, 0.0]
FEEDER_POSITION = [0.5, -0.785, 1.0, -1.57, 1.57, 0.0]
PICK_POSITION = [0.3, -0.785, 0.8, -1.57, 1.57, 0.0]
LIFT_POSITION = [0.3, -0.785, 1.2, -1.57, 1.57, 0.0]
POINT1_POSITION = [0.2, -0.5, 0.6, -1.57, 1.57, 0.0]
POINT2_POSITION = [0.2, -0.3, 0.6, -1.57, 1.57, 0.0]
POINT3_POSITION = [0.2, -0.1, 0.6, -1.57, 1.57, 0.0]
POINT4_POSITION = [0.2, 0.1, 0.6, -1.57, 1.57, 0.0]

# Define speeds
HOME_SPEED = 200.0
PICK_SPEED = 80.0
LIFT_SPEED = 180.0
POINT_SPEED = 200.0

# Define safety zone (confinement)
SAFETY_ZONE = 0.1  # Example value, adjust as needed

# Move to home position
movej(HOME_POSITION, speed=HOME_SPEED, wait=True);

# Move to feeder position
movl(FEEDER_POSITION, speed=HOME_SPEED, z_min_velocity=PICK_SPEED, wait=True);

# Pick screw
movl(PICK_POSITION, speed=PICK_SPEED, wait=True);

# Lift from feeder
movl(LIFT_POSITION, speed=LIFT_SPEED, wait=True);

# Move to fastening point 1
movl(POINT1_POSITION, speed=POINT_SPEED, wait=True);

# Fasten screw (example for point 1)
# Assuming a tool is attached and ready to use
# Example: gripper_close();
# Example: move_linear_relative([0, 0, -0.1], speed=POINT_SPEED, wait=True);
# Example: gripper_open();

# Move to fastening point 2
movl(POINT2_POSITION, speed=POINT_SPEED, wait=True);

# Fasten screw (example for point 2)
# Example: gripper_close();
# Example: move_linear_relative([0, 0, -0.1], speed=POINT_SPEED, wait=True);
# Example: gripper_open();

# Repeat for points 3 and 4
movl(POINT3_POSITION, speed=POINT_SPEED, wait=True);
# Example: gripper_close();
# Example: move_linear_relative([0, 0, -0.1], speed=POINT_SPEED, wait=True);
# Example: gripper_open();

movl(POINT4_POSITION, speed=POINT_SPEED, wait=True);
# Example: gripper_close();
# Example: move_linear_relative([0, 0, -0.1], speed=POINT_SPEED, wait=True);
# Example: gripper_open();