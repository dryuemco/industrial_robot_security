# Define payload
set_payload(1.5, [0,0,0])

# Safety zones
def in_confinement_zone(p):
    # Example confinement zone check (modify as needed)
    return p[0] >= -800 and p[0] <= 800 and p[1] >= -600 and p[1] <= 600 and p[2] >= 0 and p[2] <= 900

def in_exclusion_zone(p):
    # Example exclusion zone check (modify as needed for obstacle)
    return not (p[0] >= -300 and p[0] <= -100 and p[1] >= -150 and p[1] <= 150)

# Safety check function
def safety_check(p):
    if not in_confinement_zone(p) or not in_exclusion_zone(p):
        popup("Safety violation: Out of confinement or exclusion zone!")
        halt()

# Emergency stop handler
try:
    # Home position
    movej(get_inverse_kin([0, -90, 90, -90, 45, 0]), a=1.4, v=200.0)
    
    # WP1: Above pick station
    p1 = get_forward_kin([0, -90, 90, -90, 45, 0]) + [0, 0, 200]
    safety_check(p1)
    movel(p1, a=1.4, v=200.0)

    # WP2: Descend to pick
    p2 = p1 - [0, 0, 100]
    safety_check(p2)
    movel(p2, a=1.4, v=100.0)

    # WP3: Lift above pick
    p3 = p2 + [0, 0, 80]
    safety_check(p3)
    movel(p3, a=1.4, v=180.0)

    # WP4: Obstacle avoidance waypoint (offset in -X)
    p4 = p3 - [50, 0, 0]
    safety_check(p4)
    movel(p4, a=1.4, v=200.0)

    # Continue with remaining waypoints as needed
    # Example for WP5 to WP9 (modify positions and speeds as required)
    p5 = p4 + [50, 0, 0]  # Move back towards path
    safety_check(p5)
    movel(p5, a=1.4, v=200.0)

    p6 = p5 + [0, 0, -80]  # Descend to place position
    safety_check(p6)
    movel(p6, a=1.4, v=100.0)

    p7 = p6 + [0, 0, 80]   # Lift above place position
    safety_check(p7)
    movel(p7, a=1.4, v=180.0)

    p8 = p7 + [200, 0, 0]  # Move to next station or home
    safety_check(p8)
    movel(p8, a=1.4, v=200.0)

    p9 = get_inverse_kin([0, -90, 90, -90, 45, 0])  # Return to home position
    safety_check(get_forward_kin(p9))
    movej(p9, a=1.4, v=200.0)

except:
    popup("Emergency stop triggered!")
    halt()