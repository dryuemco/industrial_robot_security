# Define payload
set_payload(1.2, [0,0,0])

# Safety zones
def in_confinement_zone(p):
    # Define the confinement zone boundaries
    return p[0] >= -500 and p[0] <= 500 and p[1] >= -500 and p[1] <= 500 and p[2] >= 0 and p[2] <= 800

def in_exclusion_zone(p):
    # Define the exclusion zone boundaries
    return not (p[0] >= -300 and p[0] <= 300 and p[1] >= -300 and p[1] <= 300 and p[2] >= 100 and p[2] <= 700)

def safety_check(p):
    if not in_confinement_zone(p) or in_exclusion_zone(p):
        popup("Safety violation: Point out of confinement zone or in exclusion zone!")
        halt()

# Define waypoints
p_home = [0, -1.57, 1.57, -1.83, -1.57, 0]
p_above_storage = [-0.2, -1.6, 1.4, -1.9, -1.5, 0]
p_pick = [-0.2, -1.6, 1.1, -1.9, -1.5, 0]
p_lift_from_bin = [-0.2, -1.6, 1.3, -1.9, -1.5, 0]
p_transit_to_handoff = [0.4, -1.7, 1.5, -1.8, -1.5, 0]
# Define additional waypoints for the remaining moves
p_above_handoff = [0.4, -1.7, 1.3, -1.8, -1.5, 0]
p_place = [0.4, -1.7, 1.1, -1.8, -1.5, 0]
p_lift_from_handoff = [0.4, -1.7, 1.3, -1.8, -1.5, 0]

# Motion sequence
def motion_sequence():
    # Move to home position
    safety_check(p_home)
    movej(p_home, a=1.4, v=250)

    # Move above storage bin
    safety_check(p_above_storage)
    movel(p_above_storage, a=1.4, v=280)

    # Descend to pick position
    safety_check(p_pick)
    movel(p_pick, a=1.4, v=120)

    # Lift from bin
    safety_check(p_lift_from_bin)
    movel(p_lift_from_bin, a=1.4, v=200)

    # Transit to handoff zone
    safety_check(p_transit_to_handoff)
    movel(p_transit_to_handoff, a=1.4, v=250)

    # Move above handoff position
    safety_check(p_above_handoff)
    movel(p_above_handoff, a=1.4, v=280)

    # Place in handoff position
    safety_check(p_place)
    movel(p_place, a=1.4, v=120)

    # Lift from handoff position
    safety_check(p_lift_from_handoff)
    movel(p_lift_from_handoff, a=1.4, v=200)

# Execute motion sequence
motion_sequence()