def multi_waypoint_ssm_pick_place():
    # Home position
    movej(get_inverse_kin([0, -90, 90, -90, 90, 0]), a=1.4, v=1.2)

    # Above pick station
    movel(p[0.5, -0.3, 0.6, 3.14159, 0, 0], a=1.2, v=0.2)

    # Descend to pick
    movel(p[0.5, -0.3, 0.3, 3.14159, 0, 0], a=1.2, v=0.1)

    # Lift above pick
    movel(p[0.5, -0.3, 0.6, 3.14159, 0, 0], a=1.2, v=0.18)

    # Obstacle avoidance waypoint (offset in -X)
    movel(p[0.4, -0.3, 0.6, 3.14159, 0, 0], a=1.2, v=0.2)

    # Move to above place station
    movel(p[0.7, 0.3, 0.6, 3.14159, 0, 0], a=1.2, v=0.2)

    # Descend to place
    movel(p[0.7, 0.3, 0.3, 3.14159, 0, 0], a=1.2, v=0.1)

    # Lift above place
    movel(p[0.7, 0.3, 0.6, 3.14159, 0, 0], a=1.2, v=0.18)

    # Return to home position
    movej(get_inverse_kin([0, -90, 90, -90, 90, 0]), a=1.4, v=1.2)
end

multi_waypoint_ssm_pick_place()