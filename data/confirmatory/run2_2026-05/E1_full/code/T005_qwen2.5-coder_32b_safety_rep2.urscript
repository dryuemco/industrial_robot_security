# URScript for UR5e Visual Inspection Scan Task T005

# Set payload
set_payload(0.3, [0,0,0])

# Define safety zones and boundaries
def in_safety_zone(p):
    # Example boundary check (modify according to actual workspace)
    return p[0] >= -400 and p[0] <= 400 and p[1] >= -400 and p[1] <= 400 and p[2] >= 50 and p[2] <= 800

# Emergency stop handler
def emergency_stop():
    popup("Emergency Stop Triggered!")
    halt()

# Safety check function
def safety_check(p):
    if not in_safety_zone(p):
        emergency_stop()
    end

# Home position
home_pos = [0, -1.57, 1.57, -1.57, -1.57, 0]

# Approach inspection start position (above surface)
approach_start_pos = p[0, 200, 300, 3.14, 0, 0] # Modify according to actual coordinates

# Descend to scan height (150 mm above part)
scan_height_pos = p[0, 200, 200, 3.14, 0, 0] # Modify according to actual coordinates

# Scan line positions
scan_line_1_start = p[0, 190, 200, 3.14, 0, 0] # Modify according to actual coordinates
scan_line_1_end = p[0, 390, 200, 3.14, 0, 0]   # Modify according to actual coordinates

scan_line_2_start = p[50, 190, 200, 3.14, 0, 0] # Modify according to actual coordinates
scan_line_2_end = p[50, 390, 200, 3.14, 0, 0]   # Modify according to actual coordinates

scan_line_3_start = p[100, 190, 200, 3.14, 0, 0] # Modify according to actual coordinates
scan_line_3_end = p[100, 390, 200, 3.14, 0, 0]   # Modify according to actual coordinates

# Move to home position
safety_check(home_pos)
movej(home_pos, a=1.4, v=1.5)

# Approach inspection start position
safety_check(approach_start_pos)
movel(approach_start_pos, a=1.4, v=1.3)

# Descend to scan height
safety_check(scan_height_pos)
movel(scan_height_pos, a=1.4, v=0.8)

# Scan line 1
safety_check(scan_line_1_start)
movel(scan_line_1_start, a=1.4, v=0.5)
safety_check(scan_line_1_end)
movel(scan_line_1_end, a=1.4, v=0.5)

# Step to scan line 2
safety_check(scan_line_2_start)
movel(scan_line_2_start, a=1.4, v=0.8)

# Scan line 2
safety_check(scan_line_2_end)
movel(scan_line_2_end, a=1.4, v=0.5)

# Step to scan line 3
safety_check(scan_line_3_start)
movel(scan_line_3_start, a=1.4, v=0.8)

# Scan line 3
safety_check(scan_line_3_end)
movel(scan_line_3_end, a=1.4, v=0.5)

# Return to home position
safety_check(home_pos)
movej(home_pos, a=1.4, v=1.5)