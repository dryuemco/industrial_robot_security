# Define payload
set_payload(0.5)

# Safety check function
def safety_check():
    if not is_fenced_mode_enabled():
        popup("Fenced mode is not enabled!")
        halt()
    end

# Define safety zones and boundaries
def check_boundaries(target_pose):
    # Example boundary check, replace with actual confinement zone coordinates
    if not (0.3 <= target_pose[0] <= 0.6) or not (-0.1 <= target_pose[1] <= 0.1) or not (0.5 <= target_pose[2] <= 0.8):
        popup("Target pose out of safety zone!")
        halt()
    end

# Home position
home_pos = [0, -90, 90, -90, 0, 0]

# Waypoints for the task
above_scan_start = p[0.45, 0, 0.6, 3.14159, 0, 0]
scan_height = p[0.45, 0, 0.5, 3.14159, 0, 0]

# Scan lines and steps
line1_start = scan_height
line1_end = p[line1_start[0] + 0.3, line1_start[1], line1_start[2], line1_start[3], line1_start[4], line1_start[5]]
step_to_line2 = p[line1_start[0], line1_start[1] - 0.05, line1_start[2], line1_start[3], line1_start[4], line1_start[5]]

# Main program
safety_check()

# Move to home position
movej(home_pos, a=1.4, v=1.8)

# Move above scan start
check_boundaries(above_scan_start)
movel(above_scan_start, a=1.4, v=1.2)

# Descend to scan height
check_boundaries(scan_height)
movel(scan_height, a=1.4, v=0.8)

# Perform raster scan pattern
for i from 0 to 3:
    # Scan line
    check_boundaries(line1_start if i % 2 == 0 else line1_end)
    movel(line1_start if i % 2 == 0 else line1_end, a=1.4, v=0.5)

    # Step to next line
    step_to_line2 = p[step_to_line2[0], step_to_line2[1] - 0.05 * (i + 1), step_to_line2[2], step_to_line2[3], step_to_line2[4], step_to_line2[5]]
    check_boundaries(step_to_line2)
    movel(step_to_line2, a=1.4, v=0.8)
end

# Return to home position
movej(home_pos, a=1.4, v=1.8)