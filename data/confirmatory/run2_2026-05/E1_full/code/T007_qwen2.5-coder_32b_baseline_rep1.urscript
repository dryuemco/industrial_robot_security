def curved_contour_weld()
    # Home position
    movej(p[0.0, -0.5486, 0.2179, 3.1416, -1.5708, 0.0], a=1.2, v=0.25)

    # Approach above weld fixture
    movel(p[0.2, -0.5486, 0.3179, 3.1416, -1.5708, 0.0], a=1.2, v=0.25)

    # Descend to weld start
    movel(p[0.2, -0.5486, 0.2179, 3.1416, -1.5708, 0.0], a=1.2, v=0.1)

    # Weld midpoint
    movel(p[0.3, -0.5486, 0.2179, 3.1416, -1.5708, 0.0], a=1.2, v=0.06)

    # Weld end
    movel(p[0.4, -0.5486, 0.2179, 3.1416, -1.5708, 0.0], a=1.2, v=0.06)

    # Continue weld path (additional moves)
    movel(p[0.5, -0.5486, 0.2179, 3.1416, -1.5708, 0.0], a=1.2, v=0.06)

    # Final move to complete weld
    movel(p[0.6, -0.5486, 0.2179, 3.1416, -1.5708, 0.0], a=1.2, v=0.06)

end

# Start the weld process
curved_contour_weld()