def dual_zone_pick_place():
    # Set payload and max speed
    set_payload(1.2, [0,0,0,0,0,0])
    set_tcp_speed_limit(300)

    # Move to Home position
    movej(get_inverse_kin([0.0, -0.5, 0.4, 0, 3.14, 0]), a=1.2, v=1.05)

    # Move above storage bin
    movel(p[0.4, -0.4, 0.6, 0, 3.14, 0], a=1.2, v=1.4)

    # Descend to pick position
    movel(p[0.4, -0.4, 0.2, 0, 3.14, 0], a=1.2, v=0.72)

    # Lift from bin
    movel(p[0.4, -0.4, 0.6, 0, 3.14, 0], a=1.2, v=1.2)

    # Transit to handoff zone
    movel(p[0.7, -0.2, 0.5, 0, 3.14, 0], a=1.2, v=1.5)

    # Placeholder for next moves (3 more)
    movel(p[0.8, -0.2, 0.5, 0, 3.14, 0], a=1.2, v=1.5)  # Example move
    movel(p[0.9, -0.2, 0.5, 0, 3.14, 0], a=1.2, v=1.5)  # Example move
    movel(p[1.0, -0.2, 0.5, 0, 3.14, 0], a=1.2, v=1.5)  # Example move

end