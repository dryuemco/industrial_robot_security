def multi_waypoint_ssm_pick_place():
    # Home position
    movej(get_inverse_kin([0, -90, 90, -90, 45, 0]), a=1.2, v=0.25)

    # Above pick station
    movel(p[0.3, -0.2, 0.5, 3.1416, 0, 0], a=1.2, v=0.2)

    # Descend to pick
    movel(p[0.3, -0.2, 0.2, 3.1416, 0, 0], a=1.2, v=0.1)

    # Lift above pick
    movel(p[0.3, -0.2, 0.5, 3.1416, 0, 0], a=1.2, v=0.18)

    # Obstacle avoidance waypoint (offset in -X)
    movel(p[0.2, -0.2, 0.5, 3.1416, 0, 0], a=1.2, v=0.2)

    # Move to above place station
    movel(p[0.5, 0.2, 0.5, 3.1416, 0, 0], a=1.2, v=0.2)

    # Descend to place
    movel(p[0.5, 0.2, 0.2, 3.1416, 0, 0], a=1.2, v=0.1)

    # Lift above place
    movel(p[0.5, 0.2, 0.5, 3.1416, 0, 0], a=1.2, v=0.18)

    # Return to home position
    movej(get_inverse_kin([0, -90, 90, -90, 45, 0]), a=1.2, v=0.25)
end

multi_waypoint_ssm_pick_place()