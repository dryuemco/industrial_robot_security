# Define payload
set_payload(0.5)

# Safety check function
def safety_check():
    if not is_fenced_mode_enabled():
        popup("Fenced mode is not enabled!")
        halt()
    end

# Define safety zones and boundaries
def check_boundaries(target_pose):
    # Example boundary check, replace with actual confinement zone coordinates
    x_min = -0.5
    x_max = 0.5
    y_min = -0.3
    y_max = 0.3
    z_min = 0.1
    z_max = 0.8
    
    if not (x_min <= target_pose[0] <= x_max and 
            y_min <= target_pose[1] <= y_max and 
            z_min <= target_pose[2] <= z_max):
        popup("Target pose out of safety boundaries!")
        halt()
    end
end

# Emergency stop handler
def emergency_stop_handler():
    if is_emergency_stopped():
        popup("Emergency stop triggered!")
        halt()
    end
end

# Home position
home_pos = [0, -90, 90, -90, 0, 0]

# Waypoints definition (example coordinates)
above_scan_start = p[0.3, -0.15, 0.4, 3.14, 0, 0]
scan_height = p[0.3, -0.15, 0.2, 3.14, 0, 0]
line_1_start = p[0.3, -0.15, 0.2, 3.14, 0, 0]
line_1_end = p[0.6, -0.15, 0.2, 3.14, 0, 0]
step_to_line_2 = p[0.3, -0.15, 0.2, 3.14, 0, 0] # Adjust as needed for each step
# Define remaining waypoints similarly

# Motion sequence
safety_check()
emergency_stop_handler()

movej(home_pos, a=1.4, v=1.8) # Home position move

check_boundaries(above_scan_start)
movel(above_scan_start, a=1.4, v=1.5)

check_boundaries(scan_height)
movel(scan_height, a=1.4, v=1.0)

# Scan line 1
check_boundaries(line_1_end)
movel(line_1_end, a=1.4, v=0.6)

# Step to line 2 (example, repeat for all lines)
check_boundaries(step_to_line_2)
movel(step_to_line_2, a=1.4, v=1.0)

# Repeat similar moves for remaining scan lines and steps

# Return to home position
movej(home_pos, a=1.4, v=1.8)