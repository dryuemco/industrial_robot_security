def screw_fastening_assembly():
    # Move to Home position
    movej(get_inverse_kin([0, -90, 90, -90, 0, 0]), a=1.4, v=1.05)

    # Move above screw feeder
    movel(p[0.3, -0.2, 0.2, 3.14, 0, 0], a=1.2, v=1.05)

    # Pick screw from feeder
    movel(p[0.3, -0.2, 0.1, 3.14, 0, 0], a=1.2, v=0.8)

    # Lift from feeder
    movel(p[0.3, -0.2, 0.2, 3.14, 0, 0], a=1.2, v=1.65)

    # Move above fastening point 1 (collaborative approach)
    set_tcp(p[-0.01, 0, 0.1, 0, 0, 0])
    movel(p[0.4, -0.3, 0.2, 3.14, 0, 0], a=1.2, v=1.05)

    # Fasten at point 1 (fenced)
    set_tcp(p[-0.01, 0, 0, 0, 0, 0])
    movel(p[0.4, -0.3, 0.05, 3.14, 0, 0], a=1.2, v=0.2)

    # Move above fastening point 2 (collaborative approach)
    set_tcp(p[-0.01, 0, 0.1, 0, 0, 0])
    movel(p[0.45, -0.3, 0.2, 3.14, 0, 0], a=1.2, v=1.05)

    # Fasten at point 2 (fenced)
    set_tcp(p[-0.01, 0, 0, 0, 0, 0])
    movel(p[0.45, -0.3, 0.05, 3.14, 0, 0], a=1.2, v=0.2)

    # Move above fastening point 3 (collaborative approach)
    set_tcp(p[-0.01, 0, 0.1, 0, 0, 0])
    movel(p[0.5, -0.3, 0.2, 3.14, 0, 0], a=1.2, v=1.05)

    # Fasten at point 3 (fenced)
    set_tcp(p[-0.01, 0, 0, 0, 0, 0])
    movel(p[0.5, -0.3, 0.05, 3.14, 0, 0], a=1.2, v=0.2)

    # Move above fastening point 4 (collaborative approach)
    set_tcp(p[-0.01, 0, 0.1, 0, 0, 0])
    movel(p[0.55, -0.3, 0.2, 3.14, 0, 0], a=1.2, v=1.05)

    # Fasten at point 4 (fenced)
    set_tcp(p[-0.01, 0, 0, 0, 0, 0])
    movel(p[0.55, -0.3, 0.05, 3.14, 0, 0], a=1.2, v=0.2)

end