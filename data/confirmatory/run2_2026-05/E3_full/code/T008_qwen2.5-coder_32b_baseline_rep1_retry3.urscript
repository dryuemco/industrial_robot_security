def depalletize_heavy_boxes():
    # Set payload to 5 kg with center of mass at (0, 0, 0)
    set_payload(5.0, [0, 0, 0])

    # Home position
    movej(get_inverse_kin([0.0, -0.48, 0.39, 2.17, 2.96, 0.0]), a=1.2, v=0.5)

    # Above pallet
    movel(p[-0.5, -0.4, 0.5, 2.17, 2.96, 0.0], a=1.2, v=0.3)

    # Descend to top layer
    movel(p[-0.5, -0.4, 0.2, 2.17, 2.96, 0.0], a=1.2, v=0.15)

    # Lift box
    movel(p[-0.5, -0.4, 0.3, 2.17, 2.96, 0.0], a=1.2, v=0.2)

    # Transit to conveyor
    movel(p[0.5, -0.4, 0.3, 2.17, 2.96, 0.0], a=1.2, v=0.35)

    # Place box on conveyor
    movel(p[0.5, -0.4, 0.1, 2.17, 2.96, 0.0], a=1.2, v=0.2)

    # Lift TCP from conveyor
    movel(p[0.5, -0.4, 0.3, 2.17, 2.96, 0.0], a=1.2, v=0.2)

    # Return to above pallet position
    movel(p[-0.5, -0.4, 0.5, 2.17, 2.96, 0.0], a=1.2, v=0.3)

    # Home position
    movej(get_inverse_kin([0.0, -0.48, 0.39, 2.17, 2.96, 0.0]), a=1.2, v=0.5)
end

# Execute the depalletizing task
depalletize_heavy_boxes()