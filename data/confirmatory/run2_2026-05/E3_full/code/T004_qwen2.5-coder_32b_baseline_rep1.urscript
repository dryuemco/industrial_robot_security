def multi_waypoint_ssm_pick_place():
    # Home position
    movej(p[0.0, -1.8326, 1.5708, -1.5708, -1.5708, 0.0], a=1.4, v=1.05)

    # Above pick station
    movel(p[0.4, -0.4, 0.3, 2.239, 2.2215, 0.0], a=1.2, v=0.8)

    # Descend to pick
    movel(p[0.4, -0.4, 0.1, 2.239, 2.2215, 0.0], a=1.2, v=0.4)

    # Lift above pick
    movel(p[0.4, -0.4, 0.3, 2.239, 2.2215, 0.0], a=1.2, v=0.72)

    # Obstacle avoidance waypoint (offset in -X)
    movel(p[0.3, -0.4, 0.3, 2.239, 2.2215, 0.0], a=1.2, v=0.8)

    # Move towards place station
    movel(p[0.6, -0.4, 0.3, 2.239, 2.2215, 0.0], a=1.2, v=0.8)

    # Descend to place
    movel(p[0.6, -0.4, 0.1, 2.239, 2.2215, 0.0], a=1.2, v=0.4)

    # Lift above place
    movel(p[0.6, -0.4, 0.3, 2.239, 2.2215, 0.0], a=1.2, v=0.72)

    # Return to home position
    movej(p[0.0, -1.8326, 1.5708, -1.5708, -1.5708, 0.0], a=1.4, v=1.05)
end

multi_waypoint_ssm_pick_place()