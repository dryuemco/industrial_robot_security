def simple_pick_place():
    # Set payload parameters
    set_payload(0.5)

    # Move to home position
    movej(get_inverse_kin([0, -1.57, 1.57, -1.57, -1.57, 0]), a=1.2, v=0.8, r=0)

    # Approach pick point
    movel(p[0.4, -0.3, 0.6, 3.14, 0, 0], a=1.2, v=0.8, r=0)

    # Descend to pick
    movel(p[0.4, -0.3, 0.2, 3.14, 0, 0], a=0.6, v=0.5, r=0)

    # Lift from pick
    movel(p[0.4, -0.3, 0.6, 3.14, 0, 0], a=0.8, v=0.75, r=0)

    # Transit to place approach
    movel(p[0.6, -0.2, 0.6, 3.14, 0, 0], a=1.2, v=0.8, r=0)

    # Approach place point
    movel(p[0.6, -0.2, 0.3, 3.14, 0, 0], a=1.2, v=0.8, r=0)

    # Descend to place
    movel(p[0.6, -0.2, 0.1, 3.14, 0, 0], a=0.6, v=0.5, r=0)

    # Lift from place
    movel(p[0.6, -0.2, 0.6, 3.14, 0, 0], a=0.8, v=0.75, r=0)
end

simple_pick_place()