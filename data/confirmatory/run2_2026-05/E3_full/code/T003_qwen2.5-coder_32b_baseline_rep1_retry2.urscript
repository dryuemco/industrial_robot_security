def main():
    # Set payload to 4.5 kg
    set_payload(4.5)

    # Home position
    movej(p[-0.12, -0.67, 0.38, 2.92, -1.57, 0.0], a=1.2, v=0.25)

    # Approach conveyor pick — above
    movel(p[0.4, -0.4, 0.5, 2.92, -1.57, 0.0], a=1.2, v=0.25)

    # Descend to pick
    movel(p[0.4, -0.4, 0.1, 2.92, -1.57, 0.0], a=1.2, v=0.1)

    # Lift from conveyor
    movel(p[0.4, -0.4, 0.5, 2.92, -1.57, 0.0], a=1.2, v=0.2)

    # Transit to pallet position (0,0)
    movej(p[0.6, 0.3, 0.5, 2.92, -1.57, 0.0], a=1.4, v=0.28)

    # Place on pallet (position 0,0)
    movel(p[0.6, 0.3, 0.1, 2.92, -1.57, 0.0], a=1.2, v=0.1)
    movel(p[0.6, 0.3, 0.5, 2.92, -1.57, 0.0], a=1.2, v=0.2)

    # Transit to pallet position (1,0)
    movej(p[0.8, 0.3, 0.5, 2.92, -1.57, 0.0], a=1.4, v=0.28)

    # Place on pallet (position 1,0)
    movel(p[0.8, 0.3, 0.1, 2.92, -1.57, 0.0], a=1.2, v=0.1)
    movel(p[0.8, 0.3, 0.5, 2.92, -1.57, 0.0], a=1.2, v=0.2)

end