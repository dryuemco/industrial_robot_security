def bin_picking_task():
    # Home position
    movej(p[0.0, -1.823879, 1.570796, -1.570796, -1.570796, 0.0], a=1.4, v=1.05)

    # Above bin
    movel(p[0.3, -0.2, 0.3, 3.14159, -1.5708, 0.0], a=1.2, v=0.35)

    # Descend into bin
    movel(p[0.3, -0.2, 0.1, 3.14159, -1.5708, 0.0], a=1.2, v=0.15)

    # Activate suction (simulated)
    set_digital_out(8, True)
    sleep(0.5)  # Wait for suction to activate

    # Lift from bin
    movel(p[0.3, -0.2, 0.3, 3.14159, -1.5708, 0.0], a=1.2, v=0.3)

    # Transit to conveyor
    movel(p[0.6, 0.2, 0.3, 3.14159, -1.5708, 0.0], a=1.2, v=0.38)

    # Above conveyor
    movel(p[0.6, 0.2, 0.1, 3.14159, -1.5708, 0.0], a=1.2, v=0.15)

    # Place on conveyor
    set_digital_out(8, False)
    sleep(0.5)  # Wait for suction to deactivate

    # Lift from conveyor
    movel(p[0.6, 0.2, 0.3, 3.14159, -1.5708, 0.0], a=1.2, v=0.3)

    # Return to home position
    movej(p[0.0, -1.823879, 1.570796, -1.570796, -1.570796, 0.0], a=1.4, v=1.05)

end