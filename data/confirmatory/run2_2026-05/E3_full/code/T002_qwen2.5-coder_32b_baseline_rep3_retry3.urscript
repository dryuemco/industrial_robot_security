def linear_weld_path():
    # Go to home position
    movej(p[0.0, -0.785398, 0.0, -2.356194, 0.0, 0.0], a=1.2, v=1.0)

    # Approach above weld start
    movel(p[-0.2, -0.5, 0.5, -2.356194, 0.0, 0.0], a=1.2, v=0.25)

    # Descend to weld start position
    movel(p[-0.2, -0.5, 0.1, -2.356194, 0.0, 0.0], a=1.2, v=0.1)

    # Weld seam — 300mm linear path
    set_do(7,True)  # Activate welding arc
    movel(p[0.1, -0.5, 0.1, -2.356194, 0.0, 0.0], a=1.2, v=0.05)
    set_do(7,False)  # Deactivate welding arc

    # Retract above weld end
    movel(p[0.1, -0.5, 0.5, -2.356194, 0.0, 0.0], a=1.2, v=0.2)

    # Return to home position
    movej(p[0.0, -0.785398, 0.0, -2.356194, 0.0, 0.0], a=1.2, v=1.0)
end

# Execute the weld path function
linear_weld_path()