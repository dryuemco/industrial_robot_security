def screw_fastening_assembly():
    # Set TCP to screwdriver tool
    set_tcp(p[0.0, 0.0, 0.15, 0.0, 3.1416, 0.0])
    
    # Home position
    movej(get_inverse_kin([0.0, -1.8239, 1.7105, -1.2217, -1.5708, 0.0]), a=1.4, v=1.05)
    
    # Move above screw feeder
    movel(p[0.3, -0.4, 0.6, 0.0, 3.1416, 0.0], a=1.2, v=0.2)
    
    # Pick screw
    set_digital_out(8, True)  # Activate vacuum gripper
    sleep(0.5)
    movel(p[0.3, -0.4, 0.2, 0.0, 3.1416, 0.0], a=1.2, v=0.08)
    
    # Lift from feeder
    movel(p[0.3, -0.4, 0.6, 0.0, 3.1416, 0.0], a=1.2, v=0.18)
    
    # Move above fastening point 1 (hybrid mode approach)
    set_payload(1.0, [0.0, 0.0, 0.15])
    movel(p[0.4, -0.3, 0.6, 0.0, 3.1416, 0.0], a=1.2, v=0.2)
    
    # Fasten at point 1 (fenced mode)
    set_payload(1.0, [0.0, 0.0, 0.15])
    movel(p[0.4, -0.3, 0.2, 0.0, 3.1416, 0.0], a=1.2, v=0.08)
    sleep(1)  # Simulate fastening time
    movel(p[0.4, -0.3, 0.6, 0.0, 3.1416, 0.0], a=1.2, v=0.18)
    
    # Move above fastening point 2 (hybrid mode approach)
    movel(p[0.5, -0.3, 0.6, 0.0, 3.1416, 0.0], a=1.2, v=0.2)
    
    # Fasten at point 2 (fenced mode)
    movel(p[0.5, -0.3, 0.2, 0.0, 3.1416, 0.0], a=1.2, v=0.08)
    sleep(1)  # Simulate fastening time
    movel(p[0.5, -0.3, 0.6, 0.0, 3.1416, 0.0], a=1.2, v=0.18)
    
    # Move above fastening point 3 (hybrid mode approach)
    movel(p[0.5, -0.2, 0.6, 0.0, 3.1416, 0.0], a=1.2, v=0.2)
    
    # Fasten at point 3 (fenced mode)
    movel(p[0.5, -0.2, 0.2, 0.0, 3.1416, 0.0], a=1.2, v=0.08)
    sleep(1)  # Simulate fastening time
    movel(p[0.5, -0.2, 0.6, 0.0, 3.1416, 0.0], a=1.2, v=0.18)
    
    # Move above fastening point 4 (hybrid mode approach)
    movel(p[0.4, -0.2, 0.6, 0.0, 3.1416, 0.0], a=1.2, v=0.2)
    
    # Fasten at point 4 (fenced mode)
    movel(p[0.4, -0.2, 0.2, 0.0, 3.1416, 0.0], a=1.2, v=0.08)
    sleep(1)  # Simulate fastening time
    movel(p[0.4, -0.2, 0.6, 0.0, 3.1416, 0.0], a=1.2, v=0.18)
    
    # Return to home position
    movej(get_inverse_kin([0.0, -1.8239, 1.7105, -1.2217, -1.5708, 0.0]), a=1.4, v=1.05)
    
    # Deactivate vacuum gripper
    set_digital_out(8, False)

end

screw_fastening_assembly()