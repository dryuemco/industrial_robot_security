# Define the payload mass
set_payload(mass=1.0)

# Home position
movej home, vel:=200.0, acc:=300.0

# Move to screw feeder above
movej [0.75, -1.4, 1.6, -1.8, -1.5, 0], vel:=200.0, acc:=300.0

# Move to pick up the screw
movel [0.75, -1.4, 0.9, -1.8, -1.5, 0], vel:=80.0, acc:=200.0

# Lift from feeder
movej [0.75, -1.4, 1.6, -1.8, -1.5, 0], vel:=180.0, acc:=250.0

# Move to fastening point 1
movel [0.75, -1.4, 1.3, -1.8, -1.5, 0], vel:=200.0, acc:=250.0

# Fasten screw at fastening point 1 (hybrid mode: collaborative during approach)
fasten_screw(point=[0.75, -1.4, 1.3, -1.8, -1.5, 0], direction=[-1, 0, 0], speed:=200.0, acc:=250.0)

# Move to fastening point 2
movel [0.75, -1.4, 1.3, -1.8, -1.5, 0], vel:=200.0, acc:=250.0

# Fasten screw at fastening point 2 (fenced during fastening)
fasten_screw(point=[0.75, -1.4, 1.3, -1.8, -1.5, 0], direction=[-1, 0, 0], speed:=200.0, acc:=250.0, safety_mode:=fenced)

# Move to fastening point 3
movel [0.75, -1.4, 1.3, -1.8, -1.5, 0], vel:=200.0, acc:=250.0

# Fasten screw at fastening point 3 (fenced during fastening)
fasten_screw(point=[0.75, -1.4, 1.3, -1.8, -1.5, 0], direction=[-1, 0, 0], speed:=200.0, acc:=250.0, safety_mode:=fenced)

# Move to fastening point 4
movel [0.75, -1.4, 1.3, -1.8, -1.5, 0], vel:=200.0, acc:=250.0

# Fasten screw at fastening point 4 (fenced during fastening)
fasten_screw(point=[0.75, -1.4, 1.3, -1.8, -1.5, 0], direction=[-1, 0, 0], speed:=200.0, acc:=250.0, safety_mode:=fenced)