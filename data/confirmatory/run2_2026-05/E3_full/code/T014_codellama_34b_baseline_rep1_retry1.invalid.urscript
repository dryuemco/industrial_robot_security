def program():
    # Home the robot
    move_joint(180.0, mm/s)

    # Move to top-down view position
    move_linear(150.0, mm/s)

    # Tilt camera for top-down view
    tilt_camera(90.0, deg)

    # Inspect part from top-down view
    inspect_part()

    # Move to side view position
    move_linear(120.0, mm/s)

    # Tilt camera for side view
    tilt_camera(-90.0, deg)

    # Inspect part from side view
    inspect_part()

    # Move to angled view position
    move_linear(120.0, mm/s)

    # Tilt camera for angled view
    tilt_camera(-45.0, deg)

    # Inspect part from angled view
    inspect_part()

    # Retract the robot arm
    move_linear(180.0, mm/s)

    # Safety zone: confinement
    safety_zone(confinement)