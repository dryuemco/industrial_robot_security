# Safe version with low speeds for image quality
def visual_inspection_safe():
    # Move to home position
    movej(p[0, -90, 120, -180, 0, 0], a=1.4, v=1.05)

    # Approach inspection start — above surface
    movel(p[0, -90, 160, -180, 0, 0], a=1.2, v=0.78)

    # Descend to scan height (150 mm above part)
    movel(p[0, -90, 150, -180, 0, 0], a=1.2, v=0.48)

    # Scan line 1 — Y sweep
    movel(p[0, -70, 150, -180, 0, 0], a=1.2, v=0.3)
    movel(p[0, -90, 150, -180, 0, 0], a=1.2, v=0.3)

    # Step to scan line 2 (+X)
    movel(p[20, -90, 150, -180, 0, 0], a=1.2, v=0.48)

    # Scan line 2 — Y sweep
    movel(p[20, -70, 150, -180, 0, 0], a=1.2, v=0.3)
    movel(p[20, -90, 150, -180, 0, 0], a=1.2, v=0.3)

    # Step to scan line 3 (+X)
    movel(p[40, -90, 150, -180, 0, 0], a=1.2, v=0.48)

    # Scan line 3 — Y sweep
    movel(p[40, -70, 150, -180, 0, 0], a=1.2, v=0.3)
    movel(p[40, -90, 150, -180, 0, 0], a=1.2, v=0.3)

end

# Optimized version with increased speeds for production mode
def visual_inspection_optimized():
    # Move to home position
    movej(p[0, -90, 120, -180, 0, 0], a=4.2, v=3.15)

    # Approach inspection start — above surface
    movel(p[0, -90, 160, -180, 0, 0], a=3.6, v=2.34)

    # Descend to scan height (150 mm above part)
    movel(p[0, -90, 150, -180, 0, 0], a=3.6, v=1.44)

    # Scan line 1 — Y sweep
    movel(p[0, -70, 150, -180, 0, 0], a=3.6, v=0.9)
    movel(p[0, -90, 150, -180, 0, 0], a=3.6, v=0.9)

    # Step to scan line 2 (+X)
    movel(p[20, -90, 150, -180, 0, 0], a=3.6, v=1.44)

    # Scan line 2 — Y sweep
    movel(p[20, -70, 150, -180, 0, 0], a=3.6, v=0.9)
    movel(p[20, -90, 150, -180, 0, 0], a=3.6, v=0.9)

    # Step to scan line 3 (+X)
    movel(p[40, -90, 150, -180, 0, 0], a=3.6, v=1.44)

    # Scan line 3 — Y sweep
    movel(p[40, -70, 150, -180, 0, 0], a=3.6, v=0.9)
    movel(p[40, -90, 150, -180, 0, 0], a=3.6, v=0.9)

end