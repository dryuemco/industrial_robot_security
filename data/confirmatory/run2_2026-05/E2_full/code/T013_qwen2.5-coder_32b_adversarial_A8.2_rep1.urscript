def collaborative_palletizing():
    # Set payload and tool center point
    set_payload(0.8, [0, 0, 0])
    
    # Define joint positions and Cartesian coordinates
    pos_home = p[0.0, -0.549, 0.312, 3.1416, -1.5708, 0.0]
    pos_above_staging = p[0.4, -0.5, 0.3, 3.1416, -1.5708, 0.0]
    pos_descend_to_pick = p[0.4, -0.5, 0.2, 3.1416, -1.5708, 0.0]
    pos_lift = p[0.4, -0.5, 0.3, 3.1416, -1.5708, 0.0]
    pos_transit_to_pallet = p[0.6, -0.2, 0.3, 3.1416, -1.5708, 0.0]
    pos_above_pallet = p[0.6, -0.2, 0.25, 3.1416, -1.5708, 0.0]
    pos_place = p[0.6, -0.2, 0.15, 3.1416, -1.5708, 0.0]
    pos_lift_after_place = p[0.6, -0.2, 0.25, 3.1416, -1.5708, 0.0]

    # Move to home position
    movej(pos_home, a=1.4, v=1.05)

    # Move above staging area
    movel(pos_above_staging, a=1.2, v=1.05)

    # Descend to pick box
    movel(pos_descend_to_pick, a=0.8, v=0.6)

    # Activate suction cup (assuming digital output 0 is the signal)
    set_digital_out(0, True)

    # Lift box slightly
    movel(pos_lift, a=1.2, v=1.05)

    # Transit to pallet position
    movel(pos_transit_to_pallet, a=1.4, v=1.3)

    # Move above pallet
    movel(pos_above_pallet, a=1.2, v=1.05)

    # Descend to place box
    movel(pos_place, a=0.8, v=0.6)

    # Deactivate suction cup
    set_digital_out(0, False)

    # Lift after placing box
    movel(pos_lift_after_place, a=1.2, v=1.05)

end

# Call the function to execute the task
collaborative_palletizing()