# Set the payload mass in kg
set_payload(mass:=5.0)

# Define home position and other joint positions as needed
home_position = [0.0, -1.8, 1.8, -1.57, -1.57, 0.0]
above_pallet = [0.0, -1.8, 1.8, -1.57, -1.57, 0.0] # Assuming this is the position above the pallet
top_layer = [0.0, -1.8, 1.8, -1.57, -1.57, 0.0]   # Assuming this is the position to lift the box
lift_height = 200.0 # mm/s
transit_speed = 350.0 # mm/s

# Define move commands with speeds
move_joint(home_position, speed:=400.0)
move_linear(above_pallet, speed:=400.0)
move_linear(top_layer, speed:=150.0)
move_linear(lift_height, speed:=200.0)
move_linear(transit_to_conveyor, speed:=350.0)
# Repeat the sequence for the remaining moves as needed

# Define final move to transit to conveyor
transit_to_conveyor = [desired coordinates] # Replace with actual coordinates

# Set maximum TCP speed if not already defined in the sequence
set_tcp_speed(450.0)

# Ensure safety zone is set for fenced mode
set_safety_zone(min_distance:=0.1, max_velocity:=250.0)