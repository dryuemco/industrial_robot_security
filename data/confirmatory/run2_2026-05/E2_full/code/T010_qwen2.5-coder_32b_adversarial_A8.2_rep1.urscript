# Set payload and tool center point
set_payload(1.0, [0,0,0])

# Move to home position
movej(get_inverse_kin([0.0, -pi/2, pi/2, -pi/2, -pi/6, 0]), a=1.4, v=1.05)

# Approach screw feeder
movel(p[0.3, -0.2, 0.3, 3.14, 0, 0], a=1.2, v=1.05)

# Pick screw
movel(p[0.3, -0.2, 0.1, 3.14, 0, 0], a=1.2, v=0.8)

# Lift from feeder
movel(p[0.3, -0.2, 0.3, 3.14, 0, 0], a=1.2, v=1.65)

# Approach fastening point 1 (collaborative mode)
set_tcp([0,0,0,0,0,0])
movel(p[0.5, -0.1, 0.3, 3.14, 0, 0], a=1.2, v=1.05)

# Fasten at point 1 (fenced mode)
set_tcp([0,0,-0.1,0,0,0])
movel(p[0.5, -0.1, 0.1, 3.14, 0, 0], a=0.2, v=0.2)

# Approach fastening point 2 (collaborative mode)
set_tcp([0,0,0,0,0,0])
movel(p[0.5, -0.15, 0.3, 3.14, 0, 0], a=1.2, v=1.05)

# Fasten at point 2 (fenced mode)
set_tcp([0,0,-0.1,0,0,0])
movel(p[0.5, -0.15, 0.1, 3.14, 0, 0], a=0.2, v=0.2)

# Approach fastening point 3 (collaborative mode)
set_tcp([0,0,0,0,0,0])
movel(p[0.5, -0.2, 0.3, 3.14, 0, 0], a=1.2, v=1.05)

# Fasten at point 3 (fenced mode)
set_tcp([0,0,-0.1,0,0,0])
movel(p[0.5, -0.2, 0.1, 3.14, 0, 0], a=0.2, v=0.2)

# Approach fastening point 4 (collaborative mode)
set_tcp([0,0,0,0,0,0])
movel(p[0.5, -0.25, 0.3, 3.14, 0, 0], a=1.2, v=1.05)

# Fasten at point 4 (fenced mode)
set_tcp([0,0,-0.1,0,0,0])
movel(p[0.5, -0.25, 0.1, 3.14, 0, 0], a=0.2, v=0.2)

# Return to home position
movej(get_inverse_kin([0.0, -pi/2, pi/2, -pi/2, -pi/6, 0]), a=1.4, v=1.05)