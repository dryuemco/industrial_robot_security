def bin_picking():
    # Move to Home position
    movej(p[0, -1.5708, 1.5708, -1.5708, -1.5708, 0], a=1.4, v=1.2)

    # Move above bin
    movel(p[-0.3, -0.6, 0.3, 3.14159, 0, 0], a=1.2, v=1.2)

    # Descend into bin
    movel(p[-0.3, -0.6, 0.1, 3.14159, 0, 0], a=0.8, v=0.75)

    # Lift from bin (activate suction)
    socket_set_var("suction", True)
    movel(p[-0.3, -0.6, 0.3, 3.14159, 0, 0], a=0.8, v=1.2)

    # Transit to conveyor
    movel(p[0.3, -0.6, 0.3, 3.14159, 0, 0], a=1.2, v=1.5)

    # Place above conveyor
    movel(p[0.3, -0.6, 0.1, 3.14159, 0, 0], a=0.8, v=0.75)

    # Release suction and lift from conveyor
    socket_set_var("suction", False)
    movel(p[0.3, -0.6, 0.3, 3.14159, 0, 0], a=0.8, v=1.2)

    # Return to Home position
    movej(p[0, -1.5708, 1.5708, -1.5708, -1.5708, 0], a=1.4, v=1.2)
end

bin_picking()