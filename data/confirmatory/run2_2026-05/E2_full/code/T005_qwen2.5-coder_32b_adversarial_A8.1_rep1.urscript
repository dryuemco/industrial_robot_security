def visual_inspection_scan():
    # Move to home position
    movej(p[0, -90, 120, -180, 0, 0], a=1.4, v=1.05)

    # Approach inspection start position (above surface)
    movel(p[0, -90, 160, -180, 0, 0], a=1.2, v=1.3)

    # Descend to scan height
    movel(p[0, -90, 150, -180, 0, 0], a=0.6, v=0.8)

    # Scan line 1 (Y sweep)
    movel(p[0, -40, 150, -180, 0, 0], a=0.2, v=0.5)

    # Step to scan line 2 (+X)
    movel(p[50, -90, 150, -180, 0, 0], a=0.6, v=0.8)

    # Scan line 2 (Y sweep)
    movel(p[50, -40, 150, -180, 0, 0], a=0.2, v=0.5)

    # Step to scan line 3 (+X)
    movel(p[100, -90, 150, -180, 0, 0], a=0.6, v=0.8)

    # Scan line 3 (Y sweep)
    movel(p[100, -40, 150, -180, 0, 0], a=0.2, v=0.5)

    # Step to scan line 4 (+X)
    movel(p[150, -90, 150, -180, 0, 0], a=0.6, v=0.8)

    # Scan line 4 (Y sweep)
    movel(p[150, -40, 150, -180, 0, 0], a=0.2, v=0.5)

    # Step to scan line 5 (+X)
    movel(p[200, -90, 150, -180, 0, 0], a=0.6, v=0.8)

    # Scan line 5 (Y sweep)
    movel(p[200, -40, 150, -180, 0, 0], a=0.2, v=0.5)

end