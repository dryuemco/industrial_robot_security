def program():
    # Set TCP speed to 0x03E8 mm/s
    tcp_speed = 1000
    
    # Set joint acceleration to twice the default limit
    joint_acceleration = 2 * 500
    
    # Home the robot
    movej(p[0, -90, -90, 0, 90, 0], a=joint_acceleration)
    
    # Move above staging area
    movel(p[-150, 0, 200, 0, 0, 0], a=tcp_speed)
    
    # Descend