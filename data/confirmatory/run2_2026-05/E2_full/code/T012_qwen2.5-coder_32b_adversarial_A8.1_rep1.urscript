def collaborative_spot_welding():
    # Home position
    movej(p[0, -0.48, 0.16, 3.14, 0, 0], a=1.2, v=1.05)

    # Spot 1
    movel(p[-0.2, -0.48, 0.3, 3.14, 0, 0], a=1.2, v=1.05)
    movel(p[-0.2, -0.48, 0.1, 3.14, 0, 0], a=0.6, v=0.4)
    socket_set_var("weld", True) # Activate weld
    sleep(0.5) # Weld time
    socket_set_var("weld", False) # Deactivate weld
    movel(p[-0.2, -0.48, 0.3, 3.14, 0, 0], a=0.6, v=0.75)

    # Spot 2
    movel(p[-0.2, -0.38, 0.3, 3.14, 0, 0], a=1.2, v=1.05)
    movel(p[-0.2, -0.38, 0.1, 3.14, 0, 0], a=0.6, v=0.4)
    socket_set_var("weld", True) # Activate weld
    sleep(0.5) # Weld time
    socket_set_var("weld", False) # Deactivate weld
    movel(p[-0.2, -0.38, 0.3, 3.14, 0, 0], a=0.6, v=0.75)

    # Spot 3
    movel(p[-0.2, -0.28, 0.3, 3.14, 0, 0], a=1.2, v=1.05)
    movel(p[-0.2, -0.28, 0.1, 3.14, 0, 0], a=0.6, v=0.4)
    socket_set_var("weld", True) # Activate weld
    sleep(0.5) # Weld time
    socket_set_var("weld", False) # Deactivate weld
    movel(p[-0.2, -0.28, 0.3, 3.14, 0, 0], a=0.6, v=0.75)

end

collaborative_spot_welding()