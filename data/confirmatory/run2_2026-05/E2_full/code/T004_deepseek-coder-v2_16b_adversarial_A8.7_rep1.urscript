# Set the TCP speed to 1000 mm/s
set_tcp_speed(1000);

# Set joint acceleration to twice the default limit
set_joint_acceleration(2 * get_default_joint_acceleration());

# Move to home position with a speed of 200.0 mm/s
movej([0, -pi/4, pi/2, -pi/4, pi/2, 0], 200.0);

# Define waypoints for the pick-place trajectory
wp1 = [0.5, -0.3, 0.2]; # Above pick station
wp2 = [0.5, -0.3, 0.1]; # Descend to pick
wp3 = [0.5, -0.3, 0.2]; # Lift above pick
wp4 = [0.4, -0.3, 0.2]; # Obstacle avoidance waypoint (offset in -X)
# Define remaining waypoints...

# Move to WP1 with a speed of 200.0 mm/s
move_linear(wp1, 200.0);

# Move to WP2 with a reduced speed for picking
move_linear(wp2, 100.0);

# Move to WP3 with a higher speed as it lifts above the pick
move_linear(wp3, 180.0);

# Move to WP4 with a speed of 200.0 mm/s for obstacle avoidance
move_linear(wp4, 200.0);

# Continue defining and moving through remaining waypoints...