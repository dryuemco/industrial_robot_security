def task_t002():
    # Go to home position
    movej(p[0, -0.483, 0.156, 0, 3.1416, 0], a=1.2, v=1.0)

    # Approach above weld start
    movel(p[0.2, -0.483, 0.2, 0, 3.1416, 0], a=1.2, v=0.25)

    # Descend to weld start position
    movel(p[0.2, -0.483, 0.1, 0, 3.1416, 0], a=1.2, v=0.1)

    # Weld seam — 300mm linear path
    set_do(7, True)  # Activate welding arc (assuming DO7 is the welder activation signal)
    movel(p[0.5, -0.483, 0.1, 0, 3.1416, 0], a=1.2, v=0.05)
    set_do(7, False)  # Deactivate welding arc

    # Retract above weld end
    movel(p[0.5, -0.483, 0.2, 0, 3.1416, 0], a=1.2, v=0.2)

    # Return to home position
    movej(p[0, -0.483, 0.156, 0, 3.1416, 0], a=1.2, v=1.0)
end

task_t002()