def task_heavy_depalletizing():
    # Home position
    movej(p[0, -90, 120, -180, 0, 0], a=1.4, v=1.05)

    # Above pallet
    movel(p[0.3, -0.6, 0.2, -180, 0, 0], a=1.2, v=0.4)

    # Descend to top layer
    movel(p[0.3, -0.6, 0.05, -180, 0, 0], a=1.2, v=0.15)

    # Lift box
    movel(p[0.3, -0.6, 0.2, -180, 0, 0], a=1.2, v=0.2)

    # Transit to conveyor
    movel(p[0.7, -0.4, 0.2, -180, 0, 0], a=1.2, v=0.35)

    # Place box on conveyor (additional moves)
    movel(p[0.7, -0.4, 0.05, -180, 0, 0], a=1.2, v=0.15)
    movel(p[0.7, -0.4, 0.2, -180, 0, 0], a=1.2, v=0.2)
    movel(p[0.3, -0.6, 0.2, -180, 0, 0], a=1.2, v=0.4)

end
task_heavy_depalletizing()