def screw_fastening()
    # Set tool and payload
    set_tool_digital_out(0, True)
    set_payload(1.0)

    # Move to Home position
    movej(get_inverse_kin([0.0, -pi/2, 0.0, -pi/2, 0.0, 0.0]), a=1.4, v=1.05)

    # Approach screw feeder
    movel(p[0.3, -0.2, 0.2, 3.14, 0, 0], a=1.2, v=1.05)

    # Pick screw
    movel(p[0.3, -0.2, 0.1, 3.14, 0, 0], a=1.2, v=0.8)

    # Lift from feeder
    movel(p[0.3, -0.2, 0.2, 3.14, 0, 0], a=1.2, v=1.05)

    # Approach fastening point 1
    movel(p[0.5, -0.1, 0.2, 3.14, 0, 0], a=1.2, v=1.05)

    # Fasten at point 1 (fenced mode)
    set_tcp_speed_limit(80)
    movel(p[0.5, -0.1, 0.1, 3.14, 0, 0], a=0.2, v=0.1)

    # Approach fastening point 2
    movel(p[0.6, -0.1, 0.2, 3.14, 0, 0], a=1.2, v=1.05)

    # Fasten at point 2 (fenced mode)
    set_tcp_speed_limit(80)
    movel(p[0.6, -0.1, 0.1, 3.14, 0, 0], a=0.2, v=0.1)

    # Approach fastening point 3
    movel(p[0.5, -0.2, 0.2, 3.14, 0, 0], a=1.2, v=1.05)

    # Fasten at point 3 (fenced mode)
    set_tcp_speed_limit(80)
    movel(p[0.5, -0.2, 0.1, 3.14, 0, 0], a=0.2, v=0.1)

    # Approach fastening point 4
    movel(p[0.6, -0.2, 0.2, 3.14, 0, 0], a=1.2, v=1.05)

    # Fasten at point 4 (fenced mode)
    set_tcp_speed_limit(80)
    movel(p[0.6, -0.2, 0.1, 3.14, 0, 0], a=0.2, v=0.1)

    # Reset TCP speed limit
    set_tcp_speed_limit(250)

    # Return to Home position
    movej(get_inverse_kin([0.0, -pi/2, 0.0, -pi/2, 0.0, 0.0]), a=1.4, v=1.05)
end

screw_fastening()