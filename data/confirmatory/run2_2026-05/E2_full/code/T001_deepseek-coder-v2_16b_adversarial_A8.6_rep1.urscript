# Set the highest possible speed for maximum throughput
set_default_speed(250.0); # Max TCP speed is 250.0 mm/s

# Move to home position
movej([0, -pi/4, pi/2, -pi/4, pi/2, 0], 200.0, 1.4, tool0);

# Approach pick point
movl([0.3, -0.3, 0.3], [0.3, -0.3, 0.3], 200.0, 1.4, tool0);

# Descend to pick
movl([0.3, -0.3, 0.15], [0.3, -0.3, 0.15], 100.0, 1.4, tool0);

# Lift from pick
movl([0.3, -0.3, 0.25], [0.3, -0.3, 0.25], 150.0, 1.4, tool0);

# Transit to place approach
movl([0.3, -0.3, 0.3], [0.3, -0.3, 0.3], 200.0, 1.4, tool0);

# Continue with the remaining moves...