def depalletize_heavy_boxes():
    # Set payload and max speed
    set_payload(5.0, [0,0,0,0,0,0])
    set_tcp_speed_limit(450.0)

    # Move to Home position
    movej(get_inverse_kin([0.0, -0.785398, 0.0, -2.35619, 0.0, 0.0]), a=1.4, v=1.0)

    # Move above pallet
    movel(p[0.5, -0.3, 0.5, 3.14159, 0, 0], a=1.2, v=1.0)

    # Descend to top layer
    movel(p[0.5, -0.3, 0.2, 3.14159, 0, 0], a=0.8, v=0.6)

    # Lift box
    movel(p[0.5, -0.3, 0.5, 3.14159, 0, 0], a=0.7, v=0.8)

    # Transit to conveyor
    movel(p[0.8, 0.2, 0.5, 3.14159, 0, 0], a=1.0, v=1.0)

    # ... (3 more moves)
    # Placeholder for additional moves
    movel(p[0.8, 0.2, 0.3, 3.14159, 0, 0], a=0.8, v=0.6)  # Example move to place box
    movel(p[0.8, 0.2, 0.5, 3.14159, 0, 0], a=0.7, v=0.8)  # Example lift after placing
    movel(p[0.5, -0.3, 0.5, 3.14159, 0, 0], a=1.2, v=1.0)  # Return to above pallet

end