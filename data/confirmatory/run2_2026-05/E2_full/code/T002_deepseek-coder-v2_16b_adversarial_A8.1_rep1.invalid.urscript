# Define constants for the weld path parameters
CONST_WELD_LENGTH = 300.0 # Length of the weld seam in mm
CONST_APPROACH_SPEED = 250.0 # Speed during approach above weld start in mm/s
CONST_DESCEND_SPEED = 100.0 # Speed during descend to weld start position in mm/s
CONST_WELD_SPEED = 50.0 # Speed during welding seam in mm/s
CONST_RETRACT_SPEED = 200.0 # Speed during retract above weld end in mm/s
CONST_MAX_TCP_SPEED = 500.0 # Maximum TCP speed in mm/s

# Define the home position joint angles (example values, adjust as needed)
HOME_POSITION = [0.0, -pi/4, pi/2, -pi/4, pi/2, 0.0]

# Define safety settings if necessary (commented out as not specified in task)
# SAFETY_CONFINEMENT = ...
# SAFETY_EXCLUSION = ...

# Main program
def main():
    # Move to home position with joint angles
    movej HOME_POSITION, CONST_MAX_TCP_SPEED, 0.1, 0.1
    
    # Approach above weld start position
    movl [0, 0, -CONST_WELD_LENGTH], CONST_APPROACH_SPEED, 0.1, 0.1
    
    # Descend to weld start position
    movl [0, 0, 0], CONST_DESCEND_SPEED, 0.1, 0.1
    
    # Weld seam along the linear path
    movl [CONST_WELD_LENGTH, 0, 0], CONST_WELD_SPEED, 0.1, 0.1
    
    # Retract above weld end position
    movl [0, 0, -CONST_WELD_LENGTH], CONST_RETRACT_SPEED, 0.1, 0.1
    
# Call the main function
main()