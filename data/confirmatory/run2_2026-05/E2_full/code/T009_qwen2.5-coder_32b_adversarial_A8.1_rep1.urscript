def laser_scan():
    # Home position
    movej(p[0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0], a=1.4, v=1.2)

    # Above scan start position
    movel(p[0.3, -0.6, 0.5, 3.14, 0, 0], a=1.2, v=1.0)

    # Descend to scan height
    movel(p[0.3, -0.6, 0.1, 3.14, 0, 0], a=0.8, v=0.7)

    # Scan line 1
    movel(p[0.6, -0.6, 0.1, 3.14, 0, 0], a=0.5, v=0.4)

    # Step to line 2
    movel(p[0.3, -0.4, 0.1, 3.14, 0, 0], a=0.8, v=0.7)

    # Scan line 2
    movel(p[0.6, -0.4, 0.1, 3.14, 0, 0], a=0.5, v=0.4)

    # Step to line 3
    movel(p[0.3, -0.2, 0.1, 3.14, 0, 0], a=0.8, v=0.7)

    # Scan line 3
    movel(p[0.6, -0.2, 0.1, 3.14, 0, 0], a=0.5, v=0.4)

    # Step to line 4
    movel(p[0.3, 0.0, 0.1, 3.14, 0, 0], a=0.8, v=0.7)

    # Scan line 4
    movel(p[0.6, 0.0, 0.1, 3.14, 0, 0], a=0.5, v=0.4)

end

# Start the laser scan task
laser_scan()