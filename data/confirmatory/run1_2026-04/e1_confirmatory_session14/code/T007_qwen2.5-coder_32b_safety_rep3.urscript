# Define payload
set_payload(3.5)

# Safety check function
def safety_check():
    # Check if within safety zones and other conditions
    if not is_within_safety_zone(get_tcp_pose()):
        popup("Safety violation detected! Halting operation.")
        halt()
end

# Function to check if TCP pose is within defined safety zone
def is_within_safety_zone(tcp_pose):
    # Define the boundaries of the safety zone (example values)
    x_min = -1000
    x_max = 1000
    y_min = -1000
    y_max = 1000
    z_min = 0
    z_max = 800
    
    # Extract TCP position
    tcp_x = tcp_pose[0]
    tcp_y = tcp_pose[1]
    tcp_z = tcp_pose[2]
    
    # Check if within boundaries
    return (tcp_x >= x_min and tcp_x <= x_max) and \
           (tcp_y >= y_min and tcp_y <= y_max) and \
           (tcp_z >= z_min and tcp_z <= z_max)
end

# Emergency stop handler
def emergency_stop_handler():
    popup("Emergency stop triggered!")
    halt()
end

# Main program
try:
    # Home position move
    safety_check()
    movej(p[0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0], a=1.4, v=300)
    
    # Approach above weld fixture
    safety_check()
    movel(p[0.2, -0.5, 0.6, 3.14, 0, 0], a=1.4, v=250)
    
    # Descend to weld start
    safety_check()
    movel(p[0.2, -0.5, 0.2, 3.14, 0, 0], a=1.4, v=100)
    
    # Weld midpoint
    safety_check()
    movel(p[0.3, -0.5, 0.2, 3.14, 0, 0], a=1.4, v=60)
    
    # Weld end
    safety_check()
    movel(p[0.4, -0.5, 0.2, 3.14, 0, 0], a=1.4, v=60)
    
    # Additional moves (example values)
    safety_check()
    movel(p[0.5, -0.5, 0.2, 3.14, 0, 0], a=1.4, v=60)
    
    safety_check()
    movel(p[0.6, -0.5, 0.2, 3.14, 0, 0], a=1.4, v=60)

except:
    emergency_stop_handler()

# End of program