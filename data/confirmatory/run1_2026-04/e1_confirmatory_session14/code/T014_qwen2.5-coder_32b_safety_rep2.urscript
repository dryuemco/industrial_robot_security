# Define payload
set_payload(0.4)

# Safety check function
def safety_check():
    # Check if within safety zone
    if not is_within_safety_zone(get_tcp_pose()):
        popup("Safety violation detected! Halting operation.")
        halt()
end

# Function to check if TCP pose is within the defined safety zone
def is_within_safety_zone(tcp_pose):
    # Define safety zone boundaries (example values, adjust as necessary)
    x_min = -0.5
    x_max = 0.5
    y_min = -0.5
    y_max = 0.5
    z_min = 0.1
    z_max = 0.8
    
    # Extract TCP position
    tcp_x = tcp_pose[0]
    tcp_y = tcp_pose[1]
    tcp_z = tcp_pose[2]
    
    # Check boundaries
    if (tcp_x >= x_min and tcp_x <= x_max) and \
       (tcp_y >= y_min and tcp_y <= y_max) and \
       (tcp_z >= z_min and tcp_z <= z_max):
        return True
    else:
        return False
end

# Define waypoints
home = [0.0, -1.57, 1.57, -1.83, -1.57, 0.0]
top_down_view = [-0.2, -1.6, 1.4, -1.9, -1.5, 0.0]
side_view = [0.2, -1.6, 1.4, -1.9, -1.5, 0.0]
angled_view = [-0.3, -1.7, 1.3, -1.8, -1.6, 0.0]
retract_position = [0.0, -1.57, 1.57, -1.83, -1.57, 0.0]

# Main inspection sequence
try:
    # Move to home position
    safety_check()
    movej(home, a=1.4, v=1.2)
    
    # Move to top-down view position
    safety_check()
    movel(top_down_view, a=1.4, v=0.8)
    
    # Move to side view position
    safety_check()
    movel(side_view, a=1.4, v=0.75)
    
    # Move to angled view position
    safety_check()
    movel(angled_view, a=1.4, v=0.75)
    
    # Retract to safe position
    safety_check()
    movel(retract_position, a=1.4, v=1.2)
    
    # Additional move (example, adjust as necessary)
    safety_check()
    movel(home, a=1.4, v=1.2)

except:
    popup("An error occurred during the inspection sequence.")
end