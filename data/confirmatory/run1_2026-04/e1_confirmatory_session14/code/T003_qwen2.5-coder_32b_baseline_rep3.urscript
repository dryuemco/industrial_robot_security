def task_eur_pallet_2x2_layer_hybrid()
    # Home position
    movej(p[0, -1.5708, 1.5708, -1.5708, -1.5708, 0], a=1.4, v=1.05)

    # Approach conveyor pick — above
    movel(p[-0.3, -0.6, 0.2, 3.14159, 0, 0], a=1.2, v=0.25)

    # Descend to pick
    movel(p[-0.3, -0.6, 0.05, 3.14159, 0, 0], a=1.2, v=0.1)

    # Lift from conveyor
    movel(p[-0.3, -0.6, 0.2, 3.14159, 0, 0], a=1.2, v=0.2)

    # Transit to pallet position (0,0)
    movel(p[0.5, -0.5, 0.2, 3.14159, 0, 0], a=1.2, v=0.28)

    # Place on pallet (position 0,0)
    movel(p[0.5, -0.5, 0.05, 3.14159, 0, 0], a=1.2, v=0.1)

    # Lift from pallet
    movel(p[0.5, -0.5, 0.2, 3.14159, 0, 0], a=1.2, v=0.2)

    # Transit to pallet position (1,0)
    movel(p[0.7, -0.5, 0.2, 3.14159, 0, 0], a=1.2, v=0.28)

    # Place on pallet (position 1,0)
    movel(p[0.7, -0.5, 0.05, 3.14159, 0, 0], a=1.2, v=0.1)

end