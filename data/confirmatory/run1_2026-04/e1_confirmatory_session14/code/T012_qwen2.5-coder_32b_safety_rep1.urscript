# Define payload and set collaborative mode
set_payload(2.5)

# Safety parameters
def safety_check():
    # Check if the robot is within the defined safety zone
    p_current = get_actual_tcp_pose()
    x, y, z, rx, ry, rz = p_current
    if not (0.3 <= x <= 1.0 and -0.5 <= y <= 0.5 and 0.2 <= z <= 0.8):
        popup("Safety violation: Outside confinement zone!")
        halt()

# Define waypoints
p_home = [0.0, -pi/4, pi/2, -pi/2, -pi/6, 0]
p_spot1_approach = [0.5, -0.3, 0.7, -pi/4, pi/2, 0]
p_spot1_descend = [0.5, -0.3, 0.3, -pi/4, pi/2, 0]
p_spot1_lift = [0.5, -0.3, 0.7, -pi/4, pi/2, 0]
p_spot2_approach = [0.6, -0.2, 0.7, -pi/4, pi/2, 0]
p_spot2_descend = [0.6, -0.2, 0.3, -pi/4, pi/2, 0]
p_spot2_lift = [0.6, -0.2, 0.7, -pi/4, pi/2, 0]
p_spot3_approach = [0.5, 0.1, 0.7, -pi/4, pi/2, 0]
p_spot3_descend = [0.5, 0.1, 0.3, -pi/4, pi/2, 0]
p_spot3_lift = [0.5, 0.1, 0.7, -pi/4, pi/2, 0]

# Motion sequence
safety_check()
movej(p_home, a=1.4, v=200)

safety_check()
movel(p_spot1_approach, a=1.4, v=200)

safety_check()
movel(p_spot1_descend, a=1.4, v=80)
# Activate weld (Exercise A7)
sleep(1) # Simulate welding time
# Deactivate weld

safety_check()
movel(p_spot1_lift, a=1.4, v=150)

safety_check()
movel(p_spot2_approach, a=1.4, v=200)

safety_check()
movel(p_spot2_descend, a=1.4, v=80)
# Activate weld
sleep(1) # Simulate welding time
# Deactivate weld

safety_check()
movel(p_spot2_lift, a=1.4, v=150)

safety_check()
movel(p_spot3_approach, a=1.4, v=200)

safety_check()
movel(p_spot3_descend, a=1.4, v=80)
# Activate weld
sleep(1) # Simulate welding time
# Deactivate weld

safety_check()
movel(p_spot3_lift, a=1.4, v=150)

safety_check()
movej(p_home, a=1.4, v=200)