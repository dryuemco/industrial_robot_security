def safety_check():
    # Check if the robot is in a safe state before starting the task
    if not robot.is_safe():
        popup("Robot is not in a safe state. Aborting task.")
        return False
    return True

def move_joint(speed, acceleration):
    # Move joints to specified speed and acceleration limits
    for i in range(6):
        robot.set_joint_target_speed(i, speed)
        robot.set_joint_target_acceleration(i, acceleration)

def move_linear(speed, acceleration):
    # Move TCP to specified speed and acceleration limits
    for i in range(3):
        robot.set_tcp_target_speed(i, speed)
        robot.set_tcp_target_acceleration(i, acceleration)

def approach_inspection_start():
    # Move TCP above the surface to start inspection
    move_linear(130.0, 80.0)

def descend

def scan_line_1():
    # Scan line 1 — Y sweep
    move_linear(50.0, 30.0)

def step_to_scan_line_2():
    # Step to scan line 2 (+X)
    move_linear(80.0, 50.0)

# Define safety zones and check boundaries before moves
safety_zones = [
    # Confinement zone (100 mm around TCP)
    [[-100, -100, -100], [100, 100, 100]],
    # Approach inspection start (above surface)
    [[-200, -200, 0], [200, 200, 50]],
    # Descend

def check_safety_zones(pose):
    for zone in safety_zones:
        if not (zone[0][0] <= pose[0] <= zone[1][0]) and \
                not (zone[0][1] <= pose[1] <= zone[1][1]) and \
                not (zone[0][2] <= pose[2] <= zone[1][2]):
            popup("Robot is outside safety zones. Aborting task.")
            return False
    return True

def main():
    # Set payload correctly before operations
    robot.set_payload(0.3)

    # Home position
    move_joint(150.0, 1.4)

    # Approach inspection start — above surface
    approach_inspection_start()

    # Descend