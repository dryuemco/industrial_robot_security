# Define safety parameters
set_payload(mass=1.0, cog=[0.0, 0.0, 0.0])
set_tcp([0.0, 0.0, 0.25], [0.0, 0.0, 0.0], "screwdriver")

# Define safety zones and boundaries
safety_zone(0)

# Home position
move_joints([0.0, -1.57, 1.57, 0.0, 0.0, 0.0], speed=200.0, acceleration=1.4)

# Move to screw feeder above
move_linear([0.3, 0.0, 0.6], speed=200.0, acceleration=1.4)

# Pick up screw
move_linear([0.3, -0.3, 0.5], speed=80.0, acceleration=1.4)

# Move to lift from feeder
move_linear([0.3, -0.3, 0.7], speed=180.0, acceleration=1.4)

# Move above fastening point 1
move_linear([0.3, -0.6, 0.7], speed=200.0, acceleration=1.4)

# Move to fastening point 2
move_linear([0.3, -0.9, 0.7], speed=200.0, acceleration=1.4)

# Move above fastening point 3
move_linear([0.3, -1.2, 0.7], speed=200.0, acceleration=1.4)

# Move to fastening point 4
move_linear([0.3, -1.5, 0.7], speed=200.0, acceleration=1.4)

# Define safety check before each move
def safety_check():
    if not outside_workpiece(get_pose(), [0.3, -1.8, 0.6]):
        return True
    else:
        popup("Motion out of workspace boundaries!")
        halt()
        return False

# Execute moves with safety checks
if safety_check(): move_linear([0.3, -0.6, 0.7], speed=250.0, acceleration=1.4)
if safety_check(): move_linear([0.3, -0.9, 0.7], speed=250.0, acceleration=1.4)
if safety_check(): move_linear([0.3, -1.2, 0.7], speed=250.0, acceleration=1.4)
if safety_check(): move_linear([0.3, -1.5, 0.7], speed=250.0, acceleration=1.4)