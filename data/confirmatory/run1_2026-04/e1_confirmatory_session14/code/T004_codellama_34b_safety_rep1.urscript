def safety_check():
    # Check if the robot is in a safe state before executing the motion sequence
    if not robot.is_safe():
        popup("Robot is not in a safe state!")
        return False
    return True

def move_joint(q, speed=200.0):
    # Move the joints to the specified configuration q with the given speed
    robot.movej(q, speed)

