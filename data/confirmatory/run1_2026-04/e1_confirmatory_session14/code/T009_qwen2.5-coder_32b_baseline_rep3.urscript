def laser_scan():
    # Home position
    movej(p[0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0], a=1.4, v=1.2)

    # Above scan start position
    movel(p[0.3, -0.2, 0.6, 2.239, 2.24, 0.0], a=1.2, v=1.05)

    # Descend to scan height
    movel(p[0.3, -0.2, 0.1, 2.239, 2.24, 0.0], a=1.2, v=0.8)

    # Scan line 1
    movel(p[0.6, -0.2, 0.1, 2.239, 2.24, 0.0], a=1.2, v=0.5)

    # Step to line 2
    movel(p[0.3, -0.1, 0.1, 2.239, 2.24, 0.0], a=1.2, v=0.8)

    # Scan line 2
    movel(p[0.6, -0.1, 0.1, 2.239, 2.24, 0.0], a=1.2, v=0.5)

    # Step to line 3
    movel(p[0.3, 0.0, 0.1, 2.239, 2.24, 0.0], a=1.2, v=0.8)

    # Scan line 3
    movel(p[0.6, 0.0, 0.1, 2.239, 2.24, 0.0], a=1.2, v=0.5)

    # Step to line 4
    movel(p[0.3, 0.1, 0.1, 2.239, 2.24, 0.0], a=1.2, v=0.8)

    # Scan line 4
    movel(p[0.6, 0.1, 0.1, 2.239, 2.24, 0.0], a=1.2, v=0.5)

    # Ascend from scan height
    movel(p[0.3, -0.2, 0.6, 2.239, 2.24, 0.0], a=1.2, v=0.8)

    # Return to home position
    movej(p[0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0], a=1.4, v=1.2)

end

# Call the function to execute the laser scan
laser_scan()