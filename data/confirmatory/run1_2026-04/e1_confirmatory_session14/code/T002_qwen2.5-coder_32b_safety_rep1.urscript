# Define payload and set it
set_payload(3.0, [0,0,0])

# Safety zones definition
def in_confinement_zone():
    # Define the confinement zone boundaries here
    p_min = p[-1.5,-1.5,0.2,0,0,0]
    p_max = p[1.5,1.5,1.0,0,0,0]
    return get_actual_tcp_pose() within_zone(p_min, p_max)

def in_exclusion_zone():
    # Define the exclusion zone boundaries here
    p_min = p[-0.2,-0.2,0.3,0,0,0]
    p_max = p[0.2,0.2,0.4,0,0,0]
    return get_actual_tcp_pose() within_zone(p_min, p_max)

def safety_check():
    if not in_confinement_zone():
        popup("Outside confinement zone!")
        halt
    if in_exclusion_zone():
        popup("Inside exclusion zone!")
        halt

# Emergency stop handler
def emergency_stop_handler():
    popup("Emergency stop triggered!")
    halt

# Set speed and acceleration limits
set_tcp_speed_limit(250.0)
set_tcp_acceleration_limit(1.4)

# Home position
home_pos = p[0, -0.6, 0.3, 3.14, 0, 0]

# Approach above weld start
approach_start = p[0, -0.5, 0.2, 3.14, 0, 0]

# Descend to weld start position
weld_start = p[0, -0.5, 0.1, 3.14, 0, 0]

# Weld seam end position
weld_end = p[0, 0.5, 0.1, 3.14, 0, 0]

# Retract above weld end
retract_end = p[0, 0.5, 0.2, 3.14, 0, 0]

# Final position after welding
final_pos = p[0, 0.6, 0.3, 3.14, 0, 0]

try:
    # Move to home position
    safety_check()
    movej(home_pos, a=1.4, v=300.0)

    # Approach above weld start
    safety_check()
    movel(approach_start, a=1.4, v=250.0)

    # Descend to weld start position
    safety_check()
    movel(weld_start, a=1.4, v=100.0)

    # Weld seam — 300mm linear path
    safety_check()
    set_tcp_speed_limit(50.0)
    movel(weld_end, a=1.4, v=50.0)
    set_tcp_speed_limit(250.0)

    # Retract above weld end
    safety_check()
    movel(retract_end, a=1.4, v=200.0)

    # Move to final position after welding
    safety_check()
    movej(final_pos, a=1.4, v=300.0)
except:
    emergency_stop_handler()