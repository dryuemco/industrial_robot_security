# Define payload
set_payload(1.2, [0,0,0])

# Safety zones
def in_confinement_zone(p):
    # Define the confinement zone boundaries
    return p[0] >= -500 and p[0] <= 500 and p[1] >= -500 and p[1] <= 500 and p[2] >= 0 and p[2] <= 800

def in_exclusion_zone(p):
    # Define the exclusion zone boundaries
    return not (p[0] >= -300 and p[0] <= 300 and p[1] >= -300 and p[1] <= 300 and p[2] >= 100 and p[2] <= 700)

def safety_check(p):
    if not in_confinement_zone(p) or in_exclusion_zone(p):
        popup("Safety violation: Point out of confinement zone or in exclusion zone!")
        halt()

# Define waypoints
pHome = [0, -1.57, 1.57, -1.83, -1.57, 0]
pAboveStorageBin = [-0.2, -1.6, 1.4, -1.9, -1.5, 0]
pDescendToPick = [-0.2, -1.6, 1.1, -1.9, -1.5, 0]
pLiftFromBin = [-0.2, -1.6, 1.4, -1.9, -1.5, 0]
pTransitToHandoffZone = [0.3, -1.7, 1.5, -1.8, -1.5, 0]
# Define additional waypoints for the remaining moves
pApproachHandoffZone = [0.4, -1.6, 1.4, -1.9, -1.5, 0]
pPlaceInHandoffZone = [0.4, -1.6, 1.2, -1.9, -1.5, 0]
pLiftFromHandoffZone = [0.4, -1.6, 1.4, -1.9, -1.5, 0]

# Motion sequence
def motion_sequence():
    # Move to Home position
    safety_check(pHome)
    movej(pHome, a=1.4, v=250)

    # Move above storage bin
    safety_check(pAboveStorageBin)
    movel(pAboveStorageBin, a=1.4, v=280)

    # Descend to pick position
    safety_check(pDescendToPick)
    movel(pDescendToPick, a=1.4, v=120)

    # Lift from bin
    safety_check(pLiftFromBin)
    movel(pLiftFromBin, a=1.4, v=200)

    # Transit to handoff zone
    safety_check(pTransitToHandoffZone)
    movel(pTransitToHandoffZone, a=1.4, v=250)

    # Approach handoff zone
    safety_check(pApproachHandoffZone)
    movel(pApproachHandoffZone, a=1.4, v=250)

    # Place in handoff zone
    safety_check(pPlaceInHandoffZone)
    movel(pPlaceInHandoffZone, a=1.4, v=120)

    # Lift from handoff zone
    safety_check(pLiftFromHandoffZone)
    movel(pLiftFromHandoffZone, a=1.4, v=250)

# Execute motion sequence
motion_sequence()