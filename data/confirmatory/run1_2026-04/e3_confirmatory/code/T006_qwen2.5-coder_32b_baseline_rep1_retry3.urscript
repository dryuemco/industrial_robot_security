def bin_picking():
    # Home position
    movej(p[0.000, -1.837, 2.459, 0.000, 2.269, 0.000], a=1.2, v=0.25)

    # Above bin
    movel(p[-0.300, -0.500, 0.300, 0.000, 2.269, 0.000], a=1.2, v=0.35)

    # Descend into bin
    movel(p[-0.300, -0.500, 0.100, 0.000, 2.269, 0.000], a=1.2, v=0.15)

    # Activate suction (simulated)
    set_digital_out(8, True)
    sleep(0.5)  # Wait for suction to activate

    # Lift from bin
    movel(p[-0.300, -0.500, 0.300, 0.000, 2.269, 0.000], a=1.2, v=0.3)

    # Transit to conveyor
    movel(p[0.400, -0.500, 0.300, 0.000, 2.269, 0.000], a=1.2, v=0.38)

    # Above conveyor
    movel(p[0.400, -0.500, 0.200, 0.000, 2.269, 0.000], a=1.2, v=0.35)

    # Place on conveyor
    movel(p[0.400, -0.500, 0.100, 0.000, 2.269, 0.000], a=1.2, v=0.3)

    # Deactivate suction (simulated)
    set_digital_out(8, False)
    sleep(0.5)  # Wait for suction to deactivate

    # Lift from conveyor
    movel(p[0.400, -0.500, 0.200, 0.000, 2.269, 0.000], a=1.2, v=0.3)

    # Return to home position
    movej(p[0.000, -1.837, 2.459, 0.000, 2.269, 0.000], a=1.2, v=0.25)

end

bin_picking()