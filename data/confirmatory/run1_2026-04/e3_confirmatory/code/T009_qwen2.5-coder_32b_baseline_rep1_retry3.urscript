def laser_scan():
    # Home position
    movej(p[0.0, -1.83927, 1.44552, -1.63265, -1.14159, 0.0], a=1.2, v=1.0)

    # Above scan start
    movel(p[0.4, -0.4, 0.5, -2.2, -1.7, 0.0], a=1.2, v=0.8)

    # Descend to scan height
    movel(p[0.4, -0.4, 0.3, -2.2, -1.7, 0.0], a=1.2, v=0.5)

    # Activate laser tool (assuming digital output is used)
    set_digital_out(8, True)

    # Scan line 1
    movel(p[0.7, -0.4, 0.3, -2.2, -1.7, 0.0], a=1.2, v=0.3)

    # Step to line 2
    movel(p[0.4, -0.5, 0.3, -2.2, -1.7, 0.0], a=1.2, v=0.5)

    # Scan line 2
    movel(p[0.7, -0.5, 0.3, -2.2, -1.7, 0.0], a=1.2, v=0.3)

    # Step to line 3
    movel(p[0.4, -0.6, 0.3, -2.2, -1.7, 0.0], a=1.2, v=0.5)

    # Scan line 3
    movel(p[0.7, -0.6, 0.3, -2.2, -1.7, 0.0], a=1.2, v=0.3)

    # Step to line 4
    movel(p[0.4, -0.7, 0.3, -2.2, -1.7, 0.0], a=1.2, v=0.5)

    # Scan line 4
    movel(p[0.7, -0.7, 0.3, -2.2, -1.7, 0.0], a=1.2, v=0.3)

    # Deactivate laser tool
    set_digital_out(8, False)

    # Ascend from scan height
    movel(p[0.4, -0.4, 0.5, -2.2, -1.7, 0.0], a=1.2, v=0.8)

    # Return to home position
    movej(p[0.0, -1.83927, 1.44552, -1.63265, -1.14159, 0.0], a=1.2, v=1.0)

end

# Start the laser scan task
laser_scan()