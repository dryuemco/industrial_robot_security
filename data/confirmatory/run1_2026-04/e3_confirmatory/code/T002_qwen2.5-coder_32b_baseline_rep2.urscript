def task_linear_weld_path():
    # Go to home position
    movej(get_inverse_kin([0, -90, 90, -90, 90, 0]), a=1.4, v=1.05)

    # Approach above weld start
    movel(pose_trans(get_actual_tcp_pose(), [0, 0, 20]), a=1.2, v=0.25)

    # Descend to weld start position
    movel(pose_trans(get_actual_tcp_pose(), [0, 0, -20]), a=1.2, v=0.1)

    # Weld seam — 300mm linear path
    movel(pose_trans(get_actual_tcp_pose(), [300, 0, 0]), a=1.2, v=0.05)

    # Retract above weld end
    movel(pose_trans(get_actual_tcp_pose(), [0, 0, 20]), a=1.2, v=0.2)

    # Move to home position after welding
    movej(get_inverse_kin([0, -90, 90, -90, 90, 0]), a=1.4, v=1.05)
end

task_linear_weld_path()