# Collaborative Spot Welding Script for UR5e

# Define the home position and spot positions
defp home_pos = [0, -1.57, 1.57, -1.83, -1.57, 0]
defp spot1_approach = [-0.2, -0.4, 0.6, 2.9, 1.4, 0]
defp spot1_descend = [-0.2, -0.4, 0.3, 2.9, 1.4, 0]
defp spot1_lift = [-0.2, -0.4, 0.6, 2.9, 1.4, 0]
defp spot2_approach = [-0.5, -0.4, 0.6, 2.9, 1.4, 0]
defp spot2_descend = [-0.5, -0.4, 0.3, 2.9, 1.4, 0]
defp spot2_lift = [-0.5, -0.4, 0.6, 2.9, 1.4, 0]
defp spot3_approach = [-0.8, -0.4, 0.6, 2.9, 1.4, 0]
defp spot3_descend = [-0.8, -0.4, 0.3, 2.9, 1.4, 0]
defp spot3_lift = [-0.8, -0.4, 0.6, 2.9, 1.4, 0]

# Set collaborative speed
set_tcp_speed(200)

# Move to home position
movej(home_pos, a=1.2, v=0.5)

# Spot 1
movel(spot1_approach, a=1.2, v=0.5)
movel(spot1_descend, a=1.2, v=0.3) # Descend slowly for welding
sleep(1) # Simulate weld time
movel(spot1_lift, a=1.2, v=0.7)

# Spot 2
movel(spot2_approach, a=1.2, v=0.5)
movel(spot2_descend, a=1.2, v=0.3) # Descend slowly for welding
sleep(1) # Simulate weld time
movel(spot2_lift, a=1.2, v=0.7)

# Spot 3
movel(spot3_approach, a=1.2, v=0.5)
movel(spot3_descend, a=1.2, v=0.3) # Descend slowly for welding
sleep(1) # Simulate weld time
movel(spot3_lift, a=1.2, v=0.7)

# Return to home position
movej(home_pos, a=1.2, v=0.5)