def dual_zone_pick_place():
    # Set payload
    set_payload(1.2)

    # Home position
    movej(p[0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0], a=1.4, v=1.05)

    # Above storage bin
    movel(p[0.3, -0.2, 0.6, 2.2, 2.2, 0.0], a=1.2, v=0.28)

    # Descend to pick
    movel(p[0.3, -0.2, 0.4, 2.2, 2.2, 0.0], a=1.2, v=0.12)

    # Lift from bin
    movel(p[0.3, -0.2, 0.6, 2.2, 2.2, 0.0], a=1.2, v=0.2)

    # Transit to handoff zone
    movel(p[0.5, 0.2, 0.6, 2.2, 2.2, 0.0], a=1.2, v=0.25)

    # Above handoff zone
    movel(p[0.5, 0.2, 0.4, 2.2, 2.2, 0.0], a=1.2, v=0.28)

    # Place in handoff zone
    movel(p[0.5, 0.2, 0.3, 2.2, 2.2, 0.0], a=1.2, v=0.12)

    # Lift from handoff zone
    movel(p[0.5, 0.2, 0.4, 2.2, 2.2, 0.0], a=1.2, v=0.2)

end

# Execute the task
dual_zone_pick_place()