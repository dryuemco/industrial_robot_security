# Define the home position joint angles
home_joints := [0, -pi/4, pi/2, -pi/4, pi/2, 0];

# Move to home position with a speed of 250.0 mm/s
movej home_joints, 250.0;

# Define the approach conveyor pick linear coordinates relative to the TCP in mm
approach_conveyor := [0, -150, 150];

# Move linearly above the conveyor with a speed of 250.0 mm/s
movel home_joints + approach_conveyor, 250.0;

# Define the descend to pick linear coordinates relative to the TCP in mm
descend_to_pick := [0, -150, 50];

# Move linearly down to pick with a speed of 100.0 mm/s
movel home_joints + approach_conveyor + descend_to_pick, 100.0;

# Define the lift from conveyor linear coordinates relative to the TCP in mm
lift_from_conveyor := [0, -150, 200];

# Move linearly up to lift from conveyor with a speed of 200.0 mm/s
movel home_joints + approach_conveyor + descend_to_pick + lift_from_conveyor, 200.0;

# Define the transit to pallet position linear coordinates relative to the TCP in mm
transit_to_pallet := [0, -150, 300];

# Move linearly to the first pallet position with a speed of 280.0 mm/s
movel home_joints + approach_conveyor + descend_to_pick + lift_from_conveyor + transit_to_pallet, 280.0;

