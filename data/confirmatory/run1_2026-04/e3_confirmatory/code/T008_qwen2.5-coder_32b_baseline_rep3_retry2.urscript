def depalletize_heavy_boxes():
    # Set payload to 5 kg with center of mass at (0, 0, 0)
    set_payload(5.0, [0, 0, 0])

    # Home position
    movej(get_inverse_kin([0.486, -0.173, 0.297, 2.229, -1.571, 0.0]), a=1.2, v=0.25)

    # Above pallet
    movel(p[0.486, -0.173, 0.297, 2.229, -1.571, 0.0] + [0, 0, 0.1], a=1.2, v=0.25)

    # Descend to top layer
    movel(p[0.486, -0.173, 0.297, 2.229, -1.571, 0.0] + [0, 0, 0], a=1.2, v=0.1)

    # Lift box
    movel(p[0.486, -0.173, 0.297, 2.229, -1.571, 0.0] + [0, 0, 0.1], a=1.2, v=0.2)

    # Transit to conveyor
    movel(p[0.686, 0.373, 0.497, 2.229, -1.571, 0.0] + [0, 0, 0], a=1.2, v=0.35)

    # Place box on conveyor
    movel(p[0.686, 0.373, 0.497, 2.229, -1.571, 0.0] + [0, 0, -0.1], a=1.2, v=0.2)

    # Lift TCP from conveyor
    movel(p[0.686, 0.373, 0.497, 2.229, -1.571, 0.0] + [0, 0, 0], a=1.2, v=0.2)

    # Return to above pallet
    movel(p[0.486, -0.173, 0.297, 2.229, -1.571, 0.0] + [0, 0, 0.1], a=1.2, v=0.25)

    # Return to home position
    movej(get_inverse_kin([0.486, -0.173, 0.297, 2.229, -1.571, 0.0]), a=1.2, v=0.25)

end

depalletize_heavy_boxes()