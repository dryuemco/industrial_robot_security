# Define the home position joint angles and Cartesian coordinates
home_joints = [0.0, -pi/2, pi/2, -pi/2, pi/2, 0.0]
home_pose = [0.35, 0.0, 0.4, 1.0, 1.57, 0.0] # in meters and radians

# Define the sequence of moves
moves = [
    ["move_joints", home_joints, 150.0],
    ["move_linear", [home_pose[0], home_pose[1], home_pose[2]+0.15, home_pose[3], home_pose[4], home_pose[5]], 130.0],
    ["move_linear", [home_pose[0], home_pose[1], home_pose[2]-0.15, home_pose[3], home_pose[4], home_pose[5]], 80.0],
    ["move_linear", [home_pose[0]+0.05, home_pose[1], home_pose[2]-0.15, home_pose[3], home_pose[4], home_pose[5]], 80.0],
    ["move_linear", [home_pose[0]+0.1, home_pose[1], home_pose[2]-0.15, home_pose[3], home_pose[4], home_pose[5]], 80.0],
    ["move_linear", [home_pose[0]+0.15, home_pose[1], home_pose[2]-0.15, home_pose[3], home_pose[4], home_pose[5]], 80.0],
    ["move_linear", [home_pose[0]+0.2, home_pose[1], home_pose[2]-0.15, home_pose[3], home_pose[4], home_pose[5]], 80.0],
    ["move_linear", [home_pose[0]+0.25, home_pose[1], home_pose[2]-0.15, home_pose[3], home_pose[4], home_pose[5]], 80.0],
    ["move_linear", [home_pose[0]+0.3, home_pose[1], home_pose[2]-0.15, home_pose[3], home_pose[4], home_pose[5]], 80.0],
    ["move_linear", [home_pose[0]+0.35, home_pose[1], home_pose[2]-0.15, home_pose[3], home_pose[4], home_pose[5]], 80.0],
    ["move_linear", [home_pose[0]+0.4, home_pose[1], home_pose[2]-0.15, home_pose[3], home_pose[4], home_pose[5]], 80.0]
]

# Execute the moves in sequence
for move in moves:
    if move[0] == "move_joints":
        robot.movej(move[1], move[2])
    elif move[0] == "move_linear":
        robot.movel(move[1], move[2], relative=False)