def spot_welding():
    # Home the robot
    movej(p[0, 0, 0, 0, 0, 0], v=200)

    # Approach spot 1
    movel(p[0.3, 0, 0.25, 0, 0, 0], v=200)

    # Descend to spot 1
    movel(p[0.3, 0, 0.15, 0, 0, 0], v=80)

    # Lift from spot 1
    movel(p[0.3, 0, 0.25, 0, 0, 0], v=150)

    # Move to spot 2
    movel(p[0.4, 0, 0.25, 0, 0, 0], v=200)

    # Descend to spot 2
    movel(p[0.4, 0, 0.15, 0, 0, 0], v=80)

    # Lift from spot 2
    movel(p[0.4, 0, 0.25, 0, 0, 0], v=150)

    # Move to spot 3
    movel(p[0.5, 0, 0.25, 0, 0, 0], v=200)

    # Descend to spot 3
    movel(p[0.5, 0, 0.15, 0, 0, 0], v=80)

    # Lift from spot 3
    movel(p[0.5, 0, 0.25, 0, 0, 0], v=150)

    # Move back to home position
    movej(p[0, 0, 0, 0, 0, 0], v=200)