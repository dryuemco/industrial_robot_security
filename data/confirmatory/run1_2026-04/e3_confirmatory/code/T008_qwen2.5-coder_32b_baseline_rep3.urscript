def depalletize_heavy_boxes():
    # Home position
    movej(get_inverse_kin([0, -90, 90, -90, 90, 0]), a=1.4, v=1.2)

    # Above pallet
    movel(p[0.5, -0.3, 0.6, 3.14, 0, 0], a=1.2, v=1.05)

    # Descend to top layer
    movel(p[0.5, -0.3, 0.2, 3.14, 0, 0], a=1.2, v=0.6)

    # Lift box
    movel(p[0.5, -0.3, 0.4, 3.14, 0, 0], a=1.2, v=0.8)

    # Transit to conveyor
    movel(p[0.7, 0.2, 0.4, 3.14, 0, 0], a=1.2, v=1.35)

    # Place box on conveyor (additional moves)
    movel(p[0.7, 0.2, 0.2, 3.14, 0, 0], a=1.2, v=0.6)  # Descend to place
    movel(p[0.7, 0.2, 0.4, 3.14, 0, 0], a=1.2, v=0.8)  # Lift from conveyor
    movel(p[0.5, -0.3, 0.6, 3.14, 0, 0], a=1.2, v=1.05)  # Return above pallet

end