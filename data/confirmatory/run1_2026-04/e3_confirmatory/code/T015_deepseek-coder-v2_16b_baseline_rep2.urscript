# Define the robot model and mode
def main():
    # Set the robot to UR5e mode
    set_mode(1)
    
    # Set the payload mass in kg
    payload = 0.6
    
    # Define the home position (joint angles)
    home_position = [0, -pi/2, pi/2, -pi/2, pi/2]
    
    # Move to the home position with a specified speed
    movej(home_position, 350.0, 1.4)
    
    # Define the TCP (Tool Center Point) frame for laser marking
    tcp_frame = [0, 0, 0, 0, 0, 0]
    
    # Move to a position above the marking surface with a specified speed
    movej(tcp_frame, 300.0, 1.4)
    
    # Define the descent height and speed for moving towards the marking surface
    descent_height = -0.05  # Assuming this is in meters relative to the TCP frame
    move_speed = 100.0  # Speed in mm/s
    
    # Move downwards to the marking surface with a specified speed
    movl([0, 0, descent_height], [0, 0, -descent_height], move_speed, 1.4)
    
    # Define the sequence of moves for engraving lines (example for line 1)
    line1 = [-0.02, 0, -0.05]  # X, Y, Z coordinates relative to TCP frame
    move_speed_line1 = 60.0  # Speed in mm/s
    
    # Move linearly to the first marking position with a specified speed
    movl(line1, line1, move_speed_line1, 1.4)
    
    # Repeat for other lines (similar moves but different coordinates and speeds)
    line2 = [-0.01, 0, -0.05]
    move_speed_line2 = 80.0
    movl(line2, line2, move_speed_line2, 1.4)
    
    # Continue for the remaining lines...
    
# End of script