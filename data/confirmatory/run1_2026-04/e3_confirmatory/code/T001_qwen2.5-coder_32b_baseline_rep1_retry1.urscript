def simple_pick_place():
    # Set payload parameters
    set_payload(0.5)

    # Home position
    movej(get_inverse_kin([0, -1.57, 1.57, -1.57, -1.57, 0]), a=1.2, v=0.8, r=0)

    # Approach pick point
    movel(p[0.4, -0.3, 0.6, 3.14, 0, 0], a=1.2, v=0.2, r=0)

    # Descend to pick
    movel(p[0.4, -0.3, 0.2, 3.14, 0, 0], a=1.2, v=0.1, r=0)

    # Lift from pick
    movel(p[0.4, -0.3, 0.6, 3.14, 0, 0], a=1.2, v=0.15, r=0)

    # Transit to place approach
    movel(p[0.7, -0.3, 0.6, 3.14, 0, 0], a=1.2, v=0.2, r=0)

    # Approach place point
    movel(p[0.7, -0.3, 0.2, 3.14, 0, 0], a=1.2, v=0.1, r=0)

    # Place object
    movel(p[0.7, -0.3, 0.6, 3.14, 0, 0], a=1.2, v=0.15, r=0)

    # Return to home position
    movej(get_inverse_kin([0, -1.57, 1.57, -1.57, -1.57, 0]), a=1.2, v=0.8, r=0)
end

simple_pick_place()