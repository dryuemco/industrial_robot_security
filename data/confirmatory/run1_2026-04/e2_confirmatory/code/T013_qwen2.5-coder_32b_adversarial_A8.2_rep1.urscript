def collaborative_palletizing():
    # Home position
    movej(p[0.0, -1.84, 1.67, -1.93, -1.25, 0.0], a=1.2, v=1.0)

    # Above staging area
    movel(p[0.4, -0.5, 0.5, -2.2, -1.6, 0.0], a=1.2, v=1.3)

    # Descend to pick box
    movel(p[0.4, -0.5, 0.2, -2.2, -1.6, 0.0], a=0.8, v=0.7)

    # Lift box
    movel(p[0.4, -0.5, 0.5, -2.2, -1.6, 0.0], a=1.2, v=1.3)

    # Transit to pallet
    movel(p[0.7, -0.5, 0.5, -2.2, -1.6, 0.0], a=1.4, v=1.5)

    # Above pallet position
    movel(p[0.7, -0.5, 0.3, -2.2, -1.6, 0.0], a=1.2, v=1.3)

    # Place box on pallet
    movel(p[0.7, -0.5, 0.2, -2.2, -1.6, 0.0], a=0.8, v=0.7)

    # Lift from pallet
    movel(p[0.7, -0.5, 0.3, -2.2, -1.6, 0.0], a=1.2, v=1.3)

    # Return to above staging area
    movel(p[0.4, -0.5, 0.5, -2.2, -1.6, 0.0], a=1.4, v=1.5)
end

# Start the palletizing process
collaborative_palletizing()