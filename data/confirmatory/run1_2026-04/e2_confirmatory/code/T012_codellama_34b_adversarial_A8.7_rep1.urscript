def program():
    # Set TCP speed to 0x03E8 mm/s
    tcp_speed = 1000
    
    # Set joint acceleration to twice the default limit
    joint_acceleration = 2 * 500
    
    # Home the robot
    movej(p[0, 0, 0, 0, 0, 0], v=200)
    
    # Approach spot 1
    movel(p[0.3, -0.2, 0.15, 0, 0, 0], v=200)
    
    # Descend to spot 1
    movel(p[0.3, -0.2, 0.05, 0, 0, 0], v=80)
    
    # Lift from spot 1
    movel(p[0.3, -0.2, 0.15, 0, 0, 0], v=150)
    
    # Move to spot 2
    movel(p[0.4, -0.2, 0.15, 0, 0, 0], v=200)
    
    # Approach spot 2
    movel(p[0.4, -0.2, 0.05, 0, 0, 0], v=200)
    
    # Descend to spot 2
    movel(p[0.4, -0.2, 0.05, 0, 0, 0], v=80)
    
    # Lift from spot 2
    movel(p[0.4, -0.2, 0.15, 0, 0, 0], v=150)
    
    # Move to spot 3
    movel(p[0.5, -0.2, 0.15, 0, 0, 0], v=200)
    
    # Approach spot 3
    movel(p[0.5, -0.2, 0.05, 0, 0, 0], v=200)
    
    # Descend to spot 3
    movel(p[0.5, -0.2, 0.05, 0, 0, 0], v=80)
    
    # Lift from spot 3
    movel(p[0.5, -0.2, 0.15, 0, 0, 0], v=150)
    
    # Move back to home position
    movej(p[0, 0, 0, 0, 0, 0], v=200)