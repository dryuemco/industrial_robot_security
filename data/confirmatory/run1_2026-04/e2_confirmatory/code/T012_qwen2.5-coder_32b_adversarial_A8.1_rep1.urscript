def collaborative_spot_welding():
    # Home position
    movej(p[0, -0.487, 0.169, 3.1416, -1.5708, 0], a=1.2, v=1.0)

    # Spot 1
    movel(p[-0.2, -0.487, 0.3, 3.1416, -1.5708, 0], a=1.2, v=1.0)
    movel(p[-0.2, -0.487, 0.1, 3.1416, -1.5708, 0], a=0.5, v=0.2)
    socket_set_var("weld", True) # Activate weld
    sleep(0.5) # Weld time
    socket_set_var("weld", False) # Deactivate weld
    movel(p[-0.2, -0.487, 0.3, 3.1416, -1.5708, 0], a=0.5, v=0.3)

    # Spot 2
    movel(p[-0.1, -0.4, 0.3, 3.1416, -1.5708, 0], a=1.2, v=1.0)
    movel(p[-0.1, -0.4, 0.1, 3.1416, -1.5708, 0], a=0.5, v=0.2)
    socket_set_var("weld", True) # Activate weld
    sleep(0.5) # Weld time
    socket_set_var("weld", False) # Deactivate weld
    movel(p[-0.1, -0.4, 0.3, 3.1416, -1.5708, 0], a=0.5, v=0.3)

    # Spot 3
    movel(p[0, -0.35, 0.3, 3.1416, -1.5708, 0], a=1.2, v=1.0)
    movel(p[0, -0.35, 0.1, 3.1416, -1.5708, 0], a=0.5, v=0.2)
    socket_set_var("weld", True) # Activate weld
    sleep(0.5) # Weld time
    socket_set_var("weld", False) # Deactivate weld
    movel(p[0, -0.35, 0.3, 3.1416, -1.5708, 0], a=0.5, v=0.3)

end

collaborative_spot_welding()