# Move to Home position
movej(p[0.0, -0.7854, 0.0, -2.3562, -1.5708, 0.0], a=1.4, v=1.0)

# Move above screw feeder
movel(p[-0.2, -0.5, 0.3, -2.3562, -1.5708, 0.0], a=1.2, v=1.0)

# Pick screw from feeder
movel(p[-0.2, -0.5, 0.1, -2.3562, -1.5708, 0.0], a=0.4, v=0.4)

# Lift from feeder
movel(p[-0.2, -0.5, 0.3, -2.3562, -1.5708, 0.0], a=0.8, v=0.8)

# Move above fastening point 1 (collaborative approach)
movel(p[0.4, -0.3, 0.3, -2.3562, -1.5708, 0.0], a=1.2, v=1.0)

# Fasten at point 1 (fenced operation)
set_tcp(p[0, 0, -0.1, 0, 0, 0]) # Adjust TCP to screwdriver tip
movel(p[0.4, -0.3, 0.15, -2.3562, -1.5708, 0.0], a=0.2, v=0.2)
sleep(1) # Simulate fastening time
movel(p[0.4, -0.3, 0.3, -2.3562, -1.5708, 0.0], a=0.8, v=0.8)

# Move above fastening point 2 (collaborative approach)
movel(p[0.4, -0.1, 0.3, -2.3562, -1.5708, 0.0], a=1.2, v=1.0)

# Fasten at point 2 (fenced operation)
movel(p[0.4, -0.1, 0.15, -2.3562, -1.5708, 0.0], a=0.2, v=0.2)
sleep(1) # Simulate fastening time
movel(p[0.4, -0.1, 0.3, -2.3562, -1.5708, 0.0], a=0.8, v=0.8)

# Move above fastening point 3 (collaborative approach)
movel(p[0.4, 0.1, 0.3, -2.3562, -1.5708, 0.0], a=1.2, v=1.0)

# Fasten at point 3 (fenced operation)
movel(p[0.4, 0.1, 0.15, -2.3562, -1.5708, 0.0], a=0.2, v=0.2)
sleep(1) # Simulate fastening time
movel(p[0.4, 0.1, 0.3, -2.3562, -1.5708, 0.0], a=0.8, v=0.8)

# Move above fastening point 4 (collaborative approach)
movel(p[0.4, 0.3, 0.3, -2.3562, -1.5708, 0.0], a=1.2, v=1.0)

# Fasten at point 4 (fenced operation)
movel(p[0.4, 0.3, 0.15, -2.3562, -1.5708, 0.0], a=0.2, v=0.2)
sleep(1) # Simulate fastening time
movel(p[0.4, 0.3, 0.3, -2.3562, -1.5708, 0.0], a=0.8, v=0.8)

# Return to Home position
movej(p[0.0, -0.7854, 0.0, -2.3562, -1.5708, 0.0], a=1.4, v=1.0)