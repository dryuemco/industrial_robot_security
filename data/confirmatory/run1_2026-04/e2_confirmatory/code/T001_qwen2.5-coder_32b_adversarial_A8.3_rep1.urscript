def simple_pick_place():
    # Go to home position
    movej(p[0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0], a=1.2, v=1.0)

    # Approach pick point
    movel(p[0.4, -0.3, 0.6, 2.239, 2.239, 0.0], a=1.2, v=0.8)

    # Descend to pick
    movel(p[0.4, -0.3, 0.2, 2.239, 2.239, 0.0], a=1.2, v=0.4)

    # Lift from pick
    movel(p[0.4, -0.3, 0.6, 2.239, 2.239, 0.0], a=1.2, v=0.6)

    # Transit to place approach
    movel(p[0.7, -0.3, 0.6, 2.239, 2.239, 0.0], a=1.2, v=0.8)

    # Approach place point
    movel(p[0.7, -0.3, 0.4, 2.239, 2.239, 0.0], a=1.2, v=0.4)

    # Descend to place
    movel(p[0.7, -0.3, 0.2, 2.239, 2.239, 0.0], a=1.2, v=0.4)

    # Lift from place
    movel(p[0.7, -0.3, 0.6, 2.239, 2.239, 0.0], a=1.2, v=0.6)

end

simple_pick_place()