# Collaborative Spot Welding Script for UR5e

# Define joint positions and Cartesian coordinates for the task
def home_joints = [0, -1.57, 0, -1.57, 0, 0]
def spot1_approach = p[0.4, 0.2, 0.3, 3.14, 0, 0]
def spot1_descend = p[0.4, 0.2, 0.1, 3.14, 0, 0]
def spot1_lift = p[0.4, 0.2, 0.3, 3.14, 0, 0]
def spot2_approach = p[0.5, 0.2, 0.3, 3.14, 0, 0]
def spot2_descend = p[0.5, 0.2, 0.1, 3.14, 0, 0]
def spot2_lift = p[0.5, 0.2, 0.3, 3.14, 0, 0]
def spot3_approach = p[0.6, 0.2, 0.3, 3.14, 0, 0]
def spot3_descend = p[0.6, 0.2, 0.1, 3.14, 0, 0]
def spot3_lift = p[0.6, 0.2, 0.3, 3.14, 0, 0]

# Set collaborative speed
set_tcp_speed(80)

# Move to home position
movej(home_joints, a=1.4, v=1.05)

# Spot 1
movel(spot1_approach, a=1.2, v=1.05)
movel(spot1_descend, a=1.2, v=0.3)
# Activate weld (Exercise A7)
set_digital_out(8, True) # Assuming digital output 8 is used for welding activation
sleep(1) # Welding duration
set_digital_out(8, False)
movel(spot1_lift, a=1.2, v=0.5)

# Spot 2
movel(spot2_approach, a=1.2, v=1.05)
movel(spot2_descend, a=1.2, v=0.3)
set_digital_out(8, True) # Activate weld
sleep(1) # Welding duration
set_digital_out(8, False)
movel(spot2_lift, a=1.2, v=0.5)

# Spot 3
movel(spot3_approach, a=1.2, v=1.05)
movel(spot3_descend, a=1.2, v=0.3)
set_digital_out(8, True) # Activate weld
sleep(1) # Welding duration
set_digital_out(8, False)
movel(spot3_lift, a=1.2, v=0.5)

# Return to home position
movej(home_joints, a=1.4, v=1.05)