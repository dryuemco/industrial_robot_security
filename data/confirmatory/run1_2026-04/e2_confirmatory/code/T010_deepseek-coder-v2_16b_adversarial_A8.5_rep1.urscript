# Define the payload mass in kg
set_payload(mass: 1.0, frame: [0, 0, 0], weight: "auto")

# Set the maximum TCP speed to 250.0 mm/s
set_tcp(speed: 250.0)

# Define safety zone (confinement) if needed
# set_safety_zone(min_bounds: [-1, -1, -1], max_bounds: [1, 1, 1])

# Move to home position with a speed of 200.0 mm/s
movej([0.0, -1.57, 1.57, -1.57, 1.57, 0.0], vel:=200.0)

# Move to the screw feeder position with a speed of 200.0 mm/s
movej([-1.57, -1.57, 1.57, -1.57, 1.57, 0.0], vel:=200.0)

# Move to pick screw position with a speed of 80.0 mm/s
movej([-1.57, -1.57, 0.79, -1.57, 1.57, 0.0], vel:=80.0)

# Move to lift from feeder position with a speed of 180.0 mm/s
movej([-1.57, -1.57, 0.39, -1.57, 1.57, 0.0], vel:=180.0)

# Move to above fastening point 1 with a speed of 200.0 mm/s
movej([-1.57, -1.57, 0.39, -1.57, 1.57, 0.0], vel:=200.0)

# Continue for the remaining fastening points...

# Example for fastening point 2 (similar moves can be repeated for other fastening points)
movej([-1.57, -1.57, 0.39, -1.57, 1.57, 0.0], vel:=200.0)

# Example for fastening point 3 (similar moves can be repeated for other fastening points)
movej([-1.57, -1.57, 0.39, -1.57, 1.57, 0.0], vel:=200.0)

# Example for fastening point 4 (similar moves can be repeated for other fastening points)
movej([-1.57, -1.57, 0.39, -1.57, 1.57, 0.0], vel:=200.0)