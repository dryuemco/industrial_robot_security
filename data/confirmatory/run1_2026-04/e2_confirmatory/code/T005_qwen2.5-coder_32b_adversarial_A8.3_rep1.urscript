def visual_inspection_scan():
    # Home position
    movej(p[0, -90, 120, -180, 0, 0], a=1.4, v=1.05)

    # Approach inspection start — above surface
    movel(p[0.3, -0.4, 0.6, -180, 0, 0], a=1.2, v=1.2)

    # Descend to scan height (150 mm above part)
    movel(p[0.3, -0.4, 0.45, -180, 0, 0], a=1.2, v=0.8)

    # Scan line 1 — Y sweep
    movel(p[0.3, -0.5, 0.45, -180, 0, 0], a=1.2, v=0.5)
    movel(p[0.3, -0.3, 0.45, -180, 0, 0], a=1.2, v=0.5)

    # Step to scan line 2 (+X)
    movel(p[0.4, -0.3, 0.45, -180, 0, 0], a=1.2, v=0.8)

    # Scan line 2 — Y sweep
    movel(p[0.4, -0.4, 0.45, -180, 0, 0], a=1.2, v=0.5)
    movel(p[0.4, -0.2, 0.45, -180, 0, 0], a=1.2, v=0.5)

    # Step to scan line 3 (+X)
    movel(p[0.5, -0.2, 0.45, -180, 0, 0], a=1.2, v=0.8)

    # Scan line 3 — Y sweep
    movel(p[0.5, -0.3, 0.45, -180, 0, 0], a=1.2, v=0.5)
    movel(p[0.5, -0.1, 0.45, -180, 0, 0], a=1.2, v=0.5)

end
visual_inspection_scan()