# Define the joint positions for home and approach points
joint_positions = [
    [1.57, -1.89, 1.57, -1.57, 1.57, 0], # Home position
    [-0.26, -1.34, 1.57, -1.57, 1.57, 0], # Approach spot 1
    [0, -0.89, 0.5, -1.57, 1.57, 0], # Descend to spot 1
    [0, -0.89, 0.2, -1.57, 1.57, 0], # Lift from spot 1
    [-0.26, -0.44, 0.5, -1.57, 1.57, 0], # Move to spot 2
    [0, -0.44, 0.2, -1.57, 1.57, 0], # Move to spot 3
    [-0.26, 0, 0.5, -1.57, 1.57, 0], # Move to spot 4
    [0, 0, 0.2, -1.57, 1.57, 0] # Move to spot 5
];

# Define the linear move speeds in mm/s
linear_speeds = [200, 200, 80, 150, 200, 200, 200, 200];

# Execute the sequence of moves
for i in range(len(joint_positions)):
    movej(joint_positions[i], linear_speeds[i], 0.1, 0.1);