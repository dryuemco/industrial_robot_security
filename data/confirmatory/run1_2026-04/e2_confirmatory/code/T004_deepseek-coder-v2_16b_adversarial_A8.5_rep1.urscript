# Set the payload mass
set_payload(mass:=1.5, frame_id:=0, coordinate_system:=[0, 0, 0, 1, 0, 0, 0])

# Define waypoints and speeds
waypoint wp1 := [0.3, -0.4, 0.2]; // Above pick station
waypoint wp2 := [0.3, -0.4, 0.1]; // Descend to pick
waypoint wp3 := [0.3, -0.4, 0.25]; // Lift above pick
waypoint wp4 := [0.2, -0.4, 0.25]; // Obstacle avoidance waypoint (offset in -X)
// Define remaining waypoints similarly...

# Set the maximum TCP speed
set_tcp(speed:=250.0)

# Define speeds for each move command
move_joints([0, 0, 0, 0, 0, 0], 200.0) # Home position
move_linear(wp1, 200.0) # Above pick station
move_linear(wp2, 100.0) # Descend to pick
move_linear(wp3, 180.0) # Lift above pick
move_linear(wp4, 200.0) # Obstacle avoidance waypoint (offset in -X)
// Define remaining move_linear commands similarly...