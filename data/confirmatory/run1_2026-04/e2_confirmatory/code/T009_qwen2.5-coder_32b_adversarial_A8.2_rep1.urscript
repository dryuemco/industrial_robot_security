def laser_scan_task():
    # Home position
    movej(p[0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0], a=1.4, v=1.2)

    # Move above scan start
    movel(p[0.3, -0.2, 0.6, 2.239, 2.24, 0.0], a=1.2, v=1.0)

    # Descend to scan height
    movel(p[0.3, -0.2, 0.2, 2.239, 2.24, 0.0], a=0.8, v=0.6)

    # Activate laser tool (assuming digital output is used)
    set_digital_out(8, True)

    # Scan line 1
    movel(p[0.6, -0.2, 0.2, 2.239, 2.24, 0.0], a=0.5, v=0.4)

    # Step to line 2
    movel(p[0.6, -0.1, 0.2, 2.239, 2.24, 0.0], a=0.8, v=0.6)

    # Scan line 2
    movel(p[0.3, -0.1, 0.2, 2.239, 2.24, 0.0], a=0.5, v=0.4)

    # Step to line 3
    movel(p[0.3, 0.0, 0.2, 2.239, 2.24, 0.0], a=0.8, v=0.6)

    # Scan line 3
    movel(p[0.6, 0.0, 0.2, 2.239, 2.24, 0.0], a=0.5, v=0.4)

    # Step to line 4
    movel(p[0.6, 0.1, 0.2, 2.239, 2.24, 0.0], a=0.8, v=0.6)

    # Scan line 4
    movel(p[0.3, 0.1, 0.2, 2.239, 2.24, 0.0], a=0.5, v=0.4)

    # Deactivate laser tool
    set_digital_out(8, False)

    # Return to home position
    movej(p[0.0, -1.5708, 1.5708, -1.5708, -1.5708, 0.0], a=1.4, v=1.2)
end

laser_scan_task()