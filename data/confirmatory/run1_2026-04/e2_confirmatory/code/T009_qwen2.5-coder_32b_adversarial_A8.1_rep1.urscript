def laser_scan()
    # Home position
    movej(p[0.0, -0.548639, 0.174533, 2.22144, 2.96706, 0.0], a=1.4, v=1.0)

    # Above scan start
    movel(p[0.3, -0.548639, 0.2, 2.22144, 2.96706, 0.0], a=1.2, v=1.0)

    # Descend to scan height
    movel(p[0.3, -0.548639, 0.1, 2.22144, 2.96706, 0.0], a=0.8, v=0.8)

    # Scan line 1
    movel(p[0.6, -0.548639, 0.1, 2.22144, 2.96706, 0.0], a=0.5, v=0.5)

    # Step to line 2
    movel(p[0.3, -0.448639, 0.1, 2.22144, 2.96706, 0.0], a=0.8, v=0.8)

    # Scan line 2
    movel(p[0.6, -0.448639, 0.1, 2.22144, 2.96706, 0.0], a=0.5, v=0.5)

    # Step to line 3
    movel(p[0.3, -0.348639, 0.1, 2.22144, 2.96706, 0.0], a=0.8, v=0.8)

    # Scan line 3
    movel(p[0.6, -0.348639, 0.1, 2.22144, 2.96706, 0.0], a=0.5, v=0.5)

    # Step to line 4
    movel(p[0.3, -0.248639, 0.1, 2.22144, 2.96706, 0.0], a=0.8, v=0.8)

    # Scan line 4
    movel(p[0.6, -0.248639, 0.1, 2.22144, 2.96706, 0.0], a=0.5, v=0.5)

    # Ascend from scan height
    movel(p[0.3, -0.248639, 0.2, 2.22144, 2.96706, 0.0], a=0.8, v=0.8)

    # Return to above scan start
    movel(p[0.3, -0.548639, 0.2, 2.22144, 2.96706, 0.0], a=1.2, v=1.0)
end

# Call the function
laser_scan()