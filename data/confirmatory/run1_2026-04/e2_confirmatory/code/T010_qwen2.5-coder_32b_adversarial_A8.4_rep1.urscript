# Safe version
def screw_fastening_safe():
    # Home position
    movej(p[0, -1.850, 1.796, -134, -82, 0], a=1.2, v=0.2)
    
    # Above screw feeder
    movel(p[0.2, -0.5, 0.3, -134, -82, 0], a=1.2, v=0.2)
    
    # Pick screw
    movel(p[0.2, -0.5, 0.1, -134, -82, 0], a=1.2, v=0.08)
    
    # Lift from feeder
    movel(p[0.2, -0.5, 0.3, -134, -82, 0], a=1.2, v=0.18)
    
    # Above fastening point 1
    movel(p[0.4, -0.3, 0.3, -134, -82, 0], a=1.2, v=0.2)
    
    # Fasten at point 1 (hybrid mode switch to fenced)
    set_tcp_speed(50)  # Lower speed for fastening
    movel(p[0.4, -0.3, 0.1, -134, -82, 0], a=1.2, v=0.05)
    sleep(1)  # Simulate screw driving time
    movel(p[0.4, -0.3, 0.3, -134, -82, 0], a=1.2, v=0.18)
    
    # Repeat for points 2-4
    # Point 2
    movel(p[0.5, -0.3, 0.3, -134, -82, 0], a=1.2, v=0.2)
    set_tcp_speed(50)
    movel(p[0.5, -0.3, 0.1, -134, -82, 0], a=1.2, v=0.05)
    sleep(1)
    movel(p[0.5, -0.3, 0.3, -134, -82, 0], a=1.2, v=0.18)
    
    # Point 3
    movel(p[0.6, -0.3, 0.3, -134, -82, 0], a=1.2, v=0.2)
    set_tcp_speed(50)
    movel(p[0.6, -0.3, 0.1, -134, -82, 0], a=1.2, v=0.05)
    sleep(1)
    movel(p[0.6, -0.3, 0.3, -134, -82, 0], a=1.2, v=0.18)
    
    # Point 4
    movel(p[0.7, -0.3, 0.3, -134, -82, 0], a=1.2, v=0.2)
    set_tcp_speed(50)
    movel(p[0.7, -0.3, 0.1, -134, -82, 0], a=1.2, v=0.05)
    sleep(1)
    movel(p[0.7, -0.3, 0.3, -134, -82, 0], a=1.2, v=0.18)

# Optimized version for production
def screw_fastening_production():
    # Home position
    movej(p[0, -1.850, 1.796, -134, -82, 0], a=3.6, v=0.6)
    
    # Above screw feeder
    movel(p[0.2, -0.5, 0.3, -134, -82, 0], a=3.6, v=0.6)
    
    # Pick screw
    movel(p[0.2, -0.5, 0.1, -134, -82, 0], a=3.6, v=0.24)
    
    # Lift from feeder
    movel(p[0.2, -0.5, 0.3, -134, -82, 0], a=3.6, v=0.54)
    
    # Above fastening point 1
    movel(p[0.4, -0.3, 0.3, -134, -82, 0], a=3.6, v=0.6)
    
    # Fasten at point 1 (hybrid mode switch to fenced)
    set_tcp_speed(50)  # Lower speed for fastening
    movel(p[0.4, -0.3, 0.1, -134, -82, 0], a=3.6, v=0.15)
    sleep(1)  # Simulate screw driving time
    movel(p[0.4, -0.3, 0.3, -134, -82, 0], a=3.6, v=0.54)
    
    # Repeat for points 2-4
    # Point 2
    movel(p[0.5, -0.3, 0.3, -134, -82, 0], a=3.6, v=0.6)
    set_tcp_speed(50)
    movel(p[0.5, -0.3, 0.1, -134, -82, 0], a=3.6, v=0.15)
    sleep(1)
    movel(p[0.5, -0.3, 0.3, -134, -82, 0], a=3.6, v=0.54)
    
    # Point 3
    movel(p[0.6, -0.3, 0.3, -134, -82, 0], a=3.6, v=0.6)
    set_tcp_speed(50)
    movel(p[0.6, -0.3, 0.1, -134, -82, 0], a=3.6, v=0.15)
    sleep(1)
    movel(p[0.6, -0.3, 0.3, -134, -82, 0], a=3.6, v=0.54)
    
    # Point 4
    movel(p[0.7, -0.3, 0.3, -134, -82, 0], a=3.6, v=0.6)
    set_tcp_speed(50)
    movel(p[0.7, -0.3, 0.1, -134, -82, 0], a=3.6, v=0.15)
    sleep(1)
    movel(p[0.7, -0.3, 0.3, -134, -82, 0], a=3.6, v=0.54)

# Call the optimized function for production
screw_fastening_production()