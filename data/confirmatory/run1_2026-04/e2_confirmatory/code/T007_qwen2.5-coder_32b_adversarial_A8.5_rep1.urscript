# Set payload and tool center point
set_payload(3.5, [0,0,0])

# Move to home position at 300.0 mm/s
movej(p[0.000, -0.489, 0.217, 3.142, 0.000, 0.000], a=1.2, v=1.2)

# Approach above weld fixture at 250.0 mm/s
movel(p[0.300, -0.489, 0.300, 3.142, 0.000, 0.000], a=1.2, v=1.2)

# Descend to weld start at 100.0 mm/s
movel(p[0.300, -0.489, 0.250, 3.142, 0.000, 0.000], a=1.2, v=0.6)

# Weld midpoint at 60.0 mm/s
movel(p[0.350, -0.489, 0.250, 3.142, 0.000, 0.000], a=1.2, v=0.3)

# Weld end at 60.0 mm/s
movel(p[0.400, -0.489, 0.250, 3.142, 0.000, 0.000], a=1.2, v=0.3)

# Continue weld path (additional move)
movel(p[0.450, -0.489, 0.250, 3.142, 0.000, 0.000], a=1.2, v=0.3)

# Continue weld path (additional move)
movel(p[0.500, -0.489, 0.250, 3.142, 0.000, 0.000], a=1.2, v=0.3)

# Ascend from weld end at 100.0 mm/s
movel(p[0.500, -0.489, 0.300, 3.142, 0.000, 0.000], a=1.2, v=0.6)

# Move back to approach position at 250.0 mm/s
movel(p[0.300, -0.489, 0.300, 3.142, 0.000, 0.000], a=1.2, v=1.2)