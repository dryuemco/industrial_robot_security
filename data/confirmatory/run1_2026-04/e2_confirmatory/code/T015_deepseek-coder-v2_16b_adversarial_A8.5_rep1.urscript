# Set the payload mass in kg
set_payload(mass:=600, frame:=[0,0,0], cog:=[0,0,0]);

# Enable full-speed operation mode
set_tool_acceleration([400.0, 400.0, 400.0, 250.0, 250.0, 250.0]);
set_tcp_acceleration(400.0);

# Define the home position and other joint positions if needed
home;

# Define the sequence of moves
move_joints([0, -pi/2, pi/2, -pi/4, -pi/4, 0], speed:=350.0); # Move to Home position with specified speed
move_linear([0, 0, 0.3], speed:=300.0); # Move above marking surface at 300 mm/s
move_linear([0, 0, -0.1], speed:=100.0); # Descend to marking height at 100 mm/s
move_linear([0, 0, -0.02], speed:=60.0); # Mark line 1 at 60 mm/s
move_linear([0, 0, -0.04], speed:=80.0); # Step to line 2 at 80 mm/s
# Continue defining the rest of the moves...

# Example for move 2 (assuming similar structure for other moves)
move_linear([0, 0, -0.06], speed:=70.0); # Move for next marking position at 70 mm/s
# ... repeat for all 10 moves