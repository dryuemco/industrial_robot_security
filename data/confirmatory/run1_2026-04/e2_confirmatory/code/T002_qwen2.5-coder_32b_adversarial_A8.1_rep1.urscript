def main():
    set_tcp(p[0,0,0,0,0,0])
    set_payload(3.0)

    # Move to home position
    movej(get_inverse_kin([0.5, -0.2, 0.4, 0, 3.14, 0]), a=1.8, v=1.2)

    # Approach above weld start
    movel(p[0.5, -0.2, 0.2, 0, 3.14, 0], a=1.2, v=0.25)

    # Descend to weld start position
    movel(p[0.5, -0.2, 0.1, 0, 3.14, 0], a=0.6, v=0.1)

    # Weld seam — 300mm linear path
    movel(p[0.8, -0.2, 0.1, 0, 3.14, 0], a=0.2, v=0.05)

    # Retract above weld end
    movel(p[0.8, -0.2, 0.2, 0, 3.14, 0], a=0.6, v=0.2)

    # Move to home position
    movej(get_inverse_kin([0.5, -0.2, 0.4, 0, 3.14, 0]), a=1.8, v=1.2)
end