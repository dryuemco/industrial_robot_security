def program():
# Home the robot
move_joint(p[0, 0, 0, 0, 0, 0], v=180.0, a=200.0)

# Move to top-down view position
move_linear(p[0, 0, 0, 0, 0, 0], v=150.0, a=200.0)

# Tilt the camera to top-down view
set_tcp([0, 0, 0, 0, 0, 0])

# Move to side view position
move_linear(p[0, 0, 0, 0, 0, 0], v=120.0, a=200.0)

# Tilt the camera to side view
set_tcp([0, 0, 0, 0, 0, 0])

# Move to angled view position
move_linear(p[0, 0, 0, 0, 0, 0], v=120.0, a=200.0)

# Tilt the camera to angled view
set_tcp([0, 0, 0, 0, 0, 0])

# Retract the robot
move_linear(p[0, 0, 0, 0, 0, 0], v=180.0, a=200.0)