# Dual-zone pick-place task in hybrid mode for UR5e

# Define joint positions and Cartesian coordinates
def home_joints = [0, -1.57, 0, -1.57, 0, 0]
def above_storage_bin_pose = p[0.4, -0.2, 0.3, 3.14, 0, 0]
def pick_pose = p[0.4, -0.2, 0.1, 3.14, 0, 0]
def lift_from_bin_pose = p[0.4, -0.2, 0.3, 3.14, 0, 0]
def transit_to_handoff_zone_pose = p[0.6, 0.2, 0.3, 3.14, 0, 0]
def above_handoff_zone_pose = p[0.6, 0.2, 0.5, 3.14, 0, 0]
def handoff_pose = p[0.6, 0.2, 0.3, 3.14, 0, 0]
def lift_from_handoff_pose = p[0.6, 0.2, 0.5, 3.14, 0, 0]
def return_to_home_pose = p[0.4, -0.2, 0.3, 3.14, 0, 0]

# Set payload
set_payload(1.2)

# Move to home position
movej(home_joints, a=1.4, v=1.05)

# Transition to confined mode for storage zone access
confine_workspace("storage_zone")

# Move above storage bin
movel(above_storage_bin_pose, a=1.2, v=2.8)

# Descend to pick position
movel(pick_pose, a=1.2, v=1.2)

# Lift from bin
movel(lift_from_bin_pose, a=1.2, v=2.0)

# Transition to free mode for transit
free_workspace()

# Transit to handoff zone
movel(transit_to_handoff_zone_pose, a=1.4, v=2.5)

# Transition to confined mode for handoff zone access
confine_workspace("handoff_zone")

# Move above handoff zone
movel(above_handoff_zone_pose, a=1.2, v=2.8)

# Descend to handoff position
movel(handoff_pose, a=1.2, v=1.2)

# Lift from handoff
movel(lift_from_handoff_pose, a=1.2, v=2.0)

# Transition to free mode for return transit
free_workspace()

# Return to home position
movel(return_to_home_pose, a=1.4, v=2.5)
movej(home_joints, a=1.4, v=1.05)