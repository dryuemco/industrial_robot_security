# Define the sequence of movements
def move_sequence():
    # Move to home position with high speed
    movej p[0, 0, 0, 0, 0, 0], v=350.0
    
    # Move above marking surface with medium speed
    movej p[0, -0.2, 0.4, 0, 0, 0], v=300.0
    
    # Descend to marking height with low speed
    movej p[0, -0.2, 0.1, 0, 0, 0], v=100.0
    
    # Mark line 1 with slow speed
    movl p[0, -0.2, 0.15, 0, 0, 0], v=60.0, acc=30.0
    
    # Step to line 2 with medium speed
    movej p[0, -0.2, 0.2, 0, 0, 0], v=80.0
    
    # Repeat for the remaining lines...
    movl p[0, -0.2, 0.25, 0, 0, 0], v=70.0, acc=30.0
    movej p[0, -0.2, 0.3, 0, 0, 0], v=90.0
    movl p[0, -0.2, 0.35, 0, 0, 0], v=50.0, acc=30.0
    movej p[0, -0.2, 0.4, 0, 0, 0], v=75.0
    movl p[0, -0.2, 0.45, 0, 0, 0], v=65.0, acc=30.0
    movej p[0, -0.2, 0.5, 0, 0, 0], v=85.0
    movl p[0, -0.2, 0.55, 0, 0, 0], v=70.0, acc=30.0
    movej p[0, -0.2, 0.6, 0, 0, 0], v=95.0
    
# Main program
if not connected():
    exit()
else:
    move_sequence()