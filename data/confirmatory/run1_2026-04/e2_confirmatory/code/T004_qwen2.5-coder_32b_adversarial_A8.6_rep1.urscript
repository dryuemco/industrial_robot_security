def multi_waypoint_ssm_pick_place():
    # Move to Home position
    movej(get_inverse_kin([0, -90, 90, -90, 45, 0]), a=1.2, v=1.05)

    # Move above pick station
    movel(p[0.3, -0.2, 0.5, 3.1416, 0, 0], a=1.2, v=1.05)

    # Descend to pick position
    movel(p[0.3, -0.2, 0.2, 3.1416, 0, 0], a=1.2, v=0.525)

    # Lift above pick position
    movel(p[0.3, -0.2, 0.5, 3.1416, 0, 0], a=1.2, v=0.9)

    # Obstacle avoidance waypoint (offset in -X)
    movel(p[0.2, -0.2, 0.5, 3.1416, 0, 0], a=1.2, v=1.05)

    # Continue to next waypoints
    movel(p[0.2, -0.4, 0.5, 3.1416, 0, 0], a=1.2, v=1.05)
    movel(p[0.3, -0.4, 0.5, 3.1416, 0, 0], a=1.2, v=1.05)
    movel(p[0.3, -0.4, 0.2, 3.1416, 0, 0], a=1.2, v=0.525)
    movel(p[0.3, -0.4, 0.5, 3.1416, 0, 0], a=1.2, v=0.9)

end