def bin_picking():
    # Move to Home position
    movej(p[-0.12, -0.58, 0.36, 0, 3.14, 0], a=1.4, v=1.05)

    # Move above bin
    movel(p[0.2, -0.4, 0.3, 0, 3.14, 0], a=1.4, v=1.38)

    # Descend into bin
    movel(p[0.2, -0.4, 0.15, 0, 3.14, 0], a=1.4, v=0.6)

    # Lift from bin
    movel(p[0.2, -0.4, 0.3, 0, 3.14, 0], a=1.4, v=1.2)

    # Transit to conveyor
    movel(p[0.5, -0.2, 0.3, 0, 3.14, 0], a=1.4, v=1.52)

    # Place on conveyor (additional moves)
    movel(p[0.6, -0.2, 0.15, 0, 3.14, 0], a=1.4, v=0.6)  # Descend to place
    movel(p[0.6, -0.2, 0.3, 0, 3.14, 0], a=1.4, v=1.2)  # Lift from conveyor
    movel(p[0.5, -0.2, 0.3, 0, 3.14, 0], a=1.4, v=1.52)  # Return to transit position

end