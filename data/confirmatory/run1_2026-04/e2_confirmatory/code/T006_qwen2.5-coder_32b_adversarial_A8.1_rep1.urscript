def bin_picking():
    # Set max speed and acceleration
    set_tcp_speed(400.0, 1500)
    
    # Move to home position
    movej(p[-0.236, -0.278, 0.294, 2.222, -2.222, 0.0], a=1.4, v=1.05)
    
    # Move above bin
    movel(p[-0.236, -0.278, 0.194, 2.222, -2.222, 0.0], a=1.4, v=1.38)
    
    # Descend into bin
    movel(p[-0.236, -0.278, 0.094, 2.222, -2.222, 0.0], a=1.4, v=0.58)
    
    # Activate suction (assuming digital output is used for suction control)
    set_digital_out(8, True)
    sleep(0.5)  # Wait for suction to engage
    
    # Lift from bin
    movel(p[-0.236, -0.278, 0.194, 2.222, -2.222, 0.0], a=1.4, v=1.2)
    
    # Transit to conveyor
    movel(p[0.156, -0.378, 0.194, 2.222, -2.222, 0.0], a=1.4, v=1.52)
    
    # Move above conveyor
    movel(p[0.156, -0.378, 0.094, 2.222, -2.222, 0.0], a=1.4, v=1.52)
    
    # Place on conveyor
    set_digital_out(8, False)  # Deactivate suction
    
    # Lift from conveyor
    movel(p[0.156, -0.378, 0.194, 2.222, -2.222, 0.0], a=1.4, v=1.52)
    
    # Return to home position
    movej(p[-0.236, -0.278, 0.294, 2.222, -2.222, 0.0], a=1.4, v=1.05)

end

bin_picking()